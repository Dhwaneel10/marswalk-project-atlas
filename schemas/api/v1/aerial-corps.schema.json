{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marswalk.nasa/schemas/api/v1/aerial-corps.schema.json",
  "title": "AerialCorpsReport",
  "description": "JSON Schema Draft 2020-12 contract for planetary multi-rotorcraft flight, aerodynamics, aerial science, and rover-aircraft cooperation.",
  "type": "object",
  "required": [
    "mission_id",
    "timestamp_sol",
    "aircraft_fleet",
    "atmospheric_state",
    "system_disclaimer"
  ],
  "properties": {
    "mission_id": {
      "type": "string"
    },
    "timestamp_sol": {
      "type": "number",
      "minimum": 0.0
    },
    "aircraft_fleet": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "aircraft_id",
          "profile",
          "name",
          "total_mass_kg",
          "position_xyz_m",
          "altitude_agl_m",
          "flight_mode",
          "health_state",
          "battery_soc_pct",
          "power_draw_w"
        ],
        "properties": {
          "aircraft_id": { "type": "string" },
          "profile": { "type": "string" },
          "name": { "type": "string" },
          "total_mass_kg": { "type": "number", "minimum": 0.0 },
          "payload_mass_kg": { "type": "number", "minimum": 0.0 },
          "position_xyz_m": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "altitude_agl_m": { "type": "number" },
          "velocity_xyz_m_s": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "attitude_rpy_deg": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "flight_mode": { "type": "string" },
          "health_state": { "type": "string" },
          "battery_soc_pct": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
          "power_draw_w": { "type": "number", "minimum": 0.0 },
          "total_flight_time_s": { "type": "number", "minimum": 0.0 },
          "total_distance_flown_m": { "type": "number", "minimum": 0.0 },
          "paired_rover_id": { "type": ["string", "null"] }
        }
      }
    },
    "atmospheric_state": {
      "type": "object",
      "required": [
        "pressure_pa",
        "temperature_k",
        "density_kg_m3",
        "speed_of_sound_m_s"
      ],
      "properties": {
        "pressure_pa": { "type": "number", "minimum": 0.0 },
        "temperature_k": { "type": "number", "minimum": 0.0 },
        "density_kg_m3": { "type": "number", "minimum": 0.0 },
        "speed_of_sound_m_s": { "type": "number", "minimum": 0.0 },
        "dynamic_viscosity_pa_s": { "type": "string" },
        "is_valid": { "type": "boolean" },
        "provenance": { "type": "string" }
      }
    },
    "active_flight_plans": {
      "type": "array",
      "items": { "type": "object" }
    },
    "science_observations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "cooperative_plans": {
      "type": "array",
      "items": { "type": "object" }
    },
    "system_disclaimer": {
      "type": "string"
    }
  }
}
