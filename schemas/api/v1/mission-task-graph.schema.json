{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marswalk.nasa.gov/schemas/api/v1/mission-task-graph.schema.json",
  "title": "Mission Task Graph Contract",
  "description": "Directed Acyclic Graph (DAG) representation of decomposed mission activities, dependency edges, and critical path metrics.",
  "type": "object",
  "required": [
    "graph_id",
    "intent_id",
    "tasks",
    "edges",
    "total_tasks_count",
    "total_duration_s",
    "total_energy_wh",
    "is_acyclic"
  ],
  "properties": {
    "graph_id": { "type": "string" },
    "intent_id": { "type": "string" },
    "total_tasks_count": { "type": "integer", "minimum": 0 },
    "total_duration_s": { "type": "number", "minimum": 0.0 },
    "total_energy_wh": { "type": "number" },
    "total_data_mb": { "type": "number", "minimum": 0.0 },
    "is_acyclic": { "type": "boolean" },
    "critical_path": {
      "type": "array",
      "items": { "type": "string" }
    },
    "root_task_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "terminal_task_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at_utc": { "type": "string" },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["task_id", "task_type", "name", "location_rc", "estimated_duration_s", "sol_index"],
        "properties": {
          "task_id": { "type": "string" },
          "task_type": { "type": "string" },
          "name": { "type": "string" },
          "parent_goal_id": { "type": "string" },
          "assigned_rover_id": { "type": ["string", "null"] },
          "target_id": { "type": ["string", "null"] },
          "location_rc": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 2,
            "maxItems": 2
          },
          "prerequisite_task_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "estimated_duration_s": { "type": "number", "minimum": 0.0 },
          "estimated_energy_wh": { "type": "number" },
          "estimated_data_mb": { "type": "number", "minimum": 0.0 },
          "sol_index": { "type": "integer", "minimum": 1 },
          "status": { "type": "string" },
          "metadata": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
