{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarsWalk Simulated Data Transfer Schema",
  "description": "JSON Schema for MarsWalk 2.0 / Project Atlas Milestone 13G Simulated Rover-to-Base Communications Offload",
  "type": "object",
  "required": [
    "transfer_id",
    "product_id",
    "start_time_s",
    "end_time_s",
    "duration_s",
    "bytes_transferred",
    "effective_rate_bps",
    "network_path",
    "hop_count",
    "destination",
    "verified",
    "label"
  ],
  "properties": {
    "transfer_id": { "type": "string" },
    "product_id": { "type": "string" },
    "start_time_s": { "type": "number", "minimum": 0 },
    "end_time_s": { "type": "number", "minimum": 0 },
    "duration_s": { "type": "number", "minimum": 0 },
    "bytes_transferred": { "type": "integer", "minimum": 0 },
    "bytes_transferred_mb": { "type": "number", "minimum": 0 },
    "effective_rate_bps": { "type": "number", "minimum": 0 },
    "network_path": { "type": "array", "items": { "type": "string" } },
    "hop_count": { "type": "integer", "minimum": 1 },
    "destination": { "type": "string", "const": "SURFACE_BASE_STATION" },
    "verified": { "type": "boolean" },
    "receipt_checksum": { "type": "string" },
    "label": { "type": "string", "const": "SIMULATED_DATA_TRANSFER" }
  },
  "additionalProperties": false
}
