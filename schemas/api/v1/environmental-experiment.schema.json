{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marswalk.nasa.gov/schemas/api/v1/environmental-experiment.schema.json",
  "title": "Atlas Environmental Science Experiment Schema",
  "description": "Milestone 13M — Standardized planetary climate validation experiments, findings, and charts payloads.",
  "type": "object",
  "required": [
    "experiment_id",
    "title",
    "objective",
    "data_sources",
    "methodology",
    "sample_size",
    "quantitative_findings",
    "scientific_conclusion",
    "operational_implications",
    "charts_payload"
  ],
  "properties": {
    "experiment_id": { "type": "string" },
    "title": { "type": "string" },
    "objective": { "type": "string" },
    "data_sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "methodology": { "type": "string" },
    "sample_size": { "type": "integer", "minimum": 0 },
    "quantitative_findings": { "type": "object" },
    "scientific_conclusion": { "type": "string" },
    "operational_implications": { "type": "string" },
    "charts_payload": { "type": "object" }
  }
}
