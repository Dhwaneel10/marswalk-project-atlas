{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarsWalk Mission Storage Ledger Schema",
  "description": "JSON Schema for MarsWalk 2.0 / Project Atlas Milestone 13G Onboard Solid-State Memory Ledger and Byte Conservation Accounting",
  "type": "object",
  "required": [
    "capacity_bytes",
    "used_bytes",
    "free_bytes",
    "fill_ratio",
    "reserve_margin_pct",
    "configured_transfer_rate_bps",
    "effective_transfer_rate_bps",
    "destination_name",
    "cumulative_generated_bytes",
    "cumulative_released_bytes",
    "cumulative_transferred_bytes",
    "backlog_bytes",
    "queue_depth",
    "current_pressure_state",
    "byte_conservation_verified",
    "products",
    "transfers",
    "ledger_history"
  ],
  "properties": {
    "capacity_bytes": { "type": "integer", "minimum": 1 },
    "capacity_mb": { "type": "number", "minimum": 0 },
    "used_bytes": { "type": "integer", "minimum": 0 },
    "used_mb": { "type": "number", "minimum": 0 },
    "free_bytes": { "type": "integer", "minimum": 0 },
    "free_mb": { "type": "number", "minimum": 0 },
    "fill_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "reserve_margin_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "configured_transfer_rate_bps": { "type": "number", "minimum": 0 },
    "effective_transfer_rate_bps": { "type": "number", "minimum": 0 },
    "destination_name": { "type": "string" },
    "cumulative_generated_bytes": { "type": "integer", "minimum": 0 },
    "cumulative_generated_mb": { "type": "number", "minimum": 0 },
    "cumulative_released_bytes": { "type": "integer", "minimum": 0 },
    "cumulative_released_mb": { "type": "number", "minimum": 0 },
    "cumulative_transferred_bytes": { "type": "integer", "minimum": 0 },
    "cumulative_transferred_mb": { "type": "number", "minimum": 0 },
    "backlog_bytes": { "type": "integer", "minimum": 0 },
    "backlog_mb": { "type": "number", "minimum": 0 },
    "queue_depth": { "type": "integer", "minimum": 0 },
    "completed_transfers_count": { "type": "integer", "minimum": 0 },
    "current_pressure_state": {
      "type": "string",
      "enum": [
        "STORAGE_AVAILABLE",
        "STORAGE_PRESSURE",
        "STORAGE_NEAR_CAPACITY",
        "STORAGE_CAPACITY_REACHED",
        "TRANSFER_QUEUE_BACKLOG",
        "HIGH_PRIORITY_DATA_PENDING"
      ]
    },
    "byte_conservation_verified": { "type": "boolean" },
    "byte_conservation_message": { "type": "string" },
    "products": { "type": "object" },
    "transfers": { "type": "array" },
    "ledger_history": { "type": "array" }
  },
  "additionalProperties": false
}
