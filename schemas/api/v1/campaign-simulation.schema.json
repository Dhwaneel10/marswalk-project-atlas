{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marswalk.nasa.gov/schemas/api/v1/campaign-simulation.schema.json",
  "title": "MarsWalk Campaign Digital Twin Simulation Contract",
  "description": "Schema validating multi-unit planetary campaign temporal execution simulation, multi-lane task intervals, discrete event log, temporal conflicts, and state snapshots.",
  "type": "object",
  "required": [
    "schema_version",
    "simulation_id",
    "campaign_id",
    "campaign_version",
    "status",
    "current_time_s",
    "current_sol",
    "total_duration_s",
    "units",
    "timeline_intervals",
    "events",
    "conflicts",
    "statistics",
    "limitations_disclaimer"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "simulation_id": {
      "type": "string",
      "pattern": "^sim_[a-zA-Z0-9_-]{3,64}$"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^cmp_[a-zA-Z0-9_-]{3,64}$"
    },
    "campaign_version": {
      "type": "integer",
      "minimum": 1
    },
    "coordination_id": {
      "type": ["string", "null"]
    },
    "parent_simulation_id": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": ["IDLE", "RUNNING", "PAUSED", "COMPLETED", "INTERRUPTED"]
    },
    "current_time_s": {
      "type": "number",
      "minimum": 0.0
    },
    "current_sol": {
      "type": "integer",
      "minimum": 1
    },
    "total_duration_s": {
      "type": "number",
      "minimum": 0.0
    },
    "time_scale": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1000.0
    },
    "created_at_utc": {
      "type": "string"
    },
    "updated_at_utc": {
      "type": "string"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "unit_id",
          "name",
          "unit_type",
          "status",
          "current_activity",
          "position",
          "total_distance_m",
          "total_active_time_s"
        ],
        "properties": {
          "unit_id": { "type": "string", "minLength": 2, "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "unit_type": {
            "type": "string",
            "enum": ["robotic_rover", "crew_eva", "scout_rover", "unsupported"]
          },
          "status": {
            "type": "string",
            "enum": ["AVAILABLE", "BUSY", "HOLD", "DEGRADED", "OFFLINE"]
          },
          "current_activity": {
            "type": "string",
            "enum": ["IDLE", "TRANSIT", "DWELL", "HOLD", "HANDOFF", "REST", "OFFLINE"]
          },
          "current_target_id": { "type": ["string", "null"] },
          "current_sortie_id": { "type": ["string", "null"] },
          "position": {
            "type": "object",
            "required": ["row", "col", "elevation_m", "is_simulated_position"],
            "properties": {
              "row": { "type": "integer" },
              "col": { "type": "integer" },
              "lon": { "type": ["number", "null"] },
              "lat": { "type": ["number", "null"] },
              "elevation_m": { "type": "number" },
              "slope_deg": { "type": ["number", "null"] },
              "is_simulated_position": { "type": "boolean", "const": true }
            }
          },
          "total_distance_m": { "type": "number", "minimum": 0.0 },
          "total_active_time_s": { "type": "number", "minimum": 0.0 },
          "energy_consumed_kwh": { "type": "number", "minimum": 0.0 }
        }
      }
    },
    "timeline_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "interval_id",
          "unit_id",
          "activity_type",
          "start_time_s",
          "end_time_s",
          "duration_s",
          "sol_index",
          "status"
        ],
        "properties": {
          "interval_id": { "type": "string" },
          "unit_id": { "type": "string" },
          "activity_type": {
            "type": "string",
            "enum": ["TRANSIT", "DWELL", "HOLD", "HANDOFF", "REST", "DEPOT"]
          },
          "start_time_s": { "type": "number", "minimum": 0.0 },
          "end_time_s": { "type": "number", "minimum": 0.0 },
          "duration_s": { "type": "number", "minimum": 0.0 },
          "sol_index": { "type": "integer", "minimum": 1 },
          "sortie_id": { "type": ["string", "null"] },
          "target_id": { "type": ["string", "null"] },
          "target_name": { "type": ["string", "null"] },
          "status": {
            "type": "string",
            "enum": ["PLANNED", "IN_PROGRESS", "COMPLETED", "BLOCKED", "DEFERRED", "INTERRUPTED"]
          },
          "path_rc": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "integer" }
            }
          },
          "distance_m": { "type": "number", "minimum": 0.0 }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "simulated_time_s",
          "sol_index",
          "title",
          "description",
          "is_simulated"
        ],
        "properties": {
          "event_id": { "type": "string" },
          "event_type": { "type": "string" },
          "simulated_time_s": { "type": "number", "minimum": 0.0 },
          "sol_index": { "type": "integer", "minimum": 1 },
          "unit_id": { "type": ["string", "null"] },
          "target_id": { "type": ["string", "null"] },
          "sortie_id": { "type": ["string", "null"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "is_simulated": { "type": "boolean", "const": true },
          "details": { "type": "object" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "conflict_id",
          "code",
          "severity",
          "simulated_time_s",
          "affected_units",
          "affected_targets",
          "message",
          "recommendation"
        ],
        "properties": {
          "conflict_id": { "type": "string" },
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["blocker", "warning", "info"] },
          "simulated_time_s": { "type": "number", "minimum": 0.0 },
          "affected_units": {
            "type": "array",
            "items": { "type": "string" }
          },
          "affected_targets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "message": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    },
    "statistics": {
      "type": "object",
      "required": [
        "total_intervals",
        "total_events",
        "completed_targets",
        "remaining_targets",
        "conflicts_count",
        "progress_pct"
      ],
      "properties": {
        "total_intervals": { "type": "integer", "minimum": 0 },
        "total_events": { "type": "integer", "minimum": 0 },
        "completed_targets": { "type": "integer", "minimum": 0 },
        "remaining_targets": { "type": "integer", "minimum": 0 },
        "conflicts_count": { "type": "integer", "minimum": 0 },
        "progress_pct": { "type": "number", "minimum": 0.0, "maximum": 100.0 }
      }
    },
    "limitations_disclaimer": {
      "type": "string"
    }
  }
}
