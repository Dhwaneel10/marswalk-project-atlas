# Project Atlas / MarsWalk 2.0 — Environment Configuration Example
# Copy this file to .env or set environment variables as needed.

# Host and Port Configuration
ATLAS_HOST=127.0.0.1
ATLAS_PORT=3000

# Environment Mode: 'production' (default) or 'development'
ATLAS_ENV=production

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Python Path (must include 'src')
PYTHONPATH=src

# Optional Chrome DevTools Protocol (CDP) port for automated browser verification
CDP_PORT=9222

# Simulation Execution Mode: 'deterministic' (enforces strict PRNG seeding)
ATLAS_SIM_MODE=deterministic
