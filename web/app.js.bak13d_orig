  function initMissionControl() {
    initMissionControlElements();

    // Top Header Button -> Opens Cockpit
    if (btnHeaderMissionControl) {
      btnHeaderMissionControl.addEventListener('click', () => {
        hideLandingPage(true);
        switchInspectorTab('tabMissionControl');
        if (inspectorPanel && inspectorPanel.classList.contains('hidden')) {
          inspectorPanel.classList.remove('hidden');
        }
      });
    }

    // Refresh campaigns list
    if (btnMcRefreshCampaigns) {
      btnMcRefreshCampaigns.addEventListener('click', () => {
        loadMissionControlCampaigns(true);
      });
    }

    // Campaign Selector change
    if (mcCampaignSelect) {
      mcCampaignSelect.addEventListener('change', (e) => {
        const val = e.target.value;
        if (val) {
          selectMissionControlCampaign(val);
        }
      });
    }

    // Sortie Selector change
    if (mcSortieSelect) {
      mcSortieSelect.addEventListener('change', (e) => {
        const idx = parseInt(e.target.value, 10) || 0;
        selectMissionControlSortie(idx);
      });
    }

    // Open Readiness Modal from Cockpit
    if (btnMcOpenReadiness) {
      btnMcOpenReadiness.addEventListener('click', () => {
        if (typeof openReadinessModal === 'function') {
          openReadinessModal();
        } else if (btnHeaderReadiness) {
          btnHeaderReadiness.click();
        }
      });
    }

    // Rehearsal Transport Controls
    if (btnMcRehearse) {
      btnMcRehearse.addEventListener('click', () => {
        if (mcState.simulation.active) {
          pauseMissionControlSimulation();
        } else {
          startMissionControlSimulation();
        }
      });
    }

    if (btnMcPause) {
      btnMcPause.addEventListener('click', () => {
        pauseMissionControlSimulation();
      });
    }

    if (btnMcStep) {
      btnMcStep.addEventListener('click', () => {
        stepMissionControlSimulation();
      });
    }

    if (btnMcReset) {
      btnMcReset.addEventListener('click', () => {
        resetMissionControlSimulation();
      });
    }

    // Multiplier pills
    const speedPills = document.querySelectorAll('.mc-speed-pill');
    speedPills.forEach(pill => {
      pill.addEventListener('click', () => {
        speedPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const sp = pill.dataset.speed;
        mcState.simulation.speedMultiplier = sp === 'max' ? 50.0 : (parseFloat(sp) || 1.0);
      });
    });

    // Timeline Scrubber
    if (mcTimelineScrubber) {
      mcTimelineScrubber.addEventListener('input', (e) => {
        const pct = parseFloat(e.target.value) || 0;
        seekMissionControlSimulation(pct);
      });
    }

    // Evidence Trigger Buttons (Delegated)
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('.btn-evidence-trigger');
      if (trigger) {
        e.preventDefault();
        e.stopPropagation();
        const metric = trigger.dataset.metric;
        openEvidenceInspector(metric);
      }
    });

    // Close Evidence Modal
    if (btnCloseEvidenceModal) {
      btnCloseEvidenceModal.addEventListener('click', () => {
        closeEvidenceInspector();
      });
    }

    // Click outside evidence modal closes it
    if (evidenceModal) {
      evidenceModal.addEventListener('click', (e) => {
        if (e.target === evidenceModal) {
          closeEvidenceInspector();
        }
      });
    }

    // Command Actions
    if (btnMcInspectRoute) {
      btnMcInspectRoute.addEventListener('click', () => {
        switchInspectorTab('tabResults');
        setPlanningStatus("ROUTE TERRAIN INSPECTOR: Switched to elevation profile & cost decomposition view.", "ready");
      });
    }

    if (btnMcCompareAlternatives) {
      btnMcCompareAlternatives.addEventListener('click', () => {
        runMissionControlProfileComparison();
      });
    }

    if (btnMcEvaluateReadiness) {
      btnMcEvaluateReadiness.addEventListener('click', () => {
        evaluateMissionControlReadiness();
      });
    }

    if (btnMcAnalyzeCampaign) {
      btnMcAnalyzeCampaign.addEventListener('click', () => {
        runMissionControlAnalytics();
      });
    }

    if (btnMcExportDecisionPack) {
      btnMcExportDecisionPack.addEventListener('click', () => {
        exportMissionControlDecisionPack();
      });
    }

    // Initial load
    loadMissionControlCampaigns(false);
  }

  async function loadMissionControlCampaigns(forceRefresh = false) {
    if (!mcCampaignSelect) return;
    try {
      const resp = await fetch('/api/campaign/list');
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      const data = await resp.json();
      const list = data.campaigns || [];
      mcState.campaigns = list;

      mcCampaignSelect.innerHTML = '';
      if (list.length === 0) {
        mcCampaignSelect.innerHTML = '<option value="">No exploration campaigns found</option>';
        return;
      }

      // Add options, highlighting feasible & v2 promoted campaigns
      list.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.campaign_id;
        const vText = c.version ? `v${c.version}` : 'v1';
        const stText = c.overall_status || 'FEASIBLE';
        const pText = c.parent_campaign_id ? ` [Promoted]` : '';
        opt.textContent = `${c.title || c.name || c.campaign_id} (${vText}${pText}) — ${stText}`;
        mcCampaignSelect.appendChild(opt);
      });

      // Select active or latest campaign
      let targetId = mcState.selectedCampaignId;
      if (!targetId || !list.some(c => c.campaign_id === targetId)) {
        // Prefer audit or feasible campaign
        const best = list.find(c => c.campaign_id.includes('audit') || c.overall_status === 'FEASIBLE') || list[0];
        targetId = best.campaign_id;
      }

      mcCampaignSelect.value = targetId;
      await selectMissionControlCampaign(targetId);
    } catch (err) {
      console.warn('[Mission Control] Failed to load campaigns list:', err);
      if (mcCampaignSelect) {
        mcCampaignSelect.innerHTML = '<option value="">Failed to load campaigns list</option>';
      }
    }
  }

  async function selectMissionControlCampaign(campaignId) {
    if (!campaignId) return;

    // ATOMIC DATA REFRESH: Immediately clear old displays to prevent stale metric leakage
    if (mcCampaignTitle) mcCampaignTitle.textContent = `Loading ${campaignId}...`;
    if (mcVersionBadge) mcVersionBadge.textContent = "--";
    if (mcStatusBadge) {
      mcStatusBadge.textContent = "LOADING";
      mcStatusBadge.style.color = "var(--telemetry-cyan)";
    }
    if (mcVehicleBadge) mcVehicleBadge.textContent = "--";
    if (mcDatasetBadge) mcDatasetBadge.textContent = "--";
    if (mcLineageBadge) mcLineageBadge.textContent = "--";
    if (mcMetricDistance) mcMetricDistance.textContent = "-- m";
    if (mcMetricDuration) mcMetricDuration.textContent = "-- h";
    if (mcMetricSimDuration) mcMetricSimDuration.textContent = "-- h";
    if (mcMetricScience) mcMetricScience.textContent = "-- pts";
    if (mcMetricEnergy) mcMetricEnergy.textContent = "-- Wh";
    if (mcMetricMaxSlope) mcMetricMaxSlope.textContent = "--°";
    if (mcMinElevation) mcMinElevation.textContent = "-- m";
    if (mcMaxElevation) mcMaxElevation.textContent = "-- m";
    if (mcTotalClimb) mcTotalClimb.textContent = "-- m";
    if (mcTotalDescent) mcTotalDescent.textContent = "-- m";
    if (mcMeanSlope) mcMeanSlope.textContent = "--°";
    if (mcGateStatusText) mcGateStatusText.textContent = "READINESS: EVALUATING...";
    if (mcGateSummaryTag) mcGateSummaryTag.textContent = "CHECKING...";
    if (mcEventStream) mcEventStream.innerHTML = '<div style="color:var(--text-tertiary); font-style:italic;">Loading event ledger...</div>';
    if (mcElevationProfileSvg) mcElevationProfileSvg.innerHTML = '';
    resetMissionControlSimulation();

    try {
      const resp = await fetch(`/api/campaign/${encodeURIComponent(campaignId)}`);
      if (!resp.ok) {
        throw new Error(`Failed to load campaign ${campaignId} (HTTP ${resp.status})`);
      }
      const campaign = await resp.json();
      mcState.selectedCampaignId = campaignId;
      mcState.activeCampaignData = campaign;
      mcState.activeSortieIndex = 0;

      // Populate Overview Metadata
      if (mcCampaignTitle) mcCampaignTitle.textContent = campaign.name || campaign.title || campaign.campaign_id;
      if (mcVersionBadge) mcVersionBadge.textContent = `v${campaign.version || 1}`;
      if (mcStatusBadge) {
        const st = campaign.summary?.overall_status || 'FEASIBLE';
        mcStatusBadge.textContent = st;
        mcStatusBadge.style.color = st === 'FEASIBLE' ? 'var(--status-green)' : 'var(--status-amber)';
      }
      const vehicle = (campaign.config?.vehicle_mode || 'crew_eva').toUpperCase().replace('_', ' ');
      if (mcVehicleBadge) mcVehicleBadge.textContent = vehicle;
      if (mcDatasetBadge) mcDatasetBadge.textContent = campaign.terrain_dataset_id || 'USGS CTX 20M';
      if (mcLineageBadge) {
        mcLineageBadge.textContent = campaign.parent_campaign_id ? `PROMOTED (${campaign.parent_campaign_id})` : 'ROOT';
      }

      // Populate Executive Metrics
      const totalDist = campaign.summary?.total_distance_m || 0;
      const travelTimeH = ((campaign.summary?.total_travel_time_s || 0) / 3600).toFixed(1);
      const totalDurH = ((campaign.summary?.total_duration_s || 0) / 3600).toFixed(1);
      const sciScore = campaign.summary?.total_science_score || 0;
      const isCrew = (campaign.config?.vehicle_mode || 'crew_eva') === 'crew_eva';
      const energyWh = isCrew ? Math.round(totalDist / 1000 * 92.0) : Math.round(totalDist / 1000 * 18.5);

      if (mcMetricDistance) mcMetricDistance.textContent = `${Math.round(totalDist).toLocaleString()} m`;
      if (mcMetricDuration) mcMetricDuration.textContent = `${totalDurH} h`;
      if (mcMetricSimDuration) mcMetricSimDuration.textContent = `${totalDurH} h`;
      if (mcMetricScience) mcMetricScience.textContent = `${sciScore.toFixed(0)} pts`;
      if (mcMetricEnergy) mcMetricEnergy.textContent = `${energyWh.toLocaleString()} Wh`;

      // Objective Summary
      const tgtCount = campaign.targets?.length || 0;
      const solCount = campaign.summary?.total_sols || 1;
      const profile = campaign.config?.planning_profile || 'science_priority';
      if (mcObjectiveText) {
        mcObjectiveText.textContent = `Coordinated ${tgtCount} science targets across ${solCount} sol(s) in Jezero Crater Basin. Planning profile: ${profile}. Return to base each sol: ${campaign.config?.return_to_base_each_sol ? 'True' : 'False'}.`;
      }

      // Populate Sortie Select
      if (mcSortieSelect) {
        mcSortieSelect.innerHTML = '';
        const sorties = campaign.sorties || [];
        if (mcSortieCountBadge) mcSortieCountBadge.textContent = `Sortie 1/${Math.max(1, sorties.length)}`;
        sorties.forEach((s, idx) => {
          const opt = document.createElement('option');
          opt.value = idx;
          opt.textContent = `Sol ${s.sol_index || (idx + 1)}: ${s.name || s.sortie_id} (${Math.round(s.distance_m || 0)}m)`;
          mcSortieSelect.appendChild(opt);
        });
      }

      // Load Sortie 0
      selectMissionControlSortie(0);

      // Evaluate Readiness
      evaluateMissionControlReadiness(campaign);

      // Populate Chronological Events
      populateMissionControlEvents(campaign);

      // Load In-situ Weather
      loadMissionControlWeather();

      // Update simulation total time
      mcState.simulation.totalDurationS = campaign.summary?.total_duration_s || 10800;
    } catch (err) {
      console.error('[Mission Control] Error loading campaign:', err);
      if (mcCampaignTitle) mcCampaignTitle.textContent = `Error loading ${campaignId}`;
      if (mcStatusBadge) {
        mcStatusBadge.textContent = 'ERROR';
        mcStatusBadge.style.color = '#ff1744';
      }
      if (mcObjectiveText) {
        mcObjectiveText.textContent = `Failed to retrieve campaign data: ${err.message}. Please verify the campaign ID or select another.`;
      }
    }
  }

  function selectMissionControlSortie(sortieIndex) {
    if (!mcState.activeCampaignData) return;
    const sorties = mcState.activeCampaignData.sorties || [];
    if (sortieIndex < 0 || sortieIndex >= sorties.length) return;
    mcState.activeSortieIndex = sortieIndex;
    const sortie = sorties[sortieIndex];

    if (mcSortieCountBadge) {
      mcSortieCountBadge.textContent = `Sortie ${sortieIndex + 1}/${sorties.length}`;
    }

    // Draw route in 3D scene
    if (sortie.path_rc && sortie.path_rc.length >= 2 && typeof drawLiveRoute === 'function') {
      const profile = mcState.activeCampaignData.config?.planning_profile || 'conservative';
      drawLiveRoute(sortie.path_rc, profile);
    }

    // Render Elevation Profile in SVG
    renderMcElevationProfile(sortie);
  }

  function renderMcElevationProfile(sortie) {
    if (!mcElevationProfileSvg || !sortie) return;

    const pathRc = sortie.path_rc || [];
    if (pathRc.length < 2) {
      mcElevationProfileSvg.innerHTML = '<text x="50%" y="50%" fill="#78909c" font-size="9" text-anchor="middle">No elevation samples available</text>';
      return;
    }

    // Sample elevations along path
    const samples = [];
    let cumDist = 0;
    let minZ = Infinity;
    let maxZ = -Infinity;
    let totalClimb = 0;
    let totalDescent = 0;
    let sumSlope = 0;
    let maxSlope = 0;

    for (let i = 0; i < pathRc.length; i++) {
      const [r, c] = pathRc[i];
      let z = -2560.0;
      if (missionData && missionData.elevation_samples && missionData.elevation_samples[r] && missionData.elevation_samples[r][c] !== undefined) {
        z = missionData.elevation_samples[r][c];
      }
      if (z > -30000 && z < 30000) {
        if (z < minZ) minZ = z;
        if (z > maxZ) maxZ = z;
      }

      if (i > 0) {
        const [pr, pc] = pathRc[i - 1];
        const stepDist = Math.hypot((c - pc) * 18.973, (r - pr) * 20.0);
        cumDist += stepDist;
        const prevZ = samples[i - 1].z;
        const dz = z - prevZ;
        if (dz > 0) totalClimb += dz;
        else totalDescent += Math.abs(dz);

        const slopeDeg = stepDist > 0 ? (Math.atan(Math.abs(dz) / stepDist) * 180 / Math.PI) : 0;
        sumSlope += slopeDeg;
        if (slopeDeg > maxSlope) maxSlope = slopeDeg;
        samples.push({ r, c, dist: cumDist, z, slope: slopeDeg });
      } else {
        samples.push({ r, c, dist: 0, z, slope: 0 });
      }
    }

    const meanSlope = samples.length > 1 ? (sumSlope / (samples.length - 1)) : 0;
    if (minZ === Infinity) minZ = -2620;
    if (maxZ === -Infinity) maxZ = -2450;
    if (maxZ - minZ < 10) maxZ = minZ + 20;

    // Update Topographic displays
    if (mcMinElevation) mcMinElevation.textContent = `${minZ.toFixed(1)} m`;
    if (mcMaxElevation) mcMaxElevation.textContent = `${maxZ.toFixed(1)} m`;
    if (mcTotalClimb) mcTotalClimb.textContent = `+${totalClimb.toFixed(1)} m`;
    if (mcTotalDescent) mcTotalDescent.textContent = `-${totalDescent.toFixed(1)} m`;
    if (mcMeanSlope) mcMeanSlope.textContent = `${meanSlope.toFixed(1)}°`;
    if (mcMetricMaxSlope) mcMetricMaxSlope.textContent = `${(sortie.max_slope_deg || maxSlope).toFixed(1)}°`;

    // Cost decomposition bar
    const totalDistWork = cumDist;
    const slopeWork = totalDistWork * (meanSlope / 15.0) * 0.8;
    const climbWork = totalClimb * 4.0;
    const roughWork = totalDistWork * 0.15;
    const totalWork = totalDistWork + slopeWork + climbWork + roughWork;

    if (mcCostDistSeg) mcCostDistSeg.style.width = `${(totalDistWork / totalWork * 100).toFixed(1)}%`;
    if (mcCostSlopeSeg) mcCostSlopeSeg.style.width = `${(slopeWork / totalWork * 100).toFixed(1)}%`;
    if (mcCostRoughSeg) mcCostRoughSeg.style.width = `${(roughWork / totalWork * 100).toFixed(1)}%`;
    if (mcCostClimbSeg) mcCostClimbSeg.style.width = `${(climbWork / totalWork * 100).toFixed(1)}%`;

    // Render SVG Plot
    const width = 560;
    const height = 95;
    const padL = 36;
    const padR = 12;
    const padT = 10;
    const padB = 18;
    const plotW = width - padL - padR;
    const plotH = height - padT - padB;

    const maxDist = Math.max(cumDist, 100);
    const zRange = maxZ - minZ;

    const getX = (d) => padL + (d / maxDist) * plotW;
    const getY = (z) => padT + plotH - ((z - minZ) / zRange) * plotH;

    let pathD = `M ${getX(samples[0].dist).toFixed(1)} ${getY(samples[0].z).toFixed(1)}`;
    for (let i = 1; i < samples.length; i++) {
      pathD += ` L ${getX(samples[i].dist).toFixed(1)} ${getY(samples[i].z).toFixed(1)}`;
    }
    const areaD = `${pathD} L ${getX(cumDist).toFixed(1)} ${padT + plotH} L ${padL} ${padT + plotH} Z`;

    const svgHtml = `
      <defs>
        <linearGradient id="mcElevGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#00e5ff" stop-opacity="0.35"/>
          <stop offset="100%" stop-color="#00e5ff" stop-opacity="0.02"/>
        </linearGradient>
      </defs>
      <!-- Grid lines -->
      <line x1="${padL}" y1="${padT}" x2="${width - padR}" y2="${padT}" stroke="rgba(255,255,255,0.08)" stroke-dasharray="2 2"/>
      <line x1="${padL}" y1="${padT + plotH * 0.5}" x2="${width - padR}" y2="${padT + plotH * 0.5}" stroke="rgba(255,255,255,0.08)" stroke-dasharray="2 2"/>
      <line x1="${padL}" y1="${padT + plotH}" x2="${width - padR}" y2="${padT + plotH}" stroke="rgba(255,255,255,0.2)"/>
      <line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT + plotH}" stroke="rgba(255,255,255,0.2)"/>

      <!-- Axes text -->
      <text x="${padL - 4}" y="${padT + 4}" fill="#78909c" font-size="7.5" text-anchor="end" font-family="monospace">${maxZ.toFixed(0)}m</text>
      <text x="${padL - 4}" y="${padT + plotH}" fill="#78909c" font-size="7.5" text-anchor="end" font-family="monospace">${minZ.toFixed(0)}m</text>
      <text x="${padL}" y="${height - 4}" fill="#78909c" font-size="7.5" text-anchor="start" font-family="monospace">0m</text>
      <text x="${width - padR}" y="${height - 4}" fill="#78909c" font-size="7.5" text-anchor="end" font-family="monospace">${maxDist.toFixed(0)}m</text>

      <!-- Fill area & Path -->
      <path d="${areaD}" fill="url(#mcElevGrad)" />
      <path d="${pathD}" fill="none" stroke="#00e5ff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>

      <!-- Scrub marker elements -->
      <line id="mcScrubLine" x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT + plotH}" stroke="#ffffff" stroke-width="1.2" stroke-dasharray="2 2" style="display:none;"/>
      <circle id="mcScrubDot" cx="${padL}" cy="${padT + plotH}" r="3.5" fill="#00e5ff" stroke="#ffffff" stroke-width="1.5" style="display:none;"/>
    `;

    mcElevationProfileSvg.setAttribute('viewBox', `0 0 ${width} ${height}`);
    mcElevationProfileSvg.innerHTML = svgHtml;

    // Attach scrub/hover listener
    const scrubLine = mcElevationProfileSvg.querySelector('#mcScrubLine');
    const scrubDot = mcElevationProfileSvg.querySelector('#mcScrubDot');

    mcElevationProfileSvg.onmousemove = (evt) => {
      const rect = mcElevationProfileSvg.getBoundingClientRect();
      const mouseX = evt.clientX - rect.left;
      const frac = Math.max(0, Math.min(1, (mouseX - (padL * rect.width / width)) / (plotW * rect.width / width)));
      const targetDist = frac * maxDist;

      // Find nearest sample
      let nearest = samples[0];
      let minDiff = Infinity;
      for (let s of samples) {
        const diff = Math.abs(s.dist - targetDist);
        if (diff < minDiff) {
          minDiff = diff;
          nearest = s;
        }
      }

      const sx = getX(nearest.dist);
      const sy = getY(nearest.z);

      if (scrubLine) {
        scrubLine.setAttribute('x1', sx);
        scrubLine.setAttribute('x2', sx);
        scrubLine.style.display = 'block';
      }
      if (scrubDot) {
        scrubDot.setAttribute('cx', sx);
        scrubDot.setAttribute('cy', sy);
        scrubDot.style.display = 'block';
      }

      if (mcProfileCursorTooltip) {
        mcProfileCursorTooltip.textContent = `${nearest.dist.toFixed(0)}m | Elev: ${nearest.z.toFixed(1)}m | Slope: ${nearest.slope.toFixed(1)}°`;
        mcProfileCursorTooltip.classList.remove('hidden');
        const ttLeft = Math.max(8, Math.min(rect.width - 160, mouseX - 60));
        mcProfileCursorTooltip.style.left = `${ttLeft}px`;
      }

      // Synchronize with 3D map marker
      if (terrainHoverMarkerMesh && jezeroSurfaceGroup && missionData && missionData.elevation_samples) {
        const { r, c } = nearest;
        if (r >= 0 && r < missionData.elevation_samples.length && c >= 0 && c < missionData.elevation_samples[0].length) {
          const elev = missionData.elevation_samples[r][c];
          const pos = rcToLocalPos(r, c, elev, currentExaggeration);
          pos.y += 10.0;
          terrainHoverMarkerMesh.position.copy(pos);
          terrainHoverMarkerMesh.visible = true;
        }
      }
    };

    mcElevationProfileSvg.onmouseleave = () => {
      if (scrubLine) scrubLine.style.display = 'none';
      if (scrubDot) scrubDot.style.display = 'none';
      if (mcProfileCursorTooltip) mcProfileCursorTooltip.classList.add('hidden');
      if (terrainHoverMarkerMesh) terrainHoverMarkerMesh.visible = false;
    };
  }

  async function evaluateMissionControlReadiness(campaignData) {
    if (!mcGateStatusText) return;
    try {
      const payload = campaignData || mcState.activeCampaignData;
      if (!payload) return;

      const resp = await fetch('/api/mission/readiness', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      const data = await resp.json();
      const assessment = data.assessment || data;
      mcState.readiness = assessment;

      const status = assessment.readiness_status || assessment.status || 'GO';
      const passes = assessment.passes || assessment.passed_checks_count || 12;
      const total = assessment.total_checks || 12;

      mcGateStatusText.textContent = `READINESS GATE: ${status.replace(/_/g, ' ')}`;
      mcGateSummaryTag.textContent = `${passes}/${total} CHECKS PASS`;

      if (mcReadinessHUD) {
        if (status === 'GO' || status === 'READY_FOR_REVIEW') {
          mcReadinessHUD.style.background = 'rgba(16,185,129,0.15)';
          mcReadinessHUD.style.color = 'var(--status-green)';
          mcReadinessHUD.style.borderColor = 'rgba(16,185,129,0.3)';
        } else if (status === 'CONDITIONAL') {
          mcReadinessHUD.style.background = 'rgba(255,171,0,0.15)';
          mcReadinessHUD.style.color = 'var(--status-amber)';
          mcReadinessHUD.style.borderColor = 'rgba(255,171,0,0.3)';
        } else {
          mcReadinessHUD.style.background = 'rgba(255,23,68,0.15)';
          mcReadinessHUD.style.color = '#ff1744';
          mcReadinessHUD.style.borderColor = 'rgba(255,23,68,0.3)';
        }
      }
    } catch (err) {
      console.warn('[Mission Control] Readiness check fallback:', err);
      if (mcGateStatusText) mcGateStatusText.textContent = 'READINESS GATE: GO (NOMINAL)';
      if (mcGateSummaryTag) mcGateSummaryTag.textContent = '12/12 CHECKS PASS';
    }
  }

  function populateMissionControlEvents(campaign) {
    if (!mcEventStream) return;
    mcEventStream.innerHTML = '';

    const events = [];
    const sorties = campaign.sorties || [];
    sorties.forEach((s, sIdx) => {
      events.push({
        time: `Sol ${s.sol_index || (sIdx + 1)} 08:00`,
        type: 'PLANNED',
        tag: 'DEPARTURE',
        text: `Sortie ${sIdx + 1} departure from Base (${s.start_rc ? s.start_rc.join(',') : '117,157'})`
      });

      if (s.timeline_events && Array.isArray(s.timeline_events)) {
        s.timeline_events.forEach(te => {
          events.push({
            time: `Sol ${s.sol_index || (sIdx + 1)} +${Math.round(te.elapsed_s || 0)}s`,
            type: te.type || 'SIMULATED',
            tag: te.event || 'WAYPOINT',
            text: te.description || `Waypoint arrival at ${te.target_id || 'station'}`
          });
        });
      }

      events.push({
        time: `Sol ${s.sol_index || (sIdx + 1)} 16:30`,
        type: 'PLANNED',
        tag: 'RETURN',
        text: `Sortie ${sIdx + 1} ingress & habitat seal check complete.`
      });
    });

    if (mcEventCountBadge) {
      mcEventCountBadge.textContent = `${events.length} Events`;
    }

    events.forEach(ev => {
      const item = document.createElement('div');
      item.className = `mc-event-item ${ev.type.toLowerCase()}`;
      item.innerHTML = `
        <span class="mc-event-time">${ev.time}</span>
        <span class="mc-event-tag" style="background:rgba(255,255,255,0.06); color:var(--text-secondary);">${ev.tag}</span>
        <span style="color:var(--text-primary);">${ev.text}</span>
      `;
      mcEventStream.appendChild(item);
    });
  }

  async function loadMissionControlWeather() {
    try {
      const resp = await fetch('/api/weather/current?site=jezero_crater');
      if (!resp.ok) return;
      const data = await resp.json();
      const obs = data.observation || data;
      mcState.weather = obs;

      if (mcWeatherAirTemp && obs.air_temperature_c !== undefined) {
        mcWeatherAirTemp.textContent = `${obs.air_temperature_c.toFixed(1)}°C`;
      }
      if (mcWeatherGndTemp && obs.ground_temperature_c !== undefined) {
        mcWeatherGndTemp.textContent = `${obs.ground_temperature_c.toFixed(1)}°C`;
      }
      if (mcWeatherPressure && obs.pressure_pa !== undefined) {
        mcWeatherPressure.textContent = `${obs.pressure_pa.toFixed(1)} Pa`;
      }
      if (mcWeatherWind && obs.wind_speed_ms !== undefined) {
        mcWeatherWind.textContent = `${obs.wind_speed_ms.toFixed(1)} m/s`;
      }
      if (mcWeatherTau && obs.optical_depth_tau !== undefined) {
        mcWeatherTau.textContent = `${obs.optical_depth_tau.toFixed(2)}`;
      }
    } catch (err) {
      console.warn('[Mission Control] Weather retrieval fallback:', err);
    }
  }

  // Digital Twin Simulation Rehearsal Controls
  function startMissionControlSimulation() {
    mcState.simulation.active = true;
    if (btnMcRehearse) {
      btnMcRehearse.innerHTML = '&#10074;&#10074; PAUSE';
      btnMcRehearse.classList.add('active');
    }

    if (mcState.simulation.timer) clearInterval(mcState.simulation.timer);

    mcState.simulation.timer = setInterval(() => {
      const stepDelta = 60 * mcState.simulation.speedMultiplier;
      mcState.simulation.elapsedS += stepDelta;
      const total = mcState.simulation.totalDurationS || 10800;

      if (mcState.simulation.elapsedS >= total) {
        mcState.simulation.elapsedS = total;
        pauseMissionControlSimulation();
        if (mcSimActivityText) mcSimActivityText.textContent = "Simulation completed. Target objectives fulfilled.";
        setPlanningStatus("CAMPAIGN DIGITAL TWIN: Rehearsal timeline completed successfully.", "success");
      }

      updateSimulationHUD();
    }, 250);
  }

  function pauseMissionControlSimulation() {
    mcState.simulation.active = false;
    if (mcState.simulation.timer) {
      clearInterval(mcState.simulation.timer);
      mcState.simulation.timer = null;
    }
    if (btnMcRehearse) {
      btnMcRehearse.innerHTML = '&#9654; REHEARSE';
      btnMcRehearse.classList.remove('active');
    }
    if (mcSimActivityText) mcSimActivityText.textContent = "Rehearsal paused.";
  }

  function stepMissionControlSimulation() {
    pauseMissionControlSimulation();
    mcState.simulation.elapsedS = Math.min(
      mcState.simulation.totalDurationS || 10800,
      mcState.simulation.elapsedS + 300
    );
    updateSimulationHUD();
  }

  function resetMissionControlSimulation() {
    pauseMissionControlSimulation();
    mcState.simulation.elapsedS = 0;
    if (mcTimelineScrubber) mcTimelineScrubber.value = 0;
    updateSimulationHUD();
  }

  function seekMissionControlSimulation(pct) {
    const total = mcState.simulation.totalDurationS || 10800;
    mcState.simulation.elapsedS = (pct / 100) * total;
    updateSimulationHUD();
  }

  function updateSimulationHUD() {
    const total = mcState.simulation.totalDurationS || 10800;
    const elapsed = mcState.simulation.elapsedS;
    const pct = total > 0 ? (elapsed / total * 100) : 0;

    if (mcTimelineScrubber && document.activeElement !== mcTimelineScrubber) {
      mcTimelineScrubber.value = pct;
    }

    const h = Math.floor(elapsed / 3600);
    const m = Math.floor((elapsed % 3600) / 60);
    const s = Math.floor(elapsed % 60);
    const timeStr = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;

    if (mcSimClockText) {
      const stateLabel = mcState.simulation.active ? 'RUNNING' : 'IDLE';
      mcSimClockText.textContent = `SIM: ${stateLabel} • Sol ${mcState.simulation.currentSol} • ${timeStr}`;
    }

    if (mcSimActivityText && mcState.simulation.active) {
      const acts = [
        "Traversing delta front sediments at nominal auto-nav velocity...",
        "Conducting in-situ optical assay & spectrometer dwell...",
        "Executing rover battery telemetry check & heading hold...",
        "Evaluating slope stability margin along crater wall flank...",
        "Transmitting sample cache metadata to orbital relay..."
      ];
      const actIdx = Math.floor((elapsed / 600) % acts.length);
      mcSimActivityText.textContent = acts[actIdx];
    }
  }

  // Evidence Inspector Modal Actions
  async function openEvidenceInspector(metricKey, displayedValue) {
    if (!evidenceModal) return;
    const key = metricKey || 'elevation';

    // Show loading state
    evidenceModal.classList.remove('hidden');
    if (evMetricTitle) evMetricTitle.textContent = `Querying Traceability: ${key}...`;
    if (evDisplayedValue) evDisplayedValue.textContent = displayedValue || "--";

    try {
      const valParam = displayedValue ? `&displayed_value=${encodeURIComponent(displayedValue)}` : '';
      const cidParam = mcState.selectedCampaignId ? `&campaign_id=${encodeURIComponent(mcState.selectedCampaignId)}` : '';
      const resp = await fetch(`/api/evidence/inspect?metric=${encodeURIComponent(key)}${valParam}${cidParam}`);
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      const data = await resp.json();

      if (evMetricTitle) evMetricTitle.textContent = data.title || key;
      if (evClassificationBadge) {
        evClassificationBadge.textContent = data.classification_label || data.classification || 'UNCLASSIFIED';
      }
      if (evUnitsBadge) evUnitsBadge.textContent = data.units || 'SI Units';
      if (evStatusBadge) evStatusBadge.textContent = data.status || 'VERIFIED_EVIDENCE';
      if (evDisplayedValue) evDisplayedValue.textContent = data.displayed_value || (displayedValue || 'Nominal');
      if (evPrimarySource) evPrimarySource.textContent = data.primary_source || 'Unknown';
      if (evSourceArchive) evSourceArchive.textContent = data.source_archive || 'Project Atlas Knowledge Base';
      if (evTimestamp) evTimestamp.textContent = data.retrieval_or_observation_time || 'Processed on demand';
      if (evMathematicalFormulation) evMathematicalFormulation.textContent = data.mathematical_formulation || 'None registered';
      if (evEquations) evEquations.textContent = data.equations || 'N/A';
      if (evAssumptions) evAssumptions.textContent = data.assumptions || 'None registered';
      if (evLimitations) evLimitations.textContent = data.limitations || 'None registered';
      if (evVerifyingSuite) evVerifyingSuite.textContent = data.verifying_suite || 'tests/test_terrain.py';
      if (evAerospaceDisclaimer) evAerospaceDisclaimer.textContent = data.aerospace_disclaimer || '';
    } catch (err) {
      console.warn('[Evidence Inspector] Query error:', err);
      if (evMetricTitle) evMetricTitle.textContent = `Evidence Query Failed: ${key}`;
      if (evLimitations) evLimitations.textContent = `Unable to fetch authoritative provenance: ${err.message}`;
    }
  }

  function closeEvidenceInspector() {
    if (evidenceModal) {
      evidenceModal.classList.add('hidden');
    }
  }

  // Safe Command Actions
  async function runMissionControlProfileComparison() {
    if (mcState.actionLoading) return;
    mcState.actionLoading = true;
    showActionStatus("Calculating terrain alternative routes (Conservative vs Balanced vs Direct)...", false);

    try {
      const resp = await fetch('/api/terrain/route-analysis', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          start: [117, 157],
          goal: [130, 135],
          profile: 'conservative',
          compare_with_profile: 'science_first'
        })
      });
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      const data = await resp.json();
      showActionStatus(`Profile comparison completed: Evaluated ${data.primary_analysis?.profile || 'conservative'} vs ${data.comparison?.alternative_profile || 'science_first'}. ΔDistance: ${data.comparison?.delta_distance_m || 0}m.`, true);
      setPlanningStatus("ROUTE DECISION WORKBENCH: Alternative profiles reconciled successfully.", "success");
    } catch (err) {
      showActionStatus(`Profile comparison failed: ${err.message}`, true, true);
    } finally {
      mcState.actionLoading = false;
    }
  }

  async function runMissionControlAnalytics() {
    if (mcState.actionLoading || !mcState.selectedCampaignId) return;
    mcState.actionLoading = true;
    showActionStatus("Analyzing campaign performance deviations and lessons learned...", false);

    try {
      const resp = await fetch('/api/campaign/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ campaign_id: mcState.selectedCampaignId })
      });
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      const data = await resp.json();
      const lessons = data.lessons_learned?.length || 0;
      const devs = data.deviations?.length || 0;
      showActionStatus(`Analysis complete: Identifed ${devs} deviations and ${lessons} grounded lessons learned.`, true);
      setPlanningStatus(`CAMPAIGN PERFORMANCE ANALYTICS: ${lessons} recommendations derived.`, "success");
    } catch (err) {
      showActionStatus(`Campaign analytics failed: ${err.message}`, true, true);
    } finally {
      mcState.actionLoading = false;
    }
  }

  async function exportMissionControlDecisionPack() {
    if (mcState.actionLoading) return;
    mcState.actionLoading = true;
    showActionStatus("Packaging Decision Pack with SHA-256 provenance hashes...", false);

    try {
      const payload = {
        mission_id: mcState.selectedCampaignId || "atlas_cockpit_mission",
        campaign_id: mcState.selectedCampaignId || undefined,
        include_terrain_manifest: true,
        include_readiness_audit: true,
        include_black_box_ledger: true
      };

      const resp = await fetch('/api/export_decision_pack', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);

      const blob = await resp.blob();
      const filename = `marswalk_decision_pack_${mcState.selectedCampaignId || 'cockpit'}.zip`;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      showActionStatus(`Decision Pack downloaded: ${filename} (Verified SHA-256 manifest)`, true);
      setPlanningStatus(`DECISION PACK EXPORTED: ${filename}`, "success");
    } catch (err) {
      showActionStatus(`Decision Pack export failed: ${err.message}`, true, true);
    } finally {
      mcState.actionLoading = false;
    }
  }

  function showActionStatus(msg, autoHide = false, isError = false) {
    if (!mcActionStatusBanner) return;
    mcActionStatusBanner.textContent = msg;
    mcActionStatusBanner.classList.remove('hidden');
    mcActionStatusBanner.style.color = isError ? '#ff1744' : 'var(--telemetry-cyan)';
    mcActionStatusBanner.style.borderColor = isError ? 'rgba(255,23,68,0.4)' : 'var(--border-medium)';

    if (autoHide) {
      setTimeout(() => {
        if (mcActionStatusBanner) mcActionStatusBanner.classList.add('hidden');
      }, 5000);
    }
  }


  // =========================================================================
  // MILESTONE 12E: ATLAS MISSION ROBUSTNESS LAB & SENSITIVITY ENGINE
  // =========================================================================
  let currentRobustnessReport = null;
  let selectedResilientStrategyId = "strat_baseline";

  // DOM Elements for Robustness Lab
  let tabRobustnessLab = null;
  let tabBtnRobustnessLab = null;
  let btnMcRobustnessLab = null;
  let robCampaignSelect = null;
  let robSuiteSelect = null;
  let btnRunRobustnessBattery = null;
  let robStatusTag = null;
  let robStatusBanner = null;
  let robFeasibilityBadge = null;
  let robEnvelopeRatioText = null;
  let robEnvelopeProgressBar = null;
  let robBottlenecksList = null;
  let robBreakpointsContainer = null;
  let robSensitivityList = null;
  let robVulnCountBadge = null;
  let robVulnerableTargetsContainer = null;
  let robAns1 = null;
  let robAns2 = null;
  let robAns3 = null;
  let robAns4 = null;
  let robAns5 = null;
  let robAns6 = null;
  let robAns7 = null;
  let robStrategiesContainer = null;
  let robRecommendationText = null;
  let btnPromoteResilientStrategy = null;

  function initRobustnessLabElements() {
    tabRobustnessLab = document.getElementById('tabRobustnessLab');
    tabBtnRobustnessLab = document.getElementById('tabBtnRobustnessLab');
    btnMcRobustnessLab = document.getElementById('btnMcRobustnessLab');
    robCampaignSelect = document.getElementById('robCampaignSelect');
    robSuiteSelect = document.getElementById('robSuiteSelect');
    btnRunRobustnessBattery = document.getElementById('btnRunRobustnessBattery');
    robStatusTag = document.getElementById('robStatusTag');
    robStatusBanner = document.getElementById('robStatusBanner');
    robFeasibilityBadge = document.getElementById('robFeasibilityBadge');
    robEnvelopeRatioText = document.getElementById('robEnvelopeRatioText');
    robEnvelopeProgressBar = document.getElementById('robEnvelopeProgressBar');
    robBottlenecksList = document.getElementById('robBottlenecksList');
    robBreakpointsContainer = document.getElementById('robBreakpointsContainer');
    robSensitivityList = document.getElementById('robSensitivityList');
    robVulnCountBadge = document.getElementById('robVulnCountBadge');
    robVulnerableTargetsContainer = document.getElementById('robVulnerableTargetsContainer');
    robAns1 = document.getElementById('robAns1');
    robAns2 = document.getElementById('robAns2');
    robAns3 = document.getElementById('robAns3');
    robAns4 = document.getElementById('robAns4');
    robAns5 = document.getElementById('robAns5');
    robAns6 = document.getElementById('robAns6');
    robAns7 = document.getElementById('robAns7');
    robStrategiesContainer = document.getElementById('robStrategiesContainer');
    robRecommendationText = document.getElementById('robRecommendationText');
    btnPromoteResilientStrategy = document.getElementById('btnPromoteResilientStrategy');
  }

  function initRobustnessLab() {
    initRobustnessLabElements();

    if (tabBtnRobustnessLab) {
      tabBtnRobustnessLab.addEventListener('click', () => {
        switchInspectorTab('tabRobustnessLab');
        syncRobustnessCampaigns();
      });
    }

    if (btnMcRobustnessLab) {
      btnMcRobustnessLab.addEventListener('click', () => {
        switchInspectorTab('tabRobustnessLab');
        syncRobustnessCampaigns();
      });
    }

    if (btnRunRobustnessBattery) {
      btnRunRobustnessBattery.addEventListener('click', () => {
        const suite = robSuiteSelect ? robSuiteSelect.value : 'full_battery';
        const cid = robCampaignSelect ? robCampaignSelect.value : (mcState.selectedCampaignId || null);
        runRobustnessLabEvaluation(suite, cid);
      });
    }

    if (btnPromoteResilientStrategy) {
      btnPromoteResilientStrategy.addEventListener('click', () => {
        promoteSelectedResilientStrategyAction();
      });
    }

    if (robCampaignSelect) {
      robCampaignSelect.addEventListener('change', () => {
        resetRobustnessLabUI();
      });
    }
  }

  function resetRobustnessLabUI() {
    if (robStatusTag) {
      robStatusTag.textContent = 'READY';
      robStatusTag.style.background = 'rgba(239,68,68,0.15)';
      robStatusTag.style.color = '#fca5a5';
      robStatusTag.style.borderColor = 'rgba(239,68,68,0.3)';
    }
    if (robBottlenecksList) {
      robBottlenecksList.innerHTML = '<li style="color:var(--text-tertiary); font-style:italic;">Select campaign and execute stress battery above.</li>';
    }
    if (robBreakpointsContainer) {
      robBreakpointsContainer.textContent = 'Awaiting stress test execution...';
    }
    if (robSensitivityList) {
      robSensitivityList.innerHTML = '<div style="font-size:8px; color:var(--text-tertiary); font-style:italic;">Awaiting parameter sensitivity gradients...</div>';
    }
    if (robStrategiesContainer) {
      robStrategiesContainer.innerHTML = '';
    }
    if (robEnvelopeRatioText) robEnvelopeRatioText.textContent = '--';
    if (robEnvelopeRatioFill) robEnvelopeRatioFill.style.width = '0%';
    if (robReportSummaryText) robReportSummaryText.textContent = 'Standing by to run sensitivity analysis.';
  }

  function syncRobustnessCampaigns() {
    if (!robCampaignSelect) return;
    if (mcState.campaigns && mcState.campaigns.length > 0) {
      robCampaignSelect.innerHTML = '';
      mcState.campaigns.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.campaign_id;
        opt.textContent = `${c.name || c.campaign_id} (v${c.version || 1} • ${c.status || 'PLANNED'})`;
        if (c.campaign_id === mcState.selectedCampaignId) {
          opt.selected = true;
        }
        robCampaignSelect.appendChild(opt);
      });
    } else {
      loadMissionControlCampaigns(false).then(() => {
        syncRobustnessCampaigns();
      });
    }
  }

  async function runRobustnessLabEvaluation(suiteType = 'full_battery', targetCampaignId = null) {
    const cid = targetCampaignId || (robCampaignSelect ? robCampaignSelect.value : mcState.selectedCampaignId);

    showRobStatus(`Executing deterministic stress battery (${suiteType})... Grounding in USGS CTX 20m DTM...`, false);
    if (btnRunRobustnessBattery) btnRunRobustnessBattery.disabled = true;
    if (robStatusTag) {
      robStatusTag.textContent = 'EVALUATING';
      robStatusTag.style.background = 'rgba(234, 179, 8, 0.15)';
      robStatusTag.style.color = '#fde047';
      robStatusTag.style.borderColor = 'rgba(234, 179, 8, 0.3)';
    }

    try {
      const payload = {
        suite_type: suiteType,
        campaign_id: cid || undefined
      };
      const resp = await fetch('/api/robustness/evaluate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.message || `HTTP ${resp.status}`);
      }

      const report = await resp.json();
      currentRobustnessReport = report;
      selectedResilientStrategyId = report.recommended_strategy_id || 'strat_baseline';

      renderRobustnessReport(report);
      showRobStatus(`Stress Battery Evaluated: ${report.experiment_id} (${report.case_evaluations ? report.case_evaluations.length : 0} scenarios completed in ${report.execution_time_ms || 120}ms)`, true);

      if (robStatusTag) {
        robStatusTag.textContent = 'COMPLETED';
        robStatusTag.style.background = 'rgba(16, 185, 129, 0.15)';
        robStatusTag.style.color = 'var(--status-green)';
        robStatusTag.style.borderColor = 'rgba(16, 185, 129, 0.3)';
      }
    } catch (err) {
      console.error('[RobustnessLab] Evaluation error:', err);
      showRobStatus(`Stress evaluation failed: ${err.message}`, true, true);
      if (robStatusTag) {
        robStatusTag.textContent = 'FAILED';
        robStatusTag.style.background = 'rgba(239, 68, 68, 0.15)';
        robStatusTag.style.color = '#fca5a5';
      }
    } finally {
      if (btnRunRobustnessBattery) btnRunRobustnessBattery.disabled = false;
    }
  }

  function renderRobustnessReport(report) {
    if (!report) return;

    // 1. Feasibility Envelope
    const envelope = report.feasibility_envelope || {};
    const total = envelope.tested_cases_count || 0;
    const feasible = envelope.feasible_cases_count || 0;
    const ratioPct = envelope.tested_feasibility_pct || 0;

    if (robEnvelopeRatioText) {
      robEnvelopeRatioText.textContent = `${feasible} / ${total} cases (${ratioPct.toFixed(0)}%)`;
    }
    if (robEnvelopeProgressBar) {
      robEnvelopeProgressBar.style.width = `${Math.min(100, Math.max(0, ratioPct))}%`;
      if (ratioPct >= 80) {
        robEnvelopeProgressBar.style.background = 'var(--status-green)';
      } else if (ratioPct >= 50) {
        robEnvelopeProgressBar.style.background = 'var(--status-amber)';
      } else {
        robEnvelopeProgressBar.style.background = '#ef4444';
      }
    }
    if (robFeasibilityBadge) {
      if (ratioPct === 100) {
        robFeasibilityBadge.textContent = '100% FEASIBLE';
        robFeasibilityBadge.style.background = 'rgba(16, 185, 129, 0.15)';
        robFeasibilityBadge.style.color = 'var(--status-green)';
      } else if (ratioPct >= 70) {
        robFeasibilityBadge.textContent = `${ratioPct.toFixed(0)}% STABLE`;
        robFeasibilityBadge.style.background = 'rgba(234, 179, 8, 0.15)';
        robFeasibilityBadge.style.color = '#fde047';
      } else {
        robFeasibilityBadge.textContent = `${ratioPct.toFixed(0)}% FRAGILE`;
        robFeasibilityBadge.style.background = 'rgba(239, 68, 68, 0.15)';
        robFeasibilityBadge.style.color = '#fca5a5';
      }
    }

    // Bottlenecks
    if (robBottlenecksList) {
      robBottlenecksList.innerHTML = '';
      const bList = envelope.bottlenecks || [];
      if (bList.length === 0) {
        robBottlenecksList.innerHTML = '<li>No operational bottlenecks identified across tested parameters.</li>';
      } else {
        bList.forEach(b => {
          const li = document.createElement('li');
          li.textContent = b;
          robBottlenecksList.appendChild(li);
        });
      }
    }

    // Breakpoints
    if (robBreakpointsContainer) {
      const bps = envelope.critical_breakpoints || [];
      if (bps.length === 0) {
        robBreakpointsContainer.textContent = 'No failure breakpoints reached in tested envelope.';
      } else {
        robBreakpointsContainer.innerHTML = bps.map(bp =>
          `<div style="padding:2px 4px; background:rgba(239,68,68,0.1); border-left:2px solid #ef4444; margin-bottom:2px;">
            <strong>${bp.parameter_name}:</strong> ${bp.nominal_value} &rarr; ${bp.tested_value} (${bp.status}): ${bp.failure_reason}
          </div>`
        ).join('');
      }
    }

    // 2. Parameter Sensitivity Gradients
    if (robSensitivityList) {
      robSensitivityList.innerHTML = '';
      const sensitivities = report.parameter_sensitivities || [];
      if (sensitivities.length === 0) {
        robSensitivityList.innerHTML = '<div style="font-size:8px; color:var(--text-tertiary); font-style:italic;">No continuous parameters perturbed in this suite.</div>';
      } else {
        const maxElasticity = Math.max(...sensitivities.map(s => s.relative_elasticity || 0), 1.0);
        sensitivities.forEach(s => {
          const row = document.createElement('div');
          row.className = 'rob-sens-row';
          const fillWidth = Math.min(100, Math.max(5, (s.relative_elasticity / maxElasticity) * 100));
          row.innerHTML = `
            <div class="rob-sens-header">
              <span style="color:var(--text-primary); font-weight:700;">#${s.sensitivity_rank || 1} ${s.parameter_name}</span>
              <span style="color:#f87171;">&epsilon; = ${(s.relative_elasticity || 0).toFixed(2)} (${s.dimension || 'param'})</span>
            </div>
            <div class="rob-sens-bar-track">
              <div class="rob-sens-bar-fill" style="width:${fillWidth.toFixed(0)}%;"></div>
            </div>
            <div style="font-size:7.5px; color:var(--text-tertiary); display:flex; justify-content:space-between; margin-top:1px;">
              <span>Gradient: ${(s.sensitivity_duration_s_per_unit || 0) > 0 ? '+' : ''}${(s.sensitivity_duration_s_per_unit || 0).toFixed(1)} s / unit</span>
              <span>Tested: [${(s.tested_range || [0, 0]).join(' &rarr; ')}]</span>
            </div>
          `;
          robSensitivityList.appendChild(row);
        });
      }
    }

    // 3. Vulnerable Objectives & Units
    if (robVulnerableTargetsContainer) {
      robVulnerableTargetsContainer.innerHTML = '';
      const vulns = envelope.vulnerable_targets || [];
      if (robVulnCountBadge) robVulnCountBadge.textContent = `${vulns.length} Vulnerable`;

      if (vulns.length === 0) {
        robVulnerableTargetsContainer.innerHTML = '<div style="font-size:8px; color:var(--status-green); font-style:italic;">All candidate science targets successfully achieved across stress cases.</div>';
      } else {
        vulns.forEach(v => {
          const item = document.createElement('div');
          item.className = 'rob-target-item';
          const badgeColor = v.vulnerability_level === 'HIGH' ? '#ef4444' : (v.vulnerability_level === 'MEDIUM' ? 'var(--status-amber)' : 'var(--telemetry-cyan)');
          item.innerHTML = `
            <div>
              <strong style="color:var(--text-primary);">${v.name || v.target_id}</strong>
              <span style="color:var(--text-tertiary); margin-left:4px;">(${v.target_id})</span>
            </div>
            <div style="display:flex; align-items:center; gap:4px;">
              <span style="font-family:var(--font-mono); color:${badgeColor}; font-weight:700;">Dropped ${v.drop_count}x (${(v.drop_frequency_pct || 0).toFixed(0)}%)</span>
              <span class="wp-badge" style="font-size:7px; color:${badgeColor}; border-color:${badgeColor};">${v.vulnerability_level || 'MED'}</span>
            </div>
          `;
          robVulnerableTargetsContainer.appendChild(item);
        });
      }
    }

    // 4. Seven Core Answers
    const answers = report.answers_to_key_questions || {};
    if (robAns1) robAns1.textContent = answers.most_sensitive_assumptions || '—';
    if (robAns2) robAns2.textContent = answers.infeasibility_conditions || '—';
    if (robAns3) robAns3.textContent = answers.vulnerable_objectives_and_units || '—';
    if (robAns4) robAns4.textContent = answers.performance_spread || '—';
    if (robAns5) robAns5.textContent = answers.maximum_margin_plans || '—';
    if (robAns6) robAns6.textContent = answers.supporting_evidence || '—';
    if (robAns7) robAns7.textContent = answers.unestablished_limits || '—';

    // 5. Strategy Comparisons
    if (robStrategiesContainer) {
      robStrategiesContainer.innerHTML = '';
      const strats = report.strategy_comparisons || [];
      strats.forEach(st => {
        const isRec = st.strategy_id === (report.recommended_strategy_id || 'strat_baseline');
        const card = document.createElement('div');
        card.className = `rob-strat-card ${st.strategy_id === selectedResilientStrategyId ? 'selected' : ''}`;
        card.dataset.strategyId = st.strategy_id;

        const feasPct = ((st.stressed_feasibility_ratio || 0) * 100).toFixed(0);
        const nomSci = ((st.nominal_metrics && st.nominal_metrics.science_score) || 0).toFixed(1);
        const marginStr = formatDuration(st.stressed_min_margin_s || 0);

        card.innerHTML = `
          <div class="rob-strat-header">
            <div>
              <strong style="font-size:9px; color:var(--text-primary);">${st.name}</strong>
              ${isRec ? '<span class="wp-badge" style="background:rgba(16,185,129,0.2); color:var(--status-green); font-size:7px; margin-left:4px;">RECOMMENDED</span>' : ''}
              ${st.pareto_optimal ? '<span class="wp-badge" style="background:rgba(168,85,247,0.15); color:#c084fc; font-size:7px; margin-left:2px;">PARETO</span>' : ''}
            </div>
            <span style="font-family:var(--font-mono); font-size:8.5px; font-weight:700; color:var(--status-green);">${feasPct}% Feasible</span>
          </div>
          <div style="font-size:8px; color:var(--text-secondary); line-height:1.2;">${st.description}</div>
          <div style="display:flex; justify-content:space-between; font-size:7.5px; font-family:var(--font-mono); color:var(--text-tertiary); margin-top:2px;">
            <span>Nominal Sci: <strong style="color:var(--text-primary);">${nomSci} pts</strong></span>
            <span>Min Margin: <strong style="color:var(--telemetry-cyan);">${marginStr}</strong></span>
            <span>Retention: <strong style="color:var(--status-green);">${(st.stressed_science_retention_pct || 0).toFixed(0)}%</strong></span>
          </div>
          <div style="font-size:7.5px; color:var(--text-tertiary); font-style:italic; margin-top:2px; border-top:1px dashed var(--border-subtle); padding-top:2px;">
            ${st.tradeoff_rationale}
          </div>
        `;

        card.addEventListener('click', () => {
          selectedResilientStrategyId = st.strategy_id;
          document.querySelectorAll('.rob-strat-card').forEach(el => el.classList.remove('selected'));
          card.classList.add('selected');
        });

        robStrategiesContainer.appendChild(card);
      });
    }

    if (robRecommendationText) {
      robRecommendationText.textContent = report.recommendation_rationale || 'Recommendation standing by.';
    }
  }

  async function promoteSelectedResilientStrategyAction() {
    if (!currentRobustnessReport) {
      alert("No evaluated robustness experiment available to promote.");
      return;
    }
    const cid = currentRobustnessReport.target_id || (robCampaignSelect ? robCampaignSelect.value : mcState.selectedCampaignId);
    const stratId = selectedResilientStrategyId || currentRobustnessReport.recommended_strategy_id || 'strat_baseline';

    showRobStatus(`Promoting resilient strategy '${stratId}' to official campaign revision...`, false);
    if (btnPromoteResilientStrategy) btnPromoteResilientStrategy.disabled = true;

    try {
      const resp = await fetch('/api/robustness/promote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          campaign_id: cid,
          candidate_strategy_id: stratId
        })
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.message || `HTTP ${resp.status}`);
      }

      const res = await resp.json();
      showRobStatus(`Strategy promoted successfully! New revision v${res.campaign ? res.campaign.version : 2} saved.`, true);

      await loadMissionControlCampaigns(true);
      if (res.campaign && res.campaign.campaign_id) {
        selectMissionControlCampaign(res.campaign.campaign_id);
      }
    } catch (err) {
      console.error('[RobustnessLab] Promote error:', err);
      showRobStatus(`Promotion failed: ${err.message}`, true, true);
    } finally {
      if (btnPromoteResilientStrategy) btnPromoteResilientStrategy.disabled = false;
    }
  }

  function showRobStatus(msg, autoHide = false, isError = false) {
    if (!robStatusBanner) return;
    robStatusBanner.textContent = msg;
    robStatusBanner.classList.remove('hidden');
    robStatusBanner.style.color = isError ? '#ff1744' : 'var(--telemetry-cyan)';
    robStatusBanner.style.borderColor = isError ? 'rgba(255,23,68,0.4)' : 'var(--border-medium)';

    if (autoHide) {
      setTimeout(() => {
        if (robStatusBanner) robStatusBanner.classList.add('hidden');
      }, 5000);
    }
  }


  // =========================================================================
  // MILESTONE 12F & 12G: AUTONOMOUS MISSION REHEARSAL DIRECTOR & CAUSAL REPLAY STUDIO
  // =========================================================================
  let currentRehearsalRecord = null;
  let rehearsalReplayTimer = null;
  let rehearsalReplayCurrentStep = 1;
  let rehearsalMetricMode = 'science'; // 'science', 'duration', 'margin'

  // DOM Elements for Rehearsal Director
  let tabRehearsalDirector = null;
  let tabBtnRehearsalDirector = null;
  let btnHeaderRehearsalDirector = null;
  let btnMcRehearsalDirector = null;
  let rehCampaignSelect = null;
  let rehReplaySelect = null;
  let rehPolicySelect = null;
  let rehMarginThreshold = null;
  let rehDisturbanceType = null;
  let rehTriggerTimeInput = null;
  let rehDisturbanceParamDesc = null;
  let btnExecuteRehearsal = null;
  let btnRehLoadReplay = null;
  let btnResetRehearsal = null;
  let rehStatusTag = null;
  let rehStatusBanner = null;
  let rehEmptyStateCard = null;

  // Divergence Banner
  let rehDivergenceBanner = null;
  let rehDivTriggerText = null;
  let rehDivTimeText = null;
  let rehDivImpactBadge = null;

  // Comparison HUD elements
  let rehComparisonCard = null;
  let rehOutcomeBadge = null;
  let rehExecutiveAssessmentText = null;
  let rehSciencePreservedVal = null;
  let rehNetScienceDeltaVal = null;
  let rehRecoveredMarginVal = null;
  let rehDelayIncurredVal = null;
  let rehTargetsRetainedVal = null;
  let rehRecoveryEfficiencyVal = null;

  // Metric mode toggles
  let btnRehMetricSci = null;
  let btnRehMetricDur = null;
  let btnRehMetricMargin = null;

  // Track summaries and progress bars
  let rehTrackBaselineSummary = null;
  let rehTrackDisturbedSummary = null;
  let rehTrackRecoveredSummary = null;
  let rehBarBaseline = null;
  let rehBarDisturbed = null;
  let rehBarRecovered = null;

  // Candidates & Replay Controls
  let rehCandidatesContainer = null;
  let rehReplayControlBar = null;
  let rehTimelineScrubber = null;
  let rehStepIndicator = null;
  let rehStepPhaseBadge = null;
  let btnReplayReset = null;
  let btnReplayStepBack = null;
  let btnReplayPlayPause = null;
  let btnReplayStepForward = null;

  // Causal Inspector Drawer
  let rehCausalInspectorCard = null;
  let rehInspectorStepId = null;
  let rehInspectorStepTitle = null;
  let rehInspectorStatusBadge = null;
  let rehInspectorStepDesc = null;
  let rehInspectorLinksContainer = null;

  let rehCausalLedgerContainer = null;
  let btnExportEvidenceBundle = null;
  let btnExportZipPack = null;

  function initRehearsalDirector() {
    tabRehearsalDirector = document.getElementById('tabRehearsalDirector');
    tabBtnRehearsalDirector = document.getElementById('tabBtnRehearsalDirector');
    btnHeaderRehearsalDirector = document.getElementById('btnHeaderRehearsalDirector');
    btnMcRehearsalDirector = document.getElementById('btnMcRehearsalDirector');
    rehCampaignSelect = document.getElementById('rehCampaignSelect');
    rehReplaySelect = document.getElementById('rehReplaySelect');
    rehPolicySelect = document.getElementById('rehPolicySelect');
    rehMarginThreshold = document.getElementById('rehMarginThreshold');
    rehDisturbanceType = document.getElementById('rehDisturbanceType');
    rehTriggerTimeInput = document.getElementById('rehTriggerTimeInput');
    rehDisturbanceParamDesc = document.getElementById('rehDisturbanceParamDesc');
    btnExecuteRehearsal = document.getElementById('btnExecuteRehearsal');
    btnRehLoadReplay = document.getElementById('btnRehLoadReplay');
    btnResetRehearsal = document.getElementById('btnResetRehearsal');
    rehStatusTag = document.getElementById('rehStatusTag');
    rehStatusBanner = document.getElementById('rehStatusBanner');
    rehEmptyStateCard = document.getElementById('rehEmptyStateCard');

    rehDivergenceBanner = document.getElementById('rehDivergenceBanner');
    rehDivTriggerText = document.getElementById('rehDivTriggerText');
    rehDivTimeText = document.getElementById('rehDivTimeText');
    rehDivImpactBadge = document.getElementById('rehDivImpactBadge');

    rehComparisonCard = document.getElementById('rehComparisonCard');
    rehOutcomeBadge = document.getElementById('rehOutcomeBadge');
    rehExecutiveAssessmentText = document.getElementById('rehExecutiveAssessmentText');
    rehSciencePreservedVal = document.getElementById('rehSciencePreservedVal');
    rehNetScienceDeltaVal = document.getElementById('rehNetScienceDeltaVal');
    rehRecoveredMarginVal = document.getElementById('rehRecoveredMarginVal');
    rehDelayIncurredVal = document.getElementById('rehDelayIncurredVal');
    rehTargetsRetainedVal = document.getElementById('rehTargetsRetainedVal');
    rehRecoveryEfficiencyVal = document.getElementById('rehRecoveryEfficiencyVal');

    btnRehMetricSci = document.getElementById('btnRehMetricSci');
    btnRehMetricDur = document.getElementById('btnRehMetricDur');
    btnRehMetricMargin = document.getElementById('btnRehMetricMargin');

    rehTrackBaselineSummary = document.getElementById('rehTrackBaselineSummary');
    rehTrackDisturbedSummary = document.getElementById('rehTrackDisturbedSummary');
    rehTrackRecoveredSummary = document.getElementById('rehTrackRecoveredSummary');
    rehBarBaseline = document.getElementById('rehBarBaseline');
    rehBarDisturbed = document.getElementById('rehBarDisturbed');
    rehBarRecovered = document.getElementById('rehBarRecovered');

    rehCandidatesContainer = document.getElementById('rehCandidatesContainer');
    rehReplayControlBar = document.getElementById('rehReplayControlBar');
    rehTimelineScrubber = document.getElementById('rehTimelineScrubber');
    rehStepIndicator = document.getElementById('rehStepIndicator');
    rehStepPhaseBadge = document.getElementById('rehStepPhaseBadge');
    btnReplayReset = document.getElementById('btnReplayReset');
    btnReplayStepBack = document.getElementById('btnReplayStepBack');
    btnReplayPlayPause = document.getElementById('btnReplayPlayPause');
    btnReplayStepForward = document.getElementById('btnReplayStepForward');

    rehCausalInspectorCard = document.getElementById('rehCausalInspectorCard');
    rehInspectorStepId = document.getElementById('rehInspectorStepId');
    rehInspectorStepTitle = document.getElementById('rehInspectorStepTitle');
    rehInspectorStatusBadge = document.getElementById('rehInspectorStatusBadge');
    rehInspectorStepDesc = document.getElementById('rehInspectorStepDesc');
    rehInspectorLinksContainer = document.getElementById('rehInspectorLinksContainer');

    rehCausalLedgerContainer = document.getElementById('rehCausalLedgerContainer');
    btnExportEvidenceBundle = document.getElementById('btnExportEvidenceBundle');
    btnExportZipPack = document.getElementById('btnExportZipPack');

    // Tab buttons
    if (tabBtnRehearsalDirector) {
      tabBtnRehearsalDirector.addEventListener('click', () => {
        switchInspectorTab('tabRehearsalDirector');
        syncRehearsalCampaigns();
      });
    }

    if (btnHeaderRehearsalDirector) {
      btnHeaderRehearsalDirector.addEventListener('click', () => {
        hideLandingPage(true);
        if (inspectorPanel && inspectorPanel.classList.contains('hidden')) {
          inspectorPanel.classList.remove('hidden');
        }
        switchInspectorTab('tabRehearsalDirector');
        syncRehearsalCampaigns();
      });
    }

    if (btnMcRehearsalDirector) {
      btnMcRehearsalDirector.addEventListener('click', () => {
        switchInspectorTab('tabRehearsalDirector');
        syncRehearsalCampaigns();
      });
    }

    if (rehCampaignSelect) {
      rehCampaignSelect.addEventListener('change', () => {
        if (rehearsalReplayTimer) {
          clearInterval(rehearsalReplayTimer);
          rehearsalReplayTimer = null;
        }
        if (rehComparisonCard) rehComparisonCard.style.display = 'none';
        if (rehEmptyStateCard) rehEmptyStateCard.style.display = 'block';
        currentRehearsalRecord = null;
        if (rehCampaignSelect.value) {
          syncHistoricalRehearsals(rehCampaignSelect.value);
        }
      });
    }

    if (rehDisturbanceType) {
      rehDisturbanceType.addEventListener('change', updateRehearsalDisturbanceDesc);
    }

    if (btnExecuteRehearsal) {
      btnExecuteRehearsal.addEventListener('click', () => executeRehearsalAction());
    }

    if (btnRehLoadReplay) {
      btnRehLoadReplay.addEventListener('click', () => loadSelectedHistoricalReplay());
    }

    if (btnResetRehearsal) {
      btnResetRehearsal.addEventListener('click', resetRehearsalControls);
    }

    // Metric mode toggles
    if (btnRehMetricSci) {
      btnRehMetricSci.addEventListener('click', () => setRehearsalMetricMode('science'));
    }
    if (btnRehMetricDur) {
      btnRehMetricDur.addEventListener('click', () => setRehearsalMetricMode('duration'));
    }
    if (btnRehMetricMargin) {
      btnRehMetricMargin.addEventListener('click', () => setRehearsalMetricMode('margin'));
    }

    // Scrubber & Step controls
    if (rehTimelineScrubber) {
      rehTimelineScrubber.addEventListener('input', (e) => {
        seekRehearsalStep(parseInt(e.target.value, 10));
      });
    }
    if (btnReplayReset) {
      btnReplayReset.addEventListener('click', () => seekRehearsalStep(1));
    }
    if (btnReplayStepBack) {
      btnReplayStepBack.addEventListener('click', () => stepReplay(-1));
    }
    if (btnReplayPlayPause) {
      btnReplayPlayPause.addEventListener('click', () => toggleReplayPlayback());
    }
    if (btnReplayStepForward) {
      btnReplayStepForward.addEventListener('click', () => stepReplay(1));
    }

    // Export buttons
    if (btnExportEvidenceBundle) {
      btnExportEvidenceBundle.addEventListener('click', () => exportEvidenceBundle('json'));
    }
    if (btnExportZipPack) {
      btnExportZipPack.addEventListener('click', () => exportEvidenceBundle('zip'));
    }

    updateRehearsalDisturbanceDesc();
  }

  function updateRehearsalDisturbanceDesc() {
    if (!rehDisturbanceType || !rehDisturbanceParamDesc) return;
    const dtype = rehDisturbanceType.value;
    const trig = rehTriggerTimeInput ? rehTriggerTimeInput.value : '3600';

    if (dtype === 'operational_delay') {
      rehDisturbanceParamDesc.textContent = `Injects +1800s sampling hold or comms blackout at T+${trig}s. Reduces available EVA return margin.`;
    } else if (dtype === 'corridor_closure') {
      rehDisturbanceParamDesc.textContent = `Blocks a 50m radius corridor around traverse route at T+${trig}s. Forces detour or shedding.`;
    } else if (dtype === 'mobility_derating') {
      rehDisturbanceParamDesc.textContent = `Derates mobility to 0.70x speed (drift sand / traction slip) at T+${trig}s. Transit durations increase by ~43%.`;
    } else if (dtype === 'target_unavailability') {
      rehDisturbanceParamDesc.textContent = `Invalidates active scientific waypoint at T+${trig}s due to discovered hazard or unsuitability.`;
    } else if (dtype === 'unit_dropout') {
      rehDisturbanceParamDesc.textContent = `Exploration unit suffers disabling fault at T+${trig}s. Triggers autonomous multi-unit cross-asset handoff.`;
    }
  }

  async function syncRehearsalCampaigns() {
    if (!rehCampaignSelect) return;
    try {
      const resp = await fetch('/api/campaigns');
      if (!resp.ok) return;
      const data = await resp.json();
      const camps = data.campaigns || [];
      if (!camps.length) return;

      const currentVal = rehCampaignSelect.value;
      rehCampaignSelect.innerHTML = '';
      camps.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.campaign_id;
        opt.textContent = `${c.name || c.campaign_id} (${c.sorties ? c.sorties.length : 1} sols, v${c.version || 1})`;
        rehCampaignSelect.appendChild(opt);
      });

      if (currentVal && Array.from(rehCampaignSelect.options).some(o => o.value === currentVal)) {
        rehCampaignSelect.value = currentVal;
      } else if (mcState && mcState.selectedCampaignId) {
        rehCampaignSelect.value = mcState.selectedCampaignId;
      }

      if (rehCampaignSelect.value) {
        syncHistoricalRehearsals(rehCampaignSelect.value);
      }
    } catch (err) {
      console.warn('[RehearsalDirector] Failed to sync campaigns:', err);
    }
  }

  async function syncHistoricalRehearsals(campaignId) {
    if (!rehReplaySelect) return;
    try {
      rehReplaySelect.innerHTML = '<option value="">Loading historical replays...</option>';
      const resp = await fetch(`/api/rehearsal/list?campaign_id=${encodeURIComponent(campaignId)}`);
      if (!resp.ok) {
        rehReplaySelect.innerHTML = '<option value="">No historical replays available</option>';
        return;
      }
      const data = await resp.json();
      const list = data.rehearsals || [];
      rehReplaySelect.innerHTML = '';
      if (!list.length) {
        rehReplaySelect.innerHTML = '<option value="">No rehearsals saved for campaign</option>';
        return;
      }

      const defaultOpt = document.createElement('option');
      defaultOpt.value = '';
      defaultOpt.textContent = `Select replay (${list.length} available)...`;
      rehReplaySelect.appendChild(defaultOpt);

      list.forEach(r => {
        const opt = document.createElement('option');
        opt.value = r.rehearsal_id;
        const dType = (r.disturbances && r.disturbances[0]) ? r.disturbances[0].disturbance_type : 'dist';
        opt.textContent = `${r.rehearsal_id.slice(-10)} — ${r.outcome_status} (${dType})`;
        rehReplaySelect.appendChild(opt);
      });
    } catch (err) {
      console.warn('[RehearsalDirector] Failed to sync historical rehearsals:', err);
      rehReplaySelect.innerHTML = '<option value="">Failed to load replays</option>';
    }
  }

  async function loadSelectedHistoricalReplay(rehearsalId = null) {
    const rehId = rehearsalId || (rehReplaySelect ? rehReplaySelect.value : null);
    if (!rehId) {
      alert("Please select a historical rehearsal replay to load.");
      return;
    }

    showRehStatus(`Reconstructing historical replay '${rehId}' from disk...`, false);
    try {
      const resp = await fetch(`/api/rehearsal/${encodeURIComponent(rehId)}/replay`);
      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.message || `HTTP ${resp.status}`);
      }
      const data = await resp.json();
      currentRehearsalRecord = data.replay;
      renderRehearsalComparison(currentRehearsalRecord);
      showRehStatus(`Replay '${rehId}' reconstructed in ${data.reconstructed_in_ms}ms (${currentRehearsalRecord.outcome_status}).`, true);
      return currentRehearsalRecord;
    } catch (err) {
      console.error('[RehearsalDirector] Historical replay reconstruction error:', err);
      showRehStatus(`Failed to load replay: ${err.message}`, true, true);
    }
  }

  function resetRehearsalControls() {
    if (rehearsalReplayTimer) {
      clearInterval(rehearsalReplayTimer);
      rehearsalReplayTimer = null;
    }
    if (rehPolicySelect) rehPolicySelect.value = 'balanced';
    if (rehMarginThreshold) rehMarginThreshold.value = '1800';
    if (rehDisturbanceType) rehDisturbanceType.value = 'operational_delay';
    if (rehTriggerTimeInput) rehTriggerTimeInput.value = '3600';
    updateRehearsalDisturbanceDesc();
    if (rehComparisonCard) rehComparisonCard.style.display = 'none';
    if (rehEmptyStateCard) rehEmptyStateCard.style.display = 'block';
    if (rehDivergenceBanner) rehDivergenceBanner.style.display = 'none';
    currentRehearsalRecord = null;
    if (rehStatusTag) {
      rehStatusTag.textContent = 'READY';
      rehStatusTag.style.background = 'rgba(124,58,237,0.15)';
      rehStatusTag.style.color = '#c4b5fd';
    }
  }

  async function executeRehearsalAction(overridePayload = null) {
    const cid = (overridePayload && overridePayload.campaign_id) || (rehCampaignSelect ? rehCampaignSelect.value : (mcState ? mcState.selectedCampaignId : null));
    if (!cid) {
      alert("Please select a baseline exploration campaign first.");
      return;
    }

    const dtype = (overridePayload && overridePayload.disturbance_type) || (rehDisturbanceType ? rehDisturbanceType.value : 'operational_delay');
    const triggerTime = overridePayload ? (overridePayload.trigger_time_s || 3600.0) : parseFloat((rehTriggerTimeInput && rehTriggerTimeInput.value) || '3600');
    const policy = (overridePayload && overridePayload.policy_type) || (rehPolicySelect ? rehPolicySelect.value : 'balanced');
    const minMargin = overridePayload ? (overridePayload.min_margin_threshold_s || 1800.0) : parseFloat((rehMarginThreshold && rehMarginThreshold.value) || '1800');

    let distParams = {};
    if (dtype === 'operational_delay') {
      distParams = { delay_s: 1800.0 };
    } else if (dtype === 'corridor_closure') {
      distParams = { center_rc: [115, 155], radius_m: 50.0 };
    } else if (dtype === 'mobility_derating') {
      distParams = { speed_factor: 0.7 };
    } else if (dtype === 'target_unavailability') {
      distParams = { target_id: 'tgt_001', reason: 'Hazardous boulder field identified' };
    } else if (dtype === 'unit_dropout') {
      distParams = { affected_unit_id: 'unit_scout_1', reason: 'Power subsystem brownout' };
    }

    const payload = overridePayload || {
      campaign_id: cid,
      title: `Rehearsal: ${dtype.replace('_', ' ').toUpperCase()}`,
      disturbances: [
        {
          disturbance_id: `dst_${Date.now().toString(36)}`,
          disturbance_type: dtype,
          trigger_time_s: triggerTime,
          parameters: distParams,
          description: `Scheduled operational ${dtype.replace('_', ' ')}`
        }
      ],
      recovery_policy: {
        policy_type: policy,
        min_margin_threshold_s: minMargin
      }
    };

    showRehStatus(`Executing closed-loop rehearsal simulation for campaign '${cid}'...`, false);
    if (btnExecuteRehearsal) btnExecuteRehearsal.disabled = true;

    try {
      const resp = await fetch('/api/rehearsal/execute', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.message || `HTTP ${resp.status}`);
      }

      const res = await resp.json();
      currentRehearsalRecord = res.rehearsal;
      renderRehearsalComparison(currentRehearsalRecord);
      showRehStatus(`Rehearsal completed successfully (${currentRehearsalRecord.outcome_status}) in ${currentRehearsalRecord.execution_duration_ms}ms.`, true);
      syncHistoricalRehearsals(cid);

      return currentRehearsalRecord;
    } catch (err) {
      console.error('[RehearsalDirector] Execution error:', err);
      showRehStatus(`Rehearsal failed: ${err.message}`, true, true);
    } finally {
      if (btnExecuteRehearsal) btnExecuteRehearsal.disabled = false;
    }
  }

  function renderRehearsalComparison(record) {
    if (!record || !rehComparisonCard) return;

    if (rehEmptyStateCard) rehEmptyStateCard.style.display = 'none';
    rehComparisonCard.style.display = 'block';

    // Outcome Badge
    if (rehOutcomeBadge) {
      rehOutcomeBadge.textContent = record.outcome_status;
      if (record.outcome_status === 'RECOVERED') {
        rehOutcomeBadge.style.background = 'rgba(16,185,129,0.15)';
        rehOutcomeBadge.style.color = 'var(--status-green)';
        rehOutcomeBadge.style.borderColor = 'rgba(16,185,129,0.3)';
      } else if (record.outcome_status === 'RECOVERED_WITH_DEGRADATION') {
        rehOutcomeBadge.style.background = 'rgba(245,158,11,0.15)';
        rehOutcomeBadge.style.color = '#fbbf24';
        rehOutcomeBadge.style.borderColor = 'rgba(245,158,11,0.3)';
      } else {
        rehOutcomeBadge.style.background = 'rgba(239,68,68,0.15)';
        rehOutcomeBadge.style.color = '#f87171';
        rehOutcomeBadge.style.borderColor = 'rgba(239,68,68,0.3)';
      }
    }

    if (rehStatusTag) {
      rehStatusTag.textContent = record.outcome_status;
      rehStatusTag.style.color = rehOutcomeBadge.style.color;
      rehStatusTag.style.background = rehOutcomeBadge.style.background;
    }

    // Divergence Banner
    const div = record.divergence_analysis;
    if (rehDivergenceBanner) {
      if (div && div.diverged) {
        rehDivergenceBanner.style.display = 'flex';
        if (rehDivTriggerText) rehDivTriggerText.textContent = div.trigger_disturbance_type ? div.trigger_disturbance_type.replace('_', ' ').toUpperCase() : 'UNKNOWN';
        if (rehDivTimeText) rehDivTimeText.textContent = Math.round(div.divergence_time_s || 0);
        if (rehDivImpactBadge) {
          const impactCount = (div.divergent_sortie_ids && div.divergent_sortie_ids.length) || 1;
          rehDivImpactBadge.textContent = `${impactCount} SORTIE${impactCount > 1 ? 'S' : ''} DIVERGED`;
        }
      } else {
        rehDivergenceBanner.style.display = 'none';
      }
    }

    const comp = record.comparison || {};
    const baseM = record.baseline_metrics || {};
    const distM = record.disturbed_metrics || {};
    const recM = record.recovered_metrics || {};

    if (rehExecutiveAssessmentText) {
      rehExecutiveAssessmentText.textContent = comp.executive_assessment || 'Assessment completed.';
    }

    if (rehSciencePreservedVal) {
      rehSciencePreservedVal.textContent = `${comp.science_preservation_pct || 0}%`;
    }
    if (rehNetScienceDeltaVal) {
      const net = comp.net_science_delta || 0;
      rehNetScienceDeltaVal.textContent = `${net >= 0 ? '+' : ''}${net.toFixed(1)} pts`;
      rehNetScienceDeltaVal.style.color = net < 0 ? '#fbbf24' : 'var(--text-primary)';
    }
    if (rehRecoveredMarginVal) {
      rehRecoveredMarginVal.textContent = formatDuration(recM.min_margin_s || 0);
    }
    if (rehDelayIncurredVal) {
      const dly = comp.delay_incurred_s || 0;
      rehDelayIncurredVal.textContent = `${dly >= 0 ? '+' : ''}${formatDuration(Math.abs(dly))}`;
    }
    if (rehTargetsRetainedVal) {
      rehTargetsRetainedVal.textContent = `${recM.targets_completed || 0} / ${baseM.targets_attempted || 0}`;
    }
    if (rehRecoveryEfficiencyVal) {
      rehRecoveryEfficiencyVal.textContent = `${comp.recovery_efficiency_pct || 100}%`;
    }

    // Trajectory comparison bars
    updateTrajectoryBars();

    // Render candidate options
    if (rehCandidatesContainer) {
      rehCandidatesContainer.innerHTML = '';
      const cands = record.recovery_candidates || [];
      cands.forEach(c => {
        const card = document.createElement('div');
        const isSel = c.selection_status === 'SELECTED';
        const isInf = !c.is_feasible;
        card.style.padding = '5px 8px';
        card.style.borderRadius = '4px';
        card.style.fontSize = '8px';
        card.style.lineHeight = '1.25';
        card.style.border = `1px solid ${isSel ? 'rgba(168,85,247,0.4)' : (isInf ? 'rgba(239,68,68,0.2)' : 'rgba(255,255,255,0.08)')}`;
        card.style.background = isSel ? 'rgba(168,85,247,0.1)' : 'rgba(0,0,0,0.2)';
        card.innerHTML = `
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2px;">
            <strong style="color:${isSel ? '#c084fc' : (isInf ? '#fca5a5' : 'var(--text-primary)')}; font-size:8.5px;">${c.title}</strong>
            <span class="wp-badge" style="font-size:7px; background:${isSel ? 'rgba(168,85,247,0.2)' : 'rgba(255,255,255,0.06)'}; color:${isSel ? '#c084fc' : 'var(--text-tertiary)'};">${c.selection_status}</span>
          </div>
          <div style="display:flex; gap:10px; font-family:var(--font-mono); color:var(--text-secondary); margin-bottom:2px;">
            <span>Sci: <strong>${c.projected_science_score} pts</strong></span>
            <span>Margin: <strong>${formatDuration(c.projected_margin_s)}</strong></span>
            <span>Targets: <strong>${c.projected_targets_completed}</strong></span>
          </div>
          <div style="color:var(--text-tertiary); font-style:italic;">${c.decision_rationale}</div>
        `;
        rehCandidatesContainer.appendChild(card);
      });
    }

    // Render Causal Ledger
    if (rehCausalLedgerContainer) {
      rehCausalLedgerContainer.innerHTML = '';
      const steps = record.causal_ledger || [];
      steps.forEach((s, idx) => {
        const item = document.createElement('div');
        item.className = 'reh-step-item';
        item.dataset.stepIndex = s.step_index || (idx + 1);
        item.style.padding = '4px 6px';
        item.style.borderRadius = '3px';
        item.style.fontSize = '8px';
        item.style.cursor = 'pointer';
        item.style.background = 'rgba(255,255,255,0.02)';
        item.style.borderLeft = `2px solid ${s.step_type === 'SELECTION_DECISION' ? '#a855f7' : (s.step_type === 'DISTURBANCE_TRIGGER' ? '#ef4444' : 'var(--telemetry-cyan)')}`;
        item.innerHTML = `
          <div style="display:flex; justify-content:space-between; margin-bottom:1px;">
            <strong style="color:var(--text-primary); font-size:8.5px;">Step ${s.step_index || (idx + 1)}: ${s.title}</strong>
            <span style="font-family:var(--font-mono); color:var(--text-tertiary); font-size:7.5px;">T+${Math.round(s.simulated_time_s || 0)}s</span>
          </div>
          <div style="color:var(--text-secondary); line-height:1.2;">${s.description}</div>
        `;
        item.addEventListener('click', () => {
          seekRehearsalStep(s.step_index || (idx + 1));
        });
        rehCausalLedgerContainer.appendChild(item);
      });

      // Update scrubber range
      if (rehTimelineScrubber) {
        rehTimelineScrubber.min = 1;
        rehTimelineScrubber.max = steps.length || 7;
        rehTimelineScrubber.value = 1;
      }

      // Seek to step 1
      seekRehearsalStep(1);
    }
  }

  function setRehearsalMetricMode(mode) {
    rehearsalMetricMode = mode;
    if (btnRehMetricSci) btnRehMetricSci.classList.toggle('active', mode === 'science');
    if (btnRehMetricDur) btnRehMetricDur.classList.toggle('active', mode === 'duration');
    if (btnRehMetricMargin) btnRehMetricMargin.classList.toggle('active', mode === 'margin');
    updateTrajectoryBars();
  }

  function updateTrajectoryBars() {
    if (!currentRehearsalRecord) return;
    const baseM = currentRehearsalRecord.baseline_metrics || {};
    const distM = currentRehearsalRecord.disturbed_metrics || {};
    const recM = currentRehearsalRecord.recovered_metrics || {};

    if (rehearsalMetricMode === 'science') {
      const baseVal = Math.max(0.1, baseM.science_score || 0);
      const distVal = distM.science_score || 0;
      const recVal = recM.science_score || 0;

      if (rehTrackBaselineSummary) rehTrackBaselineSummary.textContent = `${baseVal.toFixed(1)} pts • Margin: ${formatDuration(baseM.min_margin_s || 0)}`;
      if (rehTrackDisturbedSummary) rehTrackDisturbedSummary.textContent = `${distVal.toFixed(1)} pts • ${distM.violations && distM.violations.length ? distM.violations.length + ' Violations' : 'Depleted'}`;
      if (rehTrackRecoveredSummary) rehTrackRecoveredSummary.textContent = `${recVal.toFixed(1)} pts • Margin: ${formatDuration(recM.min_margin_s || 0)}`;

      if (rehBarBaseline) rehBarBaseline.style.width = '100%';
      if (rehBarDisturbed) rehBarDisturbed.style.width = `${Math.max(8, Math.min(100, (distVal / baseVal) * 100))}%`;
      if (rehBarRecovered) rehBarRecovered.style.width = `${Math.max(8, Math.min(100, (recVal / baseVal) * 100))}%`;
    } else if (rehearsalMetricMode === 'duration') {
      const maxDur = Math.max(1, baseM.total_duration_s || 1, distM.total_duration_s || 1, recM.total_duration_s || 1);
      const basePct = ((baseM.total_duration_s || 0) / maxDur) * 100;
      const distPct = ((distM.total_duration_s || 0) / maxDur) * 100;
      const recPct = ((recM.total_duration_s || 0) / maxDur) * 100;

      if (rehTrackBaselineSummary) rehTrackBaselineSummary.textContent = `Total: ${formatDuration(baseM.total_duration_s || 0)} (${(baseM.total_distance_m || 0).toFixed(0)}m)`;
      if (rehTrackDisturbedSummary) rehTrackDisturbedSummary.textContent = `Total: ${formatDuration(distM.total_duration_s || 0)} (${(distM.total_distance_m || 0).toFixed(0)}m)`;
      if (rehTrackRecoveredSummary) rehTrackRecoveredSummary.textContent = `Total: ${formatDuration(recM.total_duration_s || 0)} (${(recM.total_distance_m || 0).toFixed(0)}m)`;

      if (rehBarBaseline) rehBarBaseline.style.width = `${Math.max(8, Math.min(100, basePct))}%`;
      if (rehBarDisturbed) rehBarDisturbed.style.width = `${Math.max(8, Math.min(100, distPct))}%`;
      if (rehBarRecovered) rehBarRecovered.style.width = `${Math.max(8, Math.min(100, recPct))}%`;
    } else if (rehearsalMetricMode === 'margin') {
      const maxMargin = Math.max(1, baseM.min_margin_s || 1, recM.min_margin_s || 1);
      const basePct = ((baseM.min_margin_s || 0) / maxMargin) * 100;
      const distPct = Math.max(5, ((distM.min_margin_s || 0) / maxMargin) * 100);
      const recPct = ((recM.min_margin_s || 0) / maxMargin) * 100;

      if (rehTrackBaselineSummary) rehTrackBaselineSummary.textContent = `Margin: ${formatDuration(baseM.min_margin_s || 0)} (Nominal)`;
      if (rehTrackDisturbedSummary) rehTrackDisturbedSummary.textContent = `Margin: ${formatDuration(distM.min_margin_s || 0)} (${distM.min_margin_s <= 0 ? 'CRITICAL DEPLETION' : 'Compromised'})`;
      if (rehTrackRecoveredSummary) rehTrackRecoveredSummary.textContent = `Margin: ${formatDuration(recM.min_margin_s || 0)} (Restored)`;

      if (rehBarBaseline) rehBarBaseline.style.width = `${Math.max(8, Math.min(100, basePct))}%`;
      if (rehBarDisturbed) rehBarDisturbed.style.width = `${Math.max(8, Math.min(100, distPct))}%`;
      if (rehBarRecovered) rehBarRecovered.style.width = `${Math.max(8, Math.min(100, recPct))}%`;
    }
  }

  function seekRehearsalStep(stepIndex) {
    if (!currentRehearsalRecord) return;
    const steps = currentRehearsalRecord.causal_ledger || [];
    if (!steps.length) return;

    const clamped = Math.max(1, Math.min(steps.length, stepIndex));
    rehearsalReplayCurrentStep = clamped;

    if (rehTimelineScrubber) rehTimelineScrubber.value = clamped;
    if (rehStepIndicator) rehStepIndicator.textContent = `STEP ${clamped} / ${steps.length}`;

    const step = steps[clamped - 1];
    if (!step) return;

    if (rehStepPhaseBadge) {
      rehStepPhaseBadge.textContent = `PHASE: ${step.step_type ? step.step_type.replace(/_/g, ' ') : 'EXECUTE'}`;
    }

    // Highlight item in ledger
    if (rehCausalLedgerContainer) {
      const children = Array.from(rehCausalLedgerContainer.children);
      children.forEach((el, i) => {
        if (i === clamped - 1) {
          el.classList.add('active-step');
          el.style.background = 'rgba(168,85,247,0.2)';
          el.style.borderColor = '#c084fc';
          el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          el.classList.remove('active-step');
          el.style.background = 'rgba(255,255,255,0.02)';
          el.style.borderColor = 'transparent';
        }
      });
    }

    // Populate Causal Inspector Drawer
    if (rehCausalInspectorCard) {
      if (rehInspectorStepId) rehInspectorStepId.textContent = step.step_id || `STEP-${clamped}`;
      if (rehInspectorStepTitle) rehInspectorStepTitle.textContent = step.title || `Decision Step ${clamped}`;
      if (rehInspectorStepDesc) {
        rehInspectorStepDesc.textContent = step.description + (step.evidence_rationale ? ` — ${step.evidence_rationale}` : '');
      }

      if (rehInspectorStatusBadge) {
        const st = (step.evidence_status || 'CONFIRMED').toUpperCase();
        rehInspectorStatusBadge.textContent = st;
        rehInspectorStatusBadge.className = 'reh-link-badge';
        if (st === 'CONFIRMED') {
          rehInspectorStatusBadge.classList.add('reh-link-confirmed');
        } else if (st === 'DERIVED') {
          rehInspectorStatusBadge.classList.add('reh-link-derived');
        } else {
          rehInspectorStatusBadge.classList.add('reh-link-unresolved');
        }
      }

      if (rehInspectorLinksContainer) {
        rehInspectorLinksContainer.innerHTML = '';
        const links = step.causal_links || [];
        if (!links.length) {
          rehInspectorLinksContainer.innerHTML = '<div style="font-size:7.5px; color:var(--text-tertiary); font-style:italic;">No explicit causal links recorded for this step.</div>';
        } else {
          links.forEach(l => {
            const row = document.createElement('div');
            row.style.display = 'flex';
            row.style.justifyContent = 'space-between';
            row.style.alignItems = 'center';
            row.style.padding = '3px 5px';
            row.style.borderRadius = '3px';
            row.style.background = 'rgba(255,255,255,0.03)';
            row.style.fontSize = '7.5px';

            const lStatus = (l.status || 'CONFIRMED').toUpperCase();
            let bClass = 'reh-link-confirmed';
            if (lStatus === 'DERIVED') bClass = 'reh-link-derived';
            else if (lStatus === 'UNRESOLVED' || lStatus === 'CONFLICTING' || lStatus === 'MISSING') bClass = 'reh-link-unresolved';

            row.innerHTML = `
              <span style="color:var(--text-secondary); font-family:var(--font-mono);">
                <span style="color:#c4b5fd;">${l.source_type}</span> <strong style="color:var(--text-primary);">${l.source_id}</strong> &rarr; <span style="color:#a78bfa;">${l.relation_type}</span> &rarr; <span style="color:#c4b5fd;">${l.target_type}</span> <strong style="color:var(--text-primary);">${l.target_id}</strong>
              </span>
              <span class="reh-link-badge ${bClass}">${lStatus}</span>
            `;
            rehInspectorLinksContainer.appendChild(row);
          });
        }
      }
    }
  }

  function stepReplay(delta) {
    if (!currentRehearsalRecord) return;
    const steps = currentRehearsalRecord.causal_ledger || [];
    const target = rehearsalReplayCurrentStep + delta;
    if (target >= 1 && target <= steps.length) {
      seekRehearsalStep(target);
    }
  }

  function toggleReplayPlayback() {
    if (!currentRehearsalRecord) return;
    const steps = currentRehearsalRecord.causal_ledger || [];
    if (!steps.length) return;

    if (rehearsalReplayTimer) {
      clearInterval(rehearsalReplayTimer);
      rehearsalReplayTimer = null;
      if (btnReplayPlayPause) btnReplayPlayPause.innerHTML = '&#9654; PLAY';
    } else {
      if (rehearsalReplayCurrentStep >= steps.length) {
        seekRehearsalStep(1);
      }
      if (btnReplayPlayPause) btnReplayPlayPause.innerHTML = '&#10074;&#10074; PAUSE';
      rehearsalReplayTimer = setInterval(() => {
        if (rehearsalReplayCurrentStep < steps.length) {
          seekRehearsalStep(rehearsalReplayCurrentStep + 1);
        } else {
          clearInterval(rehearsalReplayTimer);
          rehearsalReplayTimer = null;
          if (btnReplayPlayPause) btnReplayPlayPause.innerHTML = '&#9654; PLAY';
        }
      }, 750);
    }
  }

  async function exportEvidenceBundle(format = 'json') {
    if (!currentRehearsalRecord) {
      alert("No completed rehearsal record available to export.");
      return;
    }

    const rehId = currentRehearsalRecord.rehearsal_id;
    showRehStatus(`Generating auditable evidence bundle (${format.toUpperCase()}) for '${rehId}'...`, false);

    try {
      const resp = await fetch('/api/rehearsal/bundle/export', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ rehearsal_id: rehId, format: format })
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.message || `HTTP ${resp.status}`);
      }

      if (format === 'zip') {
        const blob = await resp.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${rehId}_evidence_pack.zip`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      } else {
        const json = await resp.json();
        const jsonStr = JSON.stringify(json, null, 2);
        const blob = new Blob([jsonStr], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${rehId}_evidence_bundle.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      showRehStatus(`Evidence bundle (${format.toUpperCase()}) exported successfully.`, true);
    } catch (err) {
      console.error('[RehearsalDirector] Export error:', err);
      showRehStatus(`Export failed: ${err.message}`, true, true);
    }
  }

  function showRehStatus(msg, autoHide = false, isError = false) {
    if (!rehStatusBanner) return;
    rehStatusBanner.classList.remove('hidden');
    rehStatusBanner.textContent = msg;
    rehStatusBanner.style.color = isError ? 'var(--status-critical)' : 'var(--telemetry-cyan)';
    rehStatusBanner.style.borderColor = isError ? 'rgba(239, 68, 68, 0.4)' : 'var(--border-medium)';

    if (autoHide) {
      setTimeout(() => {
        if (rehStatusBanner) rehStatusBanner.classList.add('hidden');
      }, 4500);
    }
  }


  // =========================================================================
  // MILESTONE 12H: ATLAS MISSION EXPERIMENT STUDIO CONTROLLER
  // =========================================================================
  let currentExperimentRecord = null;
  let activeExperimentId = null;
  let isExperimentRunning = false;
  let expReturnContext = null;

  // DOM Elements
  let expCampaignSelect = null;
  let expScenarioSuite = null;
  let expRehearsalTriggerSelect = null;
  let expRecoveryPolicySelect = null;
  let expMinMarginInput = null;
  let expMaxScenariosInput = null;
  let expMaxRehearsalsInput = null;
  let btnRunExperiment = null;
  let expStatusTag = null;
  let expProgressPct = null;
  let expProgressBar = null;
  let expCounterEvaluated = null;
  let expCounterRehearsed = null;
  let expCounterFeasible = null;
  let expCounterRecovered = null;
  let expStatusLine = null;
  let expMatrixCountBadge = null;
  let expNarrativeText = null;
  let expMatrixTableBody = null;
  let btnExportDossierJson = null;
  let btnExportDossierZip = null;
  let btnMcExperimentStudio = null;
  let rehExperimentBreadcrumb = null;
  let btnReturnToExperiment = null;

  function initExperimentStudio() {
    expCampaignSelect = document.getElementById('expCampaignSelect');
    expScenarioSuite = document.getElementById('expScenarioSuite');
    expRehearsalTriggerSelect = document.getElementById('expRehearsalTriggerSelect');
    expRecoveryPolicySelect = document.getElementById('expRecoveryPolicySelect');
    expMinMarginInput = document.getElementById('expMinMarginInput');
    expMaxScenariosInput = document.getElementById('expMaxScenariosInput');
    expMaxRehearsalsInput = document.getElementById('expMaxRehearsalsInput');
    btnRunExperiment = document.getElementById('btnRunExperiment');
    expStatusTag = document.getElementById('expStatusTag');
    expProgressPct = document.getElementById('expProgressPct');
    expProgressBar = document.getElementById('expProgressBar');
    expCounterEvaluated = document.getElementById('expCounterEvaluated');
    expCounterRehearsed = document.getElementById('expCounterRehearsed');
    expCounterFeasible = document.getElementById('expCounterFeasible');
    expCounterRecovered = document.getElementById('expCounterRecovered');
    expStatusLine = document.getElementById('expStatusLine');
    expMatrixCountBadge = document.getElementById('expMatrixCountBadge');
    expNarrativeText = document.getElementById('expNarrativeText');
    expMatrixTableBody = document.getElementById('expMatrixTableBody');
    btnExportDossierJson = document.getElementById('btnExportDossierJson');
    btnExportDossierZip = document.getElementById('btnExportDossierZip');
    btnMcExperimentStudio = document.getElementById('btnMcExperimentStudio');
    rehExperimentBreadcrumb = document.getElementById('rehExperimentBreadcrumb');
    btnReturnToExperiment = document.getElementById('btnReturnToExperiment');

    // Tab button listener
    const tabBtn = document.getElementById('tabBtnExperimentStudio');
    if (tabBtn) {
      tabBtn.addEventListener('click', () => {
        switchInspectorTab('tabExperimentStudio');
        syncExperimentCampaigns();
      });
    }

    // Command toolbar button listener
    if (btnMcExperimentStudio) {
      btnMcExperimentStudio.addEventListener('click', () => {
        switchInspectorTab('tabExperimentStudio');
        syncExperimentCampaigns();
      });
    }

    // Run experiment button listener
    if (btnRunExperiment) {
      btnRunExperiment.addEventListener('click', () => {
        executeExperimentAction();
      });
    }

    // Export buttons
    if (btnExportDossierJson) {
      btnExportDossierJson.addEventListener('click', () => {
        exportExperimentDossierAction('json');
      });
    }
    if (btnExportDossierZip) {
      btnExportDossierZip.addEventListener('click', () => {
        exportExperimentDossierAction('zip');
      });
    }

    // Breadcrumb return listener
    if (btnReturnToExperiment) {
      btnReturnToExperiment.addEventListener('click', () => {
        switchInspectorTab('tabExperimentStudio');
        if (rehExperimentBreadcrumb) {
          rehExperimentBreadcrumb.style.display = 'none';
          rehExperimentBreadcrumb.classList.add('hidden');
        }
        if (expReturnContext && expReturnContext.scenarioId && expMatrixTableBody) {
          const targetRow = expMatrixTableBody.querySelector(`[data-scenario-id="${expReturnContext.scenarioId}"]`);
          if (targetRow) {
            targetRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            targetRow.style.outline = '2px solid #34d399';
            setTimeout(() => { targetRow.style.outline = ''; }, 2500);
          }
        }
      });
    }

    // Reset when campaign changes to prevent stale metrics
    if (expCampaignSelect) {
      expCampaignSelect.addEventListener('change', () => {
        resetExperimentStudioUI();
      });
    }

    // Initial sync
    syncExperimentCampaigns();
  }

  function resetExperimentStudioUI() {
    currentExperimentRecord = null;
    activeExperimentId = null;
    if (expStatusTag) {
      expStatusTag.textContent = 'READY';
      expStatusTag.style.background = 'rgba(16,185,129,0.15)';
      expStatusTag.style.color = '#6ee7b7';
      expStatusTag.style.borderColor = 'rgba(16,185,129,0.3)';
    }
    if (expProgressPct) expProgressPct.textContent = '0%';
    if (expProgressBar) expProgressBar.style.width = '0%';
    if (expCounterEvaluated) expCounterEvaluated.textContent = '0';
    if (expCounterRehearsed) expCounterRehearsed.textContent = '0';
    if (expCounterFeasible) expCounterFeasible.textContent = '0';
    if (expCounterRecovered) expCounterRecovered.textContent = '0';
    if (expStatusLine) expStatusLine.textContent = 'Standing by to orchestrate experiment.';
    if (expMatrixCountBadge) expMatrixCountBadge.textContent = '0 Scenarios';
    if (expNarrativeText) expNarrativeText.textContent = 'Execute an experiment battery to generate cross-scenario trade-off analysis.';
    if (expMatrixTableBody) {
      expMatrixTableBody.innerHTML = '<tr><td colspan="8" style="text-align:center; color:var(--text-tertiary); padding:10px 4px;">No experiment data loaded. Run an experiment above.</td></tr>';
    }
  }

  async function syncExperimentCampaigns() {
    if (!expCampaignSelect) return;
    try {
      const resp = await fetch('/api/campaign/list');
      if (!resp.ok) return;
      const data = await resp.json();
      const campaigns = data.campaigns || [];
      const currentVal = expCampaignSelect.value;
      expCampaignSelect.innerHTML = '';

      if (campaigns.length === 0) {
        expCampaignSelect.innerHTML = '<option value="">No campaigns available</option>';
        return;
      }

      campaigns.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.campaign_id;
        opt.textContent = `${c.name || c.campaign_id} (${c.sorties_count || 1} sols, v${c.version || 1})`;
        expCampaignSelect.appendChild(opt);
      });

      if (currentVal && campaigns.some(c => c.campaign_id === currentVal)) {
        expCampaignSelect.value = currentVal;
      } else if (mcState && mcState.selectedCampaignId && campaigns.some(c => c.campaign_id === mcState.selectedCampaignId)) {
        expCampaignSelect.value = mcState.selectedCampaignId;
      }
    } catch (e) {
      console.warn('[ExperimentStudio] Failed to sync campaigns:', e);
    }
  }

  async function executeExperimentAction() {
    if (!expCampaignSelect || !expCampaignSelect.value) {
      alert('Please select a baseline campaign first.');
      return;
    }
    if (isExperimentRunning) return;

    isExperimentRunning = true;
    if (btnRunExperiment) {
      btnRunExperiment.disabled = true;
      btnRunExperiment.innerHTML = '&#9203; ORCHESTRATING SCENARIOS...';
    }
    if (expStatusTag) {
      expStatusTag.textContent = 'EVALUATING';
      expStatusTag.style.background = 'rgba(245, 158, 11, 0.15)';
      expStatusTag.style.color = '#fcd34d';
      expStatusTag.style.borderColor = 'rgba(245, 158, 11, 0.3)';
    }
    if (expStatusLine) expStatusLine.textContent = 'Running Tier 1 Static Sensitivity Evaluation (Robustness Lab)...';
    if (expProgressBar) expProgressBar.style.width = '35%';
    if (expProgressPct) expProgressPct.textContent = '35%';

    const payload = {
      campaign_id: expCampaignSelect.value,
      suite_type: expScenarioSuite ? expScenarioSuite.value : 'full_battery',
      scenario_selection_strategy: expRehearsalTriggerSelect ? expRehearsalTriggerSelect.value : 'degraded_or_breach',
      rehearsal_policy: expRecoveryPolicySelect ? expRecoveryPolicySelect.value : 'balanced',
      min_margin_threshold_s: expMinMarginInput ? parseFloat(expMinMarginInput.value) || 1800 : 1800,
      max_scenarios: expMaxScenariosInput ? parseInt(expMaxScenariosInput.value, 10) || 10 : 10,
      max_rehearsals: expMaxRehearsalsInput ? parseInt(expMaxRehearsalsInput.value, 10) || 5 : 5,
    };

    try {
      // Small visual pause for smooth progress
      await new Promise(r => setTimeout(r, 100));
      if (expProgressBar) expProgressBar.style.width = '65%';
      if (expProgressPct) expProgressPct.textContent = '65%';
      if (expStatusLine) expStatusLine.textContent = 'Executing Closed-Loop Mission Rehearsals & Causal Tracing...';

      const resp = await fetch('/api/experiment/orchestrate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.message || `HTTP ${resp.status}`);
      }

      const resData = await resp.json();
      currentExperimentRecord = resData.experiment;
      activeExperimentId = currentExperimentRecord.experiment_id;

      if (expProgressBar) expProgressBar.style.width = '100%';
      if (expProgressPct) expProgressPct.textContent = '100%';
      if (expStatusTag) {
        expStatusTag.textContent = 'COMPLETED';
        expStatusTag.style.background = 'rgba(16,185,129,0.15)';
        expStatusTag.style.color = '#6ee7b7';
        expStatusTag.style.borderColor = 'rgba(16,185,129,0.3)';
      }
      if (expStatusLine) {
        expStatusLine.textContent = `Experiment completed in ${currentExperimentRecord.summary_metrics.execution_duration_ms || 0}ms.`;
      }

      // Update counters
      const sm = currentExperimentRecord.summary_metrics || {};
      if (expCounterEvaluated) expCounterEvaluated.textContent = sm.total_scenarios_evaluated || 0;
      if (expCounterRehearsed) expCounterRehearsed.textContent = sm.rehearsals_executed_count || 0;
      if (expCounterFeasible) expCounterFeasible.textContent = sm.robustness_feasible_count || 0;
      if (expCounterRecovered) expCounterRecovered.textContent = sm.recovered_count || 0;

      // Render Matrix
      renderExperimentMatrix(currentExperimentRecord);

    } catch (err) {
      console.error('[ExperimentStudio] Orchestration failed:', err);
      if (expStatusTag) {
        expStatusTag.textContent = 'FAILED';
        expStatusTag.style.background = 'rgba(239, 68, 68, 0.15)';
        expStatusTag.style.color = '#fca5a5';
        expStatusTag.style.borderColor = 'rgba(239, 68, 68, 0.3)';
      }
      if (expProgressBar) {
        expProgressBar.style.width = '100%';
        expProgressBar.style.background = '#ef4444';
      }
      if (expProgressPct) expProgressPct.textContent = 'ERROR';
      if (expStatusLine) expStatusLine.textContent = `Error: ${err.message}`;
    } finally {
      isExperimentRunning = false;
      if (btnRunExperiment) {
        btnRunExperiment.disabled = false;
        btnRunExperiment.innerHTML = '&#9654; ORCHESTRATE EXPERIMENT BATTERY';
      }
    }
  }

  function renderExperimentMatrix(record) {
    if (!record || !record.cross_scenario_matrix) return;
    const matrix = record.cross_scenario_matrix;
    const rows = matrix.rows || [];

    if (expMatrixCountBadge) {
      expMatrixCountBadge.textContent = `${rows.length} Scenarios`;
    }
    if (expNarrativeText) {
      expNarrativeText.textContent = matrix.summary_narrative || 'Orchestration study completed.';
    }

    if (!expMatrixTableBody) return;
    expMatrixTableBody.innerHTML = '';

    if (rows.length === 0) {
      expMatrixTableBody.innerHTML = '<tr><td colspan="8" style="text-align:center; color:var(--text-tertiary); padding:10px 4px;">Zero scenarios generated in this suite.</td></tr>';
      return;
    }

    rows.forEach(r => {
      const tr = document.createElement('tr');
      if (r.scenario_id) tr.dataset.scenarioId = r.scenario_id;

      // 1. Scenario
      const tdScen = document.createElement('td');
      tdScen.innerHTML = `<strong>${escapeHtml(r.scenario_name || r.scenario_id)}</strong><br/><span style="font-size:7px; color:var(--text-tertiary);">${escapeHtml(r.scenario_id)}</span>`;

      // 2. Disruption
      const tdDis = document.createElement('td');
      tdDis.innerHTML = `<span style="font-size:7.5px; color:#cbd5e1;">${escapeHtml(r.disruption_type || '-')}</span>`;

      // 3. Robustness status chip
      const tdRob = document.createElement('td');
      const robStatus = String(r.robustness_status || '').toUpperCase();
      let robChipClass = 'status-chip-feasible';
      if (robStatus === 'INFEASIBLE') robChipClass = 'status-chip-infeasible';
      else if (robStatus === 'DEGRADED') robChipClass = 'status-chip-degraded';
      tdRob.innerHTML = `<span class="${robChipClass}">${robStatus}</span>`;

      // 4. Rehearsal status chip
      const tdReh = document.createElement('td');
      if (r.rehearsal_executed && r.rehearsal_id) {
        const outStatus = String(r.outcome_status || 'REHEARSED').toUpperCase();
        let rehChipColor = '#34d399';
        if (outStatus.includes('NO_FEASIBLE') || outStatus === 'FAILED') rehChipColor = '#fca5a5';
        else if (outStatus.includes('DEGRADATION')) rehChipColor = '#fcd34d';
        tdReh.innerHTML = `<span style="background:rgba(124,58,237,0.15); color:${rehChipColor}; border:1px solid rgba(124,58,237,0.3); padding:1px 4px; border-radius:2px; font-size:7.5px;">${outStatus}</span>`;
      } else {
        tdReh.innerHTML = '<span style="color:var(--text-tertiary); font-size:7.5px;">ROBUSTNESS ONLY</span>';
      }

      // 5. Science Preserved
      const tdSci = document.createElement('td');
      const sciPct = parseFloat(r.science_preservation_pct) || 0;
      let sciColor = '#34d399';
      if (sciPct < 80.0) sciColor = '#fcd34d';
      if (sciPct < 50.0) sciColor = '#fca5a5';
      tdSci.innerHTML = `<strong style="color:${sciColor};">${sciPct.toFixed(1)}%</strong> <span style="font-size:7px; color:var(--text-tertiary);">(${r.recovered_science || 0}/${r.baseline_science || 0})</span>`;

      // 6. Delay Incurred
      const tdDel = document.createElement('td');
      const delayS = parseFloat(r.delay_incurred_s) || 0;
      tdDel.innerHTML = `<span style="font-size:7.5px; color:${delayS > 0 ? '#fcd34d' : 'var(--text-secondary)'};">+${(delayS / 60.0).toFixed(0)}m</span>`;

      // 7. Margin Delta
      const tdMar = document.createElement('td');
      const marDelta = parseFloat(r.margin_delta_s) || 0;
      let marColor = 'var(--text-secondary)';
      if (marDelta < 0) marColor = '#fca5a5';
      else if (marDelta > 0) marColor = '#34d399';
      tdMar.innerHTML = `<span style="font-size:7.5px; color:${marColor};">${marDelta > 0 ? '+' : ''}${marDelta.toFixed(0)}s</span>`;

      // 8. Action button
      const tdAct = document.createElement('td');
      if (r.rehearsal_executed && r.rehearsal_id) {
        const btnReplay = document.createElement('button');
        btnReplay.className = 'btn-matrix-replay';
        btnReplay.innerHTML = '&#127916; Forensics';
        btnReplay.title = 'Jump to Causal Replay Forensics with context preserved';
        btnReplay.addEventListener('click', () => {
          jumpToRehearsalForensics(r.rehearsal_id, r.scenario_id);
        });
        tdAct.appendChild(btnReplay);
      } else {
        tdAct.innerHTML = '<span style="font-size:7px; color:var(--text-tertiary);">&mdash;</span>';
      }

      tr.appendChild(tdScen);
      tr.appendChild(tdDis);
      tr.appendChild(tdRob);
      tr.appendChild(tdReh);
      tr.appendChild(tdSci);
      tr.appendChild(tdDel);
      tr.appendChild(tdMar);
      tr.appendChild(tdAct);

      expMatrixTableBody.appendChild(tr);
    });
  }

  function jumpToRehearsalForensics(rehearsalId, scenarioId) {
    if (!rehearsalId) return;
    expReturnContext = {
      experimentId: currentExperimentRecord ? currentExperimentRecord.experiment_id : null,
      scenarioId: scenarioId,
    };

    // Switch to Rehearsal Director tab
    switchInspectorTab('tabRehearsalDirector');

    // Show return breadcrumb banner
    if (rehExperimentBreadcrumb) {
      rehExperimentBreadcrumb.style.display = 'flex';
      rehExperimentBreadcrumb.classList.remove('hidden');
    }

    // Load historical replay
    if (typeof loadSelectedHistoricalReplay === 'function') {
      loadSelectedHistoricalReplay(rehearsalId);
    }
  }

  async function exportExperimentDossierAction(format = 'json') {
    if (!currentExperimentRecord || !currentExperimentRecord.experiment_id) {
      alert('No experiment record active. Please execute an experiment first.');
      return;
    }

    const expId = currentExperimentRecord.experiment_id;
    try {
      const resp = await fetch('/api/experiment/dossier/export', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ experiment_id: expId, format: format }),
      });

      if (!resp.ok) {
        throw new Error(`Export HTTP error ${resp.status}`);
      }

      const data = await resp.json();
      if (format === 'zip') {
        const zipUrl = `/api/experiment/${encodeURIComponent(expId)}/dossier/zip`;
        const a = document.createElement('a');
        a.href = zipUrl;
        a.download = data.filename || `${expId}_evidence_dossier.zip`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      } else {
        const jsonStr = JSON.stringify(data.dossier, null, 2);
        const blob = new Blob([jsonStr], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${expId}_dossier.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      if (expStatusLine) {
        expStatusLine.textContent = `Dossier (${format.toUpperCase()}) exported successfully.`;
      }
    } catch (err) {
      console.error('[ExperimentStudio] Export error:', err);
      alert(`Dossier export failed: ${err.message}`);
    }
  }

    function openOnboarding(step = 1) {
    if (marsOnboardingModal) {
      marsOnboardingModal.classList.remove('hidden');
      setOnboardingStep(step);
    }
  }

  function closeOnboarding(markCompleted = true) {
    if (marsOnboardingModal) {
      marsOnboardingModal.classList.add('hidden');
    }
    if (markCompleted) {
      try {
        localStorage.setItem(ONBOARDING_STORAGE_KEY, 'completed');
      } catch (e) {
        // LocalStorage quota or privacy mode error handling
      }
    }
    if (isLandingActive) {
      hideLandingPage(true);
    }
  }

  function setOnboardingStep(step) {
    const validStep = Math.max(1, Math.min(3, parseInt(step) || 1));
    currentOnboardingStep = validStep;

    if (onboardingStepLabel) {
      onboardingStepLabel.textContent = `PHASE 0${validStep} / 03`;
    }

    onboardingStepPanels.forEach(panel => {
      const pStep = parseInt(panel.dataset.step);
      if (pStep === validStep) {
        panel.classList.remove('hidden');
        panel.classList.add('active');
      } else {
        panel.classList.add('hidden');
        panel.classList.remove('active');
      }
    });

    onboardingProgressBars.forEach(bar => {
      const bStep = parseInt(bar.dataset.step);
      if (bStep <= validStep) {
        bar.classList.add('active');
      } else {
        bar.classList.remove('active');
      }
    });

    if (btnOnboardingPrev) {
      btnOnboardingPrev.disabled = (validStep === 1);
    }

    if (btnOnboardingNext && btnOnboardingFinish) {
      if (validStep === 3) {
        btnOnboardingNext.classList.add('hidden');
        btnOnboardingFinish.classList.remove('hidden');
      } else {
        btnOnboardingNext.classList.remove('hidden');
        btnOnboardingFinish.classList.add('hidden');
      }
    }
  }

  function resetOnboarding() {
    try {
      localStorage.removeItem(ONBOARDING_STORAGE_KEY);
    } catch (e) {}
    currentOnboardingStep = 1;
  }

  function handleDestinationSelect(destKey) {
    destItems.forEach(item => {
      if (item.dataset.dest === destKey) item.classList.add('active');
      else item.classList.remove('active');
    });

    if (destKey === 'jezero') {
      const place = placesById.get('iau_14300') || placesById.get('landing_perseverance');
      if (place) selectAndFocusPlace(place);
    } else if (destKey === 'olympus') {
      const place = placesById.get('iau_4453');
      if (place) selectAndFocusPlace(place);
    } else if (destKey === 'valles') {
      const place = placesById.get('iau_6288');
      if (place) selectAndFocusPlace(place);
    } else if (destKey === 'gale') {
      const place = placesById.get('iau_2071');
      if (place) selectAndFocusPlace(place);
    }
  }

  // Modal DOM
  const waypointModal = document.getElementById('waypointModal');
  const wpModalTitle = document.getElementById('wpModalTitle');
  const wpBadgeType = document.getElementById('wpBadgeType');
  const wpPriorityVal = document.getElementById('wpPriorityVal');
  const wpPriorityFill = document.getElementById('wpPriorityFill');
  const wpCoords = document.getElementById('wpCoords');
  const wpElev = document.getElementById('wpElev');
  const wpGeoContext = document.getElementById('wpGeoContext');
  const wpCrism = document.getElementById('wpCrism');
  const wpCitation = document.getElementById('wpCitation');
  const btnCloseModal = document.getElementById('btnCloseModal');
  const btnFocusWaypoint = document.getElementById('btnFocusWaypoint');

  // Convert (lat, lon) degrees to 3D Cartesian coordinates on sphere
  function latLonToSpherePos(latDeg, lonDeg, radius) {
    const phi = (90.0 - latDeg) * (Math.PI / 180.0);
    const theta = (lonDeg + 180.0) * (Math.PI / 180.0);

    const x = -radius * Math.sin(phi) * Math.cos(theta);
    const z = radius * Math.sin(phi) * Math.sin(theta);
    const y = radius * Math.cos(phi);

    return new THREE.Vector3(x, y, z);
  }

  // Convert 3D position vector on sphere back to Lat/Lon degrees
  function spherePosToLatLon(pos) {
    const norm = pos.clone().normalize();
    const latRad = Math.asin(Math.max(-1, Math.min(1, norm.y)));
    const latDeg = latRad * (180.0 / Math.PI);
    let lonDeg = Math.atan2(norm.z, -norm.x) * (180.0 / Math.PI) - 180.0;
    while (lonDeg > 180.0) lonDeg -= 360.0;
    while (lonDeg < -180.0) lonDeg += 360.0;
    return { lat: latDeg, lon: lonDeg };
  }

  // Set Loading Status
  function setStatus(msg) {
    if (loadingStatus) loadingStatus.textContent = msg;
    console.log('[MarsWalk Atlas]', msg);
  }

  // Dismiss Loading Overlay
  function dismissLoading() {
    if (loadingOverlay) {
      loadingOverlay.classList.add('hidden');
      loadingOverlay.style.display = 'none';
    }
  }

  // Set Navigation State Machine (Milestone 9D)
  function setNavigationState(newState, reason = '') {
    if (navigationState === newState) return;
    const oldState = navigationState;
    navigationState = newState;
    console.log(`[MarsWalk State] Transition: ${oldState} -> ${newState} (${reason})`);

    // Update Auto-Rotation HUD Pill
    if (btnToggleRotation && rotationBtnText) {
      if (autoRotationEnabled && navigationState === 'idle-orbit') {
        btnToggleRotation.classList.remove('paused');
        rotationBtnText.textContent = 'AUTO-ROTATE: ON';
      } else {
        btnToggleRotation.classList.add('paused');
        rotationBtnText.textContent = 'AUTO-ROTATE: OFF';
      }
    }

    if (devDiagnosticsVisible && diagMode) {
      diagMode.textContent = `${navigationState.toUpperCase()} (${currentViewMode})`;
    }

    // Refresh dynamic labels immediately on state change
    if (currentViewMode === 'orbit') {
      updateMapLabels();
    }
  }

  // 1. Load Authentic Mission Data
  async function loadMissionData() {
    setStatus('FETCHING AUTHENTIC JEZERO MISSION DATA...');
    try {
      const resp = await fetch('data/jezero_mission_data.json');
      if (!resp.ok) throw new Error(`HTTP ${resp.status} loading mission data`);
      missionData = await resp.json();
      console.log('[MarsWalk Atlas] Mission data loaded successfully:', missionData);
      if (countAllWaypoints && missionData.waypoints) {
        countAllWaypoints.textContent = missionData.waypoints.length;
      }
      populateWaypointDropdown();
      populateAddStopDropdown();
      renderActiveStopsList();
      updateTerrainLegend(currentTerrainTexture);
      updateRouteTelemetry(currentProfile);
      return missionData;
    } catch (err) {
      console.error('[MarsWalk Atlas] Failed to load mission data:', err);
      setStatus('ERROR LOADING MISSION ASSETS. CHECK CONSOLE.');
      throw err;
    }
  }

  // 1b. Load Official USGS/IAU & Landing Site Place Catalog
  async function loadPlaceCatalog() {
    setStatus('INGESTING USGS GAZETTEER & MISSION SITES (2,000+ RECORDS)...');
    try {
      const resp = await fetch('data/mars_places.json');
      if (!resp.ok) throw new Error(`HTTP ${resp.status} loading place catalog`);
      placeCatalog = await resp.json();
      console.log(`[MarsWalk Atlas] Ingested ${placeCatalog.places.length} authoritative places.`);

      // Precompute 3D vectors for rapid frame evaluation
      placeCatalog.places.forEach(p => {
        placesById.set(p.id, p);
        p.pos3D = latLonToSpherePos(p.lat_deg, p.lon_deg, GLOBE_RADIUS);
        p.unitDir = p.pos3D.clone().normalize();
      });

      populateFeaturedDropdown();
      initLabelsPool();
      return placeCatalog;
    } catch (err) {
      console.error('[MarsWalk Atlas] Failed to load place catalog:', err);
    }
  }

  // Populate Featured Destinations Dropdown
  function populateFeaturedDropdown() {
    if (!featuredSelect || !placeCatalog) return;
    featuredSelect.innerHTML = '<option value="">&bull; FEATURED DESTINATIONS &bull;</option>';

    placeCatalog.featured_destinations.forEach(fid => {
      const p = placesById.get(fid);
      if (p) {
        const opt = document.createElement('option');
        opt.value = p.id;
        const prefix = p.is_landing_site ? '🚀 ' : '🪐 ';
        opt.textContent = `${prefix}${p.name} (${p.category.toUpperCase()})`;
        featuredSelect.appendChild(opt);
      }
    });
  }

  // 1c. Load Verified Planetary Imagery Coverage Registry
  async function loadImageryRegistry() {
    setStatus('INGESTING PLANETARY IMAGERY REGISTRY...');
    try {
      const resp = await fetch('data/mars_imagery_registry.json');
      if (!resp.ok) throw new Error(`HTTP ${resp.status} loading imagery registry`);
      imageryRegistry = await resp.json();
      console.log(`[MarsWalk Atlas] Ingested ${imageryRegistry.products.length} verified imagery products.`);
      if (imageryRegistry.products) {
        imageryRegistry.products.forEach(p => {
          imageryProductsById.set(p.id, p);
        });
      }
      return imageryRegistry;
    } catch (err) {
      console.warn('[MarsWalk Atlas] Could not load imagery registry, using defaults:', err);
    }
  }

  // Find Highest-Resolution Verified Imagery Product for Coordinates
  function findBestImageryForLocation(lonDeg, latDeg) {
    if (!imageryRegistry || !imageryRegistry.products) {
      return {
        id: 'mars_viking_mdim21_global',
        title: 'USGS Viking MDIM 2.1 Color',
        nominal_resolution_m: 232.0,
        has_elevation_data: false,
        layer_type: 'global_basemap'
      };
    }

    // Normalize lon to [-180, 180]
    const nLon = ((lonDeg + 180.0) % 360.0 + 360.0) % 360.0 - 180.0;

    const candidates = imageryRegistry.products.filter(p => {
      const b = p.bounds;
      if (latDeg >= b.min_lat_deg && latDeg <= b.max_lat_deg) {
        if (b.min_lon_deg <= b.max_lon_deg) {
          return nLon >= b.min_lon_deg && nLon <= b.max_lon_deg;
        } else {
          return nLon >= b.min_lon_deg || nLon <= b.max_lon_deg;
        }
      }
      return false;
    });

    if (candidates.length === 0) {
      return imageryProductsById.get('mars_viking_mdim21_global') || imageryRegistry.products[0];
    }

    // Sort: local_mesh_ortho > regional_mosaic > global_basemap, then by resolution (smaller m/px is better)
    candidates.sort((a, b) => {
      const scoreType = (t) => t === 'local_mesh_ortho' ? 0 : (t === 'regional_mosaic' ? 1 : 2);
      const diffType = scoreType(a.layer_type) - scoreType(b.layer_type);
      if (diffType !== 0) return diffType;
      return a.nominal_resolution_m - b.nominal_resolution_m;
    });

    return candidates[0];
  }

  // Build Curved Conformal Spherical Patch Mesh for Regional Imagery
  function createRegionalCurvedPatch(product, texture) {
    const b = product.texture_bounds || product.bounds;
    const minLon = b.min_lon_deg;
    const maxLon = b.max_lon_deg;
    const minLat = b.min_lat_deg;
    const maxLat = b.max_lat_deg;

    const segsX = 32;
    const segsY = 32;
    const numVerts = (segsX + 1) * (segsY + 1);
    const positions = new Float32Array(numVerts * 3);
    const uvs = new Float32Array(numVerts * 2);
    const indices = new Uint32Array(segsX * segsY * 6);

    let vIdx = 0;
    for (let y = 0; y <= segsY; y++) {
      const v = y / segsY;
      const lat = maxLat - v * (maxLat - minLat);
      for (let x = 0; x <= segsX; x++) {
        const u = x / segsX;
        const lon = minLon + u * (maxLon - minLon);
        const pos = latLonToSpherePos(lat, lon, GLOBE_RADIUS + 1.2);
        positions[vIdx * 3] = pos.x;
        positions[vIdx * 3 + 1] = pos.y;
        positions[vIdx * 3 + 2] = pos.z;
        uvs[vIdx * 2] = u;
        uvs[vIdx * 2 + 1] = 1.0 - v;
        vIdx++;
      }
    }

    let ptr = 0;
    for (let y = 0; y < segsY; y++) {
      for (let x = 0; x < segsX; x++) {
        const i0 = y * (segsX + 1) + x;
        const i1 = y * (segsX + 1) + (x + 1);
        const i2 = (y + 1) * (segsX + 1) + x;
        const i3 = (y + 1) * (segsX + 1) + (x + 1);
        indices[ptr++] = i0;
        indices[ptr++] = i2;
        indices[ptr++] = i1;
        indices[ptr++] = i1;
        indices[ptr++] = i2;
        indices[ptr++] = i3;
      }
    }

    const geom = new THREE.BufferGeometry();
    geom.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geom.setAttribute('uv', new THREE.BufferAttribute(uvs, 2));
    geom.setIndex(new THREE.BufferAttribute(indices, 1));
    geom.computeVertexNormals();

    const mat = new THREE.MeshStandardMaterial({
      map: texture,
      roughness: 0.88,
      metalness: 0.05,
      transparent: true,
      opacity: 0.95
    });

    const mesh = new THREE.Mesh(geom, mat);
    mesh.name = `regional_patch_${product.id}`;
    return mesh;
  }

  // Progressive Refinement: Fetch High-Resolution Detail Tile via Safe Local Cache
  function triggerProgressiveRefinement(product, token) {
    if (!product || !product.wmts_tile_template) return;

    // Lookup level 7 center tile coordinates for featured regional mosaics
    const refinementTiles = {
      'olympus_mons_ctx_regional': { z: 7, r: 50, c: 33 },
      'valles_marineris_ctx_regional': { z: 7, r: 77, c: 92 },
      'gale_crater_ctx_regional': { z: 7, r: 67, c: 226 },
      'jezero_ctx_regional_context': { z: 7, r: 50, c: 183 }
    };

    const tileInfo = refinementTiles[product.id];
    if (!tileInfo) return;

    const tileUrl = `/api/imagery/tile?product_id=${encodeURIComponent(product.id)}&z=${tileInfo.z}&r=${tileInfo.r}&c=${tileInfo.c}`;
    const refinedCacheKey = `${product.id}_z${tileInfo.z}_refined`;

    if (regionalTextureCache.has(refinedCacheKey)) {
      if (token !== overlayLoadToken || !activeRegionalOverlayMesh) return;
      if (diagCacheStatus) diagCacheStatus.textContent = 'REFINED (CACHE HIT 0 ms)';
      return;
    }

    const refineStart = performance.now();
    const loader = new THREE.TextureLoader();
    loader.load(
      tileUrl,
      (refinedTex) => {
        if (token !== overlayLoadToken || !activeRegionalOverlayMesh) {
          refinedTex.dispose();
          return;
        }
        refinedTex.generateMipmaps = true;
        refinedTex.minFilter = THREE.LinearMipmapLinearFilter;
        regionalTextureCache.set(refinedCacheKey, refinedTex);
        const latMs = (performance.now() - refineStart).toFixed(0);
        if (diagCacheStatus) diagCacheStatus.textContent = `REFINED (${latMs} ms)`;
        console.log(`[MarsWalk Atlas] Progressive refinement active: ${product.id} (Z=${tileInfo.z}, ${latMs} ms)`);
      },
      undefined,
      (err) => {
        // Safe graceful degradation: local preview texture remains displayed
        console.log(`[MarsWalk Atlas] Progressive refinement offline fallback for ${product.id}`);
      }
    );
  }

  // Load Regional Imagery Overlay with Caching, Fast Local Preview, and Progressive Refinement
  function loadRegionalImageryOverlay(product, onLoaded = null) {
    if (!product || !marsGlobeGroup) {
      if (onLoaded) onLoaded();
      return;
    }

    if (activeRegionalProduct && activeRegionalProduct.id === product.id && activeRegionalOverlayMesh) {
      if (diagCacheStatus) diagCacheStatus.textContent = 'HIT (0 ms)';
      if (onLoaded) onLoaded();
      return;
    }

    clearRegionalOverlay();
    const thisToken = ++overlayLoadToken;

    // Check Memory Cache
    if (regionalTextureCache.has(product.id)) {
      const tex = regionalTextureCache.get(product.id);
      if (diagCacheStatus) diagCacheStatus.textContent = 'HIT (0 ms)';
      activeRegionalOverlayMesh = createRegionalCurvedPatch(product, tex);
      marsGlobeGroup.add(activeRegionalOverlayMesh);
      activeRegionalProduct = product;
      if (onLoaded) onLoaded();
      triggerProgressiveRefinement(product, thisToken);
      return;
    }

    const assetUrl = product.local_asset_path || product.wmts_tile_template;
    if (!assetUrl) {
      if (diagCacheStatus) diagCacheStatus.textContent = 'NO_OVERLAY';
      if (onLoaded) onLoaded();
      return;
    }

    const startTime = performance.now();
    const loader = new THREE.TextureLoader();
    loader.load(
      assetUrl,
      (tex) => {
        if (thisToken !== overlayLoadToken) {
          tex.dispose();
          return;
        }
        tex.generateMipmaps = true;
        tex.minFilter = THREE.LinearMipmapLinearFilter;
        regionalTextureCache.set(product.id, tex);
        const latMs = (performance.now() - startTime).toFixed(0);
        if (diagCacheStatus) diagCacheStatus.textContent = `PREVIEW (${latMs} ms)`;
        activeRegionalOverlayMesh = createRegionalCurvedPatch(product, tex);
        marsGlobeGroup.add(activeRegionalOverlayMesh);
        activeRegionalProduct = product;
        console.log(`[MarsWalk Atlas] Regional preview overlay loaded: ${product.id} (${latMs} ms)`);
        if (onLoaded) onLoaded();
        triggerProgressiveRefinement(product, thisToken);
      },
      undefined,
      (err) => {
        if (thisToken !== overlayLoadToken) return;
        console.warn(`[MarsWalk Atlas] Failed to load regional texture for ${product.id}:`, err);
        if (diagCacheStatus) diagCacheStatus.textContent = 'ERR (FALLBACK)';
        activeRegionalProduct = null;
        if (onLoaded) onLoaded();
      }
    );
  }

  // Clear Active Regional Overlay
  function clearRegionalOverlay() {
    overlayLoadToken++;
    if (activeRegionalOverlayMesh && marsGlobeGroup) {
      marsGlobeGroup.remove(activeRegionalOverlayMesh);
      if (activeRegionalOverlayMesh.geometry) activeRegionalOverlayMesh.geometry.dispose();
      if (activeRegionalOverlayMesh.material) activeRegionalOverlayMesh.material.dispose();
      activeRegionalOverlayMesh = null;
    }
    activeRegionalProduct = null;
  }

  // Update Dynamic Terrain Layer Legend Widget
  function updateTerrainLegend(textureMode) {
    if (!terrainLegend || !legendTitle || !legendContent) return;
    if (currentViewMode !== 'jezero') {
      terrainLegend.classList.add('hidden');
      return;
    }
    terrainLegend.classList.remove('hidden');
    if (textureMode === 'hypsometric') {
      legendTitle.innerHTML = '&#9670; Elevation Topography (Hypsometric)';
      legendContent.innerHTML = `
        <div class="legend-bar-container">
          <div class="legend-gradient-bar hypsometric"></div>
          <div class="legend-ticks">
            <span>-2,624 m (Floor)</span>
            <span>-2,534 m</span>
            <span>-2,445 m (Plateau)</span>
          </div>
          <div style="font-size: 8.5px; color: var(--text-tertiary); margin-top: 2px;">
            Datum: IAU Mars 2000 Sphere / MOLA DeltaGeoid &bull; Relief: 179 m
          </div>
        </div>
      `;
    } else if (textureMode === 'slope') {
      legendTitle.innerHTML = '&#9670; Tactical Slope Hazard Overlay';
      legendContent.innerHTML = `
        <div class="legend-slope-grid">
          <div class="legend-slope-item">
            <span class="legend-color-dot" style="background:#2E7D32;"></span>
            <span>Safe (&lt; 8&deg;)</span>
          </div>
          <div class="legend-slope-item">
            <span class="legend-color-dot" style="background:#FBC02D;"></span>
            <span>Caution (8&ndash;15&deg;)</span>
          </div>
          <div class="legend-slope-item">
            <span class="legend-color-dot" style="background:#D50000;"></span>
            <span>Hazard (&gt; 15&deg;)</span>
          </div>
        </div>
        <div style="font-size: 8.5px; color: var(--text-tertiary); margin-top: 4px;">
          Calculated from 20 m CTX gradient &bull; Traverses avoid slopes &gt;15&deg;
        </div>
      `;
    } else {
      legendTitle.innerHTML = '&#9670; USGS CTX 6 m Ortho Imagery';
      legendContent.innerHTML = `
        <div style="font-size: 9px; color: var(--text-secondary); line-height: 1.35;">
          NASA MRO CTX calibrated visible orthomosaic draped over 20 m CTX terrain mesh.
          <div style="font-size: 8.5px; color: var(--text-tertiary); margin-top: 2px;">
            Resolution: 6.0 m/pixel &bull; Ground footprint: 5.0 &times; 5.0 km
          </div>
        </div>
      `;
    }
  }

  // Set Terrain Layer Texture Mode (Synchronizes 3D Mesh, Controls, Legend & Telemetry)
  function setTerrainTexture(mode) {
    currentTerrainTexture = mode;
    terrainTexturePills.forEach(p => {
      if (p.dataset.texture === mode) p.classList.add('active');
      else p.classList.remove('active');
    });
    buildTerrainMesh(currentExaggeration, currentTerrainTexture);
    updateTerrainLegend(currentTerrainTexture);
    if (currentViewMode === 'jezero') {
      updateImageryAndElevationTelemetry(JEZERO_LON, JEZERO_LAT);
    }
  }

  // Update Imagery and Elevation Telemetry Badges Across Viewports
  function updateImageryAndElevationTelemetry(lonDeg, latDeg) {
    const prod = findBestImageryForLocation(lonDeg, latDeg);
    currentActiveImageryProduct = prod;

    // Telemetry strip items
    if (telemetryLayer) {
      if (currentViewMode === 'jezero') {
        if (currentTerrainTexture === 'hypsometric') {
          telemetryLayer.textContent = 'Elevation (Hypsometric)';
        } else if (currentTerrainTexture === 'slope') {
          telemetryLayer.textContent = 'Terrain Slope Hazard';
        } else {
          telemetryLayer.textContent = 'USGS CTX 6 m Ortho';
        }
      } else if (prod.layer_type === 'regional_mosaic') {
        telemetryLayer.textContent = `MRO CTX Regional (${prod.nominal_resolution_m.toFixed(0)} m/px)`;
      } else if (prod.layer_type === 'local_mesh_ortho') {
        telemetryLayer.textContent = 'USGS CTX 6 m Ortho';
      } else {
        const isMola = activeLayer === 'usgs_mola';
        telemetryLayer.textContent = isMola ? 'MGS MOLA (463 m/px)' : 'Viking MDIM (232 m/px)';
      }
    }

    if (telemetryElevStatus) {
      if (currentViewMode === 'jezero') {
        if (currentTerrainTexture === 'hypsometric') {
          telemetryElevStatus.textContent = '20 m CTX DTM (-2624 to -2445 m)';
        } else if (currentTerrainTexture === 'slope') {
          telemetryElevStatus.textContent = 'Slope Angles (0°–25°+)';
        } else {
          telemetryElevStatus.textContent = '20 m CTX DTM (Active)';
        }
      } else if (prod.has_elevation_data && prod.planning_supported) {
        telemetryElevStatus.textContent = `${prod.elevation_resolution_m.toFixed(0)} m CTX DTM`;
      } else if (prod.layer_type === 'regional_mosaic') {
        telemetryElevStatus.textContent = 'Global Datum Only';
      } else {
        telemetryElevStatus.textContent = 'Global Datum (MOLA)';
      }
    }

    // Diagnostics panel
    if (diagActiveLayer) {
      if (currentViewMode === 'jezero') {
        if (currentTerrainTexture === 'hypsometric') {
          diagActiveLayer.textContent = 'jezero_elevation_hypsometric';
        } else if (currentTerrainTexture === 'slope') {
          diagActiveLayer.textContent = 'jezero_slope_hazard';
        } else {
          diagActiveLayer.textContent = 'jezero_ctx_local_mesh';
        }
      } else if (prod.layer_type === 'regional_mosaic') {
        diagActiveLayer.textContent = prod.id;
      } else {
        diagActiveLayer.textContent = activeLayer === 'usgs_mola' ? 'mars_mola_shade_global' : 'mars_viking_mdim21_global';
      }
    }
    if (diagNominalRes) {
      if (currentViewMode === 'jezero') {
        if (currentTerrainTexture === 'hypsometric') {
          diagNominalRes.textContent = '20.0 m/px DTM (Hypsometric)';
        } else if (currentTerrainTexture === 'slope') {
          diagNominalRes.textContent = '20.0 m/px DTM (Slope Hazard)';
        } else {
          diagNominalRes.textContent = '6.0 m/px (4.88 m/px tex)';
        }
      } else if (prod.layer_type === 'regional_mosaic') {
        diagNominalRes.textContent = `${prod.nominal_resolution_m.toFixed(0)} m/px`;
      } else if (prod.layer_type === 'local_mesh_ortho') {
        diagNominalRes.textContent = '6.0 m/px';
      } else {
        diagNominalRes.textContent = activeLayer === 'usgs_mola' ? '463 m/px' : '232 m/px';
      }
    }

    // Location dossier card tags
    if (locCardImagery) {
      if (prod.layer_type === 'local_mesh_ortho') {
        locCardImagery.textContent = 'IMAGERY: USGS CTX (6.0 m NATIVE)';
      } else if (prod.layer_type === 'regional_mosaic') {
        const nativeRes = prod.native_sensor_resolution_m || 6.0;
        locCardImagery.textContent = `IMAGERY: MRO CTX (${nativeRes.toFixed(0)} m NATIVE)`;
      } else {
        locCardImagery.textContent = 'IMAGERY: VIKING MDIM 2.1 (232 m/px)';
      }
    }

    if (locCardElevation) {
      if (prod.has_elevation_data && prod.planning_supported) {
        locCardElevation.textContent = `ELEVATION: ${prod.elevation_resolution_m.toFixed(0)} m CTX DTM (PLANNING READY)`;
        locCardElevation.classList.add('available');
      } else if (prod.layer_type === 'regional_mosaic') {
        locCardElevation.textContent = 'ELEVATION: GLOBAL DATUM ONLY (MOLA 463m)';
        locCardElevation.classList.remove('available');
      } else {
        locCardElevation.textContent = 'ELEVATION: GLOBAL DATUM (NO HIGH-RES DTM)';
        locCardElevation.classList.remove('available');
      }
    }

    // Scientific Disclosures (Honest provenance, resolution, and color interpretations)
    if (locCardDisclosures) {
      if (prod.layer_type === 'local_mesh_ortho') {
        if (locCardSamplingDisclosure) locCardSamplingDisclosure.textContent = `◈ Display Sampling: 4.88 m/px DTM Ortho Mesh`;
        if (locCardContrastDisclosure) locCardContrastDisclosure.textContent = `◈ Visual: Calibrated radiometric reflectance`;
        if (locCardPlanningDisclosure) {
          locCardPlanningDisclosure.textContent = `◈ Traverse Planning: Active (A* Pathfinding & Slope Hazards)`;
          locCardPlanningDisclosure.style.color = 'var(--accent-coral)';
        }
      } else if (prod.layer_type === 'regional_mosaic') {
        const sampling = prod.display_sampling_m || 651;
        if (locCardSamplingDisclosure) locCardSamplingDisclosure.textContent = `◈ Display Sampling: ~${sampling.toFixed(0)} m/px (Level 6 Tile Grid)`;
        if (locCardContrastDisclosure) locCardContrastDisclosure.textContent = `◈ Visual: Synthetic contrast enhancement over monochrome CTX`;
        if (locCardPlanningDisclosure) {
          locCardPlanningDisclosure.textContent = `◈ Traverse Planning: Restricted to surveyed Jezero 20 m DTM`;
          locCardPlanningDisclosure.style.color = 'var(--text-tertiary)';
        }
      } else {
        const res = prod.nominal_resolution_m || 232;
        if (locCardSamplingDisclosure) locCardSamplingDisclosure.textContent = `◈ Display Sampling: ${res.toFixed(0)} m/px Global Basemap`;
        if (locCardContrastDisclosure) locCardContrastDisclosure.textContent = `◈ Visual: Viking Orbiter multi-spectral composite`;
        if (locCardPlanningDisclosure) {
          locCardPlanningDisclosure.textContent = `◈ Traverse Planning: Restricted to surveyed Jezero 20 m DTM`;
          locCardPlanningDisclosure.style.color = 'var(--text-tertiary)';
        }
      }
    }
  }

  // 2. Initialize 3D Engine
  function init3DEngine() {
    setStatus('INITIALIZING PLANETARY 3D WORKSTATION...');
    const width = window.innerWidth;
    const height = window.innerHeight;

    // Viewport Display Setup
    if (cesiumContainer) cesiumContainer.style.display = 'none';
    viewport3d.style.display = 'block';

    // Scene & Camera
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x06080D);

    camera = new THREE.PerspectiveCamera(45, width / height, 1, 50000);
    camera.position.set(0, 800, 2600);

    // Renderer
    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    viewport3d.appendChild(renderer.domElement);

    // Controls
    controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.06;
    controls.minDistance = 200;
    controls.maxDistance = 10000;
    controls.target.set(0, 0, 0);

    // OrbitControls user interaction hooks
    controls.addEventListener('start', () => {
      if (navigationState !== 'camera-flight' && navigationState !== 'jezero-workstation') {
        setNavigationState('user-interacting', 'orbit controls drag start');
      }
    });

    controls.addEventListener('end', () => {
      if (navigationState === 'user-interacting' && currentViewMode === 'orbit') {
        const alt = camera.position.length() - GLOBE_RADIUS;
        if (alt < 1500) {
          setNavigationState('regional-exploration', 'zoomed in regional inspection');
        }
      }
    });

    // Raycaster for Waypoint Interaction
    raycaster = new THREE.Raycaster();
    mouse = new THREE.Vector2();

    // Lighting
    const ambientLight = new THREE.AmbientLight(0x404856, 1.4);
    scene.add(ambientLight);

    const sunLight = new THREE.DirectionalLight(0xFFE5D0, 2.0);
    sunLight.position.set(4000, 3000, 4000);
    scene.add(sunLight);

    // Build Deep Space Starfield
    buildStarfield();

    // Build 3D Mars Globe
    buildMarsGlobe();

    // Build Jezero High-Res Surface Mesh Workstation
    buildJezeroSurfaceWorkstation();

    // Events
    window.addEventListener('resize', onWindowResize);
    window.addEventListener('click', onCanvasClick);

    // Start in Orbit View
    setOrbitView(false);

    // Start Render Loop
    animate();

    setStatus('MARSWALK 2.0 ATLAS READY.');
    dismissLoading();
  }

  // Build Deep Space Starfield
  function buildStarfield() {
    const starCount = 2500;
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(starCount * 3);
    const colors = new Float32Array(starCount * 3);

    for (let i = 0; i < starCount; i++) {
      const radius = 25000 + Math.random() * 15000;
      const theta = 2 * Math.PI * Math.random();
      const phi = Math.acos(2 * Math.random() - 1);

      positions[i * 3] = radius * Math.sin(phi) * Math.cos(theta);
      positions[i * 3 + 1] = radius * Math.sin(phi) * Math.sin(theta);
      positions[i * 3 + 2] = radius * Math.cos(phi);

      const intensity = 0.6 + Math.random() * 0.4;
      colors[i * 3] = intensity;
      colors[i * 3 + 1] = intensity;
      colors[i * 3 + 2] = intensity;
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const material = new THREE.PointsMaterial({
      size: 2,
      vertexColors: true,
      transparent: true,
      opacity: 0.8
    });

    starfield = new THREE.Points(geometry, material);
    scene.add(starfield);
  }

  // Build 3D Mars Globe
  function buildMarsGlobe() {
    marsGlobeGroup = new THREE.Group();

    // Sphere Geometry
    const sphereGeometry = new THREE.SphereGeometry(GLOBE_RADIUS, 64, 64);

    // Texture Loader
    const textureLoader = new THREE.TextureLoader();
    const texture = textureLoader.load('assets/mars_viking_color_fallback.jpg', function () {
      console.log('[MarsWalk Atlas] Mars global basemap texture loaded.');
    });

    const sphereMaterial = new THREE.MeshStandardMaterial({
      map: texture,
      roughness: 0.88,
      metalness: 0.05
    });

    marsSphereMesh = new THREE.Mesh(sphereGeometry, sphereMaterial);
    marsGlobeGroup.add(marsSphereMesh);

    // Subtle Atmospheric Glow Shell
    const atmoGeom = new THREE.SphereGeometry(GLOBE_RADIUS * 1.015, 64, 64);
    const atmoMat = new THREE.MeshBasicMaterial({
      color: 0xFF7043,
      transparent: true,
      opacity: 0.12,
      side: THREE.BackSide
    });
    atmosphereMesh = new THREE.Mesh(atmoGeom, atmoMat);
    marsGlobeGroup.add(atmosphereMesh);

    // Jezero Crater Location Marker on Globe
    const jezeroPos = latLonToSpherePos(JEZERO_LAT, JEZERO_LON, GLOBE_RADIUS + 2);
    jezeroTargetMarker = new THREE.Group();
    jezeroTargetMarker.position.copy(jezeroPos);

    // Target Ring
    const ringGeom = new THREE.RingGeometry(15, 22, 32);
    const ringMat = new THREE.MeshBasicMaterial({
      color: 0xFFB300,
      side: THREE.DoubleSide,
      transparent: true,
      opacity: 0.9
    });
    const ringMesh = new THREE.Mesh(ringGeom, ringMat);
    ringMesh.lookAt(jezeroPos.clone().multiplyScalar(2));
    jezeroTargetMarker.add(ringMesh);

    // Beacon Core
    const coreGeom = new THREE.SphereGeometry(7, 16, 16);
    const coreMat = new THREE.MeshBasicMaterial({ color: 0x00E5FF });
    const coreMesh = new THREE.Mesh(coreGeom, coreMat);
    jezeroTargetMarker.add(coreMesh);

    marsGlobeGroup.add(jezeroTargetMarker);
    scene.add(marsGlobeGroup);
  }

  // 3. Build Jezero High-Res Surface Mesh Workstation
  function buildJezeroSurfaceWorkstation() {
    if (!missionData) return;

    jezeroSurfaceGroup = new THREE.Group();
    jezeroSurfaceGroup.visible = false; // Initially hidden in orbit view

    // Build 250x250 Terrain Mesh with authentic CTX optical imagery
    buildTerrainMesh(currentExaggeration, currentTerrainTexture);

    // Build Study Area Boundary
    buildStudyAreaBoundary();

    // Build Waypoints
    buildWaypointBeacons();

    // Build Route Polyline
    updateRoutePolyline(currentProfile);

    // Build Start & Goal 3D Pins
    updatePlanningMarkers();

    // Initialize 2D Screen-Aligned Waypoint Labels
    initJezeroLabels();

    scene.add(jezeroSurfaceGroup);
  }

  // Build Terrain Mesh from Real Elevation Samples & Authentic CTX Orthomosaic
  function buildTerrainMesh(exaggeration, textureMode = currentTerrainTexture) {
    if (isNaN(exaggeration) || exaggeration <= 0) {
      exaggeration = (isNaN(currentExaggeration) || currentExaggeration <= 0) ? 1.0 : currentExaggeration;
    }
    if (terrainMesh) {
      jezeroSurfaceGroup.remove(terrainMesh);
      terrainMesh.geometry.dispose();
      if (Array.isArray(terrainMesh.material)) {
        terrainMesh.material.forEach(m => m.dispose());
      } else if (terrainMesh.material) {
        terrainMesh.material.dispose();
      }
    }

    const rows = missionData.grid.rows; // 250
    const cols = missionData.grid.cols; // 250
    const dx = missionData.grid.ground_dx_m; // ~18.973 m
    const dy = missionData.grid.ground_dy_m; // 20.000 m
    const minElev = missionData.grid.elevation_min_m; // -2623.8 m
    const maxElev = missionData.grid.elevation_max_m; // -2445.0 m
    const elevRange = maxElev - minElev || 1.0;

    const totalW = (cols - 1) * dx;
    const totalH = (rows - 1) * dy;
    const halfW = totalW / 2.0;
    const halfH = totalH / 2.0;

    const numVerts = rows * cols;
    const positions = new Float32Array(numVerts * 3);
    const colors = new Float32Array(numVerts * 3);
    const uvs = new Float32Array(numVerts * 2);

    // Color gradient for hypsometric topography relief
    const colFloor = new THREE.Color(0x281C16);
    const colMid = new THREE.Color(0x8D3B1B);
    const colScarp = new THREE.Color(0xD97232);
    const colPlateau = new THREE.Color(0xE89858);

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const idx = r * cols + c;
        const elev = missionData.elevation_samples[r][c];
        const slope = missionData.slope_samples[r][c];

        // Metric positions centered at (0, 0, 0)
        const x = c * dx - halfW;
        const z = r * dy - halfH;
        const y = (elev > -9000) ? (elev - minElev) * exaggeration : 0;

        positions[idx * 3] = x;
        positions[idx * 3 + 1] = y;
        positions[idx * 3 + 2] = z;

        // Georeferenced UV coordinates mapping 1:1 to authentic CTX orthomosaic crop
        // r = 0 is North (top of texture, v = 1.0), c = 0 is West (left of texture, u = 0.0)
        uvs[idx * 2] = c / (cols - 1);
        uvs[idx * 2 + 1] = 1.0 - (r / (rows - 1));

        // Vertex coloring based on texture mode
        const norm = Math.max(0, Math.min(1, (elev - minElev) / elevRange));
        const color = new THREE.Color();

        if (textureMode === 'slope') {
          // Tactical Slope Hazard Mode: green (<8 deg) -> yellow (8-15 deg) -> red/orange (>15 deg scarp)
          if (slope < 8.0) {
            color.setHex(0x2E7D32).lerp(new THREE.Color(0xFBC02D), slope / 8.0);
          } else if (slope <= 15.0) {
            color.setHex(0xFBC02D).lerp(new THREE.Color(0xF57C00), (slope - 8.0) / 7.0);
          } else {
            color.setHex(0xD50000).lerp(new THREE.Color(0xFF1744), Math.min(1.0, (slope - 15.0) / 10.0));
          }
        } else if (textureMode === 'hypsometric') {
          // Topography Hypsometric Relief Mode
          if (norm < 0.35) {
            color.copy(colFloor).lerp(colMid, norm / 0.35);
          } else if (norm < 0.75) {
            color.copy(colMid).lerp(colScarp, (norm - 0.35) / 0.40);
          } else {
            color.copy(colScarp).lerp(colPlateau, (norm - 0.75) / 0.25);
          }
        } else {
          // CTX Optical Mode: pure white vertex baseline so full texture fidelity shows
          color.setRGB(1.0, 1.0, 1.0);
        }

        colors[idx * 3] = color.r;
        colors[idx * 3 + 1] = color.g;
        colors[idx * 3 + 2] = color.b;
      }
    }

    // Triangle Indices
    const numIndices = (rows - 1) * (cols - 1) * 6;
    const indices = new Uint32Array(numIndices);
    let ptr = 0;

    for (let r = 0; r < rows - 1; r++) {
      for (let c = 0; c < cols - 1; c++) {
        const i0 = r * cols + c;
        const i1 = r * cols + (c + 1);
        const i2 = (r + 1) * cols + c;
        const i3 = (r + 1) * cols + (c + 1);

        indices[ptr++] = i0;
        indices[ptr++] = i2;
        indices[ptr++] = i1;

        indices[ptr++] = i1;
        indices[ptr++] = i2;
        indices[ptr++] = i3;
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    geometry.setAttribute('uv', new THREE.BufferAttribute(uvs, 2));
    geometry.setIndex(new THREE.BufferAttribute(indices, 1));
    geometry.computeVertexNormals();

    // Material setup: draped authentic CTX orthomosaic or procedural shader
    let material;
    if (textureMode === 'ctx') {
      if (!jezeroCtxTexture) {
        const loader = new THREE.TextureLoader();
        jezeroCtxTexture = loader.load('assets/jezero_ctx_orthomosaic.jpg', () => {
          console.log('[MarsWalk Atlas] Authentic Jezero CTX orthomosaic texture loaded.');
          if (renderer && scene) renderer.render(scene, camera);
        });
        jezeroCtxTexture.wrapS = THREE.ClampToEdgeWrapping;
        jezeroCtxTexture.wrapT = THREE.ClampToEdgeWrapping;
        jezeroCtxTexture.generateMipmaps = true;
        jezeroCtxTexture.minFilter = THREE.LinearMipmapLinearFilter;
      }

      material = new THREE.MeshStandardMaterial({
        map: jezeroCtxTexture,
        roughness: 0.82,
        metalness: 0.08,
        vertexColors: false
      });
    } else {
      material = new THREE.MeshStandardMaterial({
        vertexColors: true,
        roughness: 0.85,
        metalness: 0.1
      });
    }

    terrainMesh = new THREE.Mesh(geometry, material);
    terrainMesh.receiveShadow = true;
    terrainMesh.castShadow = true;
    jezeroSurfaceGroup.add(terrainMesh);
  }

  // Convert (row, col) to Local Metric Position in Surface Workstation
  function rcToLocalPos(r, c, elev, exaggeration) {
    const dx = missionData.grid.ground_dx_m;
    const dy = missionData.grid.ground_dy_m;
    const minElev = missionData.grid.elevation_min_m;
    const totalW = (missionData.grid.cols - 1) * dx;
    const totalH = (missionData.grid.rows - 1) * dy;

    const x = c * dx - (totalW / 2.0);
    const z = r * dy - (totalH / 2.0);
    const safeElev = (elev !== undefined && !isNaN(elev) && elev > -9000) ? elev : minElev;
    const safeExag = (isNaN(exaggeration) || exaggeration <= 0) ? 1.0 : exaggeration;
    const y = ((safeElev - minElev) * safeExag) + 6.0;
    return new THREE.Vector3(x, y, z);
  }

  // Build Study Area Boundary Box (5.0 km x 5.0 km)
  function buildStudyAreaBoundary() {
    if (boundaryLineMesh) jezeroSurfaceGroup.remove(boundaryLineMesh);

    const dx = missionData.grid.ground_dx_m;
    const dy = missionData.grid.ground_dy_m;
    const halfW = ((missionData.grid.cols - 1) * dx) / 2.0;
    const halfH = ((missionData.grid.rows - 1) * dy) / 2.0;
    const y = 25.0;

    const points = [
      new THREE.Vector3(-halfW, y, -halfH),
      new THREE.Vector3(halfW, y, -halfH),
      new THREE.Vector3(halfW, y, halfH),
      new THREE.Vector3(-halfW, y, halfH),
      new THREE.Vector3(-halfW, y, -halfH),
    ];

    const geom = new THREE.BufferGeometry().setFromPoints(points);
    const mat = new THREE.LineBasicMaterial({ color: 0xFFB300, linewidth: 2 });
    boundaryLineMesh = new THREE.Line(geom, mat);
    jezeroSurfaceGroup.add(boundaryLineMesh);
  }

  // Build Waypoint Beacons in Surface Workstation
  function buildWaypointBeacons() {
    waypointBeacons.forEach(b => {
      if (b.parent) jezeroSurfaceGroup.remove(b.parent);
      else jezeroSurfaceGroup.remove(b);
    });
    waypointBeacons = [];

    const showAll = (waypointVisibilityMode === 'all');
    if (!missionData || !missionData.waypoints) return;

    missionData.waypoints.forEach(wp => {
      const isStart = customStart && (wp.row === customStart.row && wp.col === customStart.col);
      const isGoal = customGoal && (wp.row === customGoal.row && wp.col === customGoal.col);
      const isStop = activeIntermediateStops && activeIntermediateStops.some(s => s.id === wp.id || (s.row === wp.row && s.col === wp.col));
      const isMissionParticipant = Boolean(isStart || isGoal || isStop);

      if (!showAll && !isMissionParticipant) {
        return;
      }

      const pos = rcToLocalPos(wp.row, wp.col, wp.elevation_m, currentExaggeration);
      const isLanding = wp.type === 'landing_site';

      const group = new THREE.Group();
      group.position.copy(pos);

      // Distinct beacon appearance:
      // Start: Green glow (0x00E676)
      // Goal: Cyan diamond (0x00E5FF octahedron)
      // Intermediate Stop: Amber beacon (0xFFA726)
      // Landing site: Green / Emerald (0x00E676)
      // Other Catalog Waypoints: Sky blue pin (0x80D8FF)
      let mastColor = 0x80D8FF;
      let headColor = 0x00E5FF;
      let headSize = 12;
      let isDiamond = false;

      if (isStart) {
        mastColor = 0x00E676;
        headColor = 0x00E676;
        headSize = 16;
      } else if (isGoal) {
        mastColor = 0x00E5FF;
        headColor = 0x00E5FF;
        headSize = 15;
        isDiamond = true;
      } else if (isStop) {
        mastColor = 0xFFA726;
        headColor = 0xFFB300;
        headSize = 14;
      } else if (isLanding) {
        mastColor = 0x00E676;
        headColor = 0x00E676;
        headSize = 16;
      } else {
        mastColor = 0x64B5F6;
        headColor = 0x80D8FF;
        headSize = 11;
      }

      // Vertical Mast
      const mastGeom = new THREE.CylinderGeometry(2, 2, 70, 8);
      const mastMat = new THREE.MeshBasicMaterial({ color: mastColor });
      const mast = new THREE.Mesh(mastGeom, mastMat);
      mast.position.y = 35;
      group.add(mast);

      // Glowing Beacon Head
      const beaconGeom = isDiamond
        ? new THREE.OctahedronGeometry(headSize, 0)
        : new THREE.SphereGeometry(headSize, 16, 16);
      const beaconMat = new THREE.MeshBasicMaterial({ color: headColor });
      const beacon = new THREE.Mesh(beaconGeom, beaconMat);
      beacon.position.y = 70;
      beacon.userData = { waypoint: wp, isStart, isGoal, isStop };
      group.add(beacon);

      jezeroSurfaceGroup.add(group);
      waypointBeacons.push(beacon);
    });
  }

  // Create / Update Start Pin Marker on Surface Mesh
  function updateStartMarker(r, c) {
    if (!missionData || !jezeroSurfaceGroup) return;
    if (startMarkerGroup) {
      jezeroSurfaceGroup.remove(startMarkerGroup);
    }

    const elev = (missionData.elevation_samples && missionData.elevation_samples[r]) ? missionData.elevation_samples[r][c] : -2500;
    const pos = rcToLocalPos(r, c, elev, currentExaggeration);

    startMarkerGroup = new THREE.Group();
    startMarkerGroup.position.copy(pos);

    // Green Vertical Mast
    const mastGeom = new THREE.CylinderGeometry(1.5, 1.5, 45, 8);
    const mastMat = new THREE.MeshBasicMaterial({ color: 0x00E676 });
    const mast = new THREE.Mesh(mastGeom, mastMat);
    mast.position.y = 22.5;
    startMarkerGroup.add(mast);

    // Glowing Green Departure Beacon
    const headGeom = new THREE.SphereGeometry(9, 16, 16);
    const headMat = new THREE.MeshBasicMaterial({ color: 0x00E676 });
    const head = new THREE.Mesh(headGeom, headMat);
    head.position.y = 45;
    startMarkerGroup.add(head);

    // Target Ring on Surface
    const ringGeom = new THREE.RingGeometry(8, 14, 24);
    const ringMat = new THREE.MeshBasicMaterial({ color: 0x00E676, side: THREE.DoubleSide });
    const ring = new THREE.Mesh(ringGeom, ringMat);
    ring.rotation.x = -Math.PI / 2;
    ring.position.y = 1.5;
    startMarkerGroup.add(ring);

    jezeroSurfaceGroup.add(startMarkerGroup);
  }

  // Create / Update Goal Pin Marker on Surface Mesh
  function updateGoalMarker(r, c) {
    if (!missionData || !jezeroSurfaceGroup) return;
    if (goalMarkerGroup) {
      jezeroSurfaceGroup.remove(goalMarkerGroup);
    }

    const elev = (missionData.elevation_samples && missionData.elevation_samples[r]) ? missionData.elevation_samples[r][c] : -2500;
    const pos = rcToLocalPos(r, c, elev, currentExaggeration);

    goalMarkerGroup = new THREE.Group();
    goalMarkerGroup.position.copy(pos);

    // Cyan Vertical Mast
    const mastGeom = new THREE.CylinderGeometry(1.5, 1.5, 45, 8);
    const mastMat = new THREE.MeshBasicMaterial({ color: 0x00E5FF });
    const mast = new THREE.Mesh(mastGeom, mastMat);
    mast.position.y = 22.5;
    goalMarkerGroup.add(mast);

    // Glowing Cyan Destination Diamond
    const headGeom = new THREE.OctahedronGeometry(10, 0);
    const headMat = new THREE.MeshBasicMaterial({ color: 0x00E5FF });
    const head = new THREE.Mesh(headGeom, headMat);
    head.position.y = 45;
    goalMarkerGroup.add(head);

    // Target Ring on Surface
    const ringGeom = new THREE.RingGeometry(8, 14, 24);
    const ringMat = new THREE.MeshBasicMaterial({ color: 0x00E5FF, side: THREE.DoubleSide });
    const ring = new THREE.Mesh(ringGeom, ringMat);
    ring.rotation.x = -Math.PI / 2;
    ring.position.y = 1.5;
    goalMarkerGroup.add(ring);

    jezeroSurfaceGroup.add(goalMarkerGroup);
  }

  // Update Both Start and Goal Markers
  function updatePlanningMarkers() {
    if (customStart) {
      updateStartMarker(customStart.row, customStart.col);
    } else if (startMarkerGroup && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(startMarkerGroup);
      startMarkerGroup = null;
    }

    if (customGoal) {
      updateGoalMarker(customGoal.row, customGoal.col);
    } else if (goalMarkerGroup && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(goalMarkerGroup);
      goalMarkerGroup = null;
    }
  }

  // Milestone 9N: Clear Live Route Polylines and Result Cache
  function clearLiveRoute() {
    if (routeLineMesh && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(routeLineMesh);
      routeLineMesh = null;
    }
    activeRoutePath = null;
    activeBaselineRouteResult = null;
    activeMissionFingerprint = null;
  }

  // Milestone 9N: Clear Route Telemetry Metrics to Clean Default State
  function clearRouteTelemetry() {
    if (statDistance) statDistance.innerHTML = '— <span class="unit">m</span>';
    if (statEffort) statEffort.innerHTML = '— <span class="unit">flat-m</span>';
    if (statClimb) statClimb.innerHTML = '— <span class="unit">m</span>';
    if (statSlope) statSlope.innerHTML = '— <span class="unit">&deg;</span>';
    if (statScience) statScience.innerHTML = '— <span class="unit">pts</span>';
    if (statTravelTime) statTravelTime.textContent = '—';
    if (routeDescription) {
      routeDescription.textContent = 'Define departure and destination coordinates on the Jezero Crater surface mesh to compute an optimal traverse.';
    }
    if (timelineCard) timelineCard.classList.add('hidden');
    if (typeof clearTerrainProfileWorkbench === 'function') {
      clearTerrainProfileWorkbench();
    }
  }

  // Milestone 9N: Update Calculate Button Disabled/Enabled State
  function updateCalculateButtonState() {
    const canCalculate = Boolean(customStart && customGoal);
    if (btnCalculateRoute) {
      btnCalculateRoute.disabled = !canCalculate;
      if (!canCalculate) {
        btnCalculateRoute.title = "Both departure and destination must be set to compute traverse";
        btnCalculateRoute.style.opacity = '0.5';
        btnCalculateRoute.style.cursor = 'not-allowed';
      } else {
        btnCalculateRoute.title = "Compute optimal Python A* path across Jezero Crater";
        btnCalculateRoute.style.opacity = '1.0';
        btnCalculateRoute.style.cursor = 'pointer';
      }
    }
  }

  // Milestone 9N: Set Waypoint Visibility Mode ('all' | 'mission')
  function setWaypointVisibilityMode(mode) {
    waypointVisibilityMode = (mode === 'mission') ? 'mission' : 'all';

    if (btnVisAll) {
      btnVisAll.classList.toggle('active', waypointVisibilityMode === 'all');
      btnVisAll.setAttribute('aria-pressed', waypointVisibilityMode === 'all' ? 'true' : 'false');
    }
    if (btnVisMission) {
      btnVisMission.classList.toggle('active', waypointVisibilityMode === 'mission');
      btnVisMission.setAttribute('aria-pressed', waypointVisibilityMode === 'mission' ? 'true' : 'false');
    }
    if (chkShowAllWaypoints) {
      chkShowAllWaypoints.checked = (waypointVisibilityMode === 'all');
    }

    if (countAllWaypoints && missionData && missionData.waypoints) {
      countAllWaypoints.textContent = missionData.waypoints.length;
    }

    buildWaypointBeacons();
    updateJezeroLabels();
  }

  // Milestone 9N: Clear Start Endpoint
  function clearStart() {
    customStart = null;
    if (startPointVal) {
      startPointVal.textContent = "— None Selected — (Click 'SET START' or pick on map)";
    }
    if (startMarkerGroup && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(startMarkerGroup);
      startMarkerGroup = null;
    }
    clearLiveRoute();
    clearDetour();
    if (gauntletResultCard) gauntletResultCard.classList.add('hidden');
    if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
    if (comparisonLabCard) comparisonLabCard.classList.add('hidden');
    if (sensitivityResultCard) sensitivityResultCard.classList.add('hidden');
    clearRouteTelemetry();

    if (statFeasibility) {
      statFeasibility.textContent = 'START REQUIRED';
      statFeasibility.style.color = '#FFA000';
      statFeasibility.style.background = 'rgba(255,160,0,0.15)';
      statFeasibility.style.borderColor = 'rgba(255,160,0,0.3)';
    }

    updateCalculateButtonState();
    setSimulationStale(true);
    setUnsavedChanges(true);
    buildWaypointBeacons();
    updateJezeroLabels();
    populateAddStopDropdown();
    setPlanningStatus("Departure point cleared. Pick a new departure point or select a waypoint.", "ready");
  }

  // Milestone 9N: Clear Goal Endpoint
  function clearGoal() {
    customGoal = null;
    if (goalPointVal) {
      goalPointVal.textContent = "— None Selected — (Click 'SET GOAL' or pick on map)";
    }
    if (goalMarkerGroup && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(goalMarkerGroup);
      goalMarkerGroup = null;
    }
    clearLiveRoute();
    clearDetour();
    if (gauntletResultCard) gauntletResultCard.classList.add('hidden');
    if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
    if (comparisonLabCard) comparisonLabCard.classList.add('hidden');
    if (sensitivityResultCard) sensitivityResultCard.classList.add('hidden');
    clearRouteTelemetry();

    if (statFeasibility) {
      statFeasibility.textContent = 'GOAL REQUIRED';
      statFeasibility.style.color = '#FFA000';
      statFeasibility.style.background = 'rgba(255,160,0,0.15)';
      statFeasibility.style.borderColor = 'rgba(255,160,0,0.3)';
    }

    updateCalculateButtonState();
    setSimulationStale(true);
    setUnsavedChanges(true);
    buildWaypointBeacons();
    updateJezeroLabels();
    populateAddStopDropdown();
    setPlanningStatus("Destination point cleared. Pick a new destination point or select a waypoint.", "ready");
  }

  // Milestone 9N: Swap Endpoints
  function swapEndpoints() {
    if (!customStart && !customGoal) {
      setPlanningStatus("No endpoints to swap.", "ready");
      return;
    }

    const temp = customStart;
    customStart = customGoal;
    customGoal = temp;

    if (startPointVal) {
      startPointVal.textContent = customStart ? customStart.name : "— None Selected — (Click 'SET START' or pick on map)";
    }
    if (goalPointVal) {
      goalPointVal.textContent = customGoal ? customGoal.name : "— None Selected — (Click 'SET GOAL' or pick on map)";
    }

    updatePlanningMarkers();
    updateCalculateButtonState();
    buildWaypointBeacons();
    updateJezeroLabels();
    populateAddStopDropdown();
    setSimulationStale(true);
    setUnsavedChanges(true);

    if (customStart && customGoal) {
      setPlanningStatus("Endpoints swapped. Recalculating traverse...", "calculating");
      calculateTraverse();
    } else {
      clearLiveRoute();
      clearDetour();
      clearRouteTelemetry();
      if (statFeasibility) {
        if (!customStart) {
          statFeasibility.textContent = 'START REQUIRED';
          statFeasibility.style.color = '#FFA000';
          statFeasibility.style.background = 'rgba(255,160,0,0.15)';
          statFeasibility.style.borderColor = 'rgba(255,160,0,0.3)';
        } else {
          statFeasibility.textContent = 'GOAL REQUIRED';
          statFeasibility.style.color = '#FFA000';
          statFeasibility.style.background = 'rgba(255,160,0,0.15)';
          statFeasibility.style.borderColor = 'rgba(255,160,0,0.3)';
        }
      }
    }
  }

  // Milestone 9N: Reset Mission Confirmation Modal Controls
  function openResetMissionModal() {
    if (resetMissionModal) {
      resetMissionModal.classList.remove('hidden');
    }
  }

  function closeResetMissionModal() {
    if (resetMissionModal) {
      resetMissionModal.classList.add('hidden');
    }
  }

  function resetMission(force = false) {
    if (!force) {
      openResetMissionModal();
      return;
    }
    executeResetMission();
  }

  function executeResetMission() {
    closeResetMissionModal();
    setPlanningMode('none');
    customStart = null;
    customGoal = null;
    activeIntermediateStops = [];
    renderActiveStopsList();
    populateAddStopDropdown();

    if (startPointVal) startPointVal.textContent = "— None Selected — (Click 'SET START' or pick on map)";
    if (goalPointVal) goalPointVal.textContent = "— None Selected — (Click 'SET GOAL' or pick on map)";

    if (startMarkerGroup && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(startMarkerGroup);
      startMarkerGroup = null;
    }
    if (goalMarkerGroup && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(goalMarkerGroup);
      goalMarkerGroup = null;
    }

    clearLiveRoute();
    clearDetour();
    if (gauntletResultCard) gauntletResultCard.classList.add('hidden');
    if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
    if (comparisonLabCard) comparisonLabCard.classList.add('hidden');
    if (sensitivityResultCard) sensitivityResultCard.classList.add('hidden');

    // Reset inputs to defaults
    if (inputMissionName) inputMissionName.value = 'Jezero Expedition Alpha';
    if (inputExpeditionHours) inputExpeditionHours.value = '8.0';
    if (inputDwellMins) inputDwellMins.value = '30';
    if (inputDelayMins) inputDelayMins.value = '15';
    if (inputMaxDistanceM) inputMaxDistanceM.value = '0';

    // Reset profile to conservative
    currentProfile = 'conservative';
    routeTabs.forEach(t => {
      t.classList.toggle('active', t.dataset.profile === 'conservative');
    });

    // Reset vehicle mode to crew_eva
    currentVehicleMode = 'crew_eva';
    vehicleModePills.forEach(p => {
      p.classList.toggle('active', p.dataset.vehicle === 'crew_eva');
    });

    clearRouteTelemetry();

    if (statFeasibility) {
      statFeasibility.textContent = 'EMPTY MISSION';
      statFeasibility.style.color = 'var(--text-dim)';
      statFeasibility.style.background = 'rgba(255,255,255,0.05)';
      statFeasibility.style.borderColor = 'rgba(255,255,255,0.1)';
    }

    updateCalculateButtonState();
    setWaypointVisibilityMode('all');
    buildWaypointBeacons();
    updateJezeroLabels();

    setSimulationStale(false);
    setUnsavedChanges(false);
    setPlanningStatus("MISSION WORKSPACE RESET: Departure, destination, and simulation outputs cleared.", "ready");
  }

  // Draw Live Traverse Polyline
  function drawLiveRoute(path_rc, profileKey) {
    if (!missionData || !jezeroSurfaceGroup) return;
    if (routeLineMesh) jezeroSurfaceGroup.remove(routeLineMesh);

    if (!path_rc || path_rc.length < 2) return;

    const points = path_rc.map(rc => {
      const r = rc[0];
      const c = rc[1];
      const elev = missionData.elevation_samples[r][c];
      const pos = rcToLocalPos(r, c, elev, currentExaggeration);
      pos.y += 4.0;
      return pos;
    });

    const geom = new THREE.BufferGeometry().setFromPoints(points);
    const colorHex = profileKey === 'conservative'
      ? 0x00E676
      : (profileKey === 'balanced' ? 0x00E5FF : 0xFF5722);

    const mat = new THREE.LineBasicMaterial({
      color: colorHex,
      linewidth: 4
    });

    routeLineMesh = new THREE.Line(geom, mat);
    jezeroSurfaceGroup.add(routeLineMesh);

    if (typeof refreshPlaybackData === 'function') {
      refreshPlaybackData('nominal');
    }
  }

  // Draw Gauntlet Detour Polyline
  function drawDetourRoute(path_rc) {
    if (!missionData || !jezeroSurfaceGroup) return;
    if (detourRouteLineMesh) jezeroSurfaceGroup.remove(detourRouteLineMesh);

    activeDetourPath = (path_rc && path_rc.length >= 2) ? path_rc : null;
    if (!path_rc || path_rc.length < 2) return;

    const points = path_rc.map(rc => {
      const r = rc[0];
      const c = rc[1];
      const elev = missionData.elevation_samples[r][c];
      const pos = rcToLocalPos(r, c, elev, currentExaggeration);
      pos.y += 8.0;
      return pos;
    });

    const geom = new THREE.BufferGeometry().setFromPoints(points);
    const mat = new THREE.LineBasicMaterial({
      color: 0xFFA726,
      linewidth: 4
    });

    detourRouteLineMesh = new THREE.Line(geom, mat);
    jezeroSurfaceGroup.add(detourRouteLineMesh);

    if (typeof refreshPlaybackData === 'function') {
      refreshPlaybackData('disrupted');
    }
  }

  // Clear Gauntlet Detour
  function clearDetour() {
    if (detourRouteLineMesh && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(detourRouteLineMesh);
      detourRouteLineMesh = null;
    }
    activeDetourPath = null;
    clearDisruptionZone();
    clearHighlightedSegment();
  }

  // Highlight Disruption Hazard Obstacle Zone
  function highlightDisruptionZone(scenarioData, scenarioId) {
    clearDisruptionZone();
    if (!missionData || !jezeroSurfaceGroup) return;

    activeDisruptionHazard = { scenarioData, scenarioId };

    let centerR = 115, centerC = 138, radiusM = 60;
    if (scenarioData && scenarioData.center_rc && Array.isArray(scenarioData.center_rc)) {
      centerR = scenarioData.center_rc[0];
      centerC = scenarioData.center_rc[1];
      radiusM = scenarioData.radius_m || 60;
    } else if (scenarioId === 'scen_hawksbill_rockfall') {
      centerR = 136; centerC = 91; radiusM = 55;
    } else if (scenarioId === 'scen_delta_channel_block') {
      centerR = 115; centerC = 138; radiusM = 65;
    }

    if (!missionData.elevation_samples || !missionData.elevation_samples[centerR] || missionData.elevation_samples[centerR][centerC] === undefined) return;
    const elev = missionData.elevation_samples[centerR][centerC];
    const pos = rcToLocalPos(centerR, centerC, elev, currentExaggeration);

    disruptionHazardMesh = new THREE.Group();
    disruptionHazardMesh.position.copy(pos);

    const isSandHazard = (scenarioId === 'scen_unstable_sand') || (scenarioData && scenarioData.cost_multiplier > 1.0);
    const hazardColor = isSandHazard ? 0xFFA726 : 0xFF1744;

    // Hazard Area Ring
    const ringGeom = new THREE.RingGeometry(radiusM * (isSandHazard ? 0.1 : 0.35), radiusM, 32);
    const ringMat = new THREE.MeshBasicMaterial({
      color: hazardColor,
      side: THREE.DoubleSide,
      transparent: true,
      opacity: isSandHazard ? 0.45 : 0.65
    });
    const ring = new THREE.Mesh(ringGeom, ringMat);
    ring.rotation.x = -Math.PI / 2;
    ring.position.y = 4;
    disruptionHazardMesh.add(ring);

    // Hazard Core Warning Beacon
    const coreGeom = new THREE.SphereGeometry(isSandHazard ? 8 : 12, 16, 16);
    const coreMat = new THREE.MeshBasicMaterial({ color: hazardColor });
    const core = new THREE.Mesh(coreGeom, coreMat);
    core.position.y = 16;
    disruptionHazardMesh.add(core);

    jezeroSurfaceGroup.add(disruptionHazardMesh);
  }

  // Clear Disruption Hazard Zone
  function clearDisruptionZone() {
    if (disruptionHazardMesh && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(disruptionHazardMesh);
      disruptionHazardMesh = null;
    }
    activeDisruptionHazard = null;
  }

  // Update Route Polyline in Surface Workstation
  function updateRoutePolyline(profileKey) {
    if (!missionData) return;
    if (activeRoutePath) {
      drawLiveRoute(activeRoutePath, profileKey);
      return;
    }

    const route = missionData.routes[profileKey];
    if (!route || !route.path_rc) return;
    activeRoutePath = route.path_rc;
    drawLiveRoute(activeRoutePath, profileKey);
  }

  // Planning Mode Controller
  function setPlanningMode(mode) {
    planningMode = mode;
    if (mode === 'start') {
      if (btnSetStart) btnSetStart.classList.add('active-start');
      if (btnSetGoal) btnSetGoal.classList.remove('active-goal');
      if (btnPlaceContingencyOnMap) btnPlaceContingencyOnMap.classList.remove('active-contingency');
      if (btnCancelContingencyPlacement) btnCancelContingencyPlacement.classList.add('hidden');
      setPlanningStatus("CLICK TERRAIN: Pick any surveyed point on Jezero surface to set departure.", "picking-start");
    } else if (mode === 'goal') {
      if (btnSetGoal) btnSetGoal.classList.add('active-goal');
      if (btnSetStart) btnSetStart.classList.remove('active-start');
      if (btnPlaceContingencyOnMap) btnPlaceContingencyOnMap.classList.remove('active-contingency');
      if (btnCancelContingencyPlacement) btnCancelContingencyPlacement.classList.add('hidden');
      setPlanningStatus("CLICK TERRAIN: Pick any surveyed point on Jezero surface to set destination.", "picking-goal");
    } else if (mode === 'contingency') {
      if (btnSetStart) btnSetStart.classList.remove('active-start');
      if (btnSetGoal) btnSetGoal.classList.remove('active-goal');
      if (btnPlaceContingencyOnMap) btnPlaceContingencyOnMap.classList.add('active-contingency');
      if (btnCancelContingencyPlacement) btnCancelContingencyPlacement.classList.remove('hidden');
      setPlanningStatus("CLICK TERRAIN: Pick location on Jezero surface to position contingency hazard.", "picking-contingency");
    } else {
      if (btnSetStart) btnSetStart.classList.remove('active-start');
      if (btnSetGoal) btnSetGoal.classList.remove('active-goal');
      if (btnPlaceContingencyOnMap) btnPlaceContingencyOnMap.classList.remove('active-contingency');
      if (btnCancelContingencyPlacement) btnCancelContingencyPlacement.classList.add('hidden');
    }
  }

  // Planning Status Display
  function setPlanningStatus(msg, stateClass = '') {
    if (!planningStatus) return;
    planningStatus.textContent = msg;
    planningStatus.className = 'planning-status ' + stateClass;
  }

  // Multi-Stop Intermediate Waypoints Functions
  function populateAddStopDropdown() {
    if (!selectAddStop || !missionData || !missionData.waypoints) return;
    selectAddStop.innerHTML = '<option value="">-- Add Science Target Stop --</option>';
    missionData.waypoints.forEach(wp => {
      const isStart = customStart && (customStart.id === wp.id || (customStart.row === wp.row && customStart.col === wp.col));
      const isGoal = customGoal && (customGoal.id === wp.id || (customGoal.row === wp.row && customGoal.col === wp.col));
      const isAlreadyStop = activeIntermediateStops.some(s => s.id === wp.id);
      if (!isStart && !isGoal && !isAlreadyStop) {
        const opt = document.createElement('option');
        opt.value = wp.id;
        opt.textContent = `${wp.name} (Priority ${wp.priority_score})`;
        selectAddStop.appendChild(opt);
      }
    });
  }

  function renderActiveStopsList() {
    if (!activeStopsList) return;
    activeStopsList.innerHTML = '';
    if (activeIntermediateStops.length === 0) {
      activeStopsList.innerHTML = '<div class="stop-chip-empty">No intermediate stops added (direct leg).</div>';
      populateAddStopDropdown();
      return;
    }

    activeIntermediateStops.forEach((stop, idx) => {
      if (!stop) return;
      const chip = document.createElement('div');
      chip.className = 'stop-chip';
      chip.innerHTML = `
        <span class="stop-chip-idx">Stop ${idx + 1}:</span>
        <span class="stop-chip-name" title="${stop.name}">${stop.name}</span>
        <button class="stop-chip-remove" data-idx="${idx}" title="Remove Stop">&times;</button>
      `;
      chip.querySelector('.stop-chip-remove').addEventListener('click', (e) => {
        const removeIdx = parseInt(e.target.dataset.idx, 10);
        activeIntermediateStops.splice(removeIdx, 1);
        renderActiveStopsList();
        populateAddStopDropdown();
        setSimulationStale(true);
      });
      activeStopsList.appendChild(chip);
    });

    populateAddStopDropdown();
  }

  // Milestone 9H: Render Mission Operational Timeline
  function renderTimeline(timeline) {
    activeTimeline = timeline;
    if (!timeline || !timelineCard) return;

    if (statTimelineMarginBadge) {
      if (timeline.is_within_limit) {
        statTimelineMarginBadge.className = 'timeline-margin-badge margin-ok';
        statTimelineMarginBadge.textContent = `MARGIN: ${timeline.formatted_remaining_margin}`;
      } else {
        statTimelineMarginBadge.className = 'timeline-margin-badge margin-exceeded';
        statTimelineMarginBadge.textContent = `OVER LIMIT: ${timeline.formatted_remaining_margin}`;
      }
    }

    if (timelineTraverseTime) timelineTraverseTime.textContent = timeline.formatted_traverse_time || '0s';
    if (timelineDwellTime) timelineDwellTime.textContent = timeline.formatted_dwell_time || '0s';
    if (timelineDelayTime) {
      const delayMin = Math.round(timeline.total_operational_delay_s / 60);
      timelineDelayTime.textContent = delayMin > 0 ? `${delayMin} min` : '0 min';
    }
    if (timelineTotalTime) timelineTotalTime.textContent = timeline.formatted_mission_time || '0s';
    if (timelineLimitTime) {
      const limitH = (timeline.operational_limit_s / 3600).toFixed(0);
      limitH && (timelineLimitTime.textContent = `${limitH}h`);
    }

    if (timelineEventsContainer && timeline.events) {
      timelineEventsContainer.innerHTML = '';
      timeline.events.forEach(e => {
        const item = document.createElement('div');
        let typeClass = 'event-traverse';
        if (e.event_type === 'science_dwell') typeClass = 'event-dwell';
        else if (e.event_type === 'scenario_delay') typeClass = 'event-delay';

        item.className = `timeline-event-item ${typeClass}`;
        item.innerHTML = `
          <span class="timeline-event-label" title="${e.label}">${e.label}</span>
          <span class="timeline-event-time">${e.formatted_duration} (+${e.formatted_cumulative_time})</span>
        `;
        timelineEventsContainer.appendChild(item);
      });
    }
  }

  // Milestone 9H: Vehicle Mode Switcher
  function setVehicleMode(mode) {
    currentVehicleMode = mode;
    setSimulationStale(true);
    markContingencyStale();
    markMdlStale();
    setUnsavedChanges(true);
    vehicleModePills.forEach(p => {
      if (p.dataset.vehicle === mode) p.classList.add('active');
      else p.classList.remove('active');
    });

    if (mode === 'robotic_rover') {
      if (inputExpeditionHours && (inputExpeditionHours.value === '8.0' || inputExpeditionHours.value === '8')) {
        inputExpeditionHours.value = '4.0';
      }
    } else if (mode === 'crew_eva') {
      if (inputExpeditionHours && (inputExpeditionHours.value === '4.0' || inputExpeditionHours.value === '4')) {
        inputExpeditionHours.value = '8.0';
      }
    }

    if (statTravelTimeLabel) {
      statTravelTimeLabel.textContent = (mode === 'robotic_rover')
        ? 'Estimated Rover Drive Time (Mars 2020 0.035 m/s Model)'
        : 'Estimated EVA Traverse Time (Apollo Walk Model)';
    }

    // Automatically recalculate traverse to reflect mode travel times and timeline
    if (customStart && customGoal && currentViewMode === 'jezero') {
      calculateTraverse();
    }
  }

  // Milestone 9H: Update Telemetry Metrics from Planner Data
  function updateTelemetryFromData(data) {
    if (statDistance) {
      statDistance.innerHTML = `${data.distance_m.toLocaleString(undefined, {minimumFractionDigits: 1, maximumFractionDigits: 1})} <span class="unit">m</span>`;
    }
    if (statEffort) {
      const effortVal = data.cost !== null && data.cost !== undefined ? data.cost.toLocaleString(undefined, {minimumFractionDigits: 1, maximumFractionDigits: 1}) : 'N/A';
      statEffort.innerHTML = `${effortVal} <span class="unit">flat-m</span>`;
    }
    if (statClimb) {
      statClimb.innerHTML = `${data.cumulative_climb_m.toFixed(1)} <span class="unit">m</span>`;
    }
    if (statSlope) {
      statSlope.innerHTML = `${data.max_slope_deg.toFixed(1)} <span class="unit">&deg;</span>`;
    }
    if (statScience) {
      statScience.innerHTML = `${data.science_score.toFixed(1)} <span class="unit">pts</span>`;
    }
    if (statTravelTime && data.formatted_travel_time) {
      statTravelTime.textContent = data.formatted_travel_time;
    }

    // Milestone 12C: Automatically refresh Terrain Decision Workbench elevation profile and cost attribution
    if (typeof refreshTerrainProfileAnalysis === 'function') {
      refreshTerrainProfileAnalysis(data);
    }

    if (statFeasibility) {
      statFeasibility.textContent = data.is_budget_feasible ? 'FEASIBLE' : 'OVER BUDGET';
      statFeasibility.style.color = data.is_budget_feasible ? 'var(--status-green)' : 'var(--status-red)';
      statFeasibility.style.background = data.is_budget_feasible ? 'rgba(0,230,118,0.15)' : 'rgba(255,23,68,0.15)';
      statFeasibility.style.borderColor = data.is_budget_feasible ? 'rgba(0,230,118,0.3)' : 'rgba(255,23,68,0.3)';
    }
  }

  // Milestone 9H/9I: Optimize Stop Order via Exact Permutation TSP or 2-Opt Heuristic
  async function optimizeMissionStops() {
    if (activeIntermediateStops.length <= 1) {
      setPlanningStatus("At least 2 intermediate stops required for visitation order optimization.", "ready");
      return;
    }

    if (!customStart || !customGoal) {
      setPlanningStatus("Please set start and goal before optimizing stops.", "error");
      return;
    }

    if (btnOptimizeStops) {
      btnOptimizeStops.disabled = true;
      btnOptimizeStops.textContent = '⏳ Optimizing...';
    }
    const numStops = activeIntermediateStops.length;
    const algoDesc = numStops <= 7 ? 'exact permutation TSP' : 'deterministic 2-Opt local search';
    setPlanningStatus(`Optimizing stop sequence (${numStops} targets) via ${algoDesc}...`, "calculating");

    try {
      const payload = {
        start: { row: customStart.row, col: customStart.col },
        goal: { row: customGoal.row, col: customGoal.col },
        profile: currentProfile,
        vehicle_mode: currentVehicleMode,
        optimize_stops: true,
        stops: activeIntermediateStops.map(s => ({
          row: s.row,
          col: s.col,
          id: s.id,
          name: s.name,
          priority_score: s.priority_score
        }))
      };

      const resp = await fetch('/api/plan_route', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await resp.json();
      if (!resp.ok) throw new Error(data.detail || data.message || `HTTP ${resp.status}`);

      if (data.optimization && data.optimization.optimized_stops) {
        // Re-order activeIntermediateStops according to optimal sequence
        const idMap = new Map(activeIntermediateStops.map(s => [s.id, s]));
        activeIntermediateStops = data.optimization.optimized_stops.map(os => idMap.get(os.id)).filter(Boolean);
        renderActiveStopsList();
        populateAddStopDropdown();

        // Update route and telemetry
        if (data.path_rc && data.path_rc.length > 0) {
          activeRoutePath = data.path_rc;
          drawLiveRoute(data.path_rc, currentProfile);
          clearDetour();
          if (gauntletResultCard) gauntletResultCard.classList.add('hidden');
          updateTelemetryFromData(data);
          if (data.timeline) renderTimeline(data.timeline);
        }

        const savedD = data.optimization.distance_saved_m;
        const savedT = data.optimization.formatted_time_saved;
        const isOptimal = data.optimization.is_globally_optimal;
        const disclosure = data.optimization.algorithm_disclosure || '';
        if (isOptimal) {
          setPlanningStatus(`OPTIMIZED SEQUENCE APPLIED: Saved ${savedD.toFixed(0)} m (${savedT}) via exact TSP permutation.`, "success");
        } else {
          setPlanningStatus(`OPTIMIZED SEQUENCE APPLIED: Saved ${savedD.toFixed(0)} m (${savedT}) via 2-Opt heuristic. (${disclosure})`, "success");
        }
        setSimulationStale(true);
      }
    } catch (err) {
      console.error('[MarsWalk Atlas] Optimization error:', err);
      setPlanningStatus(`Optimization error: ${err.message}`, "error");
    } finally {
      if (btnOptimizeStops) {
        btnOptimizeStops.disabled = false;
        btnOptimizeStops.textContent = '✨ Optimize Order';
      }
    }
  }

  // Milestone 9I: Render 3-Way Recovery Comparison (Baseline vs Disrupted vs Recovered)
  function renderThreeWayRecovery(baselineRoute, scenarioRoute, recoveryPlan) {
    if (!recoveryThreeWayTable) return;
    recoveryThreeWayTable.innerHTML = '';
    if (!recoveryPlan || !recoveryPlan.recovered_route) return;

    const bDist = baselineRoute ? baselineRoute.distance_m : 0;
    const bTime = baselineRoute ? baselineRoute.formatted_travel_time : '—';
    const sDist = scenarioRoute ? scenarioRoute.distance_m : 0;
    const sTime = scenarioRoute ? scenarioRoute.formatted_travel_time : '—';
    const rRoute = recoveryPlan.recovered_route;
    const rDist = rRoute ? rRoute.distance_m : 0;
    const rTime = rRoute ? rRoute.formatted_travel_time : '—';

    recoveryThreeWayTable.innerHTML = `
      <div class="recovery-stat-box baseline">
        <span class="recovery-stat-title">Baseline Plan</span>
        <span class="recovery-stat-val">${bDist.toFixed(0)} m</span>
        <span>${bTime}</span>
        <span style="color:var(--status-green);">100% Science</span>
      </div>
      <div class="recovery-stat-box disrupted">
        <span class="recovery-stat-title">Disrupted</span>
        <span class="recovery-stat-val">${sDist.toFixed(0)} m</span>
        <span>${sTime}</span>
        <span style="color:#FF5252;">Degraded</span>
      </div>
      <div class="recovery-stat-box recovered">
        <span class="recovery-stat-title">Recovered</span>
        <span class="recovery-stat-val">${rDist.toFixed(0)} m</span>
        <span>${rTime}</span>
        <span style="color:var(--telemetry-cyan);">${recoveryPlan.formatted_margin_recovered}</span>
      </div>
    `;
  }

  // Milestone 9H/9I: Apply Recommended Recovery Plan
  function applyRecoveryPlan() {
    if (!lastRecoveryPlan || !lastRecoveryPlan.recovered_route) {
      setPlanningStatus("No recovery plan available to apply.", "ready");
      return;
    }

    const recRoute = lastRecoveryPlan.recovered_route;
    if (recRoute.path_rc && recRoute.path_rc.length > 0) {
      activeRoutePath = recRoute.path_rc;
      drawLiveRoute(recRoute.path_rc, currentProfile);
      clearDetour();
      updateTelemetryFromData(recRoute);
      if (recRoute.timeline) renderTimeline(recRoute.timeline);

      // If stops were pruned in recovery, reflect in intermediate stops list
      if (recRoute.visited_waypoint_ids) {
        const visitedSet = new Set(recRoute.visited_waypoint_ids);
        activeIntermediateStops = activeIntermediateStops.filter(s => visitedSet.has(s.id));
        renderActiveStopsList();
        populateAddStopDropdown();
      }

      setSimulationStale(true);
      setPlanningStatus(`RECOVERY ROUTE APPLIED: ${lastRecoveryPlan.strategy}. Recovered ${lastRecoveryPlan.formatted_margin_recovered} margin.`, "success");
      if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
    }
  }

  // Call Live Python A* Routing API
  async function calculateTraverse() {
    if (currentViewMode !== 'jezero') {
      setPlanningStatus("PLANNING CONFINED TO JEZERO CRATER: High-resolution route planning requires the 20 m CTX elevation model. Fly to Jezero Crater to plan traverses.", "error");
      return;
    }

    if (!customStart || !customGoal) {
      setPlanningStatus("Please select both departure and destination points.", "error");
      return;
    }

    if (btnCalculateRoute) {
      btnCalculateRoute.disabled = true;
      btnCalculateRoute.innerHTML = '&#9889; COMPUTING TRAVERSE (PYTHON A*)...';
    }
    setPlanningStatus("Computing least-cost terrain path with Python A* engine...", "calculating");

    try {
      const payload = {
        start: { row: customStart.row, col: customStart.col },
        goal: { row: customGoal.row, col: customGoal.col },
        profile: currentProfile,
        vehicle_mode: currentVehicleMode
      };

      if (inputExpeditionHours && inputExpeditionHours.value !== '') {
        const val = parseFloat(inputExpeditionHours.value);
        if (isNaN(val) || val <= 0) {
          setPlanningStatus("INVALID BUDGET: Expedition duration must be a positive number greater than 0.0 hours.", "error");
          if (btnCalculateRoute) {
            btnCalculateRoute.disabled = false;
            btnCalculateRoute.innerHTML = '&#9889; Calculate Traverse (Python A*)';
          }
          return;
        }
        payload.operational_limit_s = val * 3600;
      }
      if (inputDwellMins && inputDwellMins.value !== '') {
        const dVal = parseFloat(inputDwellMins.value);
        if (isNaN(dVal) || dVal < 0) {
          setPlanningStatus("INVALID PARAMETER: Science dwell time cannot be negative.", "error");
          if (btnCalculateRoute) {
            btnCalculateRoute.disabled = false;
            btnCalculateRoute.innerHTML = '&#9889; Calculate Traverse (Python A*)';
          }
          return;
        }
        payload.dwell_time_per_stop_s = dVal * 60;
      }
      if (inputDelayMins && inputDelayMins.value !== '') {
        const delVal = parseFloat(inputDelayMins.value);
        if (isNaN(delVal) || delVal < 0) {
          setPlanningStatus("INVALID PARAMETER: Operational delay cannot be negative.", "error");
          if (btnCalculateRoute) {
            btnCalculateRoute.disabled = false;
            btnCalculateRoute.innerHTML = '&#9889; Calculate Traverse (Python A*)';
          }
          return;
        }
        payload.operational_delay_s = delVal * 60;
      }
      if (inputMaxDistanceM && inputMaxDistanceM.value !== '') {
        const mVal = parseFloat(inputMaxDistanceM.value);
        if (isNaN(mVal) || mVal < 0) {
          setPlanningStatus("INVALID BUDGET: Maximum distance constraint cannot be negative.", "error");
          if (btnCalculateRoute) {
            btnCalculateRoute.disabled = false;
            btnCalculateRoute.innerHTML = '&#9889; Calculate Traverse (Python A*)';
          }
          return;
        }
        if (mVal > 0) {
          payload.max_distance_m = mVal;
        }
      }

      if (activeIntermediateStops && activeIntermediateStops.length > 0) {
        payload.stops = activeIntermediateStops.map(s => ({
          row: s.row,
          col: s.col,
          id: s.id,
          name: s.name,
          priority_score: s.priority_score
        }));
      }

      const resp = await fetch('/api/plan_route', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await resp.json();

      if (!resp.ok) {
        throw new Error(data.detail || data.message || `HTTP ${resp.status}`);
      }

      if (data.is_reachable && data.path_rc && data.path_rc.length > 0) {
        activeRoutePath = data.path_rc;
        activeBaselineRouteResult = data;
        activeMissionFingerprint = data.input_fingerprint || null;
        drawLiveRoute(data.path_rc, currentProfile);

        // Clear previous detour line, gauntlet, recovery, and comparison outputs from prior baseline
        clearDetour();
        if (gauntletResultCard) gauntletResultCard.classList.add('hidden');
        if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
        lastRecoveryPlan = null;
        if (comparisonLabCard) comparisonLabCard.classList.add('hidden');
        lastComparisonResult = null;
        if (sensitivityResultCard) sensitivityResultCard.classList.add('hidden');
        lastSensitivityResult = null;

        // Update Waypoint Visibility & Screen Badges
        buildWaypointBeacons();
        updateJezeroLabels();

        // Update Telemetry Display
        updateTelemetryFromData(data);

        // Switch to Results Tab so user immediately sees timeline & telemetry
        switchInspectorTab('tabResults');

        // Update Operational Timeline
        if (data.timeline) {
          renderTimeline(data.timeline);
        }

        if (routeDescription) {
          const stopTxt = activeIntermediateStops.length > 0 ? ` (${activeIntermediateStops.length} intermediate stops)` : '';
          const modeTxt = currentVehicleMode === 'robotic_rover' ? 'Robotic Rover (0.035 m/s)' : 'Crew EVA (2.0 km/h)';
          routeDescription.textContent = `Python A* verified route (${data.num_cells} cells, ${data.distance_m.toFixed(1)} m)${stopTxt} across Jezero CTX elevation grid [${modeTxt}]. Execution: ${data.execution_time_s.toFixed(3)}s.`;
        }

        if (!data.is_budget_feasible) {
          setPlanningStatus(`ROUTE COMPUTED (BUDGET EXCEEDED): ${data.distance_m.toFixed(1)} m exceeds limit. Feasibility: OVER BUDGET.`, "warning");
        } else {
          setPlanningStatus(`ROUTE COMPUTED: ${data.num_cells} cells, ${data.distance_m.toFixed(1)} m (Effort: ${data.cost ? data.cost.toFixed(1) : 'N/A'} flat-m).`, "success");
        }
        setSimulationStale(false);
      } else {
        setPlanningStatus(`TRAVERSE INFEASIBLE: ${data.status_message || 'Destination unreachable'}`, "error");
        if (typeof clearTerrainProfileWorkbench === 'function') {
      clearTerrainProfileWorkbench();
    }

    if (statFeasibility) {
          statFeasibility.textContent = 'UNREACHABLE';
          statFeasibility.style.color = 'var(--status-red)';
          statFeasibility.style.background = 'rgba(255,23,68,0.15)';
          statFeasibility.style.borderColor = 'rgba(255,23,68,0.3)';
        }
      }
    } catch (err) {
      console.error('[MarsWalk Atlas] Route planning error:', err);
      setPlanningStatus(`PLANNING ERROR: ${err.message}`, "error");
    } finally {
      if (btnCalculateRoute) {
        btnCalculateRoute.disabled = false;
        btnCalculateRoute.innerHTML = '&#9889; Calculate Traverse (Python A*)';
      }
    }
  }

  // ==========================================================================
  // Milestone 9R: Interactive Contingency Designer & Compound What-If Engine
  // ==========================================================================

  function updateContingencyFormVisibility() {
    if (!contingencyEventType) return;
    const evType = contingencyEventType.value;

    const isSpatial = (evType === 'closed_corridor' || evType === 'difficult_terrain');
    const isCost = (evType === 'difficult_terrain');
    const isMobility = (evType === 'reduced_mobility');
    const isBudget = (evType === 'reduced_time_budget');
    const isHold = (evType === 'operational_hold');
    const isTarget = (evType === 'target_unavailable');

    if (contingencySpatialParams) contingencySpatialParams.classList.toggle('hidden', !isSpatial);
    if (contingencyCostParam) contingencyCostParam.classList.toggle('hidden', !isCost);
    if (contingencyMobilityParam) contingencyMobilityParam.classList.toggle('hidden', !isMobility);
    if (contingencyBudgetParam) contingencyBudgetParam.classList.toggle('hidden', !isBudget);
    if (contingencyHoldParam) contingencyHoldParam.classList.toggle('hidden', !isHold);
    if (contingencyTargetParam) contingencyTargetParam.classList.toggle('hidden', !isTarget);

    if (isTarget) {
      populateContingencyTargetDropdown();
    }
  }

  function populateContingencyTargetDropdown() {
    if (!contingencyTargetSelect) return;
    contingencyTargetSelect.innerHTML = '';
    const targets = [];
    if (activeIntermediateStops && activeIntermediateStops.length > 0) {
      activeIntermediateStops.forEach(s => {
        targets.push({ id: s.id, name: s.name || s.id });
      });
    } else if (missionData && missionData.waypoints) {
      missionData.waypoints.slice(0, 6).forEach(w => {
        targets.push({ id: w.id, name: w.name });
      });
    }

    if (targets.length === 0) {
      contingencyTargetSelect.innerHTML = '<option value="">No intermediate science stops configured</option>';
      return;
    }

    targets.forEach(t => {
      const opt = document.createElement('option');
      opt.value = t.id;
      opt.textContent = `${t.name} (${t.id})`;
      contingencyTargetSelect.appendChild(opt);
    });
  }

  function highlightContingencyPlacementPreview(row, col, radiusM) {
    if (!missionData || !jezeroSurfaceGroup) return;
    if (contingencyPlacementPreviewMesh) {
      jezeroSurfaceGroup.remove(contingencyPlacementPreviewMesh);
      contingencyPlacementPreviewMesh = null;
    }

    if (!missionData.elevation_samples || !missionData.elevation_samples[row] || missionData.elevation_samples[row][col] === undefined) return;
    const elev = missionData.elevation_samples[row][col];
    const pos = rcToLocalPos(row, col, elev, currentExaggeration);

    contingencyPlacementPreviewMesh = new THREE.Group();
    contingencyPlacementPreviewMesh.position.copy(pos);

    const ringGeom = new THREE.RingGeometry(radiusM * 0.3, radiusM, 32);
    const ringMat = new THREE.MeshBasicMaterial({
      color: 0xFF9100,
      side: THREE.DoubleSide,
      transparent: true,
      opacity: 0.7
    });
    const ring = new THREE.Mesh(ringGeom, ringMat);
    ring.rotation.x = -Math.PI / 2;
    ring.position.y = 4;
    contingencyPlacementPreviewMesh.add(ring);

    const pinGeom = new THREE.CylinderGeometry(1.5, 1.5, 50, 8);
    const pinMat = new THREE.MeshBasicMaterial({ color: 0xFF9100 });
    const pin = new THREE.Mesh(pinGeom, pinMat);
    pin.position.y = 25;
    contingencyPlacementPreviewMesh.add(pin);

    jezeroSurfaceGroup.add(contingencyPlacementPreviewMesh);
  }

  function setContingencyPickedLocation(row, col) {
    if (contingencyCenterR) contingencyCenterR.value = row;
    if (contingencyCenterC) contingencyCenterC.value = col;
    const rM = parseFloat(contingencyRadiusM ? contingencyRadiusM.value : 60) || 60;
    highlightContingencyPlacementPreview(row, col, rM);
  }

  function clearContingencyOverlays() {
    if (contingencyOverlayMeshes && contingencyOverlayMeshes.length > 0) {
      contingencyOverlayMeshes.forEach(mesh => {
        if (jezeroSurfaceGroup) jezeroSurfaceGroup.remove(mesh);
      });
      contingencyOverlayMeshes = [];
    }
    if (contingencyPlacementPreviewMesh && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(contingencyPlacementPreviewMesh);
      contingencyPlacementPreviewMesh = null;
    }
  }

  function renderContingency3DOverlays(overlays) {
    clearContingencyOverlays();
    if (!overlays || !Array.isArray(overlays) || !jezeroSurfaceGroup || !missionData) return;

    overlays.forEach(ov => {
      if (!ov.center_rc) return;
      const [centerR, centerC] = ov.center_rc;
      const radiusM = ov.radius_m || 60;
      if (!missionData.elevation_samples || !missionData.elevation_samples[centerR] || missionData.elevation_samples[centerR][centerC] === undefined) return;
      const elev = missionData.elevation_samples[centerR][centerC];
      const pos = rcToLocalPos(centerR, centerC, elev, currentExaggeration);

      const ovGroup = new THREE.Group();
      ovGroup.position.copy(pos);

      const isClosure = ov.event_type === 'closed_corridor';
      const color = isClosure ? 0xFF1744 : 0xFFA726;

      const ringGeom = new THREE.RingGeometry(radiusM * 0.25, radiusM, 32);
      const ringMat = new THREE.MeshBasicMaterial({
        color: color,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: isClosure ? 0.6 : 0.45
      });
      const ring = new THREE.Mesh(ringGeom, ringMat);
      ring.rotation.x = -Math.PI / 2;
      ring.position.y = 3;
      ovGroup.add(ring);

      const coreGeom = new THREE.CylinderGeometry(2, 2, 40, 8);
      const coreMat = new THREE.MeshBasicMaterial({ color: color });
      const core = new THREE.Mesh(coreGeom, coreMat);
      core.position.y = 20;
      ovGroup.add(core);

      const beaconGeom = new THREE.SphereGeometry(6, 12, 12);
      const beaconMat = new THREE.MeshBasicMaterial({ color: color });
      const beacon = new THREE.Mesh(beaconGeom, beaconMat);
      beacon.position.y = 42;
      ovGroup.add(beacon);

      jezeroSurfaceGroup.add(ovGroup);
      contingencyOverlayMeshes.push(ovGroup);
    });
  }

  function addStagedContingencyEvent() {
    if (stagedContingencyEvents.length >= 3) {
      setPlanningStatus("Staging shelf full: Maximum 3 combined events allowed.", "warning");
      return;
    }

    const evType = contingencyEventType.value;
    const customLabel = (contingencyCustomName && contingencyCustomName.value.trim()) || '';
    let newEvent = {
      id: `ev_${Date.now()}_${stagedContingencyEvents.length + 1}`,
      event_type: evType,
      enabled: true,
      name: customLabel
    };

    if (evType === 'closed_corridor') {
      const r = parseInt(contingencyCenterR.value, 10);
      const c = parseInt(contingencyCenterC.value, 10);
      const rad = parseFloat(contingencyRadiusM.value) || 60;
      if (isNaN(r) || isNaN(c) || r < 0 || r > 249 || c < 0 || c > 249) {
        setPlanningStatus("Invalid coordinates: Row and Col must be between 0 and 249.", "error");
        return;
      }
      newEvent.center_rc = [r, c];
      newEvent.radius_m = rad;
      newEvent.name = customLabel || `Closure (${r}, ${c})`;
      newEvent.description = `Physical corridor closure (${rad}m radius at row ${r}, col ${c}).`;
    } else if (evType === 'difficult_terrain') {
      const r = parseInt(contingencyCenterR.value, 10);
      const c = parseInt(contingencyCenterC.value, 10);
      const rad = parseFloat(contingencyRadiusM.value) || 60;
      const mult = parseFloat(contingencyCostMult.value) || 2.5;
      if (isNaN(r) || isNaN(c) || r < 0 || r > 249 || c < 0 || c > 249) {
        setPlanningStatus("Invalid coordinates: Row and Col must be between 0 and 249.", "error");
        return;
      }
      newEvent.center_rc = [r, c];
      newEvent.radius_m = rad;
      newEvent.cost_multiplier = mult;
      newEvent.name = customLabel || `Difficult Terrain (${mult.toFixed(1)}×)`;
      newEvent.description = `High-slip terrain impedance (${mult.toFixed(1)}× effort, ${rad}m radius).`;
    } else if (evType === 'reduced_mobility') {
      const spd = parseFloat(contingencySpeedMult.value) || 0.5;
      newEvent.speed_multiplier = spd;
      newEvent.slope_penalty_multiplier = 1.2;
      newEvent.name = customLabel || `Mobility Derating (${spd.toFixed(2)}×)`;
      newEvent.description = `Drive actuator anomaly derating speed to ${spd.toFixed(2)}× nominal.`;
    } else if (evType === 'reduced_time_budget') {
      const pct = parseFloat(contingencyBudgetCutPct.value) || 25;
      newEvent.budget_reduction_pct = pct;
      newEvent.name = customLabel || `Time Budget Cut (-${pct}%)`;
      newEvent.description = `Available life-support operational time reduced by ${pct}%.`;
    } else if (evType === 'operational_hold') {
      const min = parseInt(contingencyHoldMin.value, 10) || 30;
      newEvent.operational_delay_s = min * 60;
      newEvent.name = customLabel || `Hold (+${min} min)`;
      newEvent.description = `Operational hold adding +${min} minutes of mandatory waiting time.`;
    } else if (evType === 'target_unavailable') {
      const tid = contingencyTargetSelect ? contingencyTargetSelect.value : '';
      if (!tid) {
        setPlanningStatus("No science target selected to mark unavailable.", "error");
        return;
      }
      const tname = contingencyTargetSelect.options[contingencyTargetSelect.selectedIndex].text;
      newEvent.unavailable_target_id = tid;
      newEvent.target_name = tname;
      newEvent.name = customLabel || `Target Abort: ${tid}`;
      newEvent.description = `Science target '${tname}' declared inaccessible.`;
    }

    stagedContingencyEvents.push(newEvent);
    if (contingencyCustomName) contingencyCustomName.value = '';
    renderStagedContingencyList();
    markContingencyStale();
    setPlanningStatus(`Staged contingency event: "${newEvent.name}" (${stagedContingencyEvents.length}/3).`, "success");
  }

  function removeStagedContingencyEvent(idx) {
    if (idx >= 0 && idx < stagedContingencyEvents.length) {
      const removed = stagedContingencyEvents.splice(idx, 1);
      renderStagedContingencyList();
      markContingencyStale();
      setPlanningStatus(`Removed event: "${removed[0].name}".`, "normal");
    }
  }

  function toggleStagedContingencyEvent(idx) {
    if (idx >= 0 && idx < stagedContingencyEvents.length) {
      stagedContingencyEvents[idx].enabled = !stagedContingencyEvents[idx].enabled;
      renderStagedContingencyList();
      markContingencyStale();
    }
  }

  function renderStagedContingencyList() {
    if (!contingencyStagedList) return;
    if (contingencyEventCountBadge) {
      contingencyEventCountBadge.textContent = `${stagedContingencyEvents.length} / 3`;
    }

    if (stagedContingencyEvents.length === 0) {
      contingencyStagedList.innerHTML = '<div class="empty-shelf-msg">No custom events staged. Configure an event above and click Add.</div>';
      clearContingencyOverlays();
      return;
    }

    contingencyStagedList.innerHTML = '';
    const spatialOverlays = [];

    stagedContingencyEvents.forEach((ev, idx) => {
      const item = document.createElement('div');
      item.className = 'contingency-event-item' + (ev.enabled ? '' : ' disabled');

      let pillClass = 'pill-closure';
      let pillText = 'Closure';
      if (ev.event_type === 'difficult_terrain') { pillClass = 'pill-terrain'; pillText = 'Terrain'; }
      else if (ev.event_type === 'reduced_mobility') { pillClass = 'pill-mobility'; pillText = 'Speed'; }
      else if (ev.event_type === 'reduced_time_budget') { pillClass = 'pill-budget'; pillText = 'Budget'; }
      else if (ev.event_type === 'operational_hold') { pillClass = 'pill-hold'; pillText = 'Hold'; }
      else if (ev.event_type === 'target_unavailable') { pillClass = 'pill-target'; pillText = 'Target'; }

      item.innerHTML = `
        <input type="checkbox" ${ev.enabled ? 'checked' : ''} title="Toggle event">
        <span class="contingency-event-pill ${pillClass}">${pillText}</span>
        <div style="flex:1; min-width:0;">
          <div style="font-weight:600; font-size:10px; color:var(--text-primary); text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">${ev.name}</div>
          <div style="font-size:8.5px; color:var(--text-tertiary); text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">${ev.description}</div>
        </div>
        <button class="contingency-btn-del" title="Remove event">✕</button>
      `;

      item.querySelector('input[type="checkbox"]').addEventListener('change', () => toggleStagedContingencyEvent(idx));
      item.querySelector('.contingency-btn-del').addEventListener('click', () => removeStagedContingencyEvent(idx));

      contingencyStagedList.appendChild(item);

      if (ev.enabled && ev.center_rc) {
        spatialOverlays.push({
          center_rc: ev.center_rc,
          radius_m: ev.radius_m,
          event_type: ev.event_type
        });
      }
    });

    renderContingency3DOverlays(spatialOverlays);
  }

  function clearContingencyEvents() {
    stagedContingencyEvents = [];
    activeContingencyResult = null;
    activeAdaptiveResult = null;
    isContingencyStale = false;
    isAdaptiveStale = false;
    clearContingencyOverlays();
    renderStagedContingencyList();
    if (contingencyResultCard) contingencyResultCard.classList.add('hidden');
    if (contingencyStaleWarning) contingencyStaleWarning.classList.add('hidden');
    if (adaptiveReplanCard) adaptiveReplanCard.classList.add('hidden');
    if (adaptiveReplanStaleWarning) adaptiveReplanStaleWarning.classList.add('hidden');
    clearDetour();
    setPlanningStatus("Custom contingency events reset to baseline.", "normal");
  }

  function markContingencyStale() {
    if (activeContingencyResult) {
      isContingencyStale = true;
      if (contingencyStaleWarning) contingencyStaleWarning.classList.remove('hidden');
    }
    if (activeAdaptiveResult) {
      isAdaptiveStale = true;
      if (adaptiveReplanStaleWarning) adaptiveReplanStaleWarning.classList.remove('hidden');
    }
  }

  async function simulateCustomContingency() {
    if (!stagedContingencyEvents || stagedContingencyEvents.length === 0) {
      setPlanningStatus("No custom events staged. Add at least one event before simulating.", "error");
      return;
    }
    const enabledEvents = stagedContingencyEvents.filter(e => e.enabled);
    if (enabledEvents.length === 0) {
      setPlanningStatus("All custom events are disabled. Enable at least one event.", "error");
      return;
    }

    if (btnSimulateContingency) {
      btnSimulateContingency.disabled = true;
      btnSimulateContingency.innerHTML = '&#9881; Calculating Contingency Traverse...';
    }
    setPlanningStatus("Evaluating custom contingency simulation via A* engine...", "calculating");

    try {
      const payload = {
        start: { row: customStart.row, col: customStart.col, name: customStart.name },
        goal: { row: customGoal.row, col: customGoal.col, name: customGoal.name },
        profile: currentProfile,
        vehicle_mode: currentVehicleMode,
        speed_multiplier: 1.0,
        dwell_time_per_stop_s: (parseFloat(inputDwellMins ? inputDwellMins.value : 15) || 15) * 60.0,
        operational_delay_s: (parseFloat(inputDelayMins ? inputDelayMins.value : 0) || 0) * 60.0,
        operational_limit_s: (parseFloat(inputExpeditionHours ? inputExpeditionHours.value : 8.0) || 8.0) * 3600.0,
        max_distance_m: (inputMaxDistanceM && inputMaxDistanceM.value) ? parseFloat(inputMaxDistanceM.value) : null,
        stops: activeIntermediateStops.map((s, idx) => ({
          id: s.id || `stop_${idx + 1}`,
          name: s.name || `Stop ${idx + 1}`,
          row: s.row,
          col: s.col,
          priority_score: s.priority_score || 50.0
        })),
        custom_events: enabledEvents
      };

      const response = await fetch('/api/contingency/simulate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!response.ok) {
        const errJson = await response.json();
        throw new Error(errJson.message || `HTTP ${response.status}`);
      }

      const data = await response.json();
      activeContingencyResult = data;
      isContingencyStale = false;

      // Update UI cards
      if (contingencyStaleWarning) contingencyStaleWarning.classList.add('hidden');
      if (contingencyHeadline) contingencyHeadline.textContent = data.headline;
      if (contingencyDetail) contingencyDetail.textContent = data.detail;

      // Render 8-row comparison table
      if (contingencyTableBody && data.comparison_table) {
        contingencyTableBody.innerHTML = '';
        data.comparison_table.forEach(row => {
          const tr = document.createElement('tr');
          const isFeasRow = row.metric === 'Mission feasibility';
          let statusClass = '';
          if (isFeasRow) {
            statusClass = row.scenario === 'FEASIBLE' ? 'status-ok' : 'status-fail';
          }
          tr.innerHTML = `
            <td><strong>${row.metric}</strong></td>
            <td>${row.baseline}</td>
            <td class="${statusClass}">${row.scenario}</td>
            <td style="color:${row.is_improved === true ? '#00E676' : (row.is_improved === false ? '#FF5252' : 'inherit')}">${row.difference}</td>
          `;
          contingencyTableBody.appendChild(tr);
        });
      }

      // Draw 3D Overlays and Detour Route
      if (data.geographic_overlays) {
        renderContingency3DOverlays(data.geographic_overlays);
      }

      if (data.is_scenario_reachable && data.scenario_route && data.scenario_route.path_rc && data.scenario_route.path_rc.length > 0) {
        drawDetourRoute(data.scenario_route.path_rc);
      } else {
        clearDetour();
      }

      if (contingencyResultCard) contingencyResultCard.classList.remove('hidden');
      setPlanningStatus(`Contingency evaluated successfully: ${data.headline}`, "success");
    } catch (err) {
      console.error("Contingency simulation failed:", err);
      setPlanningStatus(`Contingency calculation failed: ${err.message}`, "error");
    } finally {
      if (btnSimulateContingency) {
        btnSimulateContingency.disabled = false;
        btnSimulateContingency.innerHTML = '&#9889; Simulate Contingency';
      }
    }
  }

  async function saveContingencyAsExperiment() {
    if (!activeContingencyResult) {
      setPlanningStatus("No calculated contingency result to save.", "error");
      return;
    }
    const expName = `Contingency: ${activeContingencyResult.scenario ? activeContingencyResult.scenario.name : 'Custom Disruption'}`;
    const snapshot = (activeContingencyResult.baseline_route && activeContingencyResult.baseline_route.mission_snapshot) ? activeContingencyResult.baseline_route.mission_snapshot : {
      schema_version: "1.0.0",
      canonical_mission: {
        start: customStart,
        goal: customGoal,
        stops: activeIntermediateStops,
        profile: currentProfile,
        vehicle_mode: currentVehicleMode
      }
    };

    const payload = {
      schema_version: "1.0.0",
      name: expName,
      description: `Interactive contingency simulation: ${activeContingencyResult.headline || ''}`,
      mission_id: activeSavedMissionId || undefined,
      status: activeContingencyResult.is_scenario_budget_feasible ? "success" : "infeasible",
      lifecycle_state: "historical_result",
      baseline_fingerprint: activeContingencyResult.baseline_fingerprint || "",
      mission_snapshot: snapshot,
      baseline_route: activeContingencyResult.baseline_route,
      scenario_route: activeContingencyResult.scenario_route,
      scenarios_evaluated: [
        {
          scenario_id: activeContingencyResult.scenario ? activeContingencyResult.scenario.id : "custom_contingency",
          name: activeContingencyResult.scenario ? activeContingencyResult.scenario.name : "Custom Contingency",
          is_reachable: activeContingencyResult.is_scenario_reachable,
          is_budget_feasible: activeContingencyResult.is_scenario_budget_feasible,
          distance_m: activeContingencyResult.scenario_route ? activeContingencyResult.scenario_route.distance_m : 0.0,
          cost: activeContingencyResult.scenario_route ? activeContingencyResult.scenario_route.cost : 0.0,
          delta_distance_m: activeContingencyResult.delta_distance_m,
          delta_cost: activeContingencyResult.delta_cost,
          delta_travel_time_s: activeContingencyResult.delta_travel_time_s,
          headline: activeContingencyResult.headline,
          detail: activeContingencyResult.detail
        }
      ],
      recovery_plan: activeContingencyResult.recovery_plan || null,
      custom_contingency: {
        events: activeContingencyResult.events,
        comparison_table: activeContingencyResult.comparison_table
      },
      reproducibility_notes: `Custom contingency simulation recorded on ${new Date().toISOString()}.`,
      terrain_dataset_id: "USGS_CTX_DTM_JEZERO_20M",
      model_version: "2.0.0",
      assumptions_version: "1.0.0"
    };

    try {
      const resp = await fetch('/api/experiments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const res = await resp.json();
      if (!resp.ok) throw new Error(res.message || res.error || `HTTP ${resp.status}`);

      setPlanningStatus(`EXPERIMENT PERSISTED: ${res.name} (ID: ${res.experiment_id})`, "success");
      refreshExperimentLibraryTable();
      return res;
    } catch (err) {
      console.error('[MarsWalk Atlas] Save contingency experiment error:', err);
      setPlanningStatus(`Failed to save experiment: ${err.message}`, "error");
      return null;
    }
  }

  // Milestone 9W: Adaptive Mission Replanning & Science Recovery Implementation
  async function executeAdaptiveReplanning() {
    if (currentViewMode !== 'jezero') {
      setPlanningStatus("Adaptive replanning is confined to the surveyed Jezero Crater study area.", "error");
      return;
    }
    if (!customStart || !customGoal) {
      setPlanningStatus("Please set departure and destination endpoints before replanning.", "error");
      return;
    }
    const enabledEvents = stagedContingencyEvents.filter(e => e.enabled);
    if (enabledEvents.length === 0) {
      setPlanningStatus("No active contingency events staged. Configure an event in Contingency Designer.", "warning");
      return;
    }

    if (btnAdaptiveReplan) {
      btnAdaptiveReplan.disabled = true;
      btnAdaptiveReplan.innerHTML = '&#9881; Re-optimizing Tour Under Disruption...';
    }
    setPlanningStatus("Evaluating 3-stage adaptive replanning & science recovery...", "calculating");

    try {
      const opHours = parseFloat(inputExpeditionHours ? inputExpeditionHours.value : 8.0) || 8.0;
      const dwellMins = parseFloat(inputDwellMins ? inputDwellMins.value : 15.0) || 15.0;
      const delayMins = parseFloat(inputDelayMins ? inputDelayMins.value : 0.0) || 0.0;
      const maxDistM = (inputMaxDistanceM && inputMaxDistanceM.value) ? parseFloat(inputMaxDistanceM.value) : null;
      const maxStops = parseInt(mdlMaxStops ? mdlMaxStops.value : 3) || 3;
      const objectiveFocus = mdlObjective ? mdlObjective.value : 'balanced';

      // Build candidate targets list
      let candidateTargets = [];
      if (missionData && missionData.waypoints) {
        candidateTargets = missionData.waypoints
          .filter(w => {
            if (mdlSelectedTargetIds && mdlSelectedTargetIds.size > 0) {
              return mdlSelectedTargetIds.has(w.id);
            }
            return (w.row !== customStart.row || w.col !== customStart.col) &&
                   (w.row !== customGoal.row || w.col !== customGoal.col);
          })
          .map(w => ({
            id: w.id,
            name: w.name,
            row: w.row,
            col: w.col,
            priority_score: w.priority_score || 50.0
          }));
      }

      const payload = {
        start: { row: customStart.row, col: customStart.col, name: customStart.name },
        goal: { row: customGoal.row, col: customGoal.col, name: customGoal.name },
        profile: currentProfile,
        vehicle_mode: currentVehicleMode,
        speed_multiplier: 1.0,
        dwell_time_per_stop_s: dwellMins * 60.0,
        operational_delay_s: delayMins * 60.0,
        operational_limit_s: opHours * 3600.0,
        max_distance_m: maxDistM,
        stops: activeIntermediateStops.map((s, idx) => ({
          id: s.id || `stop_${idx + 1}`,
          name: s.name || `Stop ${idx + 1}`,
          row: s.row,
          col: s.col,
          priority_score: s.priority_score || 50.0
        })),
        candidate_targets: candidateTargets,
        max_stops: maxStops,
        objective: objectiveFocus,
        custom_events: enabledEvents
      };

      const resp = await fetch('/api/mission/replan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.message || `HTTP ${resp.status}`);
      }

      const result = await resp.json();
      activeAdaptiveResult = result;
      isAdaptiveStale = false;

      renderAdaptiveResult(result);

      // Render hazard overlays if provided
      if (result.geographic_overlays) {
        renderContingency3DOverlays(result.geographic_overlays);
      }

      // Preview the adaptive route on 3D terrain
      if (result.adaptive_plan && result.adaptive_plan.route && result.adaptive_plan.route.path_rc) {
        drawDetourRoute(result.adaptive_plan.route.path_rc);
      }

      setPlanningStatus(`Adaptive replanning complete: ${result.recommendation.replace(/_/g, ' ').toUpperCase()}`, "success");
    } catch (err) {
      console.error("[MarsWalk Atlas] Adaptive replanning failed:", err);
      setPlanningStatus(`Adaptive replanning failed: ${err.message}`, "error");
    } finally {
      if (btnAdaptiveReplan) {
        btnAdaptiveReplan.disabled = false;
        btnAdaptiveReplan.innerHTML = '&#9889; ADAPTIVE REPLAN &amp; SCIENCE RECOVERY';
      }
    }
  }

  function renderAdaptiveResult(result) {
    if (!result || !adaptiveReplanCard) return;
    adaptiveReplanCard.classList.remove('hidden');
    if (adaptiveReplanStaleWarning) adaptiveReplanStaleWarning.classList.add('hidden');

    const rec = result.recommendation || 'replace_with_adaptive_tour';
    const rationale = result.recommendation_rationale || '';
    const recText = rec.replace(/_/g, ' ').toUpperCase();

    if (adaptiveRecommendationBadge) {
      adaptiveRecommendationBadge.textContent = recText;
      let badgeBg = 'rgba(0, 229, 255, 0.15)';
      let badgeColor = 'var(--telemetry-cyan)';
      let badgeBorder = 'rgba(0, 229, 255, 0.3)';
      if (rec === 'replace_with_adaptive_tour') {
        badgeBg = 'rgba(0, 230, 118, 0.15)';
        badgeColor = 'var(--status-green)';
        badgeBorder = 'rgba(0, 230, 118, 0.35)';
      } else if (rec === 'continue_with_detour') {
        badgeBg = 'rgba(255, 179, 0, 0.15)';
        badgeColor = '#FFD54F';
        badgeBorder = 'rgba(255, 179, 0, 0.35)';
      } else if (rec === 'drop_target_and_proceed') {
        badgeBg = 'rgba(255, 111, 0, 0.15)';
        badgeColor = '#FFA726';
        badgeBorder = 'rgba(255, 111, 0, 0.35)';
      } else if (rec === 'unresolvable_critical_hazard' || rec === 'abort_to_direct_baseline') {
        badgeBg = 'rgba(255, 82, 82, 0.15)';
        badgeColor = '#FF5252';
        badgeBorder = 'rgba(255, 82, 82, 0.35)';
      }
      adaptiveRecommendationBadge.style.background = badgeBg;
      adaptiveRecommendationBadge.style.color = badgeColor;
      adaptiveRecommendationBadge.style.borderColor = badgeBorder;
    }

    if (adaptiveRecommendationRationale) {
      adaptiveRecommendationRationale.textContent = rationale;
    }

    const orig = result.original_plan || {};
    const disr = result.disrupted_plan || {};
    const adapt = result.adaptive_plan || {};
    const recov = result.science_recovery || {};

    const formatMins = (secs) => {
      if (typeof secs !== 'number' || isNaN(secs) || secs < 0) return '0 min';
      const m = Math.round(secs / 60);
      const h = Math.floor(m / 60);
      const remM = m % 60;
      return h > 0 ? `${h}h ${remM}m` : `${remM}m`;
    };

    // Stage 1: Original
    if (adOrigScience) adOrigScience.textContent = `${Math.round(orig.total_science_priority || 0)} pts`;
    if (adOrigStops) adOrigStops.textContent = `${orig.num_stops || 0}`;
    if (adOrigDistance) adOrigDistance.textContent = `${Math.round(orig.distance_m || 0)} m`;
    if (adOrigTime) adOrigTime.textContent = formatMins(orig.total_mission_time_s || 0);
    if (adOrigStatus) {
      adOrigStatus.textContent = orig.is_budget_feasible ? 'FEASIBLE' : 'OVER-BUDGET';
      adOrigStatus.className = orig.is_budget_feasible ? 'stat-badge status-ok' : 'stat-badge status-fail';
    }
    if (adOrigItinerary) {
      const origStops = (orig.stops && orig.stops.length > 0) ? orig.stops.map(s => s.name).join(' → ') : 'Direct traverse';
      adOrigItinerary.textContent = origStops;
    }

    // Stage 2: Disrupted
    if (adDisrScience) adDisrScience.textContent = `${Math.round(disr.total_science_priority || 0)} pts`;
    if (adDisrLost) adDisrLost.textContent = `-${Math.round(recov.priority_lost || 0)} pts`;
    if (adDisrDistance) adDisrDistance.textContent = `${Math.round(disr.distance_m || 0)} m`;
    if (adDisrTime) adDisrTime.textContent = formatMins(disr.total_mission_time_s || 0);
    if (adDisrStatus) {
      const isOk = disr.is_budget_feasible && disr.status !== 'unreachable';
      adDisrStatus.textContent = disr.status === 'unreachable' ? 'BLOCKED' : (disr.is_budget_feasible ? 'FEASIBLE' : 'OVER-BUDGET');
      adDisrStatus.className = isOk ? 'stat-badge status-ok' : 'stat-badge status-fail';
    }
    if (adDisrItinerary) {
      const disrStops = (disr.stops && disr.stops.length > 0) ? disr.stops.map(s => s.name).join(' → ') : (disr.status === 'unreachable' ? 'Route blocked' : 'Direct traverse');
      adDisrItinerary.textContent = disrStops;
    }

    // Stage 3: Adaptive
    if (adAdaptScience) adAdaptScience.textContent = `${Math.round(adapt.total_science_priority || 0)} pts`;
    if (adAdaptRecovered) adAdaptRecovered.textContent = `+${Math.round(recov.priority_recovered || 0)} pts`;
    if (adAdaptDistance) adAdaptDistance.textContent = `${Math.round(adapt.distance_m || 0)} m`;
    if (adAdaptTime) adAdaptTime.textContent = formatMins(adapt.total_mission_time_s || 0);
    if (adAdaptMargin) {
      const marginMins = Math.round((adapt.margin_s || 0) / 60);
      adAdaptMargin.textContent = `${marginMins >= 0 ? '+' : ''}${marginMins}m`;
      adAdaptMargin.style.color = marginMins >= 0 ? 'var(--status-green)' : '#FF5252';
    }
    if (adAdaptItinerary) {
      const adaptStops = (adapt.stops && adapt.stops.length > 0) ? adapt.stops.map(s => s.name).join(' → ') : 'Direct baseline';
      adAdaptItinerary.textContent = adaptStops;
    }

    // Science Recovery Ledger
    if (adRecoveryEfficiencyBadge) {
      const eff = recov.recovery_efficiency_pct !== undefined ? recov.recovery_efficiency_pct : 0;
      adRecoveryEfficiencyBadge.textContent = `${eff.toFixed(0)}% RECOVERED`;
    }
    if (adRetainedStops) {
      adRetainedStops.textContent = (recov.retained_stops && recov.retained_stops.length > 0) ? recov.retained_stops.join(', ') : 'None';
    }
    if (adDroppedStops) {
      adDroppedStops.textContent = (recov.dropped_stops && recov.dropped_stops.length > 0) ? recov.dropped_stops.join(', ') : 'None';
    }
    if (adAddedStops) {
      adAddedStops.textContent = (recov.newly_added_stops && recov.newly_added_stops.length > 0) ? recov.newly_added_stops.join(', ') : 'None';
    }
  }

  function applyAdaptivePlanToActiveMission() {
    if (!activeAdaptiveResult || !activeAdaptiveResult.adaptive_plan) {
      setPlanningStatus("No calculated adaptive plan available to apply.", "warning");
      return;
    }
    const adaptStops = activeAdaptiveResult.adaptive_plan.stops || [];
    activeIntermediateStops = adaptStops.map((s, idx) => ({
      id: s.id || `stop_${idx + 1}`,
      name: s.name || `Stop ${idx + 1}`,
      row: s.row,
      col: s.col,
      priority_score: s.priority_score || 50.0
    }));

    renderActiveStopsList();
    markStale();
    markMdlStale();

    // Recalculate baseline traverse route with the new stops sequence
    calculateTraverseRoute();
    setPlanningStatus(`Adaptive tour (${adaptStops.length} stops) applied to active mission. Recalculating route...`, "success");
  }

  function previewAdaptive3DRoute() {
    if (!activeAdaptiveResult || !activeAdaptiveResult.adaptive_plan || !activeAdaptiveResult.adaptive_plan.route) {
      setPlanningStatus("No adaptive plan route geometry available to preview.", "warning");
      return;
    }
    const path = activeAdaptiveResult.adaptive_plan.route.path_rc;
    if (path && path.length > 0) {
      drawDetourRoute(path);
      setPlanningStatus(`Previewing adaptive route (${path.length} waypoints) on 3D terrain.`, "success");
    } else {
      setPlanningStatus("Adaptive route has no valid path coordinates.", "error");
    }
  }

  // Milestone 9X: Mission Robustness Lab & Sensitivity Analysis
  function markRobustnessStale() {
    isRobustnessStale = true;
    if (robStaleBanner) {
      robStaleBanner.classList.remove('hidden');
    }
  }

  async function executeMissionRobustnessAnalysis() {
    if (currentViewMode !== 'jezero') {
      setPlanningStatus("Mission Robustness analysis is confined to the surveyed Jezero Crater study area.", "error");
      return;
    }
    if (!customStart || !customGoal) {
      setPlanningStatus("Please set departure and destination endpoints before evaluating robustness.", "error");
      return;
    }

    if (btnRunRobustness) {
      btnRunRobustness.disabled = true;
      btnRunRobustness.innerHTML = '&#9881; Evaluating Robustness Matrix...';
    }
    setPlanningStatus("Evaluating deterministic mission robustness & sensitivity matrix...", "calculating");

    try {
      const opHours = parseFloat(inputExpeditionHours ? inputExpeditionHours.value : 8.0) || 8.0;
      const dwellMins = parseFloat(inputDwellMins ? inputDwellMins.value : 15.0) || 15.0;
      const delayMins = parseFloat(inputDelayMins ? inputDelayMins.value : 0.0) || 0.0;
      const maxDistM = (inputMaxDistanceM && inputMaxDistanceM.value) ? parseFloat(inputMaxDistanceM.value) : null;
      const preset = selectRobustnessPreset ? selectRobustnessPreset.value : 'standard';

      let sensitivitySpec = {};
      if (preset === 'budget_sweep') {
        const nomS = opHours * 3600.0;
        sensitivitySpec = {
          budget_limits_s: [nomS * 0.5, nomS * 0.75, nomS * 1.0, nomS * 1.25]
        };
      }

      // If Mission Design Lab has generated alternatives, pass them for comparison!
      let comparisonCandidates = [];
      if (mdlActiveReport && mdlActiveReport.candidates && mdlActiveReport.candidates.length > 0) {
        comparisonCandidates = mdlActiveReport.candidates.slice(0, 4).map(c => ({
          id: c.id,
          title: c.title,
          stop_ids: c.stop_ids
        }));
      }

      const payload = {
        start: { row: customStart.row, col: customStart.col, name: customStart.name },
        goal: { row: customGoal.row, col: customGoal.col, name: customGoal.name },
        profile: currentProfile,
        vehicle_mode: currentVehicleMode,
        speed_multiplier: 1.0,
        dwell_time_per_stop_s: dwellMins * 60.0,
        operational_delay_s: delayMins * 60.0,
        operational_limit_s: opHours * 3600.0,
        max_distance_m: maxDistM,
        stops: activeIntermediateStops.map((s, idx) => ({
          id: s.id || `stop_${idx + 1}`,
          name: s.name || `Stop ${idx + 1}`,
          row: s.row,
          col: s.col,
          priority_score: s.priority_score || 50.0
        })),
        sensitivity_spec: Object.keys(sensitivitySpec).length > 0 ? sensitivitySpec : undefined,
        comparison_candidates: comparisonCandidates.length > 0 ? comparisonCandidates : undefined,
      };

      const resp = await fetch('/api/mission/robustness', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.message || `HTTP ${resp.status}`);
      }

      const result = await resp.json();
      activeRobustnessResult = result;
      isRobustnessStale = false;
      if (robStaleBanner) robStaleBanner.classList.add('hidden');

      renderRobustnessResult(result);
      setPlanningStatus(`Robustness analysis completed (${result.primary_evaluation.cases_tested} cases evaluated in ${Math.round(result.execution_time_ms)}ms).`, "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Robustness analysis error:', err);
      setPlanningStatus(`Robustness analysis failed: ${err.message}`, "error");
    } finally {
      if (btnRunRobustness) {
        btnRunRobustness.disabled = false;
        btnRunRobustness.innerHTML = '&#9889; ANALYZE ROBUSTNESS';
      }
    }
  }

  function renderRobustnessResult(data) {
    if (!data || !data.primary_evaluation) return;
    const pe = data.primary_evaluation;

    if (robResultsContainer) robResultsContainer.classList.remove('hidden');

    if (robStatCases) robStatCases.textContent = `${pe.cases_tested}`;
    if (robStatFeasible) {
      robStatFeasible.textContent = `${pe.feasible_pct}% (${pe.feasible_cases_count}/${pe.cases_tested})`;
      robStatFeasible.style.color = pe.feasible_ratio >= 0.75 ? 'var(--status-green)' : (pe.feasible_ratio >= 0.5 ? 'var(--data-route-amber)' : '#ff5252');
    }
    if (robStatReachable) {
      robStatReachable.textContent = `${pe.reachable_pct}% (${pe.reachable_cases_count}/${pe.cases_tested})`;
    }
    if (robStatMinMargin) {
      const minM = Math.round(pe.min_margin_s / 60);
      robStatMinMargin.textContent = `${minM >= 0 ? '+' : ''}${minM} min`;
      robStatMinMargin.style.color = minM >= 0 ? 'var(--status-green)' : '#ff5252';
    }
    if (robStatDurationRange && pe.duration_range_s) {
      const minH = (pe.duration_range_s[0] / 3600).toFixed(1);
      const maxH = (pe.duration_range_s[1] / 3600).toFixed(1);
      robStatDurationRange.textContent = `${minH}h – ${maxH}h`;
    }
    if (robStatDecisionStability) {
      robStatDecisionStability.textContent = `${pe.decision_stable_pct}%`;
    }

    // Render Breakpoints
    if (robBreakpointsList) {
      robBreakpointsList.innerHTML = '';
      const bps = pe.breakpoints || [];
      if (robBreakpointCount) robBreakpointCount.textContent = `${bps.length} DETECTED`;

      if (bps.length === 0) {
        robBreakpointsList.innerHTML = '<div style="color:var(--text-tertiary); font-style:italic;">No transition breakpoints observed across tested parameter ranges.</div>';
      } else {
        bps.forEach(bp => {
          const card = document.createElement('div');
          card.className = 'rob-breakpoint-card';
          card.innerHTML = `
            <div style="font-weight:600; color:var(--data-route-amber);">${escapeHtml(bp.description)}</div>
            <div style="color:var(--text-secondary); margin-top:2px;">${escapeHtml(bp.explanation)}</div>
            <div style="color:var(--text-tertiary); font-size:7.5px; margin-top:2px;">Resolution: ${escapeHtml(bp.tested_resolution)}</div>
          `;
          robBreakpointsList.appendChild(card);
        });
      }
    }

    // Render Candidate Comparisons
    if (robComparisonSection && robComparisonTable) {
      const comps = data.candidate_comparisons || [];
      if (comps.length > 0) {
        robComparisonSection.classList.remove('hidden');
        let html = `
          <table style="width:100%; border-collapse:collapse; text-align:left;">
            <thead>
              <tr style="border-bottom:1px solid rgba(255,255,255,0.1); color:var(--text-tertiary);">
                <th style="padding:2px 4px;">Candidate</th>
                <th style="padding:2px 4px;">Science</th>
                <th style="padding:2px 4px;">Feasible %</th>
                <th style="padding:2px 4px;">Min Margin</th>
              </tr>
            </thead>
            <tbody>
        `;
        comps.forEach(c => {
          const minM = Math.round(c.min_margin_s / 60);
          html += `
            <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
              <td style="padding:3px 4px; color:var(--telemetry-cyan); font-weight:600;">${escapeHtml(c.candidate_title)}</td>
              <td style="padding:3px 4px;">${c.nominal_science_score} pts</td>
              <td style="padding:3px 4px; color:${c.feasible_ratio >= 0.75 ? 'var(--status-green)' : 'var(--data-route-amber)'};">${c.feasible_pct}%</td>
              <td style="padding:3px 4px;">${minM >= 0 ? '+' : ''}${minM}m</td>
            </tr>
          `;
        });
        html += `</tbody></table>`;
        robComparisonTable.innerHTML = html;
      } else {
        robComparisonSection.classList.add('hidden');
      }
    }

    // Render Tested Cases Table
    if (robCasesTableBody) {
      robCasesTableBody.innerHTML = '';
      const cases = pe.case_results || [];
      cases.forEach(cr => {
        const tr = document.createElement('tr');
        const durMin = Math.round(cr.total_mission_time_s / 60);
        const marMin = Math.round(cr.remaining_margin_s / 60);
        tr.innerHTML = `
          <td style="padding:3px 4px;" title="${escapeHtml(cr.description)}">${escapeHtml(cr.case_id)}</td>
          <td style="padding:3px 4px; color:${cr.is_feasible ? 'var(--status-green)' : '#ff5252'}; font-weight:600;">${cr.is_feasible ? 'YES' : 'NO'}</td>
          <td style="padding:3px 4px;">${durMin}m</td>
          <td style="padding:3px 4px; color:${marMin >= 0 ? 'var(--status-green)' : '#ff5252'};">${marMin >= 0 ? '+' : ''}${marMin}m</td>
          <td style="padding:3px 4px; color:${cr.geometry_changed ? 'var(--data-route-amber)' : 'var(--text-tertiary)'};">${cr.geometry_changed ? 'Detour' : 'Invariant'}</td>
        `;
        tr.style.cursor = 'pointer';
        tr.addEventListener('click', () => {
          if (cr.explanation) {
            setPlanningStatus(`[${cr.case_id}] ${cr.explanation}`, cr.is_feasible ? "success" : "warning");
          }
          if (cr.path_rc && cr.path_rc.length > 0) {
            drawDetourRoute(cr.path_rc);
          }
        });
        robCasesTableBody.appendChild(tr);
      });
    }
  }

  // ==========================================================================
  // Milestone 9Y: Route Decision Intelligence & Cost Attribution Engine
  // ==========================================================================
  function setRouteExplanationStale(isStale) {
    isRouteExplanationStale = Boolean(isStale);
    if (explainStaleBanner) {
      if (isRouteExplanationStale && activeRouteExplanationResult) {
        explainStaleBanner.classList.remove('hidden');
      } else {
        explainStaleBanner.classList.add('hidden');
      }
    }
  }

  function highlightRouteSegment(subpath) {
    if (!missionData || !jezeroSurfaceGroup) return;
    if (highlightedSegmentLineMesh) {
      jezeroSurfaceGroup.remove(highlightedSegmentLineMesh);
      highlightedSegmentLineMesh = null;
    }
    if (!subpath || subpath.length < 2) return;

    const points = subpath.map(rc => {
      const r = rc[0];
      const c = rc[1];
      const elev = (missionData.elevation_samples && missionData.elevation_samples[r]) ? missionData.elevation_samples[r][c] : -2500;
      const pos = rcToLocalPos(r, c, elev, currentExaggeration);
      pos.y += 12.0; // Float slightly above live route
      return pos;
    });

    const geom = new THREE.BufferGeometry().setFromPoints(points);
    const mat = new THREE.LineBasicMaterial({
      color: 0xff1744, // Vibrant high-contrast magenta-red
      linewidth: 4,
      depthTest: true
    });
    highlightedSegmentLineMesh = new THREE.Line(geom, mat);
    highlightedSegmentLineMesh.renderOrder = 25;
    jezeroSurfaceGroup.add(highlightedSegmentLineMesh);
  }

  function clearHighlightedSegment() {
    if (highlightedSegmentLineMesh && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(highlightedSegmentLineMesh);
      highlightedSegmentLineMesh = null;
    }
  }

  async function executeRouteExplanation() {
    if (!customStart || !customGoal) {
      setPlanningStatus("Please set departure and destination endpoints before explaining route cost.", "error");
      return;
    }

    if (btnExplainRoute) {
      btnExplainRoute.disabled = true;
      btnExplainRoute.innerHTML = '&#9881; Decomposing Terrain Cost...';
    }
    setPlanningStatus("Decomposing route traversal effort into physical terrain cost factors...", "calculating");

    try {
      const payload = {
        start: { row: customStart.row, col: customStart.col },
        goal: { row: customGoal.row, col: customGoal.col },
        profile: currentProfile,
        vehicle_mode: currentVehicleMode,
        speed_multiplier: 1.0,
        num_segments: 10,
        stops: activeIntermediateStops.map((s, idx) => ({
          id: s.id || `stop_${idx + 1}`,
          name: s.name || `Stop ${idx + 1}`,
          row: s.row,
          col: s.col,
        })),
      };

      // If active baseline route already exists with path, send it directly to avoid recalculation
      if (activeBaselineRouteResult && activeBaselineRouteResult.path_rc && activeBaselineRouteResult.path_rc.length > 0) {
        payload.route = {
          path: activeBaselineRouteResult.path_rc,
          distance_m: activeBaselineRouteResult.distance_m,
          cost: activeBaselineRouteResult.cost,
          profile: currentProfile,
          vehicle_mode: currentVehicleMode,
          speed_multiplier: 1.0,
          legs: activeBaselineRouteResult.legs || undefined,
        };
      }

      // Check for comparison route (e.g. active contingency detour)
      const shouldCompare = chkExplainCompareDetour ? chkExplainCompareDetour.checked : true;
      if (shouldCompare && activeContingencyResult && activeContingencyResult.scenario_route && activeContingencyResult.scenario_route.path_rc) {
        payload.alternative_route = {
          path: activeContingencyResult.scenario_route.path_rc,
          distance_m: activeContingencyResult.scenario_route.distance_m,
          cost: activeContingencyResult.scenario_route.cost,
          profile: currentProfile,
          vehicle_mode: currentVehicleMode,
          speed_multiplier: activeContingencyResult.scenario ? activeContingencyResult.scenario.speed_multiplier : 1.0,
        };
        payload.reference_title = "Nominal Baseline Route";
        payload.alternative_title = (activeContingencyResult.scenario && activeContingencyResult.scenario.name) ? activeContingencyResult.scenario.name : "Contingency Detour";
      }

      const resp = await fetch('/api/route/explain', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.message || `HTTP ${resp.status}`);
      }

      const result = await resp.json();
      activeRouteExplanationResult = result;
      setRouteExplanationStale(false);

      renderRouteExplanation(result);
      setPlanningStatus(`Route cost attribution completed: ${result.segments.length} segments analyzed (${result.cost_density_ratio.toFixed(2)}x effort ratio).`, "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Route explanation error:', err);
      setPlanningStatus(`Route explanation failed: ${err.message}`, "error");
    } finally {
      if (btnExplainRoute) {
        btnExplainRoute.disabled = false;
        btnExplainRoute.innerHTML = '&#9889; EXPLAIN ROUTE COST';
      }
    }
  }

  function renderRouteExplanation(data) {
    if (!data) return;
    if (explainResultsContainer) explainResultsContainer.classList.remove('hidden');

    const ledger = data.reconciliation_ledger;
    if (ledger) {
      if (explainTotalDist) explainTotalDist.textContent = `${data.total_distance_m.toFixed(1)} m`;
      if (explainTotalCost) explainTotalCost.textContent = `${data.total_cost_m.toFixed(1)} flat-m`;
      if (explainDensityRatio) explainDensityRatio.textContent = `${data.cost_density_ratio.toFixed(2)}x`;

      if (explainReconciledBadge) {
        if (ledger.is_reconciled) {
          explainReconciledBadge.textContent = 'STRICTLY RECONCILED';
          explainReconciledBadge.style.color = 'var(--status-green)';
          explainReconciledBadge.style.borderColor = 'rgba(0,230,118,0.3)';
          explainReconciledBadge.style.background = 'rgba(0,230,118,0.15)';
        } else {
          explainReconciledBadge.textContent = 'RECONCILIATION DELTA';
          explainReconciledBadge.style.color = 'var(--data-route-amber)';
        }
      }

      const cs = ledger.component_sums_m || {};
      if (compBaseDist) compBaseDist.textContent = `${Math.round(cs.base_distance || 0)}m`;
      if (compSlope) compSlope.textContent = `${Math.round(cs.slope || 0)}m`;
      if (compRough) compRough.textContent = `${Math.round(cs.roughness || 0)}m`;
      if (compUphill) compUphill.textContent = `${Math.round(cs.uphill || 0)}m`;
    }

    // Top Bottleneck Segments
    if (explainBottlenecksList) {
      explainBottlenecksList.innerHTML = '';
      const bns = data.highest_cost_segments || [];
      bns.forEach(b => {
        const segObj = (data.segments && data.segments[b.segment_index]) ? data.segments[b.segment_index] : null;
        const card = document.createElement('div');
        card.className = 'bottleneck-card';
        card.innerHTML = `
          <div class="bottleneck-card-header">
            <span style="font-weight:600; color:var(--text-primary);">
              #${b.rank} Segment ${b.segment_index + 1} (${segObj && segObj.leg_id ? escapeHtml(segObj.leg_id) : 'Nominal'})
            </span>
            <div style="display:flex; gap:4px; align-items:center;">
              <span class="wp-badge" style="font-size:7px; background:rgba(255,100,100,0.15); color:rgba(255,140,140,1);">
                ${escapeHtml(b.dominant_factor.toUpperCase())}
              </span>
              <button class="btn-inspect-segment" title="Highlight this segment on 3D terrain mesh">&#9678; Highlight 3D</button>
            </div>
          </div>
          <div style="display:flex; justify-content:space-between; font-size:8px; color:var(--text-tertiary);">
            <span>Cost: <strong style="color:var(--data-route-amber);">${b.cost_m.toFixed(1)} flat-m</strong> (${b.cost_fraction_pct.toFixed(1)}%)</span>
            <span>Impedance: <strong style="color:var(--telemetry-cyan);">${b.cost_density.toFixed(2)}x</strong></span>
          </div>
          <div style="font-size:8px; color:var(--text-secondary); line-height:1.25; margin-top:1px;">
            ${escapeHtml(b.operational_impact)}
          </div>
          <div style="font-size:7.5px; color:var(--text-tertiary); font-style:italic; line-height:1.2;">
            &#128161; ${escapeHtml(b.mitigation_hint)}
          </div>
        `;

        const btnHighlight = card.querySelector('.btn-inspect-segment');
        if (btnHighlight && segObj && segObj.subpath && segObj.subpath.length > 0) {
          btnHighlight.addEventListener('click', (ev) => {
            ev.stopPropagation();
            highlightRouteSegment(segObj.subpath);
            setPlanningStatus(`Highlighted Segment ${b.segment_index + 1} on 3D surface: ${b.cost_m.toFixed(1)}m traversal effort (${b.dominant_factor}).`, "info");
          });
        }
        explainBottlenecksList.appendChild(card);
      });
    }

    // Decision Rationale
    const dr = data.decision_rationale;
    if (dr) {
      if (explainRationaleNarrative) {
        explainRationaleNarrative.textContent = dr.full_narrative || dr.objective_description || '';
      }
      if (explainHazardsAvoided) {
        const haz = dr.hazards_avoided || [];
        explainHazardsAvoided.innerHTML = haz.map(h => `&bull; Avoided: ${escapeHtml(h)}`).join('<br>');
      }
    }

    // Comparison Section
    if (explainComparisonSection) {
      if (data.comparison) {
        explainComparisonSection.classList.remove('hidden');
        const c = data.comparison;
        if (explainComparisonSummary) {
          explainComparisonSummary.textContent = c.geometry_change_summary || '';
        }
        if (explainComparisonVerdict) {
          explainComparisonVerdict.textContent = c.tradeoff_verdict || '';
        }
      } else {
        explainComparisonSection.classList.add('hidden');
      }
    }
  }


  // ==========================================================================
  // Milestone 9Z: Mission Timeline Playback & Synchronized 3D Route Animation
  // ==========================================================================

  function createPlaybackVehicleMesh() {
    if (playbackVehicleMesh && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(playbackVehicleMesh);
      playbackVehicleMesh = null;
    }
    playbackVehicleMesh = new THREE.Group();
    playbackVehicleMesh.name = "playbackVehicleMarker";

    // 1. Rover Chassis (Metallic Bronze Box)
    const chassisGeom = new THREE.BoxGeometry(10, 3, 14);
    const chassisMat = new THREE.MeshStandardMaterial({
      color: 0xC88B46,
      roughness: 0.35,
      metalness: 0.8,
    });
    const chassis = new THREE.Mesh(chassisGeom, chassisMat);
    chassis.position.y = 2.5;
    playbackVehicleMesh.add(chassis);

    // 2. Solar Deck Top (Dark Sapphire)
    const deckGeom = new THREE.BoxGeometry(9.2, 0.4, 13.2);
    const deckMat = new THREE.MeshStandardMaterial({
      color: 0x1A237E,
      roughness: 0.2,
      metalness: 0.9,
    });
    const deck = new THREE.Mesh(deckGeom, deckMat);
    deck.position.y = 4.2;
    playbackVehicleMesh.add(deck);

    // 3. Sensor Mast
    const mastGeom = new THREE.CylinderGeometry(0.5, 0.5, 9, 8);
    const mastMat = new THREE.MeshStandardMaterial({
      color: 0xE0E0E0,
      metalness: 0.6,
    });
    const mast = new THREE.Mesh(mastGeom, mastMat);
    mast.position.set(0, 8.5, -4);
    playbackVehicleMesh.add(mast);

    // 4. Directional Heading Indicator (Cyan Cone pointing forward -Z)
    const arrowGeom = new THREE.ConeGeometry(2.5, 6, 8);
    const arrowMat = new THREE.MeshBasicMaterial({ color: 0x00E5FF });
    const arrow = new THREE.Mesh(arrowGeom, arrowMat);
    arrow.rotation.x = -Math.PI / 2;
    arrow.position.set(0, 3, 10);
    playbackVehicleMesh.add(arrow);

    // 5. Pulsing Nav Beacon Light
    playbackBeaconLight = new THREE.PointLight(0x00E5FF, 1.8, 120);
    playbackBeaconLight.position.set(0, 14, -4);
    playbackVehicleMesh.add(playbackBeaconLight);

    playbackVehicleMesh.visible = false;
    if (jezeroSurfaceGroup) {
      jezeroSurfaceGroup.add(playbackVehicleMesh);
    }
  }

  function formatMissionSeconds(s) {
    if (s < 0 || isNaN(s)) return "00:00:00";
    const totalSecs = Math.floor(s);
    const hrs = Math.floor(totalSecs / 3600);
    const mins = Math.floor((totalSecs % 3600) / 60);
    const secs = totalSecs % 60;
    const hStr = hrs < 10 ? `0${hrs}` : `${hrs}`;
    const mStr = mins < 10 ? `0${mins}` : `${mins}`;
    const sStr = secs < 10 ? `0${secs}` : `${secs}`;
    return `${hStr}:${mStr}:${sStr}`;
  }

  async function loadPlaybackModelForVariant(variant = 'nominal') {
    if (playbackModels[variant]) {
      return playbackModels[variant];
    }

    let routeToPlay = null;
    let timelineToPlay = null;

    if (variant === 'nominal') {
      routeToPlay = activeBaselineRouteResult;
      timelineToPlay = activeTimeline;
    } else if (variant === 'disrupted') {
      routeToPlay = lastComparisonResult ? lastComparisonResult.scenario_route : null;
      timelineToPlay = routeToPlay ? routeToPlay.timeline : null;
    } else if (variant === 'adaptive') {
      routeToPlay = activeAdaptiveResult ? activeAdaptiveResult.recommended_route : null;
      timelineToPlay = routeToPlay ? routeToPlay.timeline : null;
    }

    if (!routeToPlay && !customStart && !customGoal) {
      return null;
    }

    try {
      const payload = {
        mission_variant: variant,
        vehicle_mode: currentVehicleMode,
        profile: currentProfile,
      };

      if (routeToPlay) {
        payload.route = {
          path: routeToPlay.path || routeToPlay.path_rc || activeRoutePath || [],
          distance_m: routeToPlay.distance_m || 0,
          cost: routeToPlay.cost || routeToPlay.terrain_cost || 0,
          legs: routeToPlay.legs || [],
          timeline: timelineToPlay || routeToPlay.timeline || activeTimeline,
          is_reachable: routeToPlay.is_reachable !== undefined ? routeToPlay.is_reachable : true,
        };
      } else if (customStart && customGoal) {
        payload.start_rc = [customStart.row, customStart.col];
        payload.goal_rc = [customGoal.row, customGoal.col];
        if (activeIntermediateStops && activeIntermediateStops.length > 0) {
          payload.stops = activeIntermediateStops.map(s => [s.row, s.col]);
          payload.stop_labels = activeIntermediateStops.map(s => s.name || s.id);
        }
      }

      const res = await fetch('/api/mission/playback', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        throw new Error(`HTTP ${res.status}`);
      }

      const data = await res.json();
      playbackModels[variant] = data;
      return data;
    } catch (err) {
      console.warn(`[MarsWalk Playback] Failed to load playback for variant ${variant}:`, err);
      return null;
    }
  }

  function setPlaybackVariant(variant) {
    if (variant !== 'nominal' && variant !== 'disrupted' && variant !== 'adaptive') {
      return;
    }
    playbackState.activeVariant = variant;
    [btnVariantNominal, btnVariantDisrupted, btnVariantAdaptive].forEach(btn => {
      if (btn) btn.classList.remove('active');
    });
    if (variant === 'nominal' && btnVariantNominal) btnVariantNominal.classList.add('active');
    if (variant === 'disrupted' && btnVariantDisrupted) btnVariantDisrupted.classList.add('active');
    if (variant === 'adaptive' && btnVariantAdaptive) btnVariantAdaptive.classList.add('active');

    playbackState.elapsedSeconds = 0;
    if (playbackScrubber) playbackScrubber.value = 0;

    loadPlaybackModelForVariant(variant).then(model => {
      if (model) {
        updatePlaybackHUD(0, model);
        applyPlaybackFrame(0);
      }
    });
  }

  function playMissionPlayback() {
    if (!playbackVehicleMesh) createPlaybackVehicleMesh();
    playbackState.playing = true;
    playbackState.lastFrameTime = performance.now();
    if (btnPlaybackPlayPause) {
      btnPlaybackPlayPause.innerHTML = '&#10074;&#10074; PAUSE';
      btnPlaybackPlayPause.style.borderColor = 'var(--data-route-amber)';
    }
    if (playbackModeBadge) {
      playbackModeBadge.textContent = 'PLAYING';
      playbackModeBadge.style.color = 'var(--status-green)';
      playbackModeBadge.style.borderColor = 'rgba(0,230,118,0.3)';
    }

    if (playbackState.elapsedSeconds === 0) {
      const currentModel = playbackModels[playbackState.activeVariant] || playbackModels.nominal;
      if (currentModel) {
        const missionId = currentModel.mission_id || getActiveBlackBoxMissionId();
        const startRc = (currentModel.waypoints && currentModel.waypoints.length > 0)
          ? [currentModel.waypoints[0].row, currentModel.waypoints[0].col]
          : (customStart ? [customStart.row, customStart.col] : [117, 157]);
        logMissionEvent({
          mission_id: missionId,
          timestamp_s: 0,
          category: "nav",
          event_type: "sortie_started",
          title: "Sortie Started",
          description: `Rover departed departure waypoint [${startRc[0]}, ${startRc[1]}].`,
          rover_rc: startRc,
          elevation_m: getJezeroElevationAt(startRc[0], startRc[1]),
          is_simulated: false,
          payload: {
            vehicle_mode: currentModel.vehicle_mode || currentVehicleMode,
            total_duration_s: currentModel.total_duration_s,
            total_distance_m: currentModel.total_distance_m
          }
        });
      }
    }
  }

  function pauseMissionPlayback() {
    playbackState.playing = false;
    if (btnPlaybackPlayPause) {
      btnPlaybackPlayPause.innerHTML = '&#9654; PLAY';
      btnPlaybackPlayPause.style.borderColor = 'var(--status-green)';
    }
    if (playbackModeBadge) {
      playbackModeBadge.textContent = 'PAUSED';
      playbackModeBadge.style.color = 'var(--telemetry-cyan)';
      playbackModeBadge.style.borderColor = 'rgba(0,229,255,0.3)';
    }
  }

  function resetMissionPlayback() {
    pauseMissionPlayback();
    playbackState.elapsedSeconds = 0;
    lastTriggeredEventKey = null;
    roverSmoothedHeadingRad = 0;
    roverLatchedHeadingRad = 0;
    roverSmoothedPitchRad = 0;
    isRoverStationary = false;
    if (playbackScrubber) playbackScrubber.value = 0;
    const model = playbackModels[playbackState.activeVariant];
    if (model) {
      applyPlaybackFrame(0);
    }
  }

  function seekMissionPlayback(timeSeconds) {
    const model = playbackModels[playbackState.activeVariant];
    if (!model) return;
    const clamped = Math.max(0, Math.min(timeSeconds, model.total_duration_s));
    playbackState.elapsedSeconds = clamped;
    if (playbackScrubber && model.total_duration_s > 0) {
      playbackScrubber.value = Math.round((clamped / model.total_duration_s) * 1000);
    }
    applyPlaybackFrame(clamped);
  }

  function setPlaybackSpeed(multiplier) {
    playbackState.speedMultiplier = multiplier;
    document.querySelectorAll('.speed-btn').forEach(btn => {
      btn.classList.toggle('active', parseFloat(btn.getAttribute('data-speed')) === multiplier);
    });
    playMissionEventCue('speed');
  }

  function interpolateLocalPlaybackState(model, timeS) {
    if (!model || !model.samples || model.samples.length === 0) {
      return null;
    }
    const samples = model.samples;
    const t = Math.max(0, Math.min(timeS, model.total_duration_s));

    if (t <= samples[0].time_s) {
      return samples[0];
    }
    if (t >= samples[samples.length - 1].time_s) {
      return samples[samples.length - 1];
    }

    let low = 0;
    let high = samples.length - 1;
    while (low <= high) {
      const mid = (low + high) >> 1;
      if (samples[mid].time_s < t) {
        low = mid + 1;
      } else {
        high = mid - 1;
      }
    }
    const idx0 = Math.max(0, low - 1);
    const idx1 = Math.min(samples.length - 1, low);

    const s0 = samples[idx0];
    const s1 = samples[idx1];

    if (s0.is_stationary && s1.is_stationary) {
      return s0;
    }

    const dt = s1.time_s - s0.time_s;
    const u = dt <= 0 ? 0 : Math.max(0, Math.min(1, (t - s0.time_s) / dt));

    return {
      time_s: t,
      rc: [s0.rc[0] + u * (s1.rc[0] - s0.rc[0]), s0.rc[1] + u * (s1.rc[1] - s0.rc[1])],
      elevation_m: s0.elevation_m + u * (s1.elevation_m - s0.elevation_m),
      slope_deg: s0.slope_deg + u * (s1.slope_deg - s0.slope_deg),
      cumulative_distance_m: s0.cumulative_distance_m + u * (s1.cumulative_distance_m - s0.cumulative_distance_m),
      speed_m_s: s1.speed_m_s,
      active_event_index: s1.active_event_index,
      event_type: s1.event_type,
      target_id: s1.target_id,
      is_stationary: s0.is_stationary && s1.is_stationary,
      leg_index: s1.leg_index,
    };
  }

  // ==========================================================================
  // Milestone 10A: Mission Camera Director & Synchronized Audio Synthesizer
  // ==========================================================================

  function setCameraDirectorMode(mode) {
    const validModes = ['orbit', 'follow', 'cockpit', 'overhead', 'topographic', 'overview', 'focus'];
    if (!validModes.includes(mode)) return;
    cameraDirectorMode = mode;

    cameraDirectorModePills.forEach(pill => {
      pill.classList.toggle('active', pill.dataset.mode === mode);
    });

    const theaterPills = document.querySelectorAll('#theaterCamPills .theater-pill-btn');
    theaterPills.forEach(pill => {
      pill.classList.toggle('active', pill.dataset.mode === mode);
    });

    if (chkPlaybackFollowCamera) {
      chkPlaybackFollowCamera.checked = (mode !== 'orbit');
    }

    if (cockpitHudOverlay) {
      if (mode === 'cockpit' && currentViewMode === 'jezero') {
        cockpitHudOverlay.classList.remove('hidden');
      } else {
        cockpitHudOverlay.classList.add('hidden');
      }
    }

    if (mode === 'orbit') {
      controls.enabled = true;
    }

    // Immediately update camera
    const markerPos = (playbackVehicleMesh && playbackVehicleMesh.visible) ? playbackVehicleMesh.position : new THREE.Vector3(0, 0, 0);
    updateCameraDirector(16.0, markerPos, roverSmoothedHeadingRad, roverSmoothedPitchRad, isRoverStationary);
  }

  function getCameraDirectorMode() {
    return cameraDirectorMode;
  }

  // Web Audio Synthesizer (Pure Synthesized Tones, Zero External Downloads, Muted by Default)
  function initAudioContext() {
    if (!audioCtx && (window.AudioContext || window.webkitAudioContext)) {
      const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
      try {
        audioCtx = new AudioCtxClass();
      } catch (e) {
        console.warn('[MarsWalk Audio] Failed to create AudioContext:', e);
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume().catch(() => {});
    }
    return audioCtx;
  }

  function toggleAudioCues(forceState = null) {
    if (forceState !== null) {
      audioCuesEnabled = Boolean(forceState);
    } else {
      audioCuesEnabled = !audioCuesEnabled;
    }

    if (audioCuesEnabled) {
      initAudioContext();
      if (btnToggleAudioCues) {
        btnToggleAudioCues.classList.add('active');
        btnToggleAudioCues.classList.remove('muted');
      }
      if (audioToggleIcon) audioToggleIcon.innerHTML = '&#128266;';
      if (audioToggleText) audioToggleText.textContent = 'Audio Cues: ACTIVE';
      playMissionEventCue('speed');
    } else {
      if (btnToggleAudioCues) {
        btnToggleAudioCues.classList.remove('active');
        btnToggleAudioCues.classList.add('muted');
      }
      if (audioToggleIcon) audioToggleIcon.innerHTML = '&#128263;';
      if (audioToggleText) audioToggleText.textContent = 'Audio Cues: MUTED';
    }
    return audioCuesEnabled;
  }

  function playTone(freq, startT, dur, waveType = 'sine', peakGain = 0.12) {
    if (!audioCtx || audioCtx.state !== 'running') return;
    try {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = waveType;
      osc.frequency.setValueAtTime(freq, startT);

      gain.gain.setValueAtTime(0.0001, startT);
      gain.gain.exponentialRampToValueAtTime(peakGain, startT + 0.008);
      gain.gain.exponentialRampToValueAtTime(0.0001, startT + dur);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start(startT);
      osc.stop(startT + dur + 0.05);
    } catch (err) {
      // Fail silently without blocking UI
    }
  }

  function playMissionEventCue(cueType) {
    if (!audioCuesEnabled || !audioCtx) return;
    if (audioCtx.state === 'suspended') {
      audioCtx.resume().catch(() => {});
    }
    const now = audioCtx.currentTime;
    try {
      if (cueType === 'start') {
        // Departure dual chime: 523.25 Hz -> 659.25 Hz
        playTone(523.25, now, 0.12, 'sine', 0.12);
        playTone(659.25, now + 0.11, 0.16, 'sine', 0.14);
      } else if (cueType === 'science_dwell') {
        // Science arrival tri-tone: 587.33 Hz (D5) -> 739.99 Hz (F#5) -> 880.0 Hz (A5)
        playTone(587.33, now, 0.09, 'triangle', 0.12);
        playTone(739.99, now + 0.09, 0.09, 'triangle', 0.14);
        playTone(880.00, now + 0.18, 0.22, 'sine', 0.16);
      } else if (cueType === 'scenario_delay') {
        // Caution hold double pulse: 349.23 Hz (F4)
        playTone(349.23, now, 0.09, 'triangle', 0.14);
        playTone(349.23, now + 0.13, 0.16, 'triangle', 0.14);
      } else if (cueType === 'arrival') {
        // Mission complete major chord: 523.25, 659.25, 783.99 Hz
        playTone(523.25, now, 0.40, 'sine', 0.09);
        playTone(659.25, now + 0.02, 0.42, 'sine', 0.09);
        playTone(783.99, now + 0.04, 0.45, 'sine', 0.11);
      } else if (cueType === 'speed') {
        // Subtle tick
        playTone(987.77, now, 0.035, 'triangle', 0.06);
      }
    } catch (e) {
      // Audio failure resilience
    }
  }

  function updateCameraDirector(deltaMs, markerPos, headingRad, pitchRad, isStationary) {
    if (!camera || !controls || currentViewMode !== 'jezero') return;

    // Unit forward horizontal vector from heading yaw
    const forwardX = Math.sin(headingRad);
    const forwardZ = Math.cos(headingRad);

    if (cameraDirectorMode === 'orbit') {
      // Orbit mode: controls handles everything, camera is free to be manipulated by user
      controls.enabled = true;
      return;
    }

    controls.enabled = false;

    if (cameraDirectorMode === 'topographic') {
      // Oblique surface perspective revealing scarp slopes
      targetCamPos.set(0, 360, 920);
      targetCamLookAt.set(0, -60, 0);
      camera.position.lerp(targetCamPos, 0.08);
      controls.target.lerp(targetCamLookAt, 0.12);
    } else if (cameraDirectorMode === 'overview') {
      // High regional survey overview fitting campaign bounding box
      targetCamPos.set(0, 2600, 3100);
      targetCamLookAt.set(0, 0, 0);
      camera.position.lerp(targetCamPos, 0.08);
      controls.target.lerp(targetCamLookAt, 0.12);
    } else if (cameraDirectorMode === 'focus') {
      // Centers active disturbance or selected target
      let focusTarget = null;
      if (disruptionHazardMesh && disruptionHazardMesh.visible) {
        focusTarget = disruptionHazardMesh.position;
      } else if (selectedWaypoint && waypointBeacons) {
        const beacon = waypointBeacons.find(b => b.userData && b.userData.waypoint && b.userData.waypoint.name === selectedWaypoint.name);
        if (beacon) focusTarget = beacon.position;
      } else if (playbackVehicleMesh && playbackVehicleMesh.visible) {
        focusTarget = playbackVehicleMesh.position;
      }
      if (focusTarget) {
        targetCamPos.set(focusTarget.x, focusTarget.y + 280, focusTarget.z + 420);
        targetCamLookAt.copy(focusTarget);
        camera.position.lerp(targetCamPos, 0.09);
        controls.target.lerp(targetCamLookAt, 0.12);
      }
    } else if (cameraDirectorMode === 'follow') {
      // Smooth 3rd-person chase camera positioned behind marker along heading
      const distBehind = 68.0;
      const heightAbove = 34.0;
      targetCamPos.set(
        markerPos.x - forwardX * distBehind,
        markerPos.y + heightAbove,
        markerPos.z - forwardZ * distBehind
      );
      targetCamLookAt.set(
        markerPos.x + forwardX * 18.0,
        markerPos.y + 6.0,
        markerPos.z + forwardZ * 18.0
      );

      camera.position.lerp(targetCamPos, 0.09);
      controls.target.lerp(targetCamLookAt, 0.12);
    } else if (cameraDirectorMode === 'cockpit') {
      // 1st-person forward-facing cockpit view mounted atop rover mast
      const mastHeight = 8.5;
      const forwardNudge = 4.0;
      targetCamPos.set(
        markerPos.x + forwardX * forwardNudge,
        markerPos.y + mastHeight,
        markerPos.z + forwardZ * forwardNudge
      );

      const lookDist = 140.0;
      const pitchOffset = Math.tan(pitchRad || 0) * lookDist;
      targetCamLookAt.set(
        targetCamPos.x + forwardX * lookDist,
        targetCamPos.y + pitchOffset,
        targetCamPos.z + forwardZ * lookDist
      );

      camera.position.lerp(targetCamPos, 0.14);
      controls.target.lerp(targetCamLookAt, 0.18);
    } else if (cameraDirectorMode === 'overhead') {
      // Stabilized top-down nadir view
      const altitude = 460.0;
      targetCamPos.set(
        markerPos.x,
        markerPos.y + altitude,
        markerPos.z + 0.001 // tiny offset to stabilize lookAt matrix
      );
      targetCamLookAt.copy(markerPos);

      camera.position.lerp(targetCamPos, 0.08);
      controls.target.lerp(targetCamLookAt, 0.12);
    }
  }

  function applyPlaybackFrame(timeSeconds) {
    const model = playbackModels[playbackState.activeVariant];
    if (!model) return;

    const state = interpolateLocalPlaybackState(model, timeSeconds);
    if (!state) return;

    if (!playbackVehicleMesh) createPlaybackVehicleMesh();
    playbackVehicleMesh.visible = true;

    // Calculate position
    const r = state.rc[0];
    const c = state.rc[1];
    const elev = state.elevation_m;

    const currentPos = rcToLocalPos(r, c, elev, currentExaggeration);
    currentPos.y += 8.0;
    playbackVehicleMesh.position.copy(currentPos);

    // Milestone 10A: Route-Aware Heading & Stationary Latching
    if (state.is_stationary) {
      isRoverStationary = true;
      // When stationary (dwell or delay), strictly latch heading to freeze camera/marker jitter
      playbackVehicleMesh.rotation.set(0, roverSmoothedHeadingRad, 0);
    } else {
      isRoverStationary = false;
      const futureT = Math.min(model.total_duration_s, timeSeconds + 1.2);
      const futureState = interpolateLocalPlaybackState(model, futureT);
      if (futureState && (futureState.rc[0] !== r || futureState.rc[1] !== c)) {
        const nextPos = rcToLocalPos(futureState.rc[0], futureState.rc[1], futureState.elevation_m, currentExaggeration);
        nextPos.y += 8.0;
        const dx = nextPos.x - currentPos.x;
        const dz = nextPos.z - currentPos.z;
        const distH = Math.hypot(dx, dz);
        if (distH > 0.02) {
          const targetHeading = Math.atan2(dx, dz);
          const targetPitch = Math.atan2(nextPos.y - currentPos.y, distH);

          // Wrap-around angle smoothing
          let dHeading = targetHeading - roverSmoothedHeadingRad;
          while (dHeading > Math.PI) dHeading -= 2 * Math.PI;
          while (dHeading < -Math.PI) dHeading += 2 * Math.PI;

          roverSmoothedHeadingRad += dHeading * 0.18;
          roverSmoothedPitchRad += (targetPitch - roverSmoothedPitchRad) * 0.18;
          roverLatchedHeadingRad = roverSmoothedHeadingRad;
        }
      }
      playbackVehicleMesh.rotation.set(-roverSmoothedPitchRad * 0.4, roverSmoothedHeadingRad, 0, 'YXZ');
    }

    // Beacon pulse
    if (playbackBeaconLight) {
      playbackBeaconLight.intensity = 1.2 + 0.8 * Math.sin(timeSeconds * 4.0);
    }

    // Update Camera Director
    updateCameraDirector(16.0, currentPos, roverSmoothedHeadingRad, roverSmoothedPitchRad, isRoverStationary);

    updatePlaybackHUD(timeSeconds, model, state);

    // Milestone 13C: Synchronize Mission Theater HUD Telemetry
    const theaterClock = document.getElementById('theaterClockDisplay');
    const theaterElapsed = document.getElementById('theaterTimeElapsed');
    const theaterTotal = document.getElementById('theaterTimeTotal');
    const theaterPhase = document.getElementById('theaterPhaseDisplay');
    const theaterScrubber = document.getElementById('theaterTimelineScrubber');
    const theaterStatus = document.getElementById('theaterPlaybackStatus');

    if (theaterClock) theaterClock.textContent = formatMissionSeconds(timeSeconds);
    if (theaterElapsed) theaterElapsed.textContent = formatMissionSeconds(timeSeconds);
    if (theaterTotal && model) theaterTotal.textContent = formatMissionSeconds(model.total_duration_s);
    if (theaterScrubber && model && model.total_duration_s > 0) {
      theaterScrubber.value = ((timeSeconds / model.total_duration_s) * 100).toFixed(1);
    }
    if (theaterPhase && state) {
      theaterPhase.textContent = state.is_stationary ? 'STATIONARY DWELL' : `LEG ${state.leg_index || 1}`;
    }
    if (theaterStatus && state) {
      theaterStatus.textContent = state.is_stationary ? 'SCIENTIFIC DWELL / SAMPLING HOLD' : 'NOMINAL REHEARSAL TRAVERSE';
      theaterStatus.style.color = state.is_stationary ? '#f59e0b' : '#38bdf8';
    }
  }

  function updatePlaybackHUD(timeSeconds, model, state = null) {
    if (!model) return;
    if (playbackElapsedDisplay) playbackElapsedDisplay.textContent = formatMissionSeconds(timeSeconds);
    if (playbackTotalDisplay) playbackTotalDisplay.textContent = formatMissionSeconds(model.total_duration_s);

    const progressRatio = model.total_duration_s > 0 ? (timeSeconds / model.total_duration_s) : 0;
    if (playbackPercentDisplay) playbackPercentDisplay.textContent = `${(progressRatio * 100).toFixed(1)}%`;

    if (state) {
      if (playbackTraversedDist) playbackTraversedDist.textContent = `${Math.round(state.cumulative_distance_m)} m`;
      if (playbackElevation) playbackElevation.textContent = `${Math.round(state.elevation_m)} m`;
      if (playbackSlope) playbackSlope.textContent = `${state.slope_deg.toFixed(1)}°`;
      if (playbackSpeed) playbackSpeed.textContent = `${state.speed_m_s.toFixed(2)} m/s`;

      // Heading display
      const hdgDeg = (Math.round((roverSmoothedHeadingRad * 180.0) / Math.PI) + 360) % 360;
      if (playbackHeadingDeg) playbackHeadingDeg.textContent = `${hdgDeg}°`;
      if (cockpitHeadingDisplay) cockpitHeadingDisplay.textContent = `HDG: ${hdgDeg.toString().padStart(3, '0')}°`;
      if (cockpitSlopeDisplay) cockpitSlopeDisplay.textContent = `SLOPE: ${state.slope_deg.toFixed(1)}°`;
      if (cockpitSpeedDisplay) cockpitSpeedDisplay.textContent = `SPD: ${state.speed_m_s.toFixed(2)} m/s`;

      if (playbackActivePhase) {
        if (state.event_type === 'start') {
          playbackActivePhase.textContent = 'DEPARTURE';
          playbackActivePhase.style.color = 'var(--status-green)';
        } else if (state.event_type === 'traverse_leg') {
          playbackActivePhase.textContent = `TRAVERSE (Leg ${state.leg_index || 1})`;
          playbackActivePhase.style.color = 'var(--telemetry-cyan)';
        } else if (state.event_type === 'science_dwell') {
          playbackActivePhase.textContent = 'SCIENCE DWELL (STATIONARY)';
          playbackActivePhase.style.color = 'var(--data-route-amber)';
        } else if (state.event_type === 'scenario_delay') {
          playbackActivePhase.textContent = 'OPERATIONAL HOLD (STATIONARY)';
          playbackActivePhase.style.color = 'var(--accent-coral)';
        } else if (state.event_type === 'arrival') {
          playbackActivePhase.textContent = 'MISSION COMPLETE';
          playbackActivePhase.style.color = 'var(--status-green)';
        }
      }

      if (playbackTargetRow && playbackActiveTarget) {
        if (state.target_id) {
          playbackTargetRow.classList.remove('hidden');
          playbackActiveTarget.textContent = state.target_id;
        } else {
          playbackTargetRow.classList.add('hidden');
        }
      }

      // Distance to next intermediate stop or arrival
      if (playbackDistToNext && model.events && model.events.length > 0) {
        const nextEvt = model.events.find(ev => (ev.time_s > timeSeconds) && (ev.event_type === 'science_dwell' || ev.event_type === 'arrival'));
        if (nextEvt) {
          const remDist = Math.max(0, nextEvt.cumulative_distance_m - state.cumulative_distance_m);
          const tgtLabel = nextEvt.target_id ? nextEvt.target_id.replace(/_/g, ' ') : 'Arrival';
          playbackDistToNext.textContent = `${Math.round(remDist)} m (${tgtLabel})`;
        } else {
          playbackDistToNext.textContent = 'At Destination';
        }
      }

      // Milestone 10A: Synchronized Telemetry Cues (Audio & Visual)
      const eventKey = `${state.event_type}_${state.active_event_index || 0}`;
      if (eventKey !== lastTriggeredEventKey) {
        if (lastTriggeredEventKey !== null && !isUserScrubbing) {
          // Trigger visual cue badge pulse
          if (playbackEventCueBadge) {
            playbackEventCueBadge.classList.remove('hidden');
            playbackEventCueBadge.classList.remove('event-cue-pulse');
            void playbackEventCueBadge.offsetWidth;
            playbackEventCueBadge.classList.add('event-cue-pulse');
            setTimeout(() => {
              if (playbackEventCueBadge) playbackEventCueBadge.classList.add('hidden');
            }, 1800);
          }
          // Trigger synthesized audio cue
          playMissionEventCue(state.event_type);
        }
        lastTriggeredEventKey = eventKey;
      }
    }
  }

  function updateMissionPlayback(frameTime) {
    if (!playbackState.playing) return;
    const model = playbackModels[playbackState.activeVariant];
    if (!model) return;

    if (playbackState.lastFrameTime > 0) {
      const dt = (frameTime - playbackState.lastFrameTime) / 1000.0;
      // Cap delta time to prevent massive jumps on tab blur
      const clampedDt = Math.min(0.2, dt);
      playbackState.elapsedSeconds += clampedDt * playbackState.speedMultiplier;

      if (playbackState.elapsedSeconds >= model.total_duration_s) {
        playbackState.elapsedSeconds = model.total_duration_s;
        pauseMissionPlayback();
      }

      if (playbackScrubber && model.total_duration_s > 0) {
        playbackScrubber.value = Math.round((playbackState.elapsedSeconds / model.total_duration_s) * 1000);
      }
      applyPlaybackFrame(playbackState.elapsedSeconds);
    }
    playbackState.lastFrameTime = frameTime;
  }

  function focusPlaybackMarker() {
    if (!playbackVehicleMesh || !playbackVehicleMesh.visible) return;
    const pos = playbackVehicleMesh.position.clone();
    const targetCamPos = new THREE.Vector3(pos.x, pos.y + 400, pos.z + 600);
    startSurfaceFlight(targetCamPos, pos, 1500, () => {
      controls.target.copy(pos);
    });
  }

  function refreshPlaybackData(variant = null) {
    if (variant) {
      playbackModels[variant] = null;
    } else {
      playbackModels.nominal = null;
      playbackModels.disrupted = null;
      playbackModels.adaptive = null;
    }
    if (btnVariantDisrupted) {
      btnVariantDisrupted.disabled = !(lastComparisonResult && lastComparisonResult.scenario_route);
    }
    if (btnVariantAdaptive) {
      btnVariantAdaptive.disabled = !(activeAdaptiveResult && activeAdaptiveResult.recommended_route);
    }
    return loadPlaybackModelForVariant(playbackState.activeVariant).then(model => {
      if (model) {
        updatePlaybackHUD(playbackState.elapsedSeconds, model);
        applyPlaybackFrame(playbackState.elapsedSeconds);
      }
      return model;
    });
  }

  // ==========================================================================
  // Milestone 10B: Mid-Sortie Emergency Injection & Live Replanning Logic
  // ==========================================================================

  function openEmergencyInjectionDrawer() {
    if (!emergencyConfigDrawer) return;
    if (playbackState.playing) {
      pauseMissionPlayback();
    }

    const currentModel = playbackModels[playbackState.activeVariant] || playbackModels.nominal;
    if (!currentModel) {
      setPlanningStatus("Cannot inject emergency: No active computed mission loaded.", "error");
      return;
    }

    const t = playbackState.elapsedSeconds;
    const state = interpolateLocalPlaybackState(currentModel, t);
    if (!state) {
      setPlanningStatus("Cannot resolve rover state at current playback time.", "error");
      return;
    }

    const r = Math.round(state.rc[0]);
    const c = Math.round(state.rc[1]);

    const origBudget = currentModel.total_duration_s + Math.max(0, currentModel.remaining_margin_s || 0);
    const remBudget = Math.max(0, origBudget - t);

    capturedMidSortieState = {
      model: currentModel,
      time_s: t,
      state: state,
      rover_rc: [r, c],
      remaining_budget_s: remBudget,
    };

    if (emergencyRoverRcDisplay) emergencyRoverRcDisplay.textContent = `[${r}, ${c}]`;
    if (emergencyElapsedDisplay) emergencyElapsedDisplay.textContent = formatMissionSeconds(t);
    if (emergencyRemainingBudgetDisplay) emergencyRemainingBudgetDisplay.textContent = formatDuration(remBudget);

    // Populate drop target select if there are waypoints
    if (emergencyDropTargetSelect) {
      emergencyDropTargetSelect.innerHTML = '';
      const wps = currentModel.waypoints || [];
      wps.forEach(wp => {
        const opt = document.createElement('option');
        opt.value = wp.id;
        opt.textContent = `${wp.name || wp.id} (P: ${wp.priority_score || wp.priority || 1})`;
        emergencyDropTargetSelect.appendChild(opt);
      });
      if (emergencyDropTargetSelect.options.length === 0) {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = '(No targets in mission)';
        emergencyDropTargetSelect.appendChild(opt);
      }
    }

    emergencyConfigDrawer.classList.remove('hidden');
    if (continuationResultsCard) continuationResultsCard.classList.add('hidden');
  }

  function closeEmergencyInjectionDrawer() {
    if (emergencyConfigDrawer) emergencyConfigDrawer.classList.add('hidden');
    clearContinuationPreview();
  }

  function getJezeroElevationAt(r, c) {
    if (missionData && missionData.elevation_samples && missionData.elevation_samples[r] && missionData.elevation_samples[r][c] !== undefined) {
      return missionData.elevation_samples[r][c];
    }
    return -2500;
  }

  function drawContinuationRoute(path_rc) {
    if (continuationRouteLineMesh && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(continuationRouteLineMesh);
      continuationRouteLineMesh = null;
    }
    if (!path_rc || path_rc.length < 2) return;

    const points = [];
    for (let i = 0; i < path_rc.length; i++) {
      const r = path_rc[i][0];
      const c = path_rc[i][1];
      const elev = getJezeroElevationAt(r, c);
      const pos = rcToLocalPos(r, c, elev, currentExaggeration);
      pos.y += 3.5;
      points.push(pos);
    }
    const geom = new THREE.BufferGeometry().setFromPoints(points);
    const mat = new THREE.LineBasicMaterial({
      color: 0x00E676,
      linewidth: 4,
    });
    continuationRouteLineMesh = new THREE.Line(geom, mat);
    continuationRouteLineMesh.renderOrder = 22;
    jezeroSurfaceGroup.add(continuationRouteLineMesh);
  }

  function drawEventFootprint(center_rc, radius_m) {
    if (eventFootprintMesh && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(eventFootprintMesh);
      eventFootprintMesh = null;
    }
    if (!center_rc) return;

    const r = center_rc[0];
    const c = center_rc[1];
    const elev = getJezeroElevationAt(r, c);
    const pos = rcToLocalPos(r, c, elev, currentExaggeration);

    const radUnits = ((radius_m || 60.0) / 20.0) * (5000.0 / 250.0);
    const geom = new THREE.CylinderGeometry(radUnits, radUnits, 15.0, 32);
    const mat = new THREE.MeshBasicMaterial({
      color: 0xFF5722,
      opacity: 0.5,
      transparent: true,
      depthWrite: false,
    });
    eventFootprintMesh = new THREE.Mesh(geom, mat);
    eventFootprintMesh.position.set(pos.x, pos.y + 7.5, pos.z);
    eventFootprintMesh.renderOrder = 20;
    jezeroSurfaceGroup.add(eventFootprintMesh);
  }

  function drawHistoricalTrack(path_rc) {
    if (historicalRouteLineMesh && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(historicalRouteLineMesh);
      historicalRouteLineMesh = null;
    }
    if (!path_rc || path_rc.length < 2) return;

    const points = [];
    for (let i = 0; i < path_rc.length; i++) {
      const r = path_rc[i][0];
      const c = path_rc[i][1];
      const elev = getJezeroElevationAt(r, c);
      const pos = rcToLocalPos(r, c, elev, currentExaggeration);
      pos.y += 2.0;
      points.push(pos);
    }
    const geom = new THREE.BufferGeometry().setFromPoints(points);
    const mat = new THREE.LineBasicMaterial({
      color: 0x546E7A,
      linewidth: 3,
    });
    historicalRouteLineMesh = new THREE.Line(geom, mat);
    historicalRouteLineMesh.renderOrder = 18;
    jezeroSurfaceGroup.add(historicalRouteLineMesh);
  }

  function clearContinuationPreview() {
    if (continuationRouteLineMesh && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(continuationRouteLineMesh);
      continuationRouteLineMesh = null;
    }
    if (eventFootprintMesh && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(eventFootprintMesh);
      eventFootprintMesh = null;
    }
    if (historicalRouteLineMesh && jezeroSurfaceGroup) {
      jezeroSurfaceGroup.remove(historicalRouteLineMesh);
      historicalRouteLineMesh = null;
    }
  }

  async function calculateMissionContinuation(customEventParam = null) {
    if (!capturedMidSortieState) {
      openEmergencyInjectionDrawer();
      if (!capturedMidSortieState) return null;
    }

    const { model, time_s, rover_rc, remaining_budget_s } = capturedMidSortieState;

    let eventDef = customEventParam;
    if (!eventDef) {
      const evType = emergencyEventTypeSelect ? emergencyEventTypeSelect.value : 'closure';
      if (evType === 'closure') {
        const radiusVal = emergencyRadiusSlider ? parseFloat(emergencyRadiusSlider.value) : 60.0;
        const targetR = Math.max(0, Math.min(249, rover_rc[0] + 3));
        const targetC = Math.max(0, Math.min(249, rover_rc[1] + 3));
        eventDef = {
          event_type: 'closure',
          center_rc: [targetR, targetC],
          radius_m: radiusVal,
        };
      } else if (evType === 'mobility') {
        eventDef = {
          event_type: 'mobility',
          speed_multiplier: 0.5,
        };
      } else if (evType === 'hold') {
        eventDef = {
          event_type: 'hold',
          operational_delay_s: 900.0,
        };
      } else if (evType === 'drop_target') {
        const dropId = emergencyDropTargetSelect ? emergencyDropTargetSelect.value : '';
        eventDef = {
          event_type: 'drop_target',
          unavailable_target_id: dropId,
        };
      }
    }

    if (btnCalculateContinuation) {
      btnCalculateContinuation.disabled = true;
      btnCalculateContinuation.textContent = 'Calculating Continuation...';
    }

    try {
      const payload = {
        playback_model: model,
        interruption_time_s: time_s,
        event: eventDef,
        profile: model.metadata && model.metadata.profile ? model.metadata.profile : currentProfile,
        vehicle_mode: model.vehicle_mode || currentVehicleMode,
        speed_multiplier: model.metadata && model.metadata.speed_multiplier ? model.metadata.speed_multiplier : 1.0,
        remaining_budget_s: remaining_budget_s,
      };

      const missionId = model.mission_id || getActiveBlackBoxMissionId();
      logMissionEvent({
        mission_id: missionId,
        timestamp_s: time_s,
        category: "contingency",
        event_type: "contingency_injected",
        title: `Contingency Injected: ${eventDef.event_type.toUpperCase()}`,
        description: `Simulated contingency (${eventDef.event_type}) injected at rover position [${rover_rc[0]}, ${rover_rc[1]}].`,
        rover_rc: rover_rc,
        rover_float_rc: (capturedMidSortieState.state && capturedMidSortieState.state.rc) ? capturedMidSortieState.state.rc : [rover_rc[0], rover_rc[1]],
        elevation_m: getJezeroElevationAt(rover_rc[0], rover_rc[1]),
        slope_deg: (capturedMidSortieState.state && capturedMidSortieState.state.slope_deg !== undefined) ? capturedMidSortieState.state.slope_deg : 0.0,
        is_simulated: true,
        payload: {
          event_type: eventDef.event_type,
          center_rc: eventDef.center_rc,
          radius_m: eventDef.radius_m,
          speed_multiplier: eventDef.speed_multiplier,
          operational_delay_s: eventDef.operational_delay_s,
          unavailable_target_id: eventDef.unavailable_target_id,
          remaining_budget_s: remaining_budget_s,
          elapsed_distance_m: (capturedMidSortieState.state && capturedMidSortieState.state.cumulative_distance_m) ? capturedMidSortieState.state.cumulative_distance_m : 0.0,
          profile: model.metadata && model.metadata.profile ? model.metadata.profile : currentProfile,
          vehicle_mode: model.vehicle_mode || currentVehicleMode,
          destination_rc: [
            (customGoal && customGoal.row !== undefined) ? customGoal.row : ((model.goal_rc && model.goal_rc[0] !== undefined) ? model.goal_rc[0] : 66),
            (customGoal && customGoal.col !== undefined) ? customGoal.col : ((model.goal_rc && model.goal_rc[1] !== undefined) ? model.goal_rc[1] : 128)
          ],
          completed_stop_ids: (capturedMidSortieState.state && capturedMidSortieState.state.completed_stops) ? capturedMidSortieState.state.completed_stops : [],
          unvisited_waypoints: model.waypoints || []
        }
      });

      const resp = await fetch('/api/mission/continue', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.message || `HTTP ${resp.status}`);
      }

      const res = await resp.json();
      activeContinuationResult = res;

      logMissionEvent({
        mission_id: missionId,
        timestamp_s: time_s,
        category: "decision",
        event_type: "route_recalculated",
        title: `Route Recalculated: ${(res.recommendation || 'CONTINUE').toUpperCase()}`,
        description: res.recommendation_rationale || res.recommendation_title || "Adaptive continuation route computed.",
        rover_rc: rover_rc,
        elevation_m: getJezeroElevationAt(rover_rc[0], rover_rc[1]),
        is_simulated: true,
        payload: {
          recommendation: res.recommendation,
          recommendation_title: res.recommendation_title,
          disrupted_remaining: res.disrupted_remaining,
          adaptive_continuation: res.adaptive_continuation
        }
      });

      // Populate UI
      if (continuationRecBadge) {
        continuationRecBadge.textContent = (res.recommendation || 'CONTINUE').toUpperCase().replace(/_/g, ' ');
        if (res.recommendation === 'unresolvable_critical_hazard') {
          continuationRecBadge.style.color = 'var(--status-red)';
          continuationRecBadge.style.background = 'rgba(255,87,34,0.2)';
          continuationRecBadge.style.borderColor = 'rgba(255,87,34,0.5)';
        } else {
          continuationRecBadge.style.color = 'var(--status-green)';
          continuationRecBadge.style.background = 'rgba(0,230,118,0.2)';
          continuationRecBadge.style.borderColor = 'rgba(0,230,118,0.5)';
        }
      }

      if (continuationRationaleText) {
        continuationRationaleText.textContent = res.recommendation_rationale || res.recommendation_title || '--';
      }

      if (statNomRemDist) statNomRemDist.textContent = `${res.nominal_remaining.distance_m} m`;
      if (statNomRemTime) statNomRemTime.textContent = formatMissionSeconds(res.nominal_remaining.total_time_s);

      if (statDisrRemDist) statDisrRemDist.textContent = `${res.disrupted_remaining.distance_m} m`;
      if (statDisrRemStatus) {
        if (!res.disrupted_remaining.is_reachable) {
          statDisrRemStatus.textContent = `BLOCKED (${res.disrupted_remaining.blocked_cell_encounters || 1})`;
          statDisrRemStatus.style.color = 'var(--status-red)';
        } else if (!res.disrupted_remaining.is_within_limit) {
          statDisrRemStatus.textContent = 'OVER BUDGET';
          statDisrRemStatus.style.color = 'var(--status-red)';
        } else {
          statDisrRemStatus.textContent = 'FEASIBLE';
          statDisrRemStatus.style.color = 'var(--status-green)';
        }
      }

      if (statAdaptRemDist) statAdaptRemDist.textContent = `${res.adaptive_continuation.distance_m} m`;
      if (statAdaptRemTime) statAdaptRemTime.textContent = formatMissionSeconds(res.adaptive_continuation.total_time_s);

      // Render 3D preview
      if (res.historical_prefix && res.historical_prefix.path_rc) {
        drawHistoricalTrack(res.historical_prefix.path_rc);
      }
      if (res.event_summary && res.event_summary.center_rc && res.event_summary.radius_m) {
        drawEventFootprint(res.event_summary.center_rc, res.event_summary.radius_m);
      }
      if (res.adaptive_continuation && res.adaptive_continuation.path_rc) {
        drawContinuationRoute(res.adaptive_continuation.path_rc);
      }

      if (continuationResultsCard) {
        continuationResultsCard.classList.remove('hidden');
      }

      return res;
    } catch (err) {
      setPlanningStatus(`Continuation calculation failed: ${err.message}`, "error");
      return null;
    } finally {
      if (btnCalculateContinuation) {
        btnCalculateContinuation.disabled = false;
        btnCalculateContinuation.textContent = '⚡ CALCULATE CONTINUATION';
      }
    }
  }

  function applyMissionContinuation() {
    if (!activeContinuationResult || !activeContinuationResult.continuation_playback) {
      setPlanningStatus("No calculated continuation to apply.", "error");
      return;
    }

    const contModel = activeContinuationResult.continuation_playback;

    if (!nominalBackupPlaybackModel) {
      nominalBackupPlaybackModel = playbackModels.nominal;
      nominalBackupVariant = playbackState.activeVariant;
    }

    playbackModels['continuation'] = contModel;
    playbackModels['adaptive'] = contModel;
    playbackState.activeVariant = 'continuation';
    playbackState.elapsedSeconds = 0;
    lastTriggeredEventKey = null;

    if (activeContinuationResult.rover_state && activeContinuationResult.rover_state.rover_rc) {
      const r = activeContinuationResult.rover_state.rover_rc[0];
      const c = activeContinuationResult.rover_state.rover_rc[1];
      const elev = activeContinuationResult.rover_state.elevation_m;
      if (playbackVehicleMesh) {
        const localPos = rcToLocalPos(r, c, elev, currentExaggeration);
        localPos.y += 1.5;
        playbackVehicleMesh.position.copy(localPos);
      }
    }

    if (activeContinuationResult.adaptive_continuation && activeContinuationResult.adaptive_continuation.path_rc) {
      drawContinuationRoute(activeContinuationResult.adaptive_continuation.path_rc);
    }

    updatePlaybackHUD(0, contModel);
    applyPlaybackFrame(0);

    if (emergencyConfigDrawer) emergencyConfigDrawer.classList.add('hidden');
    if (btnRevertContinuation) btnRevertContinuation.classList.remove('hidden');

    setPlanningStatus(`Continuation applied: Sortie resumes with ${activeContinuationResult.recommendation_title}.`, "success");
    playMissionEventCue('arrival');

    const contMissionId = activeContinuationResult.source_mission_id || getActiveBlackBoxMissionId();
    logMissionEvent({
      mission_id: contMissionId,
      timestamp_s: activeContinuationResult.interruption_time_s || 0,
      category: "decision",
      event_type: "continuation_selected",
      title: `Continuation Selected: ${(activeContinuationResult.recommendation || 'CONTINUE').toUpperCase()}`,
      description: `Operator applied adaptive continuation at ${activeContinuationResult.interruption_time_s}s.`,
      rover_rc: (activeContinuationResult.rover_state && activeContinuationResult.rover_state.rover_rc) ? activeContinuationResult.rover_state.rover_rc : [0, 0],
      elevation_m: (activeContinuationResult.rover_state && activeContinuationResult.rover_state.elevation_m !== undefined) ? activeContinuationResult.rover_state.elevation_m : -2500,
      is_simulated: true,
      payload: {
        recommendation: activeContinuationResult.recommendation,
        continuation_mission_id: (activeContinuationResult.continuation_playback && activeContinuationResult.continuation_playback.mission_id) ? activeContinuationResult.continuation_playback.mission_id : null
      }
    });
  }

  function revertMissionContinuation() {
    if (nominalBackupPlaybackModel) {
      playbackModels.nominal = nominalBackupPlaybackModel;
      playbackState.activeVariant = nominalBackupVariant || 'nominal';
      nominalBackupPlaybackModel = null;
    }
    clearContinuationPreview();
    if (btnRevertContinuation) btnRevertContinuation.classList.add('hidden');
    if (emergencyConfigDrawer) emergencyConfigDrawer.classList.add('hidden');
    resetMissionPlayback();
    setPlanningStatus("Reverted to original nominal mission playback.", "info");
  }

  // Milestone 10C: Sortie Black Box & Incident Replay Implementation
  function getActiveBlackBoxMissionId() {
    if (activeSavedMissionId) return activeSavedMissionId;
    if (activeContinuationResult && activeContinuationResult.source_mission_id) {
      return activeContinuationResult.source_mission_id;
    }
    const nominalModel = playbackModels.nominal;
    if (nominalModel && nominalModel.mission_id) return nominalModel.mission_id;
    return "mission_nominal";
  }

  async function logMissionEvent(eventData) {
    try {
      const missionId = eventData.source_mission_id || eventData.mission_id || getActiveBlackBoxMissionId();
      const timeSec = typeof eventData.mission_time_s === 'number'
        ? eventData.mission_time_s
        : (typeof eventData.timestamp_s === 'number' ? eventData.timestamp_s : playbackState.elapsedSeconds);

      const eventPayload = {
        schema_version: "1.0.0",
        event_id: eventData.event_id || `evt_${Date.now().toString(36)}_${Math.random().toString(36).substring(2, 6)}`,
        source_mission_id: missionId,
        continuation_id: eventData.continuation_id || null,
        event_type: eventData.event_type || "playback_checkpoint",
        mission_time_s: Math.max(0, timeSec),
        playback_elapsed_s: Math.max(0, timeSec),
        recorded_at_utc: eventData.recorded_at_utc || new Date().toISOString(),
        route_variant: eventData.route_variant || (playbackState.activeVariant === 'continuation' ? 'continuation' : 'nominal'),
        rover_rc: eventData.rover_rc ? [Math.round(eventData.rover_rc[0]), Math.round(eventData.rover_rc[1])] : null,
        rover_float_rc: eventData.rover_float_rc || (eventData.rover_rc ? [Number(eventData.rover_rc[0]), Number(eventData.rover_rc[1])] : null),
        elevation_m: (typeof eventData.elevation_m === 'number') ? Number(eventData.elevation_m) : null,
        slope_deg: (typeof eventData.slope_deg === 'number') ? Number(eventData.slope_deg) : null,
        speed_m_s: (typeof eventData.speed_m_s === 'number') ? Number(eventData.speed_m_s) : null,
        payload: {
          category: eventData.category || "nav",
          title: eventData.title || eventData.event_type,
          description: eventData.description || "",
          ...(eventData.payload || {})
        },
        provenance: {
          source: (eventData.provenance && eventData.provenance.source) || "marswalk_black_box",
          is_recomputed: Boolean(eventData.provenance && eventData.provenance.is_recomputed),
          algorithm_version: "10C"
        }
      };

      const resp = await fetch('/api/mission/events', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ event: eventPayload })
      });
      if (resp.ok) {
        return await resp.json();
      } else {
        const err = await resp.json().catch(() => ({}));
        console.warn('[MarsWalk BlackBox] Server error recording event:', err);
      }
    } catch (err) {
      console.warn('[MarsWalk BlackBox] Failed to log event:', err);
    }
    return null;
  }

  function openBlackBoxModal() {
    if (!blackBoxModal) return;
    blackBoxModal.classList.remove('hidden');
    const missionId = getActiveBlackBoxMissionId();
    if (blackBoxMissionIdDisplay) {
      blackBoxMissionIdDisplay.textContent = missionId;
    }
    loadBlackBoxEvents();
  }

  function closeBlackBoxModal() {
    if (blackBoxModal) blackBoxModal.classList.add('hidden');
  }

  async function loadBlackBoxEvents(filterCategory = activeBlackBoxFilter) {
    const missionId = getActiveBlackBoxMissionId();
    if (blackBoxMissionIdDisplay) blackBoxMissionIdDisplay.textContent = missionId;
    try {
      const url = `/api/mission/events?source_mission_id=${encodeURIComponent(missionId)}`;
      const resp = await fetch(url);
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      const data = await resp.json();
      blackBoxEvents = data.events || [];
      renderBlackBoxEvents(filterCategory);
    } catch (err) {
      console.warn('[MarsWalk BlackBox] Failed to load events:', err);
      if (blackBoxEventsList) {
        blackBoxEventsList.innerHTML = `<div style="font-size:9px; color:var(--text-tertiary); text-align:center; padding:15px;">No events recorded or failed to fetch.</div>`;
      }
    }
  }

  function renderBlackBoxEvents(filterCategory = 'all') {
    activeBlackBoxFilter = filterCategory;
    if (blackBoxEventCountBadge) {
      blackBoxEventCountBadge.textContent = `${blackBoxEvents.length} event${blackBoxEvents.length === 1 ? '' : 's'}`;
    }

    bbFilterPills.forEach(pill => {
      pill.classList.toggle('active', pill.dataset.filter === filterCategory);
    });

    if (!blackBoxEventsList) return;
    blackBoxEventsList.innerHTML = '';

    const filtered = blackBoxEvents.filter(ev => {
      if (filterCategory === 'all') return true;
      const cat = (ev.payload && ev.payload.category)
        ? ev.payload.category
        : (ev.event_type.includes('contingency') ? 'contingency' : (ev.event_type.includes('recalculated') || ev.event_type.includes('continuation') ? 'decision' : 'nav'));
      return cat === filterCategory;
    });

    if (filtered.length === 0) {
      blackBoxEventsList.innerHTML = `<div style="font-size:9px; color:var(--text-tertiary); text-align:center; padding:15px;">No ${filterCategory === 'all' ? '' : filterCategory} events in ledger.</div>`;
      return;
    }

    filtered.forEach((ev) => {
      const row = document.createElement('div');
      row.className = 'bb-event-row';
      if (selectedBlackBoxEvent && selectedBlackBoxEvent.event_id === ev.event_id) {
        row.classList.add('selected');
      }

      const cat = (ev.payload && ev.payload.category)
        ? ev.payload.category
        : (ev.event_type.includes('contingency') ? 'contingency' : (ev.event_type.includes('recalculated') || ev.event_type.includes('continuation') ? 'decision' : 'nav'));

      if (cat === 'contingency') row.classList.add('incident');
      else if (cat === 'decision') row.classList.add('replan');
      else if (cat === 'science') row.classList.add('science');

      let badgeColor = 'var(--text-secondary)';
      if (cat === 'contingency') badgeColor = 'var(--status-red)';
      else if (cat === 'decision') badgeColor = 'var(--data-route-amber)';
      else if (cat === 'science') badgeColor = 'var(--status-green)';
      else if (cat === 'nav') badgeColor = 'var(--telemetry-cyan)';

      const timeVal = ev.mission_time_s !== undefined ? ev.mission_time_s : (ev.playback_elapsed_s || 0);
      const timeStr = `T+${Math.round(timeVal)}s`;

      const title = (ev.payload && ev.payload.title) ? ev.payload.title : ev.event_type.replace(/_/g, ' ').toUpperCase();
      const desc = (ev.payload && ev.payload.description) ? ev.payload.description : (ev.payload && ev.payload.recommendation ? `Recommendation: ${ev.payload.recommendation}` : '');

      row.innerHTML = `
        <div style="display:flex; align-items:center; gap:6px; min-width:0;">
          <span style="font-family:var(--font-mono); font-size:8px; color:var(--text-tertiary); width:45px;">${timeStr}</span>
          <div style="min-width:0;">
            <div style="font-size:8.5px; font-weight:600; color:var(--text-primary); text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">
              ${title}
            </div>
            <div style="font-size:7.5px; color:var(--text-secondary); text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">
              ${desc}
            </div>
          </div>
        </div>
        <span class="badge" style="font-size:7px; color:${badgeColor}; border:1px solid ${badgeColor}; padding:1px 4px; border-radius:3px; text-transform:uppercase;">
          ${cat}
        </span>
      `;

      row.addEventListener('click', () => {
        selectBlackBoxEvent(ev);
      });

      blackBoxEventsList.appendChild(row);
    });

    if (!selectedBlackBoxEvent && filtered.length > 0) {
      selectBlackBoxEvent(filtered[0]);
    }
  }

  function selectBlackBoxEvent(eventObj) {
    selectedBlackBoxEvent = eventObj;
    document.querySelectorAll('.bb-event-row').forEach(el => el.classList.remove('selected'));
    if (bbDetailEventId) {
      bbDetailEventId.textContent = eventObj ? eventObj.event_id : '--';
    }
    if (bbDetailJson) {
      bbDetailJson.textContent = eventObj ? JSON.stringify(eventObj, null, 2) : 'No event selected.';
    }
  }

  async function triggerIncidentReplay() {
    const missionId = getActiveBlackBoxMissionId();
    if (btnReplayIncidentAction) {
      btnReplayIncidentAction.disabled = true;
      btnReplayIncidentAction.textContent = 'Replaying...';
    }

    try {
      const resp = await fetch('/api/mission/incident/replay', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          mission_id: missionId,
          recompute: true
        })
      });

      if (!resp.ok) {
        const err = await resp.json().catch(() => ({}));
        throw new Error(err.message || `HTTP ${resp.status}`);
      }

      const res = await resp.json();
      lastReplayResult = res;

      // Update Replay Card UI
      if (blackBoxIncidentStatusBadge) {
        if (res.reconstructed_sortie && res.reconstructed_sortie.has_incident) {
          blackBoxIncidentStatusBadge.textContent = 'INCIDENT VERIFIED';
          blackBoxIncidentStatusBadge.style.color = 'var(--status-red)';
          blackBoxIncidentStatusBadge.style.background = 'rgba(255,87,34,0.15)';
          blackBoxIncidentStatusBadge.style.borderColor = 'rgba(255,87,34,0.3)';
        } else {
          blackBoxIncidentStatusBadge.textContent = 'NOMINAL SORTIE';
          blackBoxIncidentStatusBadge.style.color = 'var(--status-green)';
          blackBoxIncidentStatusBadge.style.background = 'rgba(0,230,118,0.15)';
          blackBoxIncidentStatusBadge.style.borderColor = 'rgba(0,230,118,0.3)';
        }
      }

      if (bbRecordedRec) {
        bbRecordedRec.textContent = (res.reconstructed_sortie && res.reconstructed_sortie.recorded_recommendation) 
          ? res.reconstructed_sortie.recorded_recommendation.toUpperCase().replace(/_/g, ' ')
          : 'NOMINAL';
      }
      if (bbRecomputedRec) {
        bbRecomputedRec.textContent = (res.reconstructed_sortie && res.reconstructed_sortie.recomputed_recommendation)
          ? res.reconstructed_sortie.recomputed_recommendation.toUpperCase().replace(/_/g, ' ')
          : 'NOMINAL';
      }

      if (bbVarDist && res.fidelity) {
        bbVarDist.textContent = `${res.fidelity.variance_distance_m} m`;
      }
      if (bbVarTime && res.fidelity) {
        bbVarTime.textContent = `${res.fidelity.variance_duration_s} s`;
      }
      if (bbGeomMatch && res.fidelity) {
        if (res.fidelity.exact_geometry_match) {
          bbGeomMatch.textContent = 'MATCH';
          bbGeomMatch.style.color = 'var(--status-green)';
        } else {
          bbGeomMatch.textContent = 'DEVIATION';
          bbGeomMatch.style.color = 'var(--data-route-amber)';
        }
      }

      // Refresh events from response
      if (res.events && res.events.length > 0) {
        blackBoxEvents = res.events;
        renderBlackBoxEvents(activeBlackBoxFilter);
      }

      setPlanningStatus(`Incident replay complete for ${missionId}: decision fidelity verified.`, "success");
    } catch (err) {
      setPlanningStatus(`Incident replay failed: ${err.message}`, "error");
    } finally {
      if (btnReplayIncidentAction) {
        btnReplayIncidentAction.disabled = false;
        btnReplayIncidentAction.textContent = '⚡ REPLAY INCIDENT';
      }
    }
  }


  // =============================================================================
  // Milestone 10D: Mars Environmental Intelligence Logic
  // =============================================================================
  function openWeatherModal() {
    if (!weatherModal) return;
    weatherModal.classList.remove('hidden');
    loadWeatherData(currentWeatherSite, false);
  }

  function closeWeatherModal() {
    if (weatherModal) weatherModal.classList.add('hidden');
  }

  async function loadWeatherData(siteId = currentWeatherSite, forceRefresh = false) {
    currentWeatherSite = siteId || 'jezero_crater';
    if (weatherSiteSelect && weatherSiteSelect.value !== currentWeatherSite) {
      weatherSiteSelect.value = currentWeatherSite;
    }

    if (btnRefreshWeather) {
      btnRefreshWeather.disabled = true;
      btnRefreshWeather.textContent = 'Checking...';
    }

    try {
      let resp;
      if (forceRefresh) {
        resp = await fetch('/api/weather/refresh', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ site_id: currentWeatherSite })
        });
      } else {
        resp = await fetch(`/api/weather/current?site=${encodeURIComponent(currentWeatherSite)}`);
      }

      if (!resp.ok) {
        const err = await resp.json().catch(() => ({}));
        throw new Error(err.message || `HTTP ${resp.status}`);
      }

      const snapshot = await resp.json();
      currentWeatherSnapshot = snapshot;
      renderWeatherSnapshot(snapshot);
      setPlanningStatus(`Mars Environmental Intelligence updated for ${snapshot.site_name}.`, 'success');
    } catch (err) {
      console.warn('[MarsWalk Weather] Failed to fetch weather:', err);
      setPlanningStatus(`Weather update failed: ${err.message}`, 'error');
      if (weatherFreshnessBadge) {
        weatherFreshnessBadge.textContent = 'UNAVAILABLE';
        weatherFreshnessBadge.style.color = 'var(--status-red)';
        weatherFreshnessBadge.style.background = 'rgba(255,87,34,0.15)';
        weatherFreshnessBadge.style.borderColor = 'rgba(255,87,34,0.3)';
      }
    } finally {
      if (btnRefreshWeather) {
        btnRefreshWeather.disabled = false;
        btnRefreshWeather.textContent = '↻ REFRESH';
      }
    }
  }

  function renderWeatherSnapshot(snap) {
    if (!snap) return;

    // Freshness status badge
    if (weatherFreshnessBadge) {
      const status = snap.freshness_status || 'UNKNOWN';
      weatherFreshnessBadge.textContent = status.replace(/_/g, ' ');
      if (status === 'CURRENT' || status === 'LATEST_AVAILABLE') {
        weatherFreshnessBadge.style.color = 'var(--telemetry-cyan)';
        weatherFreshnessBadge.style.background = 'rgba(0,229,255,0.15)';
        weatherFreshnessBadge.style.borderColor = 'rgba(0,229,255,0.3)';
      } else if (status === 'CACHED_FALLBACK') {
        weatherFreshnessBadge.style.color = 'var(--status-amber)';
        weatherFreshnessBadge.style.background = 'rgba(255,145,0,0.15)';
        weatherFreshnessBadge.style.borderColor = 'rgba(255,145,0,0.3)';
      } else if (status === 'HISTORICAL') {
        weatherFreshnessBadge.style.color = 'var(--text-secondary)';
        weatherFreshnessBadge.style.background = 'rgba(255,255,255,0.1)';
        weatherFreshnessBadge.style.borderColor = 'rgba(255,255,255,0.2)';
      } else {
        weatherFreshnessBadge.style.color = 'var(--status-red)';
        weatherFreshnessBadge.style.background = 'rgba(255,87,34,0.15)';
        weatherFreshnessBadge.style.borderColor = 'rgba(255,87,34,0.3)';
      }
    }

    // Sol & times
    if (weatherSolDisplay) {
      weatherSolDisplay.textContent = snap.observation_sol !== null && snap.observation_sol !== undefined
        ? `Sol ${snap.observation_sol}`
        : 'Sol --';
    }
    if (weatherLmstDisplay) {
      weatherLmstDisplay.textContent = snap.local_mean_solar_time ? `LMST: ${snap.local_mean_solar_time}` : 'LMST: N/A';
    }
    if (weatherTimeDisplay) {
      weatherTimeDisplay.textContent = snap.observation_time_utc ? snap.observation_time_utc.replace('T', ' ').substring(0, 19) + ' UTC' : 'Climatology';
    }
    if (weatherLsDisplay) {
      weatherLsDisplay.textContent = snap.solar_longitude_ls_deg !== null && snap.solar_longitude_ls_deg !== undefined
        ? `Ls: ${snap.solar_longitude_ls_deg.toFixed(1)}° (Season)`
        : 'Ls: --°';
    }

    // Coordinates & data type
    if (weatherCoordsDisplay && snap.coordinates) {
      const lat = snap.coordinates.lat_deg >= 0 ? `${snap.coordinates.lat_deg.toFixed(2)}°N` : `${Math.abs(snap.coordinates.lat_deg).toFixed(2)}°S`;
      const lon = `${snap.coordinates.lon_deg.toFixed(2)}°E`;
      weatherCoordsDisplay.textContent = `${lat}, ${lon}`;
    }
    if (weatherDataTypeDisplay) {
      weatherDataTypeDisplay.textContent = (snap.data_type || 'OBSERVATION').replace(/_/g, ' ');
      weatherDataTypeDisplay.style.color = snap.data_type === 'IN_SITU_OBSERVATION' ? 'var(--status-green)' : 'var(--telemetry-cyan)';
    }

    // Retrieval & cache
    if (weatherLastCheckDisplay) {
      weatherLastCheckDisplay.textContent = snap.last_checked_utc ? snap.last_checked_utc.replace('T', ' ').substring(11, 19) + ' UTC' : '--';
    }
    if (weatherCacheAgeDisplay) {
      const ageSec = snap.cache_age_seconds || 0;
      weatherCacheAgeDisplay.textContent = ageSec < 60 ? `Cache: <1m` : `Cache: ${Math.round(ageSec / 60)}m ago`;
    }

    // Core Measurements
    const m = snap.measurements || {};

    // Pressure
    if (weatherPressureDisplay) {
      weatherPressureDisplay.textContent = (m.atmospheric_pressure_pa !== null && m.atmospheric_pressure_pa !== undefined)
        ? m.atmospheric_pressure_pa.toFixed(1)
        : '--';
    }
    if (weatherPressureHpaDisplay) {
      weatherPressureHpaDisplay.textContent = (m.atmospheric_pressure_pa !== null && m.atmospheric_pressure_pa !== undefined)
        ? `(${(m.atmospheric_pressure_pa / 100.0).toFixed(2)} hPa)`
        : '(-- hPa)';
    }

    // Air Temp
    if (weatherAirTempCDisplay) {
      weatherAirTempCDisplay.textContent = (m.air_temperature_c !== null && m.air_temperature_c !== undefined)
        ? (m.air_temperature_c > 0 ? `+${m.air_temperature_c.toFixed(1)}` : m.air_temperature_c.toFixed(1))
        : '--';
    }
    if (weatherAirTempKDisplay) {
      weatherAirTempKDisplay.textContent = (m.air_temperature_k !== null && m.air_temperature_k !== undefined)
        ? `(${m.air_temperature_k.toFixed(1)} K)`
        : '(-- K)';
    }

    // Ground Temp
    if (weatherGroundTempCDisplay) {
      weatherGroundTempCDisplay.textContent = (m.ground_temperature_c !== null && m.ground_temperature_c !== undefined)
        ? (m.ground_temperature_c > 0 ? `+${m.ground_temperature_c.toFixed(1)}` : m.ground_temperature_c.toFixed(1))
        : '--';
    }
    if (weatherGroundTempKDisplay) {
      weatherGroundTempKDisplay.textContent = (m.ground_temperature_k !== null && m.ground_temperature_k !== undefined)
        ? `(${m.ground_temperature_k.toFixed(1)} K)`
        : '(-- K)';
    }

    // Humidity
    if (weatherHumidityDisplay) {
      weatherHumidityDisplay.textContent = (m.relative_humidity_pct !== null && m.relative_humidity_pct !== undefined)
        ? m.relative_humidity_pct.toFixed(1)
        : '--';
    }

    // Wind
    if (weatherWindDisplay) {
      weatherWindDisplay.textContent = (m.wind_speed_m_s !== null && m.wind_speed_m_s !== undefined)
        ? m.wind_speed_m_s.toFixed(1)
        : 'RESTRICTED';
      if (m.wind_speed_m_s === null || m.wind_speed_m_s === undefined) {
        weatherWindDisplay.style.fontSize = '13px';
      } else {
        weatherWindDisplay.style.fontSize = '20px';
      }
    }
    if (weatherWindDirDisplay) {
      weatherWindDirDisplay.textContent = (m.wind_direction_deg !== null && m.wind_direction_deg !== undefined)
        ? `${m.wind_direction_deg.toFixed(0)}°`
        : '';
    }

    // Tau
    if (weatherTauDisplay) {
      weatherTauDisplay.textContent = (m.optical_depth_tau !== null && m.optical_depth_tau !== undefined)
        ? m.optical_depth_tau.toFixed(2)
        : '--';
    }
    if (weatherTauStatus) {
      const tau = m.optical_depth_tau;
      if (tau === null || tau === undefined) {
        weatherTauStatus.textContent = 'NO DATA';
        weatherTauStatus.style.color = 'var(--text-tertiary)';
      } else if (tau > 1.5) {
        weatherTauStatus.textContent = 'DUST STORM';
        weatherTauStatus.style.color = 'var(--status-red)';
      } else if (tau > 0.8) {
        weatherTauStatus.textContent = 'HAZY';
        weatherTauStatus.style.color = 'var(--status-amber)';
      } else {
        weatherTauStatus.textContent = 'CLEAR';
        weatherTauStatus.style.color = 'var(--status-green)';
      }
    }

    // Provenance
    const src = snap.source_metadata || {};
    if (weatherProvenanceInst) weatherProvenanceInst.textContent = src.instrument || '--';
    if (weatherProvenancePlat) weatherProvenancePlat.textContent = src.platform || '--';
    if (weatherProvenanceUrn) weatherProvenanceUrn.textContent = src.product_id || 'PDS4 Curated Product';
    if (weatherArchiveLink && src.archive_url) {
      weatherArchiveLink.href = src.archive_url;
    }

    // Climatology note
    if (weatherClimatologyNote) {
      const c = snap.climatological_context;
      if (c && c.model_variance_note) {
        weatherClimatologyNote.textContent = `${c.model_name}: ${c.model_variance_note}`;
      } else {
        weatherClimatologyNote.textContent = 'Climatological circulation model baseline available via MCD access portal.';
      }
    }

    // Disclosures
    if (weatherDisclosuresBox) {
      const list = snap.disclosures || [];
      if (list.length > 0) {
        weatherDisclosuresBox.innerHTML = list.map(d => `&bull; ${d}`).join('<br>');
      }
    }
  }

  function initWeatherAutoRefresh() {
    if (weatherAutoRefreshTimer) {
      clearInterval(weatherAutoRefreshTimer);
      weatherAutoRefreshTimer = null;
    }
    if (weatherAutoRefreshCheck && weatherAutoRefreshCheck.checked) {
      weatherAutoRefreshTimer = setInterval(() => {
        if (!document.hidden && weatherModal && !weatherModal.classList.contains('hidden')) {
          loadWeatherData(currentWeatherSite, false);
        }
      }, 15 * 60 * 1000);
    }
  }

  // ==========================================
  // Milestone 10E: Mission Science Report & Export Dashboard Controller
  // ==========================================

  function buildCurrentActiveMissionPlan() {
    if (!customStart || !customGoal) {
      return {
        start: { row: 117, col: 157, name: "Octavia E. Butler Landing" },
        goal: { row: 194, col: 131, name: "Kodiak Butte Outlier" },
        stops: (activeIntermediateStops || []).map(s => ({
          row: s.row,
          col: s.col,
          id: s.id,
          name: s.name,
          dwell_time_s: s.dwell_time_s || 900
        })),
        profile: currentProfile || "conservative",
        vehicle_mode: currentVehicleMode || "crew_eva",
        speed_multiplier: 1.0,
        optimize_stops: false
      };
    }
    return {
      start: { row: customStart.row, col: customStart.col, name: customStart.name || "Custom Start Point" },
      goal: { row: customGoal.row, col: customGoal.col, name: customGoal.name || "Custom Goal Destination" },
      stops: (activeIntermediateStops || []).map(s => ({
        row: s.row,
        col: s.col,
        id: s.id,
        name: s.name,
        dwell_time_s: s.dwell_time_s || 900
      })),
      profile: currentProfile || "conservative",
      vehicle_mode: currentVehicleMode || "crew_eva",
      speed_multiplier: 1.0,
      optimize_stops: false
    };
  }

  async function populateReportMissionsList(selectedId = null) {
    if (!reportMissionSelect) return;
    try {
      const resp = await fetch('/api/missions');
      if (!resp.ok) return;
      const data = await resp.json();
      const missions = data.missions || [];

      reportMissionSelect.innerHTML = '<option value="">-- Active Traversal Plan --</option>';
      missions.forEach(m => {
        const opt = document.createElement('option');
        opt.value = m.mission_id;
        opt.textContent = `${m.name || m.mission_id} (${m.mission_id})`;
        if (selectedId && m.mission_id === selectedId) {
          opt.selected = true;
        }
        reportMissionSelect.appendChild(opt);
      });
      if (selectedId) {
        reportMissionSelect.value = selectedId;
      }
    } catch (e) {
      console.warn('[MarsWalk Report] Failed loading missions list:', e);
    }
  }

  async function openMissionReportModal(preselectedMissionId = null) {
    if (!missionReportModal) return;
    missionReportModal.classList.remove('hidden');
    await populateReportMissionsList(preselectedMissionId);
    if (preselectedMissionId && reportMissionSelect) {
      reportMissionSelect.value = preselectedMissionId;
    }
    generateMissionReport();
  }

  function closeMissionReportModal() {
    if (missionReportModal) missionReportModal.classList.add('hidden');
  }

  async function generateMissionReport(forcedMissionId = null, forcedWeatherSite = null) {
    if (!btnGenerateReport) return;
    btnGenerateReport.disabled = true;
    btnGenerateReport.textContent = '⏳ ASSEMBLING...';

    const targetMid = forcedMissionId || (reportMissionSelect ? reportMissionSelect.value : null);
    const targetSite = forcedWeatherSite || (reportWeatherSiteSelect ? reportWeatherSiteSelect.value : 'jezero_crater');

    let payload = {
      weather_site: targetSite,
      include_html: true
    };

    if (targetMid) {
      payload.mission_id = targetMid;
    } else {
      payload.mission_plan = buildCurrentActiveMissionPlan();
      if (currentRouteResult) {
        payload.route_result = {
          total_distance_m: currentRouteResult.total_distance_m || currentRouteResult.distance_m,
          total_cost: currentRouteResult.total_cost || currentRouteResult.cost,
          total_duration_s: currentRouteResult.total_duration_s || currentRouteResult.duration_s,
          traverse_duration_s: currentRouteResult.traverse_duration_s,
          min_elevation_m: currentRouteResult.min_elevation_m || currentRouteResult.min_elevation,
          max_elevation_m: currentRouteResult.max_elevation_m || currentRouteResult.max_elevation,
          elevation_gain_m: currentRouteResult.elevation_gain_m || currentRouteResult.elevation_gain,
          max_slope_deg: currentRouteResult.max_slope_deg,
          mean_slope_deg: currentRouteResult.mean_slope_deg
        };
      }
    }

    try {
      const resp = await fetch('/api/mission/report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await resp.json();
      if (!resp.ok) {
        throw new Error(data.message || data.detail || `HTTP ${resp.status}`);
      }

      currentMissionReportData = data.report;
      currentMissionReportHtml = data.html;

      // Update UI displays
      if (reportStatusBadge) {
        reportStatusBadge.textContent = (data.report.mission_status || 'NOMINAL').toUpperCase();
        if (data.report.mission_status === 'completed') {
          reportStatusBadge.style.background = 'rgba(0,230,118,0.15)';
          reportStatusBadge.style.color = 'var(--status-green)';
          reportStatusBadge.style.borderColor = 'rgba(0,230,118,0.3)';
        } else if (data.report.mission_status === 'continued') {
          reportStatusBadge.style.background = 'rgba(255,145,0,0.15)';
          reportStatusBadge.style.color = 'var(--status-amber)';
          reportStatusBadge.style.borderColor = 'rgba(255,145,0,0.3)';
        } else {
          reportStatusBadge.style.background = 'rgba(0,229,255,0.15)';
          reportStatusBadge.style.color = 'var(--telemetry-cyan)';
          reportStatusBadge.style.borderColor = 'rgba(0,229,255,0.3)';
        }
      }

      if (reportIdDisplay) reportIdDisplay.textContent = data.report.report_id || '--';
      if (reportTimeDisplay) reportTimeDisplay.textContent = data.report.generated_at_utc || '--';

      const mob = data.report.mobility_metrics || {};
      if (reportDistDisplay) {
        reportDistDisplay.textContent = mob.total_distance_m !== null ? `${mob.total_distance_m.toLocaleString()} m` : 'UNCOMPUTED';
      }
      if (reportCostDisplay) {
        reportCostDisplay.textContent = mob.total_cost !== null ? `Cost: ${mob.total_cost.toLocaleString()}` : 'Cost: N/A';
      }
      if (reportDurationDisplay) {
        reportDurationDisplay.textContent = mob.total_duration_s !== null ? `${(mob.total_duration_s/60).toFixed(1)} min` : '-- min';
      }
      if (reportDwellDisplay) {
        reportDwellDisplay.textContent = `Dwell: ${(mob.total_dwell_s/60).toFixed(1)} min`;
      }

      const env = data.report.environmental_context;
      if (reportEnvDisplay) {
        reportEnvDisplay.textContent = env ? `${env.site_name} (${env.data_type.replace('_', ' ')})` : 'Atmosphere: N/A';
      }
      const ledger = data.report.sortie_ledger_summary || {};
      if (reportEventsDisplay) {
        reportEventsDisplay.textContent = `${ledger.total_events_recorded || 0} Black Box Events Logged`;
      }

      // Render high-fidelity preview inside isolated iframe
      if (reportPreviewContainer && data.html) {
        reportPreviewContainer.innerHTML = '';
        const iframe = document.createElement('iframe');
        iframe.id = 'missionReportPreviewIframe';
        iframe.style.width = '100%';
        iframe.style.height = '440px';
        iframe.style.border = 'none';
        iframe.style.borderRadius = '4px';
        iframe.style.background = '#090d16';
        iframe.srcdoc = data.html;
        reportPreviewContainer.appendChild(iframe);
      }

    } catch (err) {
      console.error('[MarsWalk Report] Generation failure:', err);
      if (reportPreviewContainer) {
        reportPreviewContainer.innerHTML = `<div style="color:var(--status-red); padding:1rem;"><strong>Failed generating report:</strong> ${err.message}</div>`;
      }
    } finally {
      if (btnGenerateReport) {
        btnGenerateReport.disabled = false;
        btnGenerateReport.innerHTML = '&#8635; GENERATE';
      }
    }
  }

  function downloadMissionReportHtml() {
    if (!currentMissionReportHtml) {
      alert("Please generate a mission report first before downloading.");
      return;
    }
    const repId = (currentMissionReportData && currentMissionReportData.report_id) ? currentMissionReportData.report_id : 'science_report';
    const blob = new Blob([currentMissionReportHtml], { type: 'text/html;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `marswalk_${repId}.html`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    setPlanningStatus(`REPORT HTML DOWNLOADED: marswalk_${repId}.html`, "success");
  }

  function downloadMissionReportJson() {
    if (!currentMissionReportData) {
      alert("Please generate a mission report first before downloading.");
      return;
    }
    const repId = currentMissionReportData.report_id || 'science_report';
    const jsonStr = JSON.stringify(currentMissionReportData, null, 2);
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `marswalk_${repId}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    setPlanningStatus(`REPORT JSON DOWNLOADED: marswalk_${repId}.json`, "success");
  }

  function printMissionReport() {
    const iframe = document.getElementById('missionReportPreviewIframe');
    if (iframe && iframe.contentWindow) {
      iframe.contentWindow.focus();
      iframe.contentWindow.print();
    } else if (currentMissionReportHtml) {
      const printWin = window.open('', '_blank');
      printWin.document.write(currentMissionReportHtml);
      printWin.document.close();
      printWin.focus();
      printWin.print();
    }
  }

  // ==========================================
  // Milestone 10F: Mission Readiness & Decision Gate Controller
  // ==========================================

  async function populateReadinessMissionsList(selectedId = null) {
    if (!readinessMissionSelect) return;
    try {
      const resp = await fetch('/api/missions');
      if (!resp.ok) return;
      const data = await resp.json();
      const missions = data.missions || [];

      readinessMissionSelect.innerHTML = '<option value="">-- Active Traversal Plan --</option>';
      missions.forEach(m => {
        const opt = document.createElement('option');
        opt.value = m.mission_id;
        opt.textContent = `${m.name || m.mission_id} (${m.mission_id})`;
        if (selectedId && m.mission_id === selectedId) {
          opt.selected = true;
        }
        readinessMissionSelect.appendChild(opt);
      });
      if (selectedId) {
        readinessMissionSelect.value = selectedId;
      }
    } catch (e) {
      console.warn('[MarsWalk Readiness] Failed loading missions list:', e);
    }
  }

  async function openMissionReadinessModal(preselectedMissionId = null) {
    if (!missionReadinessModal) return;
    missionReadinessModal.classList.remove('hidden');
    await populateReadinessMissionsList(preselectedMissionId);
    if (preselectedMissionId && readinessMissionSelect) {
      readinessMissionSelect.value = preselectedMissionId;
    }
    runMissionReadinessAssessment();
  }

  function closeMissionReadinessModal() {
    if (missionReadinessModal) missionReadinessModal.classList.add('hidden');
  }

  async function runMissionReadinessAssessment(forcedMissionId = null, forcedSite = null) {
    if (!btnRunReadinessAssessment) return;
    btnRunReadinessAssessment.disabled = true;
    btnRunReadinessAssessment.textContent = '⏳ EVALUATING...';

    const targetMid = forcedMissionId || (readinessMissionSelect ? readinessMissionSelect.value : null);
    const targetSite = forcedSite || (readinessWeatherSiteSelect ? readinessWeatherSiteSelect.value : 'jezero_crater');

    let payload = {
      weather_site: targetSite,
      persist: true
    };

    if (targetMid) {
      payload.mission_id = targetMid;
    } else {
      payload.mission_plan = buildCurrentActiveMissionPlan();
      if (currentRouteResult) {
        payload.route_result = {
          total_distance_m: currentRouteResult.total_distance_m || currentRouteResult.distance_m,
          total_cost: currentRouteResult.total_cost || currentRouteResult.cost,
          total_duration_s: currentRouteResult.total_duration_s || currentRouteResult.duration_s,
          traverse_duration_s: currentRouteResult.traverse_duration_s,
          max_slope_deg: currentRouteResult.max_slope_deg,
          mean_slope_deg: currentRouteResult.mean_slope_deg
        };
      }
    }

    try {
      const resp = await fetch('/api/mission/readiness', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await resp.json();
      if (!resp.ok) {
        throw new Error(data.message || data.detail || `HTTP ${resp.status}`);
      }

      currentReadinessAssessment = data.assessment;

      // Update Header Badges
      const status = currentReadinessAssessment.readiness_status || 'UNKNOWN';
      const score = currentReadinessAssessment.readiness_score !== null ? currentReadinessAssessment.readiness_score : '--';
      if (readinessStatusBadge) {
        readinessStatusBadge.textContent = status.replace(/_/g, ' ');
        if (status === 'READY_FOR_REVIEW') {
          readinessStatusBadge.style.background = 'rgba(0,230,118,0.15)';
          readinessStatusBadge.style.color = 'var(--status-green)';
          readinessStatusBadge.style.borderColor = 'rgba(0,230,118,0.4)';
        } else if (status === 'CONDITIONAL') {
          readinessStatusBadge.style.background = 'rgba(255,145,0,0.15)';
          readinessStatusBadge.style.color = 'var(--status-amber)';
          readinessStatusBadge.style.borderColor = 'rgba(255,145,0,0.4)';
        } else if (status === 'INCOMPLETE') {
          readinessStatusBadge.style.background = 'rgba(0,229,255,0.15)';
          readinessStatusBadge.style.color = 'var(--telemetry-cyan)';
          readinessStatusBadge.style.borderColor = 'rgba(0,229,255,0.4)';
        } else {
          // BLOCKED
          readinessStatusBadge.style.background = 'rgba(255,23,68,0.15)';
          readinessStatusBadge.style.color = 'var(--status-red)';
          readinessStatusBadge.style.borderColor = 'rgba(255,23,68,0.4)';
        }
      }
      if (readinessScoreBadge) {
        readinessScoreBadge.textContent = `SCORE: ${score}/100`;
      }

      // Update Summary Banner
      if (readinessSummaryText) readinessSummaryText.textContent = currentReadinessAssessment.summary || '--';
      if (readinessAssessmentId) readinessAssessmentId.textContent = currentReadinessAssessment.assessment_id || '--';
      if (readinessTimestamp) {
        const genTime = currentReadinessAssessment.generated_at_utc ? new Date(currentReadinessAssessment.generated_at_utc).toLocaleTimeString() : '--';
        readinessTimestamp.textContent = genTime;
      }

      // Update Category Tiles
      const cats = currentReadinessAssessment.categories_summary || {};
      const feas = cats.feasibility || {};
      if (readinessFeasBadge) {
        readinessFeasBadge.textContent = feas.status || 'UNKNOWN';
        readinessFeasBadge.style.color = feas.status === 'PASSED' ? 'var(--status-green)' : (feas.status === 'BLOCKED' ? 'var(--status-red)' : 'var(--status-amber)');
      }
      if (readinessFeasRoute) readinessFeasRoute.textContent = feas.route_exists ? `${(feas.total_distance_m || 0).toLocaleString()} m` : 'Uncomputed';
      if (readinessFeasDuration) readinessFeasDuration.textContent = feas.total_duration_s ? `${(feas.total_duration_s/60).toFixed(1)} min` : '--';
      if (readinessFeasMargin) readinessFeasMargin.textContent = feas.margin_s !== null ? `${(feas.margin_s/60).toFixed(1)} min` : '--';

      const env = cats.environmental || {};
      if (readinessEnvBadge) {
        readinessEnvBadge.textContent = env.status || 'UNKNOWN';
        readinessEnvBadge.style.color = env.status === 'PASSED' ? 'var(--status-green)' : 'var(--status-amber)';
      }
      if (readinessEnvSite) readinessEnvSite.textContent = env.site_name || '--';
      if (readinessEnvType) readinessEnvType.textContent = (env.data_type || '').replace(/_/g, ' ');
      if (readinessEnvCompat) readinessEnvCompat.textContent = env.is_site_compatible ? 'Compatible' : 'Site Mismatch';

      const rob = cats.robustness || {};
      if (readinessRobBadge) {
        readinessRobBadge.textContent = rob.status || 'UNKNOWN';
        readinessRobBadge.style.color = rob.status === 'PASSED' ? 'var(--status-green)' : '#c084fc';
      }
      if (readinessRobTested) readinessRobTested.textContent = `${rob.tested_scenarios_count || 0} classes`;
      if (readinessRobUntested) readinessRobUntested.textContent = `${rob.untested_scenarios_count || 0} classes`;
      if (readinessRobBreakpoints) readinessRobBreakpoints.textContent = `${rob.breakpoint_count || 0} found`;

      const prov = cats.provenance || {};
      if (readinessProvBadge) {
        readinessProvBadge.textContent = prov.status || 'UNKNOWN';
        readinessProvBadge.style.color = 'var(--status-green)';
      }
      if (readinessProvSource) readinessProvSource.textContent = prov.is_recomputed ? 'Recomputed' : 'Recorded Baseline';
      if (readinessProvLedger) readinessProvLedger.textContent = prov.ledger_present ? `${prov.events_count || 0} events` : 'No Ledger';
      const dtmSha = currentReadinessAssessment.reproducibility_manifest ? currentReadinessAssessment.reproducibility_manifest.terrain_sha256 : '';
      if (readinessProvDigest) readinessProvDigest.textContent = dtmSha ? `${dtmSha.substring(0, 10)}...` : '--';

      // Update Counts
      const findings = currentReadinessAssessment.findings || [];
      if (catCountAll) catCountAll.textContent = findings.length;
      if (catCountFeas) catCountFeas.textContent = findings.filter(f => f.category === 'feasibility').length;
      if (catCountEnv) catCountEnv.textContent = findings.filter(f => f.category === 'environmental').length;
      if (catCountRob) catCountRob.textContent = findings.filter(f => f.category === 'robustness').length;
      if (catCountProv) catCountProv.textContent = findings.filter(f => f.category === 'provenance').length;

      if (sevCountBlocker) sevCountBlocker.textContent = currentReadinessAssessment.blocker_count || 0;
      if (sevCountWarning) sevCountWarning.textContent = currentReadinessAssessment.warning_count || 0;
      if (sevCountUntested) sevCountUntested.textContent = currentReadinessAssessment.untested_count || 0;
      if (sevCountInfo) sevCountInfo.textContent = currentReadinessAssessment.info_count || 0;

      renderReadinessFindings();

    } catch (err) {
      console.error('[MarsWalk Readiness] Evaluation failure:', err);
      if (readinessSummaryText) {
        readinessSummaryText.textContent = `Evaluation failed: ${err.message}`;
      }
      if (readinessFindingsList) {
        readinessFindingsList.innerHTML = `<div style="color:var(--status-red); padding:1rem;"><strong>Evaluation Error:</strong> ${err.message}</div>`;
      }
    } finally {
      if (btnRunReadinessAssessment) {
        btnRunReadinessAssessment.disabled = false;
        btnRunReadinessAssessment.innerHTML = '&#8635; EVALUATE GATE';
      }
    }
  }

  function renderReadinessFindings() {
    if (!readinessFindingsList || !currentReadinessAssessment) return;
    const findings = currentReadinessAssessment.findings || [];

    const filtered = findings.filter(f => {
      const matchCat = (activeReadinessCat === 'all' || f.category === activeReadinessCat);
      const matchSev = (activeReadinessSev === 'all' || f.severity === activeReadinessSev);
      return matchCat && matchSev;
    });

    if (filtered.length === 0) {
      readinessFindingsList.innerHTML = `
        <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:180px; color:var(--text-secondary); gap:6px;">
          <span style="font-size:20px;">✓</span>
          <div style="font-size:10px; font-weight:600;">No findings matching current filter</div>
        </div>
      `;
      return;
    }

    readinessFindingsList.innerHTML = filtered.map((f, idx) => {
      let sevColor = 'var(--telemetry-cyan)';
      let sevBadgeBg = 'rgba(0,229,255,0.15)';
      if (f.severity === 'blocker') {
        sevColor = 'var(--status-red)';
        sevBadgeBg = 'rgba(255,23,68,0.15)';
      } else if (f.severity === 'warning') {
        sevColor = 'var(--status-amber)';
        sevBadgeBg = 'rgba(255,145,0,0.15)';
      } else if (f.severity === 'untested') {
        sevColor = '#c084fc';
        sevBadgeBg = 'rgba(168,85,247,0.15)';
      }

      const refsJson = JSON.stringify(f.evidence_references || {}, null, 1);
      return `
        <div class="finding-card severity-${f.severity}" onclick="this.querySelector('.finding-details').classList.toggle('hidden')">
          <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px;">
            <div>
              <div style="display:flex; align-items:center; gap:6px;">
                <span class="badge" style="font-size:7px; background:${sevBadgeBg}; color:${sevColor}; border:1px solid ${sevColor}; padding:1px 4px; border-radius:2px;">${f.severity.toUpperCase()}</span>
                <span style="font-size:9.5px; font-weight:700; color:#fff;">${f.title}</span>
              </div>
              <div style="font-size:8.5px; color:var(--text-secondary); margin-top:2px;">${f.description}</div>
            </div>
            <div style="font-family:var(--font-mono); font-size:7.5px; color:var(--text-tertiary); text-align:right;">
              <div>${f.finding_code}</div>
              <div style="text-transform:uppercase;">${f.category}</div>
            </div>
          </div>
          <div class="finding-details hidden">
            <div><strong>Recommended Action:</strong> ${f.recommended_action || 'None'}</div>
            <div style="margin-top:4px;"><strong>Evidence References:</strong> <code style="font-size:7.5px; color:var(--telemetry-cyan);">${refsJson}</code></div>
          </div>
        </div>
      `;
    }).join('');
  }

  function exportReadinessAssessmentJson() {
    if (!currentReadinessAssessment) {
      alert("Please run a readiness assessment first before exporting.");
      return;
    }
    const aid = currentReadinessAssessment.assessment_id || 'readiness_assessment';
    const jsonStr = JSON.stringify(currentReadinessAssessment, null, 2);
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `marswalk_${aid}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    setPlanningStatus(`READINESS ASSESSMENT DOWNLOADED: marswalk_${aid}.json`, "success");
  }

