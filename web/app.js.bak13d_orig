  function switchInspectorTab(tabId) {
    if (inspectorTabs) {
      inspectorTabs.forEach(t => {
        if (t.dataset.tab === tabId) t.classList.add('active');
        else t.classList.remove('active');
      });
    }
    const panels = { tabMissionControl, tabExperimentStudio, tabRobustnessLab, tabRehearsalDirector, tabPlan, tabResults, tabScenarios, tabWorkspaces };
    Object.keys(panels).forEach(k => {
      if (panels[k]) {
        if (k === tabId) panels[k].classList.remove('hidden');
        else panels[k].classList.add('hidden');
      }
    });
    if (inspectorPanel) {
      if (tabId === 'tabMissionControl' || tabId === 'tabExperimentStudio' || tabId === 'tabRobustnessLab' || tabId === 'tabRehearsalDirector') {
        inspectorPanel.classList.add('cockpit-mode');
      } else {
        inspectorPanel.classList.remove('cockpit-mode');
      }
    }
    if (tabId !== 'tabRehearsalDirector' && rehExperimentBreadcrumb) {
      rehExperimentBreadcrumb.style.display = 'none';
      rehExperimentBreadcrumb.classList.add('hidden');
    }
  }


