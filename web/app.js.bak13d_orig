  function renderCampaignTargetsList() {
    if (!campaignTargetsContainer) return;
    if (!availableCampaignTargets || availableCampaignTargets.length === 0) {
      availableCampaignTargets = JSON.parse(JSON.stringify(defaultJezeroCampaignTargets));
      availableCampaignTargets.forEach(t => t.selected = true);
    }

    const scheduledTargetIds = new Map();
    if (currentCampaignPlan && currentCampaignPlan.sorties) {
      currentCampaignPlan.sorties.forEach(s => {
        (s.targets_visited || []).forEach(tid => {
          scheduledTargetIds.set(tid, s.sol_number);
        });
      });
    }

    const unscheduledMap = new Map();
    if (currentCampaignPlan && currentCampaignPlan.summary && currentCampaignPlan.summary.unscheduled_targets) {
      currentCampaignPlan.summary.unscheduled_targets.forEach(u => {
        unscheduledMap.set(u.target_id, u.reason);
      });
    }

    let scheduledCount = scheduledTargetIds.size;
    let totalCount = availableCampaignTargets.filter(t => t.selected !== false).length;
    if (campaignTargetsCountBadge) {
      campaignTargetsCountBadge.textContent = `${scheduledCount} / ${totalCount} Scheduled`;
    }

    campaignTargetsContainer.innerHTML = availableCampaignTargets.map(target => {
      const isChecked = target.selected !== false ? 'checked' : '';
      let statusHtml = '';
      if (scheduledTargetIds.has(target.id)) {
        const solNum = scheduledTargetIds.get(target.id);
        const solColor = solColors[(solNum - 1) % solColors.length];
        statusHtml = `<span class="badge" style="background:rgba(0,0,0,0.5); color:${solColor}; border:1px solid ${solColor}; font-size:7px;">SOL ${solNum}</span>`;
      } else if (unscheduledMap.has(target.id)) {
        const reason = unscheduledMap.get(target.id);
        let badgeBg = 'rgba(239,68,68,0.15)';
        let badgeColor = '#f87171';
        let label = reason;
        if (reason === 'REJECTED_PREREQUISITE_FAILED') {
          label = 'PREREQ FAILED';
        } else if (reason === 'REJECTED_BUDGET_EXCEEDED') {
          label = 'BUDGET EXCEEDED';
          badgeColor = '#fbbf24';
          badgeBg = 'rgba(245,158,11,0.15)';
        } else if (reason === 'DEFERRED') {
          label = 'DEFERRED';
          badgeColor = '#9ca3af';
          badgeBg = 'rgba(156,163,175,0.15)';
        }
        statusHtml = `<span class="badge" style="background:${badgeBg}; color:${badgeColor}; font-size:7px;">${label}</span>`;
      }

      const prereqBadge = (target.required_prerequisites && target.required_prerequisites.length > 0)
        ? `<span style="font-size:7.5px; color:#f59e0b; background:rgba(245,158,11,0.1); padding:1px 4px; border-radius:2px;">Prereq: ${target.required_prerequisites.join(', ')}</span>`
        : '';

      return `
        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:8px; padding:6px 8px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); border-radius:3px;">
          <div style="display:flex; align-items:flex-start; gap:6px;">
            <input type="checkbox" id="campaign_target_${target.id}" data-target-id="${target.id}" class="campaign-target-checkbox" ${isChecked} style="margin-top:2px;">
            <div>
              <div style="display:flex; align-items:center; gap:6px;">
                <label for="campaign_target_${target.id}" style="font-size:9.5px; font-weight:600; color:#fff; cursor:pointer;">${target.name}</label>
                <span class="badge" style="background:rgba(16,185,129,0.15); color:#34d399; font-size:7px;">★ ${target.priority_score}</span>
                <span style="font-size:7.5px; color:var(--text-secondary); font-family:var(--font-mono);">${Math.round(target.dwell_time_seconds / 60)}m dwell</span>
              </div>
              <div style="font-size:8px; color:var(--text-tertiary); margin-top:2px;">${target.scientific_rationale || ''}</div>
              <div style="display:flex; gap:4px; margin-top:3px;">
                ${prereqBadge}
                <span style="font-size:7.5px; color:var(--text-tertiary); font-family:var(--font-mono);">(${target.row}, ${target.col})</span>
              </div>
            </div>
          </div>
          <div>${statusHtml}</div>
        </div>
      `;
    }).join('');

    campaignTargetsContainer.querySelectorAll('.campaign-target-checkbox').forEach(cb => {
      cb.addEventListener('change', (e) => {
        const tid = e.target.dataset.targetId;
        const t = availableCampaignTargets.find(item => item.id === tid);
        if (t) {
          t.selected = e.target.checked;
          const totalSel = availableCampaignTargets.filter(item => item.selected !== false).length;
          const schedCount = scheduledTargetIds.size;
          if (campaignTargetsCountBadge) {
            campaignTargetsCountBadge.textContent = `${schedCount} / ${totalSel} Scheduled`;
          }
        }
      });
    });
  }

  function openCampaignModal() {
    if (!campaignModal) return;
    campaignModal.classList.remove('hidden');
    if (!availableCampaignTargets || availableCampaignTargets.length === 0) {
      availableCampaignTargets = JSON.parse(JSON.stringify(defaultJezeroCampaignTargets));
      availableCampaignTargets.forEach(t => t.selected = true);
    }
    renderCampaignTargetsList();
    if (currentCampaignPlan) {
      renderCampaignSummary(currentCampaignPlan);
      renderCampaignSorties(currentCampaignPlan.sorties);
    }
  }

  function closeCampaignModal() {
    if (campaignModal) campaignModal.classList.add('hidden');
  }

  function renderCampaignSummary(campaign) {
    if (!campaign) return;
    const summary = campaign.summary || {};
    const sorties = campaign.sorties || [];

    if (campaignStatusBadge) {
      campaignStatusBadge.textContent = (campaign.status || 'PLANNED').toUpperCase();
    }
    if (campaignSolsBadge) {
      campaignSolsBadge.textContent = `${sorties.length} Sols Planned`;
    }
    if (campaignVersionBadge) {
      campaignVersionBadge.textContent = `v${campaign.version || 1}`;
    }

    if (campaignSummaryTitle) {
      const scheduledTargets = summary.targets_scheduled !== undefined ? summary.targets_scheduled : 0;
      const solsCount = summary.sols_utilized || summary.total_sols || sorties.length;
      campaignSummaryTitle.textContent = `${campaign.name} (${(campaign.profile || (campaign.config && campaign.config.planning_profile) || 'balanced').toUpperCase()} profile) — ${scheduledTargets} objectives scheduled across ${solsCount} sols.`;
    }

    const totalDist = summary.total_traverse_distance_m !== undefined ? summary.total_traverse_distance_m : (summary.total_distance_m || 0);
    const totalTravel = summary.total_travel_time_seconds !== undefined ? summary.total_travel_time_seconds : (summary.total_travel_time_s || 0);
    const totalDwell = summary.total_dwell_time_seconds !== undefined ? summary.total_dwell_time_seconds : (summary.total_dwell_time_s || 0);
    const totalDurH = summary.total_duration_hours !== undefined ? summary.total_duration_hours : ((summary.total_duration_s || 0) / 3600);
    const totalScore = summary.total_science_yield !== undefined ? summary.total_science_yield : (summary.total_science_score || 0);

    if (campaignTotalDist) {
      campaignTotalDist.textContent = `${(totalDist / 1000).toFixed(2)} km`;
    }
    if (campaignTotalTravel) {
      campaignTotalTravel.textContent = `${(totalTravel / 3600).toFixed(2)} h`;
    }
    if (campaignTotalDwell) {
      campaignTotalDwell.textContent = `${(totalDwell / 3600).toFixed(2)} h`;
    }
    if (campaignTotalTime) {
      campaignTotalTime.textContent = `${totalDurH.toFixed(2)} h`;
    }
    if (campaignTotalScore) {
      campaignTotalScore.textContent = `${totalScore.toFixed(1)}`;
    }
  }

  function renderCampaignSorties(sorties) {
    if (!campaignSortiesList) return;
    if (!sorties || sorties.length === 0) {
      campaignSortiesList.innerHTML = `
        <div style="font-size:9.5px; color:var(--text-tertiary); text-align:center; padding:30px 10px;">
          No sorties planned. Configure parameters and click 'PLAN CAMPAIGN'.
        </div>
      `;
      if (campaignSortieCountBadge) campaignSortieCountBadge.textContent = '0 Sols';
      return;
    }

    if (campaignSortieCountBadge) {
      campaignSortieCountBadge.textContent = `${sorties.length} Sols`;
    }

    campaignSortiesList.innerHTML = sorties.map((s, idx) => {
      const color = solColors[idx % solColors.length];
      const solNum = s.sol_number !== undefined ? s.sol_number : (s.sol_index !== undefined ? s.sol_index : (idx + 1));
      const dist = s.traverse_distance_m !== undefined ? s.traverse_distance_m : (s.distance_m || 0);
      const distKm = (dist / 1000).toFixed(2);
      const durSec = s.total_duration_seconds !== undefined ? s.total_duration_seconds : (s.total_duration_s || 0);
      const durHours = (durSec / 3600).toFixed(2);
      const climbM = (s.cumulative_climb_m || 0).toFixed(1);
      const targetIds = s.targets_visited || s.target_ids || [];
      const score = s.science_yield !== undefined ? s.science_yield : (s.science_score || 0);
      const targetsVisited = targetIds.map(tid => {
        const tObj = availableCampaignTargets.find(item => item.id === tid);
        const tName = tObj ? tObj.name : tid;
        return `<span class="badge" style="font-size:7.5px; background:rgba(0,0,0,0.4); color:${color}; border:1px solid ${color}; padding:1px 4px; border-radius:2px;">${tName}</span>`;
      }).join(' ');

      const baseReturnTag = s.return_to_base
        ? `<span style="font-size:7.5px; color:var(--text-secondary);">&rarr; Base Return</span>`
        : `<span style="font-size:7.5px; color:var(--status-amber);">&rarr; Field Overnight</span>`;

      return `
        <div style="background:rgba(255,255,255,0.02); border-left:3px solid ${color}; border-top:1px solid rgba(255,255,255,0.06); border-right:1px solid rgba(255,255,255,0.06); border-bottom:1px solid rgba(255,255,255,0.06); border-radius:3px; padding:8px 10px;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <div style="display:flex; align-items:center; gap:6px;">
              <span class="badge" style="background:${color}22; color:${color}; font-size:8px; font-weight:700; border:1px solid ${color}; padding:1px 5px; border-radius:2px;">SOL ${solNum}</span>
              <span style="font-size:9.5px; font-weight:600; color:#fff;">${s.status ? s.status.toUpperCase() : 'NOMINAL'}</span>
              ${baseReturnTag}
            </div>
            <div style="font-size:7.5px; font-family:var(--font-mono); color:var(--text-secondary);">
              Yield: <strong style="color:#34d399;">${score.toFixed(1)}</strong>
            </div>
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:4px; margin-top:5px;">
            ${targetsVisited || '<span style="font-size:8px; color:var(--text-tertiary);">Direct leg / transit</span>'}
          </div>
          <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:6px; margin-top:6px; font-size:8px; font-family:var(--font-mono); color:var(--text-secondary);">
            <div>Distance: <strong style="color:#fff;">${distKm} km</strong></div>
            <div>Duration: <strong style="color:#fff;">${durHours} h</strong></div>
            <div>Climb: <strong style="color:#fff;">${climbM} m</strong></div>
          </div>
        </div>
      `;
    }).join('');
  }

  function drawCampaignSortieRoutes(sorties) {
    if (campaignRouteMeshes && campaignRouteMeshes.length > 0) {
      campaignRouteMeshes.forEach(mesh => {
        if (jezeroSurfaceGroup) jezeroSurfaceGroup.remove(mesh);
      });
      campaignRouteMeshes = [];
    }
    if (!sorties || sorties.length === 0 || !jezeroSurfaceGroup) return;

    sorties.forEach((sortie, idx) => {
      const path = sortie.route_path_rc || sortie.path_rc || [];
      if (!path || path.length < 2) return;
      const points = [];
      for (let i = 0; i < path.length; i++) {
        const r = path[i][0];
        const c = path[i][1];
        const elev = getJezeroElevationAt(r, c);
        const pos = rcToLocalPos(r, c, elev, currentExaggeration);
        pos.y += 3.8 + (idx * 0.25);
        points.push(pos);
      }
      const colorHex = parseInt(solColors[idx % solColors.length].replace('#', '0x'), 16);
      const geom = new THREE.BufferGeometry().setFromPoints(points);
      const mat = new THREE.LineBasicMaterial({
        color: colorHex,
        linewidth: 3,
      });
      const lineMesh = new THREE.Line(geom, mat);
      lineMesh.renderOrder = 24 + idx;
      jezeroSurfaceGroup.add(lineMesh);
      campaignRouteMeshes.push(lineMesh);
    });
  }

  function clearCampaignRoutes() {
    if (campaignRouteMeshes && campaignRouteMeshes.length > 0) {
      campaignRouteMeshes.forEach(mesh => {
        if (jezeroSurfaceGroup) jezeroSurfaceGroup.remove(mesh);
      });
      campaignRouteMeshes = [];
    }
  }

  async function planCampaignAction(forcedPayload = null) {
    if (btnPlanCampaign) {
      btnPlanCampaign.disabled = true;
      btnPlanCampaign.innerHTML = '&#9881; Planning Campaign...';
    }
    setPlanningStatus("COMPUTING MULTI-SOL CAMPAIGN ITINERARY (A* TRAVERSES)...", "calculating");

    try {
      let payload = forcedPayload;
      if (!payload) {
        const profile = campaignProfileSelect ? campaignProfileSelect.value : 'science_priority';
        const maxDurationH = parseFloat(campaignDurationInput ? campaignDurationInput.value : '8.0') || 8.0;
        const maxSols = parseInt(campaignMaxSolsInput ? campaignMaxSolsInput.value : '4', 10) || 4;
        const returnBase = campaignReturnBaseCheck ? campaignReturnBaseCheck.checked : true;

        if (!availableCampaignTargets || availableCampaignTargets.length === 0) {
          availableCampaignTargets = JSON.parse(JSON.stringify(defaultJezeroCampaignTargets));
          availableCampaignTargets.forEach(t => t.selected = true);
        }

        const selectedTargets = availableCampaignTargets
          .filter(t => t.selected !== false)
          .map(t => ({
            id: t.id,
            name: t.name,
            row: t.row,
            col: t.col,
            priority_score: t.priority_score,
            dwell_time_seconds: t.dwell_time_seconds,
            required_prerequisites: t.required_prerequisites || [],
            scientific_rationale: t.scientific_rationale || ''
          }));

        const baseLoc = (customStart && customStart.row && customStart.col)
          ? { id: customStart.id || 'mission_base', name: customStart.name || 'Expedition Base', row: customStart.row, col: customStart.col }
          : { id: 'octavia_butler_landing', name: 'Octavia E. Butler Landing', row: 117, col: 157 };

        payload = {
          name: "Jezero Multi-Sol Science Campaign",
          campaign_id: currentCampaignPlan ? currentCampaignPlan.campaign_id : `cmp_jezero_${Date.now()}`,
          profile: profile,
          base_location: baseLoc,
          targets: selectedTargets,
          config: {
            max_sol_duration_hours: maxDurationH,
            max_sols: maxSols,
            return_to_base_each_sol: returnBase,
            profile: profile
          },
          persist: true
        };
      }

      const resp = await fetch('/api/campaign/plan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.error || `HTTP ${resp.status} during campaign planning`);
      }

      const result = await resp.json();
      currentCampaignPlan = result.campaign;

      renderCampaignSummary(currentCampaignPlan);
      renderCampaignSorties(currentCampaignPlan.sorties);
      renderCampaignTargetsList();
      drawCampaignSortieRoutes(currentCampaignPlan.sorties);

      if (campaignDisruptionDelta) campaignDisruptionDelta.classList.add('hidden');

      setPlanningStatus(`CAMPAIGN PLANNED: ${currentCampaignPlan.summary.targets_scheduled} targets scheduled across ${currentCampaignPlan.sorties.length} sols`, "success");
      return currentCampaignPlan;
    } catch (err) {
      console.error('[MarsWalk Atlas] Campaign planning error:', err);
      setPlanningStatus(`CAMPAIGN PLANNING FAILED: ${err.message || err}`, "error");
    } finally {
      if (btnPlanCampaign) {
        btnPlanCampaign.disabled = false;
        btnPlanCampaign.innerHTML = '&#9654; PLAN CAMPAIGN';
      }
    }
  }

  function openCampaignDisruptionModal() {
    if (!currentCampaignPlan) {
      alert("Please plan a campaign before injecting an operational disruption.");
      return;
    }
    if (campaignDisruptionModal) campaignDisruptionModal.classList.remove('hidden');
  }

  function closeCampaignDisruptionModal() {
    if (campaignDisruptionModal) campaignDisruptionModal.classList.add('hidden');
  }

  async function replanCampaignAction(forcedDisruption = null) {
    if (!currentCampaignPlan) {
      alert("Please plan a campaign first.");
      return;
    }
    if (btnExecuteCampaignReplan) {
      btnExecuteCampaignReplan.disabled = true;
      btnExecuteCampaignReplan.innerHTML = '&#9881; Replanning Campaign...';
    }
    setPlanningStatus("REPLANNING CAMPAIGN UNDER OPERATIONAL DISRUPTION...", "calculating");

    try {
      const disruptionType = forcedDisruption ? forcedDisruption.disruption_type : (campaignDisruptionTypeSelect ? campaignDisruptionTypeSelect.value : 'target_unavailable');
      const desc = forcedDisruption ? forcedDisruption.description : (disruptionDescriptionInput ? disruptionDescriptionInput.value : 'Simulated operational disruption');
      const solNum = forcedDisruption ? (forcedDisruption.sol_number || 2) : 2;

      const payload = {
        campaign_id: currentCampaignPlan.campaign_id,
        campaign: currentCampaignPlan,
        disruption_type: disruptionType,
        description: desc,
        sol_number: solNum,
        persist: true
      };

      if (disruptionType === 'target_unavailable') {
        payload.affected_target_id = 'hawksbill_gap';
      } else if (disruptionType === 'closed_corridor') {
        payload.affected_center_rc = [136, 91];
        payload.affected_radius_m = 100.0;
      } else if (disruptionType === 'reduced_mobility') {
        payload.speed_multiplier = 0.5;
      } else if (disruptionType === 'reduced_time_budget') {
        payload.new_duration_hours = 5.0;
      }

      const prevPlan = JSON.parse(JSON.stringify(currentCampaignPlan));
      const resp = await fetch('/api/campaign/replan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.error || `HTTP ${resp.status} during campaign replanning`);
      }

      const result = await resp.json();
      currentCampaignPlan = result.campaign;

      // Render delta banner
      const oldSummary = prevPlan.summary || {};
      const newSummary = currentCampaignPlan.summary || {};

      const deltaDistKm = ((newSummary.total_traverse_distance_m - oldSummary.total_traverse_distance_m) / 1000).toFixed(2);
      const deltaTimeH = (newSummary.total_duration_hours - oldSummary.total_duration_hours).toFixed(2);
      const deltaScore = (newSummary.total_science_yield - oldSummary.total_science_yield).toFixed(1);

      const oldTargets = new Set();
      (prevPlan.sorties || []).forEach(s => (s.targets_visited || []).forEach(tid => oldTargets.add(tid)));
      const newTargets = new Set();
      (currentCampaignPlan.sorties || []).forEach(s => (s.targets_visited || []).forEach(tid => newTargets.add(tid)));
      let omittedCount = 0;
      oldTargets.forEach(tid => {
        if (!newTargets.has(tid)) omittedCount++;
      });

      if (campaignDisruptionDelta) {
        campaignDisruptionDelta.classList.remove('hidden');
        if (campaignDisruptionTypeBadge) campaignDisruptionTypeBadge.textContent = disruptionType.toUpperCase().replace(/_/g, ' ');
        if (campaignDisruptionNotes) campaignDisruptionNotes.textContent = desc;
        if (campaignDeltaDist) campaignDeltaDist.textContent = `${deltaDistKm >= 0 ? '+' : ''}${deltaDistKm} km`;
        if (campaignDeltaTime) campaignDeltaTime.textContent = `${deltaTimeH >= 0 ? '+' : ''}${deltaTimeH} h`;
        if (campaignDeltaScore) campaignDeltaScore.textContent = `${deltaScore >= 0 ? '+' : ''}${deltaScore}`;
        if (campaignDeltaOmitted) campaignDeltaOmitted.textContent = `${omittedCount} target${omittedCount === 1 ? '' : 's'}`;
      }

      renderCampaignSummary(currentCampaignPlan);
      renderCampaignSorties(currentCampaignPlan.sorties);
      renderCampaignTargetsList();
      drawCampaignSortieRoutes(currentCampaignPlan.sorties);

      closeCampaignDisruptionModal();
      setPlanningStatus(`CAMPAIGN REPLANNED (v${currentCampaignPlan.version}): Downstream itinerary adapted under ${disruptionType}`, "success");
      return currentCampaignPlan;
    } catch (err) {
      console.error('[MarsWalk Atlas] Campaign replanning error:', err);
      setPlanningStatus(`CAMPAIGN REPLANNING FAILED: ${err.message || err}`, "error");
    } finally {
      if (btnExecuteCampaignReplan) {
        btnExecuteCampaignReplan.disabled = false;
        btnExecuteCampaignReplan.innerHTML = '&#9889; REPLAN DOWNSTREAM SOLS';
      }
    }
  }

  function exportCampaignJson() {
    if (!currentCampaignPlan) {
      alert("Please plan a campaign first before exporting.");
      return;
    }
    const cid = currentCampaignPlan.campaign_id || 'campaign';
    const ver = currentCampaignPlan.version || 1;
    const jsonStr = JSON.stringify(currentCampaignPlan, null, 2);
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `marswalk_${cid}_v${ver}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    setPlanningStatus(`CAMPAIGN DEFINITION DOWNLOADED: marswalk_${cid}_v${ver}.json`, "success");
  }

  async function exportCampaignHtml() {
    if (!currentCampaignPlan) {
      alert("Please plan a campaign first before exporting report.");
      return;
    }
    setPlanningStatus("GENERATING STANDALONE HTML CAMPAIGN REPORT...", "calculating");
    try {
      const resp = await fetch('/api/campaign/export_report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ campaign: currentCampaignPlan })
      });
      if (!resp.ok) throw new Error(`HTTP ${resp.status} exporting campaign report`);
      const result = await resp.json();
      const htmlStr = result.html;
      const cid = currentCampaignPlan.campaign_id || 'campaign';
      const ver = currentCampaignPlan.version || 1;
      const blob = new Blob([htmlStr], { type: 'text/html' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `marswalk_campaign_dossier_${cid}_v${ver}.html`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      setPlanningStatus(`CAMPAIGN DOSSIER DOWNLOADED: marswalk_campaign_dossier_${cid}_v${ver}.html`, "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Export HTML report error:', err);
      setPlanningStatus(`EXPORT CAMPAIGN REPORT FAILED: ${err.message || err}`, "error");
    }
  }

  // ==============================================================================
  // Milestone 11B: Campaign Progress & Science Observation Registry
  // ==============================================================================

  function switchCampaignTab(tab) {
    const tabs = [
      { id: 'planning', btn: btnTabCampaignPlanning, view: campaignPlanningView },
      { id: 'progress', btn: btnTabCampaignProgress, view: campaignProgressView },
      { id: 'intelligence', btn: btnTabCampaignIntelligence, view: campaignIntelligenceView },
      { id: 'whatif', btn: btnTabCampaignWhatIf, view: campaignWhatIfView },
      { id: 'coordination', btn: btnTabCampaignCoordination, view: campaignCoordinationView },
      { id: 'simulation', btn: btnTabCampaignSimulation, view: campaignSimulationView },
      { id: 'analytics', btn: btnTabCampaignAnalytics, view: campaignAnalyticsView },
      { id: 'design_space', btn: btnTabCampaignDesignSpace, view: campaignDesignSpaceView }
    ];

    tabs.forEach(t => {
      if (!t.btn || !t.view) return;
      if (t.id === tab) {
        t.btn.classList.add('active');
        t.btn.style.background = 'rgba(16,185,129,0.2)';
        t.btn.style.borderColor = '#10b981';
        t.btn.style.color = '#34d399';
        t.view.classList.remove('hidden');
      } else {
        t.btn.classList.remove('active');
        t.btn.style.background = 'transparent';
        t.btn.style.borderColor = 'rgba(255,255,255,0.15)';
        t.btn.style.color = '#fff';
        t.view.classList.add('hidden');
      }
    });

    if (currentCampaignPlan) {
      if (tab === 'progress') {
        loadAndRenderCampaignProgress(currentCampaignPlan.campaign_id);
      } else if (tab === 'intelligence') {
        loadAndRenderCampaignIntelligence(currentCampaignPlan.campaign_id);
      } else if (tab === 'whatif') {
        loadAndRenderCampaignWhatIf(currentCampaignPlan.campaign_id);
      } else if (tab === 'coordination') {
        loadAndRenderCampaignCoordination(currentCampaignPlan.campaign_id);
      } else if (tab === 'simulation') {
        loadAndRenderCampaignSimulation(currentCampaignPlan.campaign_id);
      } else if (tab === 'analytics') {
        loadAndRenderCampaignAnalytics(currentCampaignPlan.campaign_id);
      } else if (tab === 'design_space') {
        loadAndRenderCampaignDesignSpace(currentCampaignPlan.campaign_id);
      }
    }
  }

  async function loadAndRenderCampaignProgress(campaignId) {
    if (!campaignId) return;
    try {
      const [progResp, nextResp] = await Promise.all([
        fetch(`/api/campaign/progress?campaign_id=${encodeURIComponent(campaignId)}`),
        fetch(`/api/campaign/next_eligible_targets?campaign_id=${encodeURIComponent(campaignId)}`)
      ]);

      if (!progResp.ok) throw new Error(`HTTP ${progResp.status} loading campaign progress`);
      const progData = await progResp.json();
      const nextData = nextResp.ok ? await nextResp.json() : { eligible_targets: [] };

      renderCampaignProgressUI(progData, nextData.eligible_targets || []);
    } catch (err) {
      console.error('[MarsWalk Atlas] Error loading campaign progress:', err);
    }
  }

  function renderCampaignProgressUI(progData, eligibleTargets = []) {
    const progress = (progData && progData.progress) ? progData.progress : {};
    const events = (progData && progData.events) ? progData.events : [];
    const observations = (progData && progData.observations) ? progData.observations : [];

    const completedIds = new Set(progress.completed_target_ids || []);
    const blockedIds = new Set(progress.blocked_target_ids || []);
    const eligibleIds = new Set((eligibleTargets || []).map(t => t.id));

    const totalTargets = currentCampaignPlan ? (currentCampaignPlan.targets || []).length : 0;
    const completedCount = completedIds.size;
    const pct = totalTargets > 0 ? ((completedCount / totalTargets) * 100).toFixed(1) : '0.0';

    if (campProgActiveSol) campProgActiveSol.textContent = `Sol ${progress.active_sol_index || 1}`;
    if (campProgCompletedCount) campProgCompletedCount.textContent = completedCount;
    if (campProgTotalCount) campProgTotalCount.textContent = totalTargets;
    if (campProgPct) campProgPct.textContent = `${pct}%`;
    if (campProgObsCount) campProgObsCount.textContent = observations.length;
    if (campProgressBarFill) campProgressBarFill.style.width = `${pct}%`;
    if (campProgTargetsBadge) campProgTargetsBadge.textContent = `${completedCount} / ${totalTargets} Complete`;
    if (campProgObsBadge) campProgObsBadge.textContent = `${observations.length} Recorded`;

    // Render Targets list
    if (campProgTargetsList && currentCampaignPlan) {
      const targets = currentCampaignPlan.targets || [];
      if (targets.length === 0) {
        campProgTargetsList.innerHTML = `<div style="padding:16px; text-align:center; color:var(--text-secondary); font-size:9px;">No targets in campaign.</div>`;
      } else {
        campProgTargetsList.innerHTML = targets.map(t => {
          let statusLabel = 'SCHEDULED';
          let badgeBg = 'rgba(0,229,255,0.15)';
          let badgeColor = 'var(--telemetry-cyan)';
          let badgeBorder = 'rgba(0,229,255,0.3)';

          if (completedIds.has(t.id)) {
            statusLabel = 'COMPLETED';
            badgeBg = 'rgba(16,185,129,0.2)';
            badgeColor = '#34d399';
            badgeBorder = 'rgba(16,185,129,0.4)';
          } else if (blockedIds.has(t.id)) {
            statusLabel = 'BLOCKED';
            badgeBg = 'rgba(239,68,68,0.2)';
            badgeColor = '#f87171';
            badgeBorder = 'rgba(239,68,68,0.4)';
          } else if (eligibleIds.has(t.id)) {
            statusLabel = 'ELIGIBLE';
            badgeBg = 'rgba(245,158,11,0.2)';
            badgeColor = '#fbbf24';
            badgeBorder = 'rgba(245,158,11,0.4)';
          }

          const prereqsStr = (t.prerequisites && t.prerequisites.length > 0)
            ? `Prereqs: ${t.prerequisites.join(', ')}`
            : `Root Target (No Prereqs)`;

          const canObserve = !completedIds.has(t.id) && !blockedIds.has(t.id);
          const canBlock = !completedIds.has(t.id) && !blockedIds.has(t.id);

          return `
            <div style="padding:8px 10px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:4px; display:flex; justify-content:space-between; align-items:center; gap:8px;">
              <div style="flex:1;">
                <div style="display:flex; align-items:center; gap:6px;">
                  <strong style="color:#fff; font-size:10px;">${escapeHtml(t.name || t.id)}</strong>
                  <span style="font-size:7.5px; padding:1px 5px; border-radius:2px; background:${badgeBg}; color:${badgeColor}; border:1px solid ${badgeBorder}; font-weight:700;">
                    ${statusLabel}
                  </span>
                </div>
                <div style="font-size:8px; color:var(--text-secondary); margin-top:2px;">
                  Priority: ${t.priority_score || 0} &bull; ${escapeHtml(prereqsStr)}
                </div>
              </div>
              <div style="display:flex; gap:4px;">
                ${canObserve ? `
                  <button class="btn-picker btn-observe-target" data-target-id="${escapeHtml(t.id)}" style="font-size:8px; padding:2px 6px;" title="Record science observation at this target">
                    &#128300; Observe
                  </button>
                ` : ''}
                ${canBlock ? `
                  <button class="btn-picker-secondary btn-block-target" data-target-id="${escapeHtml(t.id)}" style="font-size:8px; padding:2px 6px; border-color:rgba(239,68,68,0.4); color:#f87171;" title="Mark target blocked by terrain or hazard">
                    &#9940; Block
                  </button>
                ` : ''}
              </div>
            </div>
          `;
        }).join('');

        // Wire target buttons
        campProgTargetsList.querySelectorAll('.btn-observe-target').forEach(btn => {
          btn.addEventListener('click', () => {
            const tid = btn.getAttribute('data-target-id');
            openRecordObservationModal(tid);
          });
        });
        campProgTargetsList.querySelectorAll('.btn-block-target').forEach(btn => {
          btn.addEventListener('click', () => {
            const tid = btn.getAttribute('data-target-id');
            markTargetBlockedAction(tid);
          });
        });
      }
    }

    // Render Observations list
    if (campProgObservationsList) {
      if (observations.length === 0) {
        campProgObservationsList.innerHTML = `<div style="padding:16px; text-align:center; color:var(--text-secondary); font-size:9px;">No observations recorded yet. Complete targets or log measurements to populate the registry.</div>`;
      } else {
        campProgObservationsList.innerHTML = observations.map(obs => {
          const isSim = obs.is_simulated !== false;
          const provBadge = isSim
            ? `<span style="font-size:7px; padding:1px 4px; border-radius:2px; background:rgba(0,229,255,0.15); color:var(--telemetry-cyan); border:1px solid rgba(0,229,255,0.3); font-weight:700;">SIMULATED</span>`
            : `<span style="font-size:7px; padding:1px 4px; border-radius:2px; background:rgba(16,185,129,0.2); color:#34d399; border:1px solid rgba(16,185,129,0.4); font-weight:700;">AUTHENTIC PDS</span>`;

          const measurementsStr = (obs.quantitative_measurements || []).map(m =>
            `${escapeHtml(m.parameter)}: <strong>${m.value} ${escapeHtml(m.unit)}</strong>`
          ).join(' &bull; ') || 'No quantitative telemetry';

          return `
            <div style="padding:8px 10px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:4px;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:3px;">
                <span style="font-size:9px; font-weight:600; color:#fff;">${escapeHtml(obs.target_id)}: ${escapeHtml(obs.observation_type)}</span>
                <div style="display:flex; align-items:center; gap:4px;">
                  ${provBadge}
                  <span style="font-size:7.5px; color:var(--text-secondary);">${escapeHtml((obs.timestamp_utc || '').substring(0, 19).replace('T', ' '))}</span>
                </div>
              </div>
              <div style="font-size:8.5px; color:var(--text-primary); margin-bottom:2px;">
                ${measurementsStr}
              </div>
              <div style="font-size:8px; color:var(--text-secondary); font-style:italic;">
                ${escapeHtml(obs.qualitative_notes || '')}
              </div>
            </div>
          `;
        }).join('');
      }
    }
  }

  function openRecordObservationModal(targetId = null, solIndex = null) {
    if (!currentCampaignPlan) {
      alert("Please plan or load a campaign first.");
      return;
    }
    if (obsTargetSelect) {
      const targets = currentCampaignPlan.targets || [];
      obsTargetSelect.innerHTML = targets.map(t =>
        `<option value="${escapeHtml(t.id)}" ${t.id === targetId ? 'selected' : ''}>${escapeHtml(t.name || t.id)} (${escapeHtml(t.id)})</option>`
      ).join('');
    }
    if (obsSolIndexInput) {
      obsSolIndexInput.value = solIndex || (currentCampaignPlan.progress ? currentCampaignPlan.progress.active_sol_index : 1) || 1;
    }
    if (campaignObservationModal) campaignObservationModal.classList.remove('hidden');
  }

  function closeRecordObservationModal() {
    if (campaignObservationModal) campaignObservationModal.classList.add('hidden');
  }

  async function submitObservationAction() {
    if (!currentCampaignPlan) return;
    const tid = obsTargetSelect ? obsTargetSelect.value : null;
    const solIdx = parseInt(obsSolIndexInput ? obsSolIndexInput.value : 1, 10);
    const obsType = obsTypeSelect ? obsTypeSelect.value : 'GEOLOGICAL_ASSAY';
    const prov = obsProvenanceSelect ? obsProvenanceSelect.value : 'SIMULATED';
    const instrument = obsInstrumentInput ? obsInstrumentInput.value : 'PIXL_SIMULATOR';
    const param = obsParamInput ? obsParamInput.value : 'mineral_wt_pct';
    const val = parseFloat(obsValInput ? obsValInput.value : 0);
    const unit = obsUnitSelect ? obsUnitSelect.value : '%';
    const notes = obsNotesInput ? obsNotesInput.value : '';

    const payload = {
      campaign_id: currentCampaignPlan.campaign_id,
      event_type: 'TARGET_OBSERVED',
      target_id: tid,
      sol_index: solIdx,
      observation: {
        observation_type: obsType,
        provenance: prov,
        is_simulated: (prov === 'SIMULATED'),
        instrument_name: instrument,
        quantitative_measurements: [
          { parameter: param, value: val, unit: unit }
        ],
        qualitative_notes: notes,
      }
    };

    if (btnSubmitObservation) {
      btnSubmitObservation.disabled = true;
      btnSubmitObservation.innerHTML = '&#9881; Recording Observation & Replanning...';
    }
    setPlanningStatus("RECORDING SCIENCE OBSERVATION & ADVANCING CAMPAIGN...", "calculating");

    try {
      const resp = await fetch('/api/campaign/progress', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.error || `HTTP ${resp.status} recording progress`);
      }

      const result = await resp.json();
      currentCampaignPlan = result.campaign;

      // Update UI
      renderCampaignSummary(currentCampaignPlan);
      renderCampaignSorties(currentCampaignPlan.sorties);
      renderCampaignTargetsList();
      drawCampaignSortieRoutes(currentCampaignPlan.sorties);

      closeRecordObservationModal();
      await loadAndRenderCampaignProgress(currentCampaignPlan.campaign_id);

      setPlanningStatus(`OBSERVATION LOGGED: Target '${tid}' complete. Downstream sorties adapted (v${currentCampaignPlan.version}).`, "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Error recording observation:', err);
      setPlanningStatus(`RECORD OBSERVATION FAILED: ${err.message || err}`, "error");
    } finally {
      if (btnSubmitObservation) {
        btnSubmitObservation.disabled = false;
        btnSubmitObservation.innerHTML = '&#128190; RECORD OBSERVATION & ADVANCE PROGRESS';
      }
    }
  }

  async function markTargetBlockedAction(targetId) {
    if (!currentCampaignPlan || !targetId) return;
    const reason = prompt(`Enter reason for blocking target '${targetId}':`, "Steep scree slope exceeds mobility threshold");
    if (!reason) return;

    const payload = {
      campaign_id: currentCampaignPlan.campaign_id,
      event_type: 'TARGET_BLOCKED',
      target_id: targetId,
      sol_index: (currentCampaignPlan.progress ? currentCampaignPlan.progress.active_sol_index : 1) || 1,
      details: { reason: reason }
    };

    setPlanningStatus(`MARKING TARGET '${targetId}' BLOCKED...`, "calculating");
    try {
      const resp = await fetch('/api/campaign/progress', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.error || `HTTP ${resp.status}`);
      }
      const result = await resp.json();
      currentCampaignPlan = result.campaign;

      renderCampaignSummary(currentCampaignPlan);
      renderCampaignSorties(currentCampaignPlan.sorties);
      renderCampaignTargetsList();
      drawCampaignSortieRoutes(currentCampaignPlan.sorties);

      await loadAndRenderCampaignProgress(currentCampaignPlan.campaign_id);
      setPlanningStatus(`TARGET '${targetId}' BLOCKED: Schedule adapted (v${currentCampaignPlan.version}).`, "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Error blocking target:', err);
      setPlanningStatus(`BLOCK TARGET FAILED: ${err.message || err}`, "error");
    }
  }

  // ==============================================================================
  // Milestone 11C: Observation-Driven Campaign Intelligence & Adaptive Prioritization
  // ==============================================================================

  function loadAndRenderCampaignIntelligence(campaignId) {
    if (!currentCampaignPlan) return;

    // 1. Objectives Weights
    if (campIntelWeightsContainer) {
      const defaultObjectives = [
        { key: 'ASTROBIOLOGY_BIOSIGNATURE', label: 'Astrobiology / Biosignature', defaultVal: 1.0 },
        { key: 'PALEOLAKE_HYDROLOGY', label: 'Paleolake Hydrology', defaultVal: 1.0 },
        { key: 'FLUVIAL_DELTA_SEDIMENTOLOGY', label: 'Fluvial Sedimentology', defaultVal: 1.0 },
        { key: 'REGOLITH_GEOCHEMISTRY', label: 'Regolith Geochemistry', defaultVal: 1.0 },
      ];

      const targets = currentCampaignPlan.targets || [];
      const presentObjectives = new Set(targets.map(t => t.science_objective).filter(Boolean));
      presentObjectives.forEach(obj => {
        if (!defaultObjectives.some(d => d.key === obj)) {
          defaultObjectives.push({ key: obj, label: obj.replace(/_/g, ' '), defaultVal: 1.0 });
        }
      });

      campIntelWeightsContainer.innerHTML = defaultObjectives.map(obj => `
        <div style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06); border-radius:3px; padding:4px 6px;">
          <div style="font-size:7.5px; color:#d1d5db; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${escapeHtml(obj.label)}">${escapeHtml(obj.label)}</div>
          <div style="display:flex; align-items:center; gap:6px; margin-top:2px;">
            <input type="number" class="camp-intel-weight-input" data-objective="${escapeHtml(obj.key)}" min="0.0" max="3.0" step="0.25" value="${obj.defaultVal}" style="width:55px; font-size:9px; padding:2px 4px; background:rgba(0,0,0,0.5); border:1px solid var(--border-subtle); color:#00e5ff; border-radius:2px;">
            <span style="font-size:7.5px; color:#9ca3af;">x</span>
          </div>
        </div>
      `).join('');
    }

    // 2. Target Assessment Rows
    if (campIntelAssessmentsList) {
      const targets = currentCampaignPlan.targets || [];
      if (campIntelTargetCountBadge) campIntelTargetCountBadge.textContent = `${targets.length} Targets`;

      if (targets.length === 0) {
        campIntelAssessmentsList.innerHTML = `<div style="padding:16px; text-align:center; color:var(--text-secondary); font-size:9px;">No targets loaded.</div>`;
      } else {
        campIntelAssessmentsList.innerHTML = targets.map(t => {
          const currentClass = t.objective_classification || 'NOT_ASSESSED';
          const isRepeat = !!t.repeat_observation_requested;
          const objLabel = t.science_objective || 'GENERAL';
          return `
            <div class="camp-intel-target-row" data-target-id="${escapeHtml(t.id)}" style="padding:6px 8px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:3px; font-size:8.5px;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                <span style="font-weight:600; color:#fff;">${escapeHtml(t.name || t.id)} <span style="font-size:7.5px; color:var(--telemetry-cyan); font-weight:normal;">(${escapeHtml(t.id)})</span></span>
                <span class="badge" style="font-size:7px; background:rgba(255,255,255,0.06); color:#9ca3af; padding:1px 4px; border-radius:2px;">${escapeHtml(objLabel)}</span>
              </div>
              <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
                <label style="display:flex; align-items:center; gap:4px; font-size:8px; color:var(--text-secondary);">
                  Assessment:
                  <select class="camp-intel-outcome-select hud-select" style="font-size:8px; padding:2px 4px; border-radius:2px;">
                    <option value="NOT_ASSESSED" ${currentClass === 'NOT_ASSESSED' ? 'selected' : ''}>Not Assessed</option>
                    <option value="SUPPORTS_OBJECTIVE" ${currentClass === 'SUPPORTS_OBJECTIVE' ? 'selected' : ''}>Supports (+25% downstream)</option>
                    <option value="DOES_NOT_SUPPORT_OBJECTIVE" ${currentClass === 'DOES_NOT_SUPPORT_OBJECTIVE' ? 'selected' : ''}>Does Not Support (-35% downstream)</option>
                    <option value="INCONCLUSIVE" ${currentClass === 'INCONCLUSIVE' ? 'selected' : ''}>Inconclusive (Neutral)</option>
                  </select>
                </label>
                <label style="display:flex; align-items:center; gap:4px; font-size:8px; color:#d1d5db; cursor:pointer;" title="Request follow-up inspection / verification visit">
                  <input type="checkbox" class="camp-intel-repeat-checkbox" ${isRepeat ? 'checked' : ''} style="margin:0;">
                  Repeat
                </label>
              </div>
            </div>
          `;
        }).join('');
      }
    }

    if (currentCampaignPlan.intelligence_recommendation) {
      renderRecommendationResults(currentCampaignPlan.intelligence_recommendation);
    }
  }

  async function evaluateCampaignIntelligence(campaignId, apply = false) {
    if (!campaignId && currentCampaignPlan) campaignId = currentCampaignPlan.campaign_id;
    if (!campaignId) {
      setPlanningStatus("No active campaign to evaluate.", "warning");
      return;
    }

    try {
      if (campIntelStatusBadge) {
        campIntelStatusBadge.textContent = apply ? 'APPLYING PLAN...' : 'EVALUATING...';
        campIntelStatusBadge.style.color = '#fbbf24';
        campIntelStatusBadge.style.borderColor = 'rgba(245,158,11,0.4)';
      }

      // Collect objective weights
      const objectiveWeights = {};
      const weightInputs = document.querySelectorAll('.camp-intel-weight-input');
      weightInputs.forEach(input => {
        const objKey = input.getAttribute('data-objective');
        const val = parseFloat(input.value);
        if (objKey && !isNaN(val) && val >= 0) {
          objectiveWeights[objKey] = val;
        }
      });

      // Collect assessments & repeat requests
      const assessments = [];
      const repeatRequests = [];
      const targetRows = document.querySelectorAll('.camp-intel-target-row');
      targetRows.forEach(row => {
        const tid = row.getAttribute('data-target-id');
        const outcomeSel = row.querySelector('.camp-intel-outcome-select');
        const repeatCb = row.querySelector('.camp-intel-repeat-checkbox');
        const outcome = outcomeSel ? outcomeSel.value : 'NOT_ASSESSED';

        if (outcome !== 'NOT_ASSESSED') {
          assessments.push({
            target_id: tid,
            objective_classification: outcome,
            assessment_notes: 'User-specified investigation assessment outcome'
          });
        }
        if (repeatCb && repeatCb.checked) {
          repeatRequests.push(tid);
        }
      });

      const profile = campIntelProfileSelect ? campIntelProfileSelect.value : null;

      const payload = {
        campaign_id: campaignId,
        objective_weights: objectiveWeights,
        objective_assessments: assessments,
        repeat_requests: repeatRequests,
        preferred_profile: profile || null,
        apply: !!apply
      };

      setPlanningStatus(apply ? "APPLYING ADAPTIVE CAMPAIGN REVISION..." : "EVALUATING ADAPTIVE PRIORITIZATION & STRATEGIES...", "calculating");

      const resp = await fetch('/api/campaign/reprioritize', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.error || `HTTP ${resp.status} reprioritization failed`);
      }

      const resData = await resp.json();
      latestCampaignRecommendation = resData.recommendation;

      if (apply && resData.campaign) {
        currentCampaignPlan = resData.campaign;
        renderCampaignSummary(currentCampaignPlan);
        renderCampaignSorties(currentCampaignPlan.sorties);
        renderCampaignTargetsList();
        drawCampaignSortieRoutes(currentCampaignPlan.sorties);
        setPlanningStatus(`APPLIED ADAPTIVE PLAN v${currentCampaignPlan.version} (${currentCampaignPlan.summary ? currentCampaignPlan.summary.total_sols : 1} Sols).`, "success");
      } else {
        setPlanningStatus(`EVALUATION COMPLETE: ${latestCampaignRecommendation.has_improvements ? 'Improvements found' : 'Current plan optimal'}.`, "success");
      }

      renderRecommendationResults(latestCampaignRecommendation);

      if (campIntelStatusBadge) {
        campIntelStatusBadge.textContent = latestCampaignRecommendation.has_improvements ? 'REPRIORITIZATION READY' : 'OPTIMAL / UNCHANGED';
        campIntelStatusBadge.style.color = latestCampaignRecommendation.has_improvements ? '#34d399' : 'var(--telemetry-cyan)';
        campIntelStatusBadge.style.borderColor = latestCampaignRecommendation.has_improvements ? 'rgba(16,185,129,0.4)' : 'rgba(0,229,255,0.4)';
      }

      if (btnApplyCampaignAdaptivePlan) {
        btnApplyCampaignAdaptivePlan.disabled = !latestCampaignRecommendation.has_improvements || apply;
        btnApplyCampaignAdaptivePlan.style.opacity = (!latestCampaignRecommendation.has_improvements || apply) ? '0.5' : '1.0';
        btnApplyCampaignAdaptivePlan.style.cursor = (!latestCampaignRecommendation.has_improvements || apply) ? 'not-allowed' : 'pointer';
      }

      if (btnExportRecommendationJson) {
        btnExportRecommendationJson.disabled = false;
        btnExportRecommendationJson.style.opacity = '1.0';
        btnExportRecommendationJson.style.cursor = 'pointer';
      }
    } catch (err) {
      console.error('[MarsWalk Atlas] Campaign intelligence evaluation error:', err);
      setPlanningStatus(`EVALUATION FAILED: ${err.message || err}`, "error");
      if (campIntelStatusBadge) {
        campIntelStatusBadge.textContent = 'EVALUATION ERROR';
        campIntelStatusBadge.style.color = '#f87171';
        campIntelStatusBadge.style.borderColor = 'rgba(239,68,68,0.4)';
      }
    }
  }

  function renderRecommendationResults(rec) {
    if (!rec) return;

    if (campIntelSummaryTitle) {
      if (rec.has_improvements) {
        campIntelSummaryTitle.textContent = `Proposed Adaptive Plan (v${rec.proposed_version}): Optimized sortie allocations across ${rec.target_rationales.length} target rationales.`;
      } else {
        campIntelSummaryTitle.textContent = `Baseline plan is already optimal under current observational constraints and weights.`;
      }
    }

    // 1. Render Multi-Strategy Trade-off Matrix Table
    if (campIntelStrategyTable && rec.strategy_comparison) {
      const comp = rec.strategy_comparison;
      const rows = Object.entries(comp).map(([key, st]) => {
        const isBaseline = key === 'baseline';
        const isProposed = key === 'proposed_adaptive';
        const rowBg = isProposed ? 'rgba(0,229,255,0.08)' : (isBaseline ? 'rgba(255,255,255,0.04)' : 'transparent');
        const nameColor = isProposed ? 'var(--telemetry-cyan)' : (isBaseline ? '#fff' : '#9ca3af');
        const feasBadge = st.is_feasible
          ? `<span style="color:#34d399;">FEASIBLE</span>`
          : `<span style="color:#f87171;">INFEASIBLE</span>`;

        return `
          <tr style="background:${rowBg}; border-bottom:1px solid rgba(255,255,255,0.06);">
            <td style="padding:4px 6px; font-weight:${isProposed ? '700' : 'normal'}; color:${nameColor};">${escapeHtml(st.profile_name)}</td>
            <td style="padding:4px 6px; text-align:center;">${st.total_sols}</td>
            <td style="padding:4px 6px; text-align:right;">${st.total_distance_m.toFixed(0)}m</td>
            <td style="padding:4px 6px; text-align:right;">${(st.total_duration_s / 60).toFixed(0)}m</td>
            <td style="padding:4px 6px; text-align:right; font-weight:700; color:#34d399;">${st.total_science_score.toFixed(1)}</td>
            <td style="padding:4px 6px; text-align:center;">${st.targets_scheduled}</td>
            <td style="padding:4px 6px; text-align:center;">${feasBadge}</td>
          </tr>
        `;
      }).join('');

      campIntelStrategyTable.innerHTML = `
        <table style="width:100%; border-collapse:collapse; text-align:left;">
          <thead>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1); color:var(--text-secondary); font-size:7.5px;">
              <th style="padding:3px 6px;">Strategy</th>
              <th style="padding:3px 6px; text-align:center;">Sols</th>
              <th style="padding:3px 6px; text-align:right;">Dist</th>
              <th style="padding:3px 6px; text-align:right;">Dur</th>
              <th style="padding:3px 6px; text-align:right;">Science</th>
              <th style="padding:3px 6px; text-align:center;">Sched</th>
              <th style="padding:3px 6px; text-align:center;">Status</th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      `;
    }

    // 2. Render Target Movement Rationales
    if (campIntelRationalesList && rec.target_rationales) {
      if (campIntelRationalesBadge) campIntelRationalesBadge.textContent = `${rec.target_rationales.length} Rationales`;

      campIntelRationalesList.innerHTML = rec.target_rationales.map(r => {
        let badgeBg = 'rgba(255,255,255,0.06)';
        let badgeColor = '#9ca3af';

        if (r.status_change === 'EXPEDITED') {
          badgeBg = 'rgba(0,229,255,0.15)';
          badgeColor = 'var(--telemetry-cyan)';
        } else if (r.status_change === 'POSTPONED') {
          badgeBg = 'rgba(245,158,11,0.2)';
          badgeColor = '#fbbf24';
        } else if (r.status_change === 'UNBLOCKED') {
          badgeBg = 'rgba(16,185,129,0.2)';
          badgeColor = '#34d399';
        } else if (r.status_change === 'REPEAT_ADDED') {
          badgeBg = 'rgba(192,132,252,0.2)';
          badgeColor = '#c084fc';
        } else if (r.status_change === 'DEFERRED') {
          badgeBg = 'rgba(239,68,68,0.2)';
          badgeColor = '#f87171';
        }

        const solMove = (r.original_sol && r.revised_sol && r.original_sol !== r.revised_sol)
          ? `<span style="font-size:7.5px; color:#d1d5db; font-family:var(--font-mono);">Sol ${r.original_sol} &rarr; Sol ${r.revised_sol}</span>`
          : (r.revised_sol ? `<span style="font-size:7.5px; color:#9ca3af;">Sol ${r.revised_sol}</span>` : `<span style="font-size:7.5px; color:#f87171;">Omitted</span>`);

        return `
          <div style="padding:6px 8px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06); border-radius:3px; font-size:8px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2px;">
              <span style="font-weight:600; color:#fff;">${escapeHtml(r.target_name || r.target_id)}</span>
              <div style="display:flex; align-items:center; gap:6px;">
                ${solMove}
                <span class="badge" style="font-size:7px; background:${badgeBg}; color:${badgeColor}; padding:1px 5px; border-radius:2px; font-weight:700;">${escapeHtml(r.status_change)}</span>
              </div>
            </div>
            <div style="font-size:7.5px; color:#d1d5db; line-height:1.3;">${escapeHtml(r.reason)}</div>
          </div>
        `;
      }).join('');
    }
  }

  function exportRecommendationJson() {
    if (!latestCampaignRecommendation) {
      setPlanningStatus("No recommendation to export.", "warning");
      return;
    }
    const blob = new Blob([JSON.stringify(latestCampaignRecommendation, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `campaign_recommendation_${latestCampaignRecommendation.campaign_id}_v${latestCampaignRecommendation.proposed_version}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    setPlanningStatus("Exported campaign recommendation JSON.", "success");
  }

  // ==============================================================================
  // Milestone 11D: Campaign What-If Simulation Lab & Scenario Comparison
  // ==============================================================================

  function handleWhatIfTypeChange() {
    const selType = campWhatIfTypeSelect ? campWhatIfTypeSelect.value : 'mobility_change';
    const panelMap = {
      'mobility_change': whatifParamMobility,
      'target_loss': whatifParamTarget,
      'corridor_closure': whatifParamCorridor,
      'operational_delay': whatifParamDelay,
      'time_constraint': whatifParamTime,
    };

    Object.entries(panelMap).forEach(([t, el]) => {
      if (el) {
        if (selType === t || selType === 'combined') {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      }
    });
  }

  async function loadAndRenderCampaignWhatIf(campaignId) {
    if (!campaignId && currentCampaignPlan) campaignId = currentCampaignPlan.campaign_id;
    if (!campaignId) return;

    if (whatifTargetSelect && currentCampaignPlan) {
      const targets = currentCampaignPlan.targets || [];
      whatifTargetSelect.innerHTML = targets.map(t =>
        `<option value="${escapeHtml(t.id)}">${escapeHtml(t.name || t.id)} (${escapeHtml(t.id)})</option>`
      ).join('');
    }

    try {
      const resp = await fetch(`/api/campaign/scenarios?campaign_id=${encodeURIComponent(campaignId)}`);
      if (resp.ok) {
        const data = await resp.json();
        currentCampaignScenarios = data.scenarios || [];
      }
    } catch (err) {
      console.warn('[MarsWalk Atlas] Error loading scenarios:', err);
    }

    renderWhatIfComparisonMatrix();
  }

  async function simulateWhatIfScenario(specOverride = null) {
    if (!currentCampaignPlan) {
      setPlanningStatus("Please plan or load a campaign before simulating scenarios.", "warning");
      return;
    }

    let spec = specOverride;
    if (!spec) {
      const scenType = campWhatIfTypeSelect ? campWhatIfTypeSelect.value : 'mobility_change';
      const name = (campWhatIfNameInput && campWhatIfNameInput.value.trim()) || `Scenario ${scenType}`;
      const profile = whatifProfileSelect ? whatifProfileSelect.value : null;

      const mods = [];
      if (scenType === 'mobility_change' || scenType === 'combined') {
        const speed = parseFloat(whatifSpeedFactor ? whatifSpeedFactor.value : 0.6);
        const slope = parseFloat(whatifMaxSlope ? whatifMaxSlope.value : 15.0);
        mods.push({ type: 'mobility_change', speed_factor: speed, max_slope_deg: slope });
      }
      if (scenType === 'target_loss' || scenType === 'combined') {
        const tid = whatifTargetSelect ? whatifTargetSelect.value : null;
        if (tid) mods.push({ type: 'target_loss', target_id: tid, reason: 'Manual operator what-if exclusion' });
      }
      if (scenType === 'corridor_closure' || scenType === 'combined') {
        const r = parseInt(whatifCenterRow ? whatifCenterRow.value : 121, 10);
        const c = parseInt(whatifCenterCol ? whatifCenterCol.value : 157, 10);
        const rad = parseFloat(whatifRadiusM ? whatifRadiusM.value : 60.0);
        mods.push({ type: 'corridor_closure', center_row: r, center_col: c, radius_m: rad });
      }
      if (scenType === 'operational_delay' || scenType === 'combined') {
        const d = parseFloat(whatifDelaySeconds ? whatifDelaySeconds.value : 1800.0);
        mods.push({ type: 'operational_delay', delay_s: d });
      }
      if (scenType === 'time_constraint' || scenType === 'combined') {
        const maxDur = parseFloat(whatifMaxDuration ? whatifMaxDuration.value : 5400.0);
        const maxSols = parseInt(whatifMaxSols ? whatifMaxSols.value : 2, 10);
        mods.push({ type: 'time_constraint', max_duration_per_sortie_s: maxDur, max_sols: maxSols });
      }

      spec = {
        scenario_id: `scen_whatif_${Date.now().toString(36)}`,
        name: name,
        scenario_type: scenType,
        planning_profile: profile || null,
        modifications: mods,
      };
    }

    if (campWhatIfStatusBadge) {
      campWhatIfStatusBadge.textContent = "SIMULATING...";
      campWhatIfStatusBadge.style.color = "#fbbf24";
      campWhatIfStatusBadge.style.borderColor = "rgba(245,158,11,0.4)";
    }
    setPlanningStatus(`SIMULATING WHAT-IF SCENARIO '${spec.name}'...`, "calculating");

    try {
      const payload = {
        campaign: currentCampaignPlan,
        scenarios: [spec],
      };

      const resp = await fetch('/api/campaign/scenarios/evaluate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.error || `HTTP ${resp.status}`);
      }

      const resData = await resp.json();
      const evaluatedScen = (resData.scenarios && resData.scenarios[0]) ? resData.scenarios[0] : null;

      if (evaluatedScen) {
        const existingIdx = currentCampaignScenarios.findIndex(s => s.scenario_id === evaluatedScen.scenario_id);
        if (existingIdx >= 0) {
          currentCampaignScenarios[existingIdx] = evaluatedScen;
        } else {
          currentCampaignScenarios.unshift(evaluatedScen);
        }
        selectedCampaignScenario = evaluatedScen;
        renderWhatIfComparisonMatrix();
        inspectWhatIfScenarioDetail(evaluatedScen);
        setPlanningStatus(`SCENARIO '${spec.name}' EVALUATED: ${evaluatedScen.status} (${evaluatedScen.is_feasible ? 'FEASIBLE' : 'INFEASIBLE'}).`, "success");
      }
    } catch (err) {
      console.error('[MarsWalk Atlas] Scenario simulation error:', err);
      setPlanningStatus(`SCENARIO SIMULATION FAILED: ${err.message || err}`, "error");
      if (campWhatIfStatusBadge) {
        campWhatIfStatusBadge.textContent = "SIMULATION ERROR";
        campWhatIfStatusBadge.style.color = "#f87171";
        campWhatIfStatusBadge.style.borderColor = "rgba(239,68,68,0.4)";
      }
    }
  }

  async function runWhatIfStandardPresets() {
    if (!currentCampaignPlan) {
      setPlanningStatus("Please plan or load a campaign first.", "warning");
      return;
    }

    const firstTid = (currentCampaignPlan.targets && currentCampaignPlan.targets.length > 0)
      ? currentCampaignPlan.targets[0].id
      : "target_01";

    const presetSpecs = [
      {
        scenario_id: `scen_preset_dust_${Date.now().toString(36)}`,
        name: "Dust Storm Motor Derating (-40% Speed)",
        scenario_type: "mobility_change",
        modifications: [{"type": "mobility_change", "speed_factor": 0.6}],
      },
      {
        scenario_id: `scen_preset_rockfall_${Date.now().toString(36)}`,
        name: "Delta Scarp Rockfall Corridor Closure",
        scenario_type: "corridor_closure",
        modifications: [{"type": "corridor_closure", "center_row": 121, "center_col": 157, "radius_m": 60.0}],
      },
      {
        scenario_id: `scen_preset_sensor_${Date.now().toString(36)}`,
        name: `Primary Sensor Failure (${firstTid})`,
        scenario_type: "target_loss",
        modifications: [{"type": "target_loss", "target_id": firstTid, "reason": "Spectrometer optical window frosted"}],
      },
      {
        scenario_id: `scen_preset_constriction_${Date.now().toString(36)}`,
        name: "Constricted Sol Life-Support Window (5400s)",
        scenario_type: "time_constraint",
        modifications: [{"type": "time_constraint", "max_duration_per_sortie_s": 5400.0, "max_sols": 2}],
      },
    ];

    if (campWhatIfStatusBadge) {
      campWhatIfStatusBadge.textContent = "RUNNING PRESETS...";
      campWhatIfStatusBadge.style.color = "#fbbf24";
      campWhatIfStatusBadge.style.borderColor = "rgba(245,158,11,0.4)";
    }
    setPlanningStatus("EVALUATING 4 WHAT-IF PRESET SCENARIOS IN BATCH...", "calculating");

    try {
      const payload = {
        campaign: currentCampaignPlan,
        scenarios: presetSpecs,
      };

      const resp = await fetch('/api/campaign/scenarios/evaluate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.error || `HTTP ${resp.status}`);
      }

      const resData = await resp.json();
      const newScens = resData.scenarios || [];

      for (const s of newScens) {
        const idx = currentCampaignScenarios.findIndex(item => item.scenario_id === s.scenario_id);
        if (idx >= 0) currentCampaignScenarios[idx] = s;
        else currentCampaignScenarios.unshift(s);
      }

      if (newScens.length > 0) {
        selectedCampaignScenario = newScens[0];
        inspectWhatIfScenarioDetail(selectedCampaignScenario);
      }

      renderWhatIfComparisonMatrix();
      setPlanningStatus(`EVALUATED ${newScens.length} PRESET SCENARIOS: Multi-scenario matrix populated.`, "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Error running presets:', err);
      setPlanningStatus(`PRESET RUN FAILED: ${err.message || err}`, "error");
    }
  }

  function renderWhatIfComparisonMatrix() {
    if (!campWhatIfTableContainer) return;

    if (campWhatIfScenarioCountBadge) {
      campWhatIfScenarioCountBadge.textContent = `${currentCampaignScenarios.length} Scenarios`;
    }

    if (campWhatIfStatusBadge) {
      campWhatIfStatusBadge.textContent = currentCampaignScenarios.length > 0
        ? `${currentCampaignScenarios.length} SCENARIOS LOADED`
        : "READY FOR SIMULATION";
      campWhatIfStatusBadge.style.color = currentCampaignScenarios.length > 0 ? "#c084fc" : "var(--telemetry-cyan)";
      campWhatIfStatusBadge.style.borderColor = currentCampaignScenarios.length > 0 ? "rgba(192,132,252,0.4)" : "rgba(0,229,255,0.4)";
    }

    if (!currentCampaignPlan) {
      campWhatIfTableContainer.innerHTML = `<div style="padding:16px; text-align:center; color:var(--text-secondary); font-size:9px;">No campaign plan loaded.</div>`;
      return;
    }

    const baseSum = currentCampaignPlan.summary || {};
    const baseSols = baseSum.total_sols || 0;
    const baseDist = baseSum.total_distance_m || 0;
    const baseDur = baseSum.total_duration_s || 0;
    const baseScore = baseSum.total_science_score || 0;
    const baseSched = baseSum.targets_scheduled || 0;

    const baselineRow = `
      <tr style="background:rgba(255,255,255,0.06); border-bottom:1px solid rgba(255,255,255,0.1); font-weight:600;">
        <td style="padding:4px 6px; color:#fff;">Current Baseline Plan (v${currentCampaignPlan.version || 1})</td>
        <td style="padding:4px 6px; text-align:center;"><span style="color:#34d399;">FEASIBLE</span></td>
        <td style="padding:4px 6px; text-align:center;">${baseSols}</td>
        <td style="padding:4px 6px; text-align:right;">${baseDist.toFixed(0)}m</td>
        <td style="padding:4px 6px; text-align:right;">${(baseDur / 60).toFixed(0)}m</td>
        <td style="padding:4px 6px; text-align:right; color:#34d399;">${baseScore.toFixed(1)}</td>
        <td style="padding:4px 6px; text-align:center;">${baseSched}</td>
        <td style="padding:4px 6px; text-align:center; color:#9ca3af;">[BASELINE]</td>
      </tr>
    `;

    const scenarioRows = currentCampaignScenarios.map(scen => {
      const comp = scen.comparison || {};
      const simCamp = scen.simulated_campaign || {};
      const simSum = simCamp.summary || {};

      const isSelected = selectedCampaignScenario && selectedCampaignScenario.scenario_id === scen.scenario_id;
      const rowBg = isSelected ? 'rgba(192,132,252,0.15)' : 'transparent';
      const borderCol = isSelected ? 'rgba(192,132,252,0.4)' : 'rgba(255,255,255,0.05)';

      const statusBadge = scen.is_feasible
        ? `<span style="color:#34d399;">FEASIBLE</span>`
        : `<span style="color:#f87171;">${escapeHtml(scen.status)}</span>`;

      const targetDelta = comp.targets_scheduled_delta !== undefined
        ? (comp.targets_scheduled_delta >= 0 ? `+${comp.targets_scheduled_delta}` : `${comp.targets_scheduled_delta}`)
        : '--';

      const solsVal = simSum.total_sols !== undefined ? simSum.total_sols : (comp.delta_sols !== undefined ? `${baseSols + comp.delta_sols}` : '--');
      const distVal = simSum.total_distance_m !== undefined ? `${simSum.total_distance_m.toFixed(0)}m` : '--';
      const durVal = simSum.total_duration_s !== undefined ? `${(simSum.total_duration_s / 60).toFixed(0)}m` : '--';
      const scoreVal = simSum.total_science_score !== undefined ? simSum.total_science_score.toFixed(1) : '--';

      return `
        <tr class="camp-whatif-row" data-scen-id="${escapeHtml(scen.scenario_id)}" style="background:${rowBg}; border-bottom:1px solid ${borderCol}; cursor:pointer;" title="Click to inspect scenario details">
          <td style="padding:4px 6px; color:#c084fc; font-weight:600;">${escapeHtml(scen.name)}</td>
          <td style="padding:4px 6px; text-align:center;">${statusBadge}</td>
          <td style="padding:4px 6px; text-align:center;">${solsVal}</td>
          <td style="padding:4px 6px; text-align:right;">${distVal}</td>
          <td style="padding:4px 6px; text-align:right;">${durVal}</td>
          <td style="padding:4px 6px; text-align:right; font-weight:700; color:#34d399;">${scoreVal}</td>
          <td style="padding:4px 6px; text-align:center; color:${comp.targets_scheduled_delta < 0 ? '#f87171' : '#34d399'};">${targetDelta}</td>
          <td style="padding:4px 6px; text-align:center;">
            <button class="btn-picker-secondary btn-inspect-scen" data-scen-id="${escapeHtml(scen.scenario_id)}" style="font-size:7.5px; padding:2px 6px; border-radius:2px;">Inspect</button>
          </td>
        </tr>
      `;
    }).join('');

    campWhatIfTableContainer.innerHTML = `
      <table style="width:100%; border-collapse:collapse; text-align:left;">
        <thead>
          <tr style="border-bottom:1px solid rgba(255,255,255,0.1); color:var(--text-secondary); font-size:7.5px;">
            <th style="padding:3px 6px;">Scenario</th>
            <th style="padding:3px 6px; text-align:center;">Status</th>
            <th style="padding:3px 6px; text-align:center;">Sols</th>
            <th style="padding:3px 6px; text-align:right;">Dist</th>
            <th style="padding:3px 6px; text-align:right;">Time</th>
            <th style="padding:3px 6px; text-align:right;">Science</th>
            <th style="padding:3px 6px; text-align:center;">Δ Tgt</th>
            <th style="padding:3px 6px; text-align:center;">Action</th>
          </tr>
        </thead>
        <tbody>
          ${baselineRow}
          ${scenarioRows}
        </tbody>
      </table>
    `;

    const rows = campWhatIfTableContainer.querySelectorAll('.camp-whatif-row');
    rows.forEach(r => {
      r.addEventListener('click', () => {
        const sid = r.getAttribute('data-scen-id');
        const scen = currentCampaignScenarios.find(s => s.scenario_id === sid);
        if (scen) {
          selectedCampaignScenario = scen;
          renderWhatIfComparisonMatrix();
          inspectWhatIfScenarioDetail(scen);
        }
      });
    });
  }

  function inspectWhatIfScenarioDetail(scen) {
    if (!scen || !campWhatIfDetailContent) return;

    if (campWhatIfSelectedBadge) {
      campWhatIfSelectedBadge.textContent = `${scen.name} (${scen.is_feasible ? 'FEASIBLE' : 'INFEASIBLE'})`;
      campWhatIfSelectedBadge.style.color = scen.is_feasible ? '#34d399' : '#f87171';
    }

    const comp = scen.comparison || {};
    const lostList = (comp.lost_target_ids || []).map(tid =>
      `<span class="badge" style="background:rgba(239,68,68,0.2); color:#f87171; border:1px solid rgba(239,68,68,0.4); padding:1px 5px; border-radius:2px; font-size:7.5px;">-${escapeHtml(tid)}</span>`
    ).join(' ');

    const gainedList = (comp.gained_target_ids || []).map(tid =>
      `<span class="badge" style="background:rgba(16,185,129,0.2); color:#34d399; border:1px solid rgba(16,185,129,0.4); padding:1px 5px; border-radius:2px; font-size:7.5px;">+${escapeHtml(tid)}</span>`
    ).join(' ');

    const deferredList = (comp.deferred_target_ids || []).map(tid =>
      `<span class="badge" style="background:rgba(245,158,11,0.2); color:#fbbf24; border:1px solid rgba(245,158,11,0.4); padding:1px 5px; border-radius:2px; font-size:7.5px;">⏳ ${escapeHtml(tid)}</span>`
    ).join(' ');

    const causalItems = Object.entries(comp.causal_attribution || {}).map(([tid, reason]) =>
      `<div style="margin-bottom:3px;"><strong style="color:#c084fc;">${escapeHtml(tid)}:</strong> <span style="color:#d1d5db;">${escapeHtml(reason)}</span></div>`
    ).join('');

    const warningsItems = (scen.warnings || []).map(w =>
      `<div style="color:#fbbf24;">&bull; ${escapeHtml(w)}</div>`
    ).join('');

    campWhatIfDetailContent.innerHTML = `
      <div style="display:flex; flex-direction:column; gap:6px;">
        <div style="display:flex; justify-content:space-between; align-items:center; background:rgba(0,0,0,0.3); padding:4px 6px; border-radius:3px;">
          <span>Type: <strong style="color:#fff;">${escapeHtml(scen.scenario_type)}</strong></span>
          <span>Status: <strong style="color:${scen.is_feasible ? '#34d399' : '#f87171'};">${escapeHtml(scen.status)}</strong></span>
        </div>

        <div style="font-size:8px;">
          <div style="font-weight:600; color:var(--text-secondary); margin-bottom:2px;">Target Inventory Delta:</div>
          <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:4px;">
            ${lostList ? `<div><span style="color:#f87171;">Lost:</span> ${lostList}</div>` : ''}
            ${gainedList ? `<div><span style="color:#34d399;">Gained:</span> ${gainedList}</div>` : ''}
            ${deferredList ? `<div><span style="color:#fbbf24;">Deferred:</span> ${deferredList}</div>` : ''}
            ${(!lostList && !gainedList && !deferredList) ? '<span style="color:#9ca3af;">All candidate targets preserved</span>' : ''}
          </div>
        </div>

        ${causalItems ? `
          <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); border-radius:3px; padding:6px;">
            <div style="font-weight:600; color:var(--text-secondary); margin-bottom:3px;">Causal Attributions:</div>
            ${causalItems}
          </div>
        ` : ''}

        ${warningsItems ? `
          <div style="background:rgba(245,158,11,0.05); border:1px solid rgba(245,158,11,0.2); border-radius:3px; padding:6px; font-size:7.5px;">
            <div style="font-weight:600; color:#fbbf24; margin-bottom:2px;">Simulation Warnings:</div>
            ${warningsItems}
          </div>
        ` : ''}
      </div>
    `;

    if (btnPromoteScenario) {
      btnPromoteScenario.disabled = !scen.is_feasible;
      btnPromoteScenario.style.opacity = scen.is_feasible ? "1.0" : "0.5";
      btnPromoteScenario.style.cursor = scen.is_feasible ? "pointer" : "not-allowed";
      btnPromoteScenario.innerHTML = `&#9989; PROMOTE AS OFFICIAL CAMPAIGN v${(currentCampaignPlan.version || 1) + 1}`;
    }

    if (btnExportWhatIfBriefing) {
      btnExportWhatIfBriefing.disabled = false;
      btnExportWhatIfBriefing.style.opacity = "1.0";
      btnExportWhatIfBriefing.style.cursor = "pointer";
    }
  }

  async function promoteSelectedScenario() {
    if (!selectedCampaignScenario || !selectedCampaignScenario.is_feasible || !currentCampaignPlan) {
      setPlanningStatus("Cannot promote an infeasible or missing scenario.", "warning");
      return;
    }

    const payload = {
      campaign_id: currentCampaignPlan.campaign_id,
      scenario_id: selectedCampaignScenario.scenario_id,
      campaign: currentCampaignPlan,
    };

    setPlanningStatus(`PROMOTING SCENARIO '${selectedCampaignScenario.name}' TO OFFICIAL PLAN...`, "calculating");

    try {
      const resp = await fetch('/api/campaign/scenarios/apply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.error || `HTTP ${resp.status}`);
      }

      const resData = await resp.json();
      currentCampaignPlan = resData.campaign;

      renderCampaignSummary(currentCampaignPlan);
      renderCampaignSorties(currentCampaignPlan.sorties);
      renderCampaignTargetsList();
      drawCampaignSortieRoutes(currentCampaignPlan.sorties);

      setPlanningStatus(`CAMPAIGN PROMOTED: Version incremented to v${currentCampaignPlan.version} based on '${selectedCampaignScenario.name}'.`, "success");
      renderWhatIfComparisonMatrix();
    } catch (err) {
      console.error('[MarsWalk Atlas] Error promoting scenario:', err);
      setPlanningStatus(`PROMOTION FAILED: ${err.message || err}`, "error");
    }
  }

  function exportWhatIfBriefingJson() {
    if (!currentCampaignScenarios || currentCampaignScenarios.length === 0) {
      setPlanningStatus("No what-if scenarios to export.", "warning");
      return;
    }

    const briefingPayload = {
      briefing_title: `What-If Simulation Lab Briefing — ${currentCampaignPlan ? currentCampaignPlan.name : 'Campaign'}`,
      timestamp_utc: new Date().toISOString(),
      baseline_campaign_id: currentCampaignPlan ? currentCampaignPlan.campaign_id : null,
      baseline_version: currentCampaignPlan ? currentCampaignPlan.version : 1,
      scenarios_count: currentCampaignScenarios.length,
      scenarios: currentCampaignScenarios,
      limitations_disclaimer: (
        "Calculated what-if scenarios are deterministic planning heuristics for Mars mission simulation. " +
        "They do not represent certified flight decisions, probabilistic failure risks, or statistical survival models."
      ),
    };

    const blob = new Blob([JSON.stringify(briefingPayload, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `campaign_whatif_briefing_${briefingPayload.baseline_campaign_id || 'cmp'}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    setPlanningStatus("Exported What-If simulation briefing JSON.", "success");
  }

  // ==============================================================================
  // Milestone 11E: Multi-Agent Campaign Coordination & Resource Handoffs
  // ==============================================================================

  async function loadAndRenderCampaignCoordination(campaignId) {
    if (!campaignId && currentCampaignPlan) campaignId = currentCampaignPlan.campaign_id;
    if (!campaignId) return;

    if (campHandoffTargetSelect && currentCampaignPlan) {
      const targets = currentCampaignPlan.targets || [];
      campHandoffTargetSelect.innerHTML = `<option value="">Select Target...</option>` +
        targets.map(t => `<option value="${escapeHtml(t.id)}">${escapeHtml(t.name || t.id)} (${escapeHtml(t.id)}) - Sol ${t.scheduled_sol || 1}</option>`).join('');
    }

    try {
      const [coordResp, handoffResp] = await Promise.all([
        fetch(`/api/campaign/coordination?campaign_id=${encodeURIComponent(campaignId)}`),
        fetch(`/api/campaign/handoffs?campaign_id=${encodeURIComponent(campaignId)}`)
      ]);

      if (handoffResp.ok) {
        currentCampaignHandoffs = await handoffResp.json();
      }

      if (coordResp.ok) {
        const plans = await coordResp.json();
        if (Array.isArray(plans) && plans.length > 0) {
          currentCoordinationPlan = plans[0];
          renderCoordinationPlanView(currentCoordinationPlan);
          return;
        }
      }

      renderDefaultFleetView();
    } catch (err) {
      console.warn('[MarsWalk Atlas] Warning loading coordination state:', err);
      renderDefaultFleetView();
    }
  }

  function renderDefaultFleetView() {
    if (campCoordFleetList) {
      campCoordFleetList.innerHTML = `
        <div style="background:rgba(255,255,255,0.03); border:1px solid rgba(56,189,248,0.3); border-radius:3px; padding:6px 8px;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-weight:700; color:#38bdf8; font-size:8.5px;">🤖 Perseverance Rover</span>
            <span class="badge" style="background:rgba(56,189,248,0.15); color:#38bdf8; font-size:7px; padding:1px 4px;">Robotic Rover</span>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:4px; margin-top:4px; font-size:7.5px; color:#94a3b8;">
            <div>Speed: <strong style="color:#fff;">0.035 m/s</strong> (0.13 km/h)</div>
            <div>Slope Limit: <strong style="color:#fff;">15.0°</strong></div>
            <div>Max Sortie: <strong style="color:#fff;">4.0 hrs</strong> (14,400s)</div>
            <div>Status: <strong style="color:#34d399;">AVAILABLE</strong></div>
          </div>
        </div>
        <div style="background:rgba(255,255,255,0.03); border:1px solid rgba(245,158,11,0.3); border-radius:3px; padding:6px 8px;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-weight:700; color:#fbbf24; font-size:8.5px;">👨‍🚀 Crew EVA Team Alpha</span>
            <span class="badge" style="background:rgba(245,158,11,0.15); color:#fbbf24; font-size:7px; padding:1px 4px;">Crew EVA</span>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:4px; margin-top:4px; font-size:7.5px; color:#94a3b8;">
            <div>Speed: <strong style="color:#fff;">0.556 m/s</strong> (2.00 km/h)</div>
            <div>Slope Limit: <strong style="color:#fff;">25.0°</strong></div>
            <div>Max Sortie: <strong style="color:#fff;">8.0 hrs</strong> (28,800s)</div>
            <div>Status: <strong style="color:#34d399;">AVAILABLE</strong></div>
          </div>
        </div>
      `;
    }
    if (campCoordUnitCountBadge) {
      campCoordUnitCountBadge.textContent = "2 Configured Units";
    }
  }

  async function coordinateCampaignFleet(strategyParam = null) {
    if (!currentCampaignPlan) {
      setPlanningStatus("No active campaign plan to coordinate.", "warning");
      return;
    }

    const strategy = strategyParam || (campCoordStrategySelect ? campCoordStrategySelect.value : "priority_first");

    if (btnCoordinateFleet) {
      btnCoordinateFleet.disabled = true;
      btnCoordinateFleet.innerHTML = "&#9881; COORDINATING...";
    }
    setPlanningStatus(`COORDINATING CAMPAIGN FLEET USING '${strategy.toUpperCase()}' STRATEGY...`, "calculating");

    try {
      const payload = {
        campaign_id: currentCampaignPlan.campaign_id,
        campaign: currentCampaignPlan,
        strategy: strategy,
        persist: true
      };

      const resp = await fetch('/api/campaign/coordinate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.error || `HTTP ${resp.status}`);
      }

      const planData = await resp.json();
      currentCoordinationPlan = planData;
      renderCoordinationPlanView(currentCoordinationPlan);

      setPlanningStatus(`FLEET COORDINATION COMPLETE: ${planData.allocated_targets_count} targets scheduled across ${planData.total_sorties_count} sorties (${planData.strategy}).`, "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Error coordinating fleet:', err);
      setPlanningStatus(`COORDINATION FAILED: ${err.message || err}`, "error");
    } finally {
      if (btnCoordinateFleet) {
        btnCoordinateFleet.disabled = false;
        btnCoordinateFleet.innerHTML = "&#9654; COORDINATE FLEET";
      }
    }
  }

  function renderCoordinationPlanView(plan) {
    if (!plan) return;

    if (campCoordFleetList) {
      const units = plan.units || [];
      const sorties = plan.sorties || [];
      const allocations = plan.allocations || [];

      campCoordFleetList.innerHTML = units.map(u => {
        const isRover = u.unit_type === 'robotic_rover';
        const color = isRover ? '#38bdf8' : '#fbbf24';
        const icon = isRover ? '🤖' : '👨‍🚀';
        const unitAllocations = allocations.filter(a => a.assigned_unit_id === u.unit_id && a.allocation_status === 'allocated');
        const unitSorties = sorties.filter(s => s.unit_id === u.unit_id);
        const totalDurationS = unitSorties.reduce((sum, s) => sum + (s.total_duration_s || 0), 0);
        const totalDistM = unitSorties.reduce((sum, s) => sum + (s.total_distance_m || 0), 0);
        const speedKmh = ((u.mobility_profile?.max_velocity_mps || 0.035) * 3.6).toFixed(2);
        const maxSlope = (u.mobility_profile?.max_slope_deg || 15.0).toFixed(1);

        return `
          <div style="background:rgba(255,255,255,0.03); border:1px solid ${color}40; border-radius:3px; padding:6px 8px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <span style="font-weight:700; color:${color}; font-size:8.5px;">${icon} ${escapeHtml(u.name)}</span>
              <span class="badge" style="background:${color}20; color:${color}; font-size:7px; padding:1px 4px;">
                ${unitSorties.length} Sorties | ${unitAllocations.length} Targets
              </span>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:4px; margin-top:4px; font-size:7.5px; color:#94a3b8;">
              <div>Speed: <strong style="color:#fff;">${speedKmh} km/h</strong></div>
              <div>Slope Limit: <strong style="color:#fff;">${maxSlope}°</strong></div>
              <div>Traverse: <strong style="color:#fff;">${(totalDistM / 1000).toFixed(2)} km</strong></div>
              <div>Duration: <strong style="color:#fff;">${(totalDurationS / 3600).toFixed(1)} hrs</strong></div>
            </div>
          </div>
        `;
      }).join('');
    }

    if (campCoordUnitCountBadge && plan.units) {
      campCoordUnitCountBadge.textContent = `${plan.units.length} Active Units`;
    }

    if (campCoordStratTableContainer) {
      const evals = plan.strategy_evaluations || {};
      const stratKeys = Object.keys(evals);

      if (stratKeys.length > 0) {
        const rows = stratKeys.map(k => {
          const ev = evals[k];
          const isSelected = k === plan.strategy;
          const stratName = k === 'priority_first' ? 'Priority-First' :
                            k === 'balanced_workload' ? 'Balanced Workload' : 'Capability-First';
          return `
            <tr style="border-bottom:1px solid rgba(255,255,255,0.05); ${isSelected ? 'background:rgba(56,189,248,0.12); font-weight:700;' : ''}">
              <td style="padding:4px 6px; color:${isSelected ? '#38bdf8' : '#e2e8f0'};">
                ${isSelected ? '▶ ' : ''}${stratName}
              </td>
              <td style="padding:4px 6px; text-align:center;">${ev.scheduled_targets || 0}</td>
              <td style="padding:4px 6px; text-align:center;">${ev.total_sorties || 0}</td>
              <td style="padding:4px 6px; text-align:right;">${((ev.total_distance_m || 0) / 1000).toFixed(2)} km</td>
              <td style="padding:4px 6px; text-align:right;">${((ev.total_duration_s || 0) / 3600).toFixed(1)} h</td>
              <td style="padding:4px 6px; text-align:right; color:#34d399;">${(ev.efficiency_score || 0).toFixed(1)}</td>
            </tr>
          `;
        }).join('');

        campCoordStratTableContainer.innerHTML = `
          <table style="width:100%; border-collapse:collapse; text-align:left;">
            <thead>
              <tr style="border-bottom:1px solid rgba(255,255,255,0.1); color:var(--text-secondary); font-size:7.5px;">
                <th style="padding:3px 6px;">Strategy</th>
                <th style="padding:3px 6px; text-align:center;">Targets</th>
                <th style="padding:3px 6px; text-align:center;">Sorties</th>
                <th style="padding:3px 6px; text-align:right;">Dist</th>
                <th style="padding:3px 6px; text-align:right;">Time</th>
                <th style="padding:3px 6px; text-align:right;">Score</th>
              </tr>
            </thead>
            <tbody>
              ${rows}
            </tbody>
          </table>
        `;
      } else {
        campCoordStratTableContainer.innerHTML = `
          <div style="padding:8px; color:#94a3b8; font-size:8px;">
            Active Strategy: <strong style="color:#38bdf8;">${escapeHtml(plan.strategy)}</strong> (${plan.allocated_targets_count} targets allocated).
          </div>
        `;
      }
    }

    if (campCoordSortiesContainer) {
      const sorties = plan.sorties || [];
      const handoffs = plan.handoffs || [];

      if (campCoordSortieCountBadge) {
        campCoordSortieCountBadge.textContent = `${sorties.length} Sorties | ${handoffs.length} Handoffs`;
      }

      let sortiesHtml = sorties.map(s => {
        const isRover = s.unit_id === 'unit_perseverance';
        const color = isRover ? '#38bdf8' : '#fbbf24';
        const label = isRover ? '🤖 Perseverance' : '👨‍🚀 Crew EVA';
        const targetsStr = (s.targets_visited || []).join(' → ') || 'None';
        const distKm = ((s.total_distance_m || 0) / 1000).toFixed(2);
        const durHrs = ((s.total_duration_s || 0) / 3600).toFixed(1);

        return `
          <div style="background:rgba(255,255,255,0.02); border-left:3px solid ${color}; border-radius:2px; padding:4px 6px; margin-bottom:4px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <span style="font-weight:700; color:#fff;">Sol ${s.sol_index}: ${escapeHtml(s.name || s.sortie_id)}</span>
              <span style="color:${color}; font-size:7.5px;">${label}</span>
            </div>
            <div style="color:#94a3b8; margin-top:2px;">Targets: <strong style="color:#e2e8f0;">${escapeHtml(targetsStr)}</strong></div>
            <div style="color:var(--text-secondary); margin-top:1px; display:flex; gap:8px;">
              <span>Dist: ${distKm} km</span>
              <span>Duration: ${durHrs} hrs</span>
              <span>Energy: ${(s.energy_kwh || 0).toFixed(2)} kWh</span>
            </div>
          </div>
        `;
      }).join('');

      let handoffsHtml = '';
      if (handoffs.length > 0) {
        handoffsHtml = `
          <div style="margin-top:8px; border-top:1px solid rgba(255,255,255,0.08); padding-top:6px;">
            <div style="font-weight:700; color:#c084fc; margin-bottom:4px; font-size:7.5px; text-transform:uppercase;">Executed Task Handoffs:</div>
            ${handoffs.map(h => `
              <div style="background:rgba(192,132,252,0.05); border:1px solid rgba(192,132,252,0.2); border-radius:2px; padding:3px 5px; margin-bottom:3px; font-size:7.5px;">
                <span style="color:#34d399;">✔ ${escapeHtml(h.target_id)}</span>:
                ${escapeHtml(h.source_unit_id)} ➔ <strong style="color:#c084fc;">${escapeHtml(h.receiving_unit_id)}</strong>
                (Sol ${h.scheduled_sol}) — <em>${escapeHtml(h.reason)}</em>
              </div>
            `).join('')}
          </div>
        `;
      }

      campCoordSortiesContainer.innerHTML = sortiesHtml + handoffsHtml;
    }

    if (btnApplyCoordinationPlan) {
      btnApplyCoordinationPlan.disabled = false;
      btnApplyCoordinationPlan.style.opacity = "1.0";
      btnApplyCoordinationPlan.style.cursor = "pointer";
      btnApplyCoordinationPlan.innerHTML = `&#9989; PROMOTE AS OFFICIAL CAMPAIGN v${(currentCampaignPlan.version || 1) + 1}`;
    }

    if (btnExportCoordinationBriefing) {
      btnExportCoordinationBriefing.disabled = false;
      btnExportCoordinationBriefing.style.opacity = "1.0";
      btnExportCoordinationBriefing.style.cursor = "pointer";
    }
  }

  async function executeTaskHandoffAction() {
    if (!currentCampaignPlan || !currentCoordinationPlan) {
      setPlanningStatus("Please coordinate the fleet before executing a task handoff.", "warning");
      return;
    }

    const tid = campHandoffTargetSelect ? campHandoffTargetSelect.value : "";
    const sol = campHandoffSolInput ? parseInt(campHandoffSolInput.value || "1", 10) : 1;
    const src = campHandoffSourceSelect ? campHandoffSourceSelect.value : "unit_perseverance";
    const dest = campHandoffDestSelect ? campHandoffDestSelect.value : "unit_crew_eva_1";
    const reason = campHandoffReasonInput ? campHandoffReasonInput.value.trim() : "Operational task responsibility handoff";

    if (!tid) {
      if (campHandoffValidationMsg) {
        campHandoffValidationMsg.textContent = "Please select a target for the handoff.";
        campHandoffValidationMsg.style.color = "#f87171";
      }
      return;
    }

    if (src === dest) {
      if (campHandoffValidationMsg) {
        campHandoffValidationMsg.textContent = "Source unit and receiving unit must be distinct.";
        campHandoffValidationMsg.style.color = "#f87171";
      }
      return;
    }

    if (campHandoffValidationMsg) {
      campHandoffValidationMsg.textContent = "Validating task handoff feasibility and DAG constraints...";
      campHandoffValidationMsg.style.color = "#fbbf24";
    }

    try {
      const payload = {
        campaign_id: currentCampaignPlan.campaign_id,
        campaign: currentCampaignPlan,
        coordination_id: currentCoordinationPlan.plan_id,
        coordination_plan: currentCoordinationPlan,
        target_id: tid,
        source_unit_id: src,
        receiving_unit_id: dest,
        sol_index: sol,
        reason: reason
      };

      const resp = await fetch('/api/campaign/handoff', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.error || `HTTP ${resp.status}`);
      }

      const resData = await resp.json();
      const handoff = resData.handoff;

      if (handoff.status === "rejected") {
        if (campHandoffValidationMsg) {
          campHandoffValidationMsg.textContent = `❌ REJECTED: ${handoff.rejection_reason || 'Infeasible transfer'}`;
          campHandoffValidationMsg.style.color = "#f87171";
        }
        setPlanningStatus(`HANDOFF REJECTED: ${handoff.rejection_reason}`, "warning");
      } else {
        if (campHandoffValidationMsg) {
          campHandoffValidationMsg.textContent = `✅ HANDOFF EXECUTED: ${escapeHtml(tid)} transferred to ${escapeHtml(dest)} on Sol ${sol}.`;
          campHandoffValidationMsg.style.color = "#34d399";
        }
        currentCoordinationPlan = resData.coordination_plan;
        renderCoordinationPlanView(currentCoordinationPlan);
        setPlanningStatus(`HANDOFF EXECUTED: ${tid} reallocated to ${dest}.`, "success");
      }
    } catch (err) {
      console.error('[MarsWalk Atlas] Error executing handoff:', err);
      if (campHandoffValidationMsg) {
        campHandoffValidationMsg.textContent = `❌ ERROR: ${err.message || err}`;
        campHandoffValidationMsg.style.color = "#f87171";
      }
      setPlanningStatus(`HANDOFF FAILED: ${err.message || err}`, "error");
    }
  }

  async function executeTaskHandoffDirect(params) {
    if (!params) return null;
    const payload = {
      campaign_id: params.campaign_id || (currentCampaignPlan ? currentCampaignPlan.campaign_id : null),
      campaign: currentCampaignPlan,
      coordination_id: params.coordination_id || (currentCoordinationPlan ? currentCoordinationPlan.plan_id : null),
      coordination_plan: currentCoordinationPlan,
      target_id: params.target_id,
      source_unit_id: params.source_unit_id,
      receiving_unit_id: params.receiving_unit_id,
      sol_index: params.sol_index || 1,
      reason: params.reason || "Programmatic handoff request"
    };

    const resp = await fetch('/api/campaign/handoff', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    if (!resp.ok) {
      const errJson = await resp.json().catch(() => ({}));
      throw new Error(errJson.detail || errJson.error || `HTTP ${resp.status}`);
    }
    const resData = await resp.json();
    if (resData.coordination_plan) {
      currentCoordinationPlan = resData.coordination_plan;
      renderCoordinationPlanView(currentCoordinationPlan);
    }
    return resData;
  }

  async function applyCoordinationPlanAction() {
    if (!currentCoordinationPlan || !currentCampaignPlan) {
      setPlanningStatus("No coordinated plan to promote.", "warning");
      return;
    }

    setPlanningStatus(`PROMOTING MULTI-UNIT COORDINATION PLAN TO OFFICIAL CAMPAIGN v${(currentCampaignPlan.version || 1) + 1}...`, "calculating");

    try {
      const payload = {
        campaign_id: currentCampaignPlan.campaign_id,
        campaign: currentCampaignPlan,
        coordination_id: currentCoordinationPlan.plan_id,
        coordination_plan: currentCoordinationPlan
      };

      const resp = await fetch('/api/campaign/coordination/apply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.error || `HTTP ${resp.status}`);
      }

      const resData = await resp.json();
      currentCampaignPlan = resData.campaign;

      renderCampaignSummary(currentCampaignPlan);
      renderCampaignSorties(currentCampaignPlan.sorties);
      renderCampaignTargetsList();
      drawCampaignSortieRoutes(currentCampaignPlan.sorties);

      setPlanningStatus(`CAMPAIGN PROMOTED: Version incremented to v${currentCampaignPlan.version} with coordinated multi-unit schedule.`, "success");
      renderCoordinationPlanView(currentCoordinationPlan);
    } catch (err) {
      console.error('[MarsWalk Atlas] Error applying coordination plan:', err);
      setPlanningStatus(`PROMOTION FAILED: ${err.message || err}`, "error");
    }
  }

  function exportCoordinationBriefingJson() {
    if (!currentCoordinationPlan) {
      setPlanningStatus("No coordination plan available to export.", "warning");
      return;
    }

    const briefingPayload = {
      briefing_title: `Multi-Unit Campaign Coordination Briefing — ${currentCampaignPlan ? currentCampaignPlan.name : 'Campaign'}`,
      timestamp_utc: new Date().toISOString(),
      campaign_id: currentCampaignPlan ? currentCampaignPlan.campaign_id : currentCoordinationPlan.campaign_id,
      campaign_version: currentCampaignPlan ? currentCampaignPlan.version : 1,
      coordination_plan: currentCoordinationPlan,
      handoffs: currentCampaignHandoffs,
      limitations_disclaimer: (
        "Calculated multi-unit fleet allocations, speed envelopes, and task handoffs are deterministic simulation models for Mars mission planning. " +
        "Physical sample transfer, direct power tethering, and inter-vehicle towing are NOT modeled by this simulation and must not be inferred."
      )
    };

    const blob = new Blob([JSON.stringify(briefingPayload, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `campaign_coordination_briefing_${briefingPayload.campaign_id || 'cmp'}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    setPlanningStatus("Exported Multi-Unit Coordination briefing JSON.", "success");
  }

  // ==============================================================================
  // Milestone 11F: Campaign Digital Twin, Multi-Unit Timeline & Temporal Execution Simulation
  // ==============================================================================

  function formatSimulatedTime(seconds) {
    if (typeof seconds !== 'number' || isNaN(seconds) || seconds < 0) seconds = 0;
    const sols = Math.floor(seconds / 88775.244);
    const rem = seconds % 88775.244;
    const hrs = Math.floor(rem / 3600);
    const mins = Math.floor((rem % 3600) / 60);
    const secs = Math.floor(rem % 60);
    return `T+${String(sols).padStart(2, '0')}d ${String(hrs).padStart(2, '0')}h ${String(mins).padStart(2, '0')}m ${String(secs).padStart(2, '0')}s`;
  }

  async function loadAndRenderCampaignSimulation(campaignId) {
    if (!campaignId && currentCampaignPlan) campaignId = currentCampaignPlan.campaign_id;
    if (!campaignId) return;

    try {
      const resp = await fetch(`/api/campaign/simulations?campaign_id=${encodeURIComponent(campaignId)}`);
      if (resp.ok) {
        const sims = await resp.json();
        if (Array.isArray(sims) && sims.length > 0) {
          currentCampaignSimulation = sims[0];
          renderCampaignSimulationView(currentCampaignSimulation);
          return;
        }
      }

      // Initialize a new simulation if none exists
      await startCampaignSimulationAction(campaignId);
    } catch (err) {
      console.warn('[MarsWalk Atlas] Warning loading simulation:', err);
      await startCampaignSimulationAction(campaignId);
    }
  }

  async function startCampaignSimulationAction(campaignId) {
    if (!campaignId && currentCampaignPlan) campaignId = currentCampaignPlan.campaign_id;
    if (!campaignId) return;

    setPlanningStatus("INITIALIZING CAMPAIGN DIGITAL TWIN EXECUTION SIMULATION...", "calculating");
    try {
      const payload = {
        campaign_id: campaignId,
        campaign: currentCampaignPlan,
        coordination_id: currentCoordinationPlan ? currentCoordinationPlan.coordination_id : null,
        persist: true
      };

      const resp = await fetch('/api/campaign/simulation/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.error || `HTTP ${resp.status}`);
      }

      const simData = await resp.json();
      currentCampaignSimulation = simData;
      renderCampaignSimulationView(currentCampaignSimulation);
      setPlanningStatus(`DIGITAL TWIN INITIALIZED: ${simData.simulation_id} (${simData.statistics.total_intervals} task intervals).`, "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Error starting simulation:', err);
      setPlanningStatus(`SIMULATION INIT FAILED: ${err.message || err}`, "error");
    }
  }

  function renderCampaignSimulationView(sim) {
    if (!sim) return;

    // 1. Clock and status banner
    if (campSimSolBadge) campSimSolBadge.textContent = `SOL ${sim.current_sol || 1}`;
    if (campSimClockDisplay) campSimClockDisplay.textContent = formatSimulatedTime(sim.current_time_s || 0);

    if (campSimStatusBadge) {
      campSimStatusBadge.textContent = sim.status || 'IDLE';
      if (sim.status === 'RUNNING') {
        campSimStatusBadge.style.color = '#34d399';
        campSimStatusBadge.style.background = 'rgba(16,185,129,0.2)';
        campSimStatusBadge.style.borderColor = 'rgba(16,185,129,0.4)';
      } else if (sim.status === 'PAUSED') {
        campSimStatusBadge.style.color = '#fbbf24';
        campSimStatusBadge.style.background = 'rgba(245,158,11,0.2)';
        campSimStatusBadge.style.borderColor = 'rgba(245,158,11,0.4)';
      } else if (sim.status === 'INTERRUPTED') {
        campSimStatusBadge.style.color = '#c084fc';
        campSimStatusBadge.style.background = 'rgba(192,132,252,0.2)';
        campSimStatusBadge.style.borderColor = 'rgba(192,132,252,0.4)';
      } else {
        campSimStatusBadge.style.color = '#38bdf8';
        campSimStatusBadge.style.background = 'rgba(56,189,248,0.2)';
        campSimStatusBadge.style.borderColor = 'rgba(56,189,248,0.4)';
      }
    }

    // 2. Scrubber slider
    if (simTimeScrubber) {
      simTimeScrubber.max = sim.total_duration_s || 100;
      simTimeScrubber.value = sim.current_time_s || 0;
    }
    if (campSimTotalDurationLabel) {
      campSimTotalDurationLabel.textContent = formatSimulatedTime(sim.total_duration_s || 0);
    }

    // 3. Multi-unit timeline lanes
    if (campSimLanesContainer) {
      const units = sim.units || [];
      const intervals = sim.timeline_intervals || [];
      const totalDur = Math.max(1.0, sim.total_duration_s || 1.0);
      const currentTimePct = Math.min(100.0, Math.max(0.0, ((sim.current_time_s || 0) / totalDur) * 100));

      campSimLanesContainer.innerHTML = units.map(u => {
        const isRover = u.unit_type === 'robotic_rover';
        const uColor = isRover ? '#38bdf8' : '#fbbf24';
        const icon = isRover ? '🤖' : '👨‍🚀';
        const uIntervals = intervals.filter(iv => iv.unit_id === u.unit_id);

        const intervalBlocks = uIntervals.map(iv => {
          const leftPct = ((iv.start_time_s || 0) / totalDur) * 100;
          const widthPct = Math.max(1.5, ((iv.duration_s || 0) / totalDur) * 100);
          let bg = '#38bdf8';
          let border = '#0284c7';
          if (iv.activity_type === 'DWELL') {
            bg = '#10b981'; border = '#059669';
          } else if (iv.activity_type === 'HOLD') {
            bg = '#f59e0b'; border = '#d97706';
          } else if (iv.activity_type === 'REST' || iv.activity_type === 'DEPOT') {
            bg = '#475569'; border = '#334155';
          }

          const label = iv.target_name || iv.target_id || iv.activity_type;
          return `
            <div title="${escapeHtml(iv.activity_type)}: ${escapeHtml(label)} (Sol ${iv.sol_index}, ${iv.duration_s.toFixed(0)}s)"
                 style="position:absolute; left:${leftPct.toFixed(2)}%; width:${widthPct.toFixed(2)}%; height:18px; top:1px; background:${bg}; border:1px solid ${border}; border-radius:2px; font-size:7px; color:#fff; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; padding:1px 3px; box-sizing:border-box; cursor:pointer;">
              ${escapeHtml(label)}
            </div>
          `;
        }).join('');

        return `
          <div style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); border-radius:3px; padding:6px 8px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
              <span style="font-weight:700; color:${uColor}; font-size:8px;">${icon} ${escapeHtml(u.name)}</span>
              <span style="font-size:7px; color:#94a3b8; font-family:var(--font-mono);">
                Status: <strong style="color:${u.status === 'AVAILABLE' ? '#34d399' : '#fbbf24'};">${escapeHtml(u.status)}</strong> |
                Activity: <strong style="color:#fff;">${escapeHtml(u.current_activity || 'IDLE')}</strong> |
                Traverse: <strong>${((u.total_distance_m || 0) / 1000).toFixed(2)} km</strong>
              </span>
            </div>
            <!-- Timeline track with cursor -->
            <div style="position:relative; width:100%; height:20px; background:rgba(0,0,0,0.4); border:1px solid rgba(255,255,255,0.08); border-radius:2px; overflow:hidden;">
              ${intervalBlocks}
              <!-- Current time indicator cursor line -->
              <div style="position:absolute; left:${currentTimePct.toFixed(2)}%; top:0; bottom:0; width:2px; background:#00e5ff; box-shadow:0 0 4px #00e5ff; z-index:10; pointer-events:none;"></div>
            </div>
          </div>
        `;
      }).join('');
    }

    // 4. Chronological Event Stream
    if (campSimEventStreamContainer) {
      const events = sim.events || [];
      if (campSimEventCountBadge) campSimEventCountBadge.textContent = `${events.length} Events`;

      campSimEventStreamContainer.innerHTML = events.slice(-40).reverse().map(e => {
        let typeColor = '#38bdf8';
        if (e.event_type.includes('DWELL')) typeColor = '#10b981';
        else if (e.event_type.includes('INTERRUPT') || e.event_type.includes('CONFLICT')) typeColor = '#f87171';
        else if (e.event_type.includes('HOLD')) typeColor = '#fbbf24';

        return `
          <div class="camp-sim-event-item" data-event-id="${escapeHtml(e.event_id)}"
               style="background:rgba(255,255,255,0.02); border-left:2px solid ${typeColor}; padding:3px 6px; border-radius:2px; cursor:pointer;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <span style="color:#fff; font-weight:600;">${escapeHtml(e.title)}</span>
              <span style="color:var(--text-secondary); font-size:7px;">T+${e.simulated_time_s.toFixed(0)}s (Sol ${e.sol_index})</span>
            </div>
            <div style="color:#94a3b8; margin-top:1px;">${escapeHtml(e.description)}</div>
          </div>
        `;
      }).join('');

      // Wire event selection
      const evtItems = campSimEventStreamContainer.querySelectorAll('.camp-sim-event-item');
      evtItems.forEach(item => {
        item.addEventListener('click', () => {
          const eid = item.getAttribute('data-event-id');
          const found = (sim.events || []).find(x => x.event_id === eid);
          if (found) inspectSimEventDetail(found, sim);
        });
      });
    }

    // 5. Temporal Conflicts
    if (campSimConflictsContainer) {
      const conflicts = sim.conflicts || [];
      if (campSimConflictCountBadge) {
        campSimConflictCountBadge.textContent = `${conflicts.length} Conflicts`;
        campSimConflictCountBadge.style.color = conflicts.length > 0 ? '#f87171' : '#34d399';
      }

      if (conflicts.length === 0) {
        campSimConflictsContainer.innerHTML = `
          <div style="padding:8px; text-align:center; color:#34d399; font-size:8px;">
            &#10004; Zero temporal scheduling conflicts detected.
          </div>
        `;
      } else {
        campSimConflictsContainer.innerHTML = conflicts.map(c => `
          <div style="background:rgba(239,68,68,0.05); border:1px solid rgba(239,68,68,0.25); border-radius:2px; padding:4px 6px; margin-bottom:3px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <span style="font-weight:700; color:#f87171;">&#9888; ${escapeHtml(c.code)}</span>
              <span class="badge" style="background:rgba(239,68,68,0.2); color:#f87171; font-size:7px; padding:1px 4px;">${escapeHtml(c.severity)}</span>
            </div>
            <div style="color:#e2e8f0; margin-top:2px;">${escapeHtml(c.message)}</div>
            <div style="color:#fbbf24; margin-top:1px; font-size:7px;"><em>Mitigation:</em> ${escapeHtml(c.recommendation)}</div>
          </div>
        `).join('');
      }
    }

    // 6. Inspect primary unit state by default if no event selected
    if (!selectedSimEvent && sim.units && sim.units.length > 0) {
      inspectSimUnitTelemetry(sim.units[0]);
    }
  }

  function inspectSimUnitTelemetry(unit) {
    if (!unit || !campSimDetailContent) return;
    if (campSimDetailBadge) campSimDetailBadge.textContent = unit.name;

    const pos = unit.position || {};
    campSimDetailContent.innerHTML = `
      <div style="display:flex; flex-direction:column; gap:4px; font-family:var(--font-mono); font-size:7.5px;">
        <div style="display:flex; justify-content:space-between; background:rgba(0,0,0,0.3); padding:3px 5px; border-radius:2px;">
          <span>Platform: <strong style="color:#38bdf8;">${escapeHtml(unit.name)}</strong> (${escapeHtml(unit.unit_type)})</span>
          <span>Status: <strong style="color:#34d399;">${escapeHtml(unit.status)}</strong></span>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:3px;">
          <div>Grid: <strong style="color:#fff;">[${pos.row || 0}, ${pos.col || 0}]</strong></div>
          <div>Elevation: <strong style="color:#fff;">${pos.elevation_m || 0} m</strong></div>
          <div>Lon: <strong style="color:#fff;">${pos.lon ? pos.lon.toFixed(5) : 'N/A'}°</strong></div>
          <div>Lat: <strong style="color:#fff;">${pos.lat ? pos.lat.toFixed(5) : 'N/A'}°</strong></div>
          <div>Slope: <strong style="color:#fff;">${pos.slope_deg || 0}°</strong></div>
          <div>Energy: <strong style="color:#fff;">${unit.energy_consumed_kwh || 0} kWh</strong></div>
        </div>
        <div style="color:#94a3b8; font-size:7px; margin-top:2px;">
          &bull; <em>Position Telemetry Notice:</em> Coordinates are derived along the planned route (is_simulated_position=true).
        </div>
      </div>
    `;
  }

  function inspectSimEventDetail(evt, sim) {
    if (!evt || !campSimDetailContent) return;
    selectedSimEvent = evt;
    if (campSimDetailBadge) campSimDetailBadge.textContent = evt.event_type;

    campSimDetailContent.innerHTML = `
      <div style="display:flex; flex-direction:column; gap:4px; font-family:var(--font-mono); font-size:7.5px;">
        <div style="font-weight:700; color:#fff; font-size:8px;">${escapeHtml(evt.title)}</div>
        <div style="color:#cbd5e1;">${escapeHtml(evt.description)}</div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:3px; background:rgba(0,0,0,0.25); padding:3px 5px; border-radius:2px; margin-top:2px;">
          <div>Timestamp: <strong style="color:#38bdf8;">T+${evt.simulated_time_s.toFixed(1)}s</strong></div>
          <div>Martian Sol: <strong style="color:#38bdf8;">Sol ${evt.sol_index}</strong></div>
          <div>Assigned Unit: <strong style="color:#fff;">${escapeHtml(evt.unit_id || 'Global')}</strong></div>
          <div>Target ID: <strong style="color:#fff;">${escapeHtml(evt.target_id || 'N/A')}</strong></div>
        </div>
      </div>
    `;
  }

  function toggleSimPlayPause() {
    if (simPlaybackTimer) {
      clearInterval(simPlaybackTimer);
      simPlaybackTimer = null;
      if (btnSimPlayPause) btnSimPlayPause.innerHTML = "&#9654; PLAY";
      if (currentCampaignSimulation) {
        currentCampaignSimulation.status = 'PAUSED';
        renderCampaignSimulationView(currentCampaignSimulation);
      }
    } else {
      if (!currentCampaignSimulation) return;
      if (btnSimPlayPause) btnSimPlayPause.innerHTML = "&#10074;&#10074; PAUSE";
      simPlaybackTimer = setInterval(() => {
        if (!currentCampaignSimulation) {
          clearInterval(simPlaybackTimer);
          simPlaybackTimer = null;
          return;
        }
        if (currentCampaignSimulation.current_time_s >= (currentCampaignSimulation.total_duration_s || 100)) {
          clearInterval(simPlaybackTimer);
          simPlaybackTimer = null;
          if (btnSimPlayPause) btnSimPlayPause.innerHTML = "&#9654; PLAY";
          return;
        }
        advanceSimTime(300.0);
      }, 400);
    }
  }

  async function stepSimEvent() {
    if (!currentCampaignSimulation) return;
    try {
      const payload = {
        simulation_id: currentCampaignSimulation.simulation_id,
        event_count: 1,
        persist: true
      };
      const resp = await fetch('/api/campaign/simulation/step', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (resp.ok) {
        const resData = await resp.json();
        currentCampaignSimulation = resData.simulation;
        renderCampaignSimulationView(currentCampaignSimulation);
      }
    } catch (err) {
      console.error('[MarsWalk Atlas] Error stepping simulation:', err);
    }
  }

  async function advanceSimTime(deltaSeconds) {
    if (!currentCampaignSimulation) return;
    try {
      const targetTime = (currentCampaignSimulation.current_time_s || 0) + deltaSeconds;
      const payload = {
        simulation_id: currentCampaignSimulation.simulation_id,
        target_time_s: targetTime,
        persist: true
      };
      const resp = await fetch('/api/campaign/simulation/advance', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (resp.ok) {
        const resData = await resp.json();
        currentCampaignSimulation = resData.simulation;
        renderCampaignSimulationView(currentCampaignSimulation);
      }
    } catch (err) {
      console.error('[MarsWalk Atlas] Error advancing simulation:', err);
    }
  }

  async function seekSimTime(targetTime) {
    if (!currentCampaignSimulation) return;
    try {
      const payload = {
        simulation_id: currentCampaignSimulation.simulation_id,
        target_time_s: parseFloat(targetTime),
        persist: true
      };
      const resp = await fetch('/api/campaign/simulation/seek', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (resp.ok) {
        const resData = await resp.json();
        currentCampaignSimulation = resData.simulation;
        renderCampaignSimulationView(currentCampaignSimulation);
      }
    } catch (err) {
      console.error('[MarsWalk Atlas] Error seeking simulation:', err);
    }
  }

  async function resetSimAction() {
    if (!currentCampaignSimulation) return;
    if (simPlaybackTimer) {
      clearInterval(simPlaybackTimer);
      simPlaybackTimer = null;
      if (btnSimPlayPause) btnSimPlayPause.innerHTML = "&#9654; PLAY";
    }
    await seekSimTime(0.0);
  }

  async function injectSimContingencyAction() {
    if (!currentCampaignSimulation) return;
    setPlanningStatus("INJECTING SIMULATED CONTINGENCY AT CURRENT TIMESTAMP...", "calculating");
    try {
      const payload = {
        simulation_id: currentCampaignSimulation.simulation_id,
        interruption_type: "operational_hold",
        affected_unit_id: "unit_perseverance",
        delay_duration_s: 1800.0,
        reason: "Dust accumulation on optical sensors requiring diagnostic hold",
        persist: true
      };

      const resp = await fetch('/api/campaign/simulation/interrupt', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.error || `HTTP ${resp.status}`);
      }

      const resData = await resp.json();
      currentCampaignSimulation = resData.revised_simulation;
      renderCampaignSimulationView(currentCampaignSimulation);
      setPlanningStatus("CONTINGENCY INJECTED: Historical prefix frozen; remaining work re-evaluated.", "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Error injecting contingency:', err);
      setPlanningStatus(`INJECTION FAILED: ${err.message || err}`, "error");
    }
  }

  function exportSimBriefingJson() {
    if (!currentCampaignSimulation) {
      setPlanningStatus("No active simulation to export.", "warning");
      return;
    }

    const briefingPayload = {
      briefing_title: `Campaign Digital Twin Execution Briefing - ${currentCampaignPlan ? currentCampaignPlan.name : 'Campaign'}`,
      timestamp_utc: new Date().toISOString(),
      simulation_id: currentCampaignSimulation.simulation_id,
      campaign_id: currentCampaignSimulation.campaign_id,
      current_time_s: currentCampaignSimulation.current_time_s,
      current_sol: currentCampaignSimulation.current_sol,
      status: currentCampaignSimulation.status,
      units: currentCampaignSimulation.units,
      statistics: currentCampaignSimulation.statistics,
      conflicts: currentCampaignSimulation.conflicts,
      events: currentCampaignSimulation.events,
      limitations_disclaimer: currentCampaignSimulation.limitations_disclaimer
    };

    const blob = new Blob([JSON.stringify(briefingPayload, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `campaign_digital_twin_briefing_${currentCampaignSimulation.simulation_id}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    setPlanningStatus("Exported Digital Twin Simulation briefing JSON.", "success");
  }

  // Milestone 11G: Campaign Performance Analytics & Lessons Learned Implementation
  async function loadAndRenderCampaignAnalytics(campaignId) {
    if (!campaignId && currentCampaignPlan) campaignId = currentCampaignPlan.campaign_id;
    if (!campaignId) return;

    try {
      const resp = await fetch(`/api/campaign/analyses?campaign_id=${encodeURIComponent(campaignId)}`);
      if (resp.ok) {
        const analyses = await resp.json();
        if (Array.isArray(analyses) && analyses.length > 0) {
          currentCampaignAnalysis = analyses[0];
          renderCampaignAnalyticsView(currentCampaignAnalysis);
          return;
        }
      }
      await runCampaignPerformanceAnalysis();
    } catch (err) {
      console.error('[MarsWalk Atlas] Error loading campaign analytics:', err);
    }
  }

  async function runCampaignPerformanceAnalysis() {
    if (!currentCampaignPlan) {
      setPlanningStatus("Please plan a campaign before running performance analytics.", "warning");
      return;
    }

    setPlanningStatus("RUNNING CAMPAIGN PERFORMANCE & DEVIATION ANALYSIS...", "calculating");

    try {
      let simId = currentCampaignSimulation ? currentCampaignSimulation.simulation_id : null;
      if (!simId) {
        const simResp = await fetch(`/api/campaign/simulations?campaign_id=${encodeURIComponent(currentCampaignPlan.campaign_id)}`);
        if (simResp.ok) {
          const sims = await simResp.json();
          if (Array.isArray(sims) && sims.length > 0) {
            currentCampaignSimulation = sims[0];
            simId = currentCampaignSimulation.simulation_id;
          }
        }
      }

      if (!simId) {
        const startResp = await fetch('/api/campaign/simulation/start', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            campaign_id: currentCampaignPlan.campaign_id,
            persist: true
          })
        });
        if (startResp.ok) {
          const startData = await startResp.json();
          currentCampaignSimulation = startData.simulation;
          simId = currentCampaignSimulation.simulation_id;
        }
      }

      const payload = {
        campaign_id: currentCampaignPlan.campaign_id,
        simulation_id: simId,
        persist: true
      };

      const resp = await fetch('/api/campaign/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.error || `HTTP ${resp.status}`);
      }

      currentCampaignAnalysis = await resp.json();
      renderCampaignAnalyticsView(currentCampaignAnalysis);
      setPlanningStatus("Performance analytics & lessons learned generated successfully.", "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Error running performance analysis:', err);
      setPlanningStatus(`ANALYTICS FAILED: ${err.message || err}`, "error");
    }
  }

  function renderCampaignAnalyticsView(analysis) {
    if (!analysis) return;

    // 1. Executive Summary KPIs
    const exec = analysis.executive_summary || {};
    if (kpiDurationDelta) {
      const deltaS = exec.duration_delta_s || 0;
      const sign = deltaS > 0 ? '+' : '';
      const color = deltaS > 600 ? '#f87171' : (deltaS < -600 ? '#34d399' : '#fff');
      kpiDurationDelta.textContent = `${sign}${(deltaS / 60).toFixed(1)}m`;
      kpiDurationDelta.style.color = color;
    }
    if (kpiDurationSub) {
      kpiDurationSub.textContent = `Planned: ${((exec.planned_duration_s || 0) / 3600).toFixed(1)}h | Sim: ${((exec.simulated_duration_s || 0) / 3600).toFixed(1)}h`;
    }
    if (kpiTargetCompletion) {
      kpiTargetCompletion.textContent = `${exec.target_completion_rate_pct || 0}%`;
    }
    if (kpiTargetSub) {
      const tgt = analysis.target_analytics || {};
      kpiTargetSub.textContent = `${tgt.completed_count || 0} of ${tgt.total_targets || 0} Completed`;
    }
    if (kpiFleetUtilization) {
      kpiFleetUtilization.textContent = `${exec.fleet_utilization_pct || 0}%`;
    }
    if (kpiOperationalHolds) {
      const holds = exec.total_operational_holds || 0;
      const dur = (exec.total_hold_duration_s || 0);
      kpiOperationalHolds.textContent = `${holds} (${(dur / 60).toFixed(1)}m)`;
    }
    if (kpiTemporalConflicts) {
      const confs = exec.temporal_conflicts_count || 0;
      kpiTemporalConflicts.textContent = confs;
      kpiTemporalConflicts.style.color = confs > 0 ? '#f87171' : '#34d399';
    }

    // 2. Sortie Deviations Table
    if (tblSortieDeviationsBody) {
      const sDevs = analysis.sortie_deviations || [];
      if (sDevs.length === 0) {
        tblSortieDeviationsBody.innerHTML = '<tr><td colspan="6" style="padding:8px 6px; color:var(--text-tertiary); text-align:center;">No sortie deviations recorded.</td></tr>';
      } else {
        tblSortieDeviationsBody.innerHTML = sDevs.map(s => {
          const slipMin = (s.start_slip_s / 60).toFixed(1);
          const durDeltaMin = (s.duration_delta_s / 60).toFixed(1);
          const slipColor = Math.abs(s.start_slip_s) > 300 ? '#fbbf24' : '#9ca3af';
          const durColor = s.duration_delta_s > 300 ? '#f87171' : '#9ca3af';
          return `
            <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
              <td style="padding:4px 6px; color:#fff; font-weight:600;">${escapeHtml(s.sortie_id)}</td>
              <td style="padding:4px 6px; color:#38bdf8;">Sol ${s.sol_index}</td>
              <td style="padding:4px 6px; color:var(--text-secondary);">${(s.planned_start_s / 3600).toFixed(1)}h</td>
              <td style="padding:4px 6px; color:${slipColor};">${s.start_slip_s >= 0 ? '+' : ''}${slipMin}m</td>
              <td style="padding:4px 6px; color:${durColor};">${s.duration_delta_s >= 0 ? '+' : ''}${durDeltaMin}m</td>
              <td style="padding:4px 6px;"><span class="badge" style="font-size:7.5px; padding:1px 4px; background:rgba(16,185,129,0.15); color:#34d399;">${escapeHtml(s.status)}</span></td>
            </tr>
          `;
        }).join('');
      }
    }

    // 3. Unit Workloads Decomposition
    if (unitWorkloadContainer) {
      const uWorks = analysis.unit_workloads || [];
      if (uWorks.length === 0) {
        unitWorkloadContainer.innerHTML = '<div style="font-size:8.5px; color:var(--text-tertiary); text-align:center; padding:12px 0;">No unit workload data loaded.</div>';
      } else {
        unitWorkloadContainer.innerHTML = uWorks.map(uw => {
          const actH = (uw.active_duration_s / 3600).toFixed(1);
          const idlH = (uw.idle_duration_s / 3600).toFixed(1);
          const distKm = (uw.total_distance_m / 1000).toFixed(2);
          const pct = Math.min(100, Math.max(0, uw.utilization_pct || 0));
          return `
            <div style="padding:6px 8px; background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.05); border-radius:3px;">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:9px; font-weight:600; color:#fff;">${escapeHtml(uw.unit_name || uw.unit_id)}</span>
                <span style="font-size:8px; font-family:var(--font-mono); color:#38bdf8;">${pct}% Utilization</span>
              </div>
              <div style="height:4px; width:100%; background:rgba(255,255,255,0.1); border-radius:2px; margin:4px 0; overflow:hidden;">
                <div style="height:100%; width:${pct}%; background:linear-gradient(90deg, #0284c7, #38bdf8); border-radius:2px;"></div>
              </div>
              <div style="display:flex; justify-content:space-between; font-size:7.5px; color:var(--text-tertiary); font-family:var(--font-mono);">
                <span>Active: ${actH}h | Idle: ${idlH}h</span>
                <span>Dist: ${distKm}km | Energy: ${uw.energy_consumed_kwh} kWh</span>
              </div>
            </div>
          `;
        }).join('');
      }
    }

    // 4. Deviations & Root Cause Inspector
    if (deviationsContainer) {
      const devs = analysis.deviations || [];
      if (deviationCountBadge) deviationCountBadge.textContent = `${devs.length} DEVIATIONS`;
      if (devs.length === 0) {
        deviationsContainer.innerHTML = '<div style="font-size:8.5px; color:var(--text-tertiary); text-align:center; padding:12px 0;">No deviations detected. Execution matches nominal campaign baseline.</div>';
      } else {
        deviationsContainer.innerHTML = devs.map(d => {
          let causeBadge = '';
          if (d.cause_attribution === 'confirmed_cause') {
            causeBadge = '<span class="badge" style="background:rgba(239,68,68,0.2); color:#f87171; border:1px solid rgba(239,68,68,0.4); font-size:7.5px;">CONFIRMED CAUSE</span>';
          } else if (d.cause_attribution === 'contributing_factor') {
            causeBadge = '<span class="badge" style="background:rgba(245,158,11,0.2); color:#fbbf24; border:1px solid rgba(245,158,11,0.4); font-size:7.5px;">CONTRIBUTING FACTOR</span>';
          } else {
            causeBadge = '<span class="badge" style="background:rgba(156,163,175,0.2); color:#9ca3af; border:1px solid rgba(156,163,175,0.4); font-size:7.5px;">UNDETERMINED</span>';
          }

          const trigHtml = (d.triggering_event_ids && d.triggering_event_ids.length > 0)
            ? `<div style="font-size:7.5px; color:var(--text-tertiary); font-family:var(--font-mono); margin-top:2px;">Trigger Events: ${d.triggering_event_ids.map(id => escapeHtml(id)).join(', ')}</div>`
            : '';

          return `
            <div style="padding:6px 8px; background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.05); border-radius:3px;">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:8.5px; font-weight:700; color:#fbbf24; font-family:var(--font-mono);">${escapeHtml(d.code)}</span>
                <div style="display:flex; gap:4px; align-items:center;">
                  <span class="badge" style="font-size:7.5px; background:rgba(255,255,255,0.08); color:#d1d5db;">${escapeHtml(d.severity)}</span>
                  ${causeBadge}
                </div>
              </div>
              <div style="font-size:8.5px; color:#e2e8f0; margin-top:3px;">${escapeHtml(d.explanation)}</div>
              ${trigHtml}
              <div style="font-size:8px; color:#34d399; margin-top:3px;">&bull; Action: ${escapeHtml(d.recommended_action)}</div>
            </div>
          `;
        }).join('');
      }
    }

    // 5. Lessons Learned & Actionable Recommendations Center
    if (lessonsLearnedContainer) {
      const recs = analysis.lessons_learned || [];
      if (recommendationsCountBadge) recommendationsCountBadge.textContent = `${recs.length} RECOMMENDATIONS`;
      if (recs.length === 0) {
        lessonsLearnedContainer.innerHTML = '<div style="font-size:8.5px; color:var(--text-tertiary); text-align:center; padding:12px 0;">No lessons learned recommendations generated. Run analysis to produce advisory suggestions.</div>';
      } else {
        lessonsLearnedContainer.innerHTML = recs.map(rec => {
          let statusBadge = '';
          if (rec.status === 'reviewed') {
            statusBadge = '<span class="badge" style="background:rgba(16,185,129,0.2); color:#34d399; border:1px solid rgba(16,185,129,0.4); font-size:7.5px;">REVIEWED</span>';
          } else if (rec.status === 'dismissed') {
            statusBadge = '<span class="badge" style="background:rgba(156,163,175,0.2); color:#9ca3af; border:1px solid rgba(156,163,175,0.4); font-size:7.5px;">DISMISSED</span>';
          } else {
            statusBadge = '<span class="badge" style="background:rgba(99,102,241,0.2); color:#a5b4fc; border:1px solid rgba(99,102,241,0.4); font-size:7.5px;">ACTIVE</span>';
          }

          const propJson = JSON.stringify(rec.proposed_change || {}, null, 2);

          return `
            <div style="padding:8px 10px; background:rgba(15,22,34,0.7); border:1px solid rgba(99,102,241,0.25); border-radius:4px;">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <div style="display:flex; gap:6px; align-items:center;">
                  <span class="badge" style="font-size:8px; background:rgba(99,102,241,0.2); color:#a5b4fc; text-transform:uppercase;">${escapeHtml(rec.category)}</span>
                  <strong style="font-size:9.5px; color:#fff;">${escapeHtml(rec.title)}</strong>
                </div>
                <div style="display:flex; gap:4px; align-items:center;">
                  ${statusBadge}
                  <button class="btn-picker-secondary btn-review-rec" data-rec-id="${escapeHtml(rec.recommendation_id)}" data-action="reviewed" style="font-size:7.5px; padding:2px 6px;">&#10003; Accept</button>
                  <button class="btn-picker-secondary btn-review-rec" data-rec-id="${escapeHtml(rec.recommendation_id)}" data-action="dismissed" style="font-size:7.5px; padding:2px 6px;">&times; Dismiss</button>
                </div>
              </div>
              <div style="font-size:8.5px; color:#cbd5e1; margin-top:4px;"><strong>Rationale:</strong> ${escapeHtml(rec.rationale)}</div>
              <div style="font-size:8.5px; color:#34d399; margin-top:2px;"><strong>Expected Impact:</strong> ${escapeHtml(rec.expected_impact)}</div>
              <div style="font-size:8px; color:var(--text-tertiary); margin-top:2px;"><em>Assumptions:</em> ${escapeHtml(rec.assumptions_and_limitations)}</div>
              <details style="margin-top:4px;">
                <summary style="font-size:7.5px; color:#38bdf8; cursor:pointer; font-family:var(--font-mono);">View Proposed Structured Change</summary>
                <pre style="margin-top:2px; padding:4px 6px; background:rgba(0,0,0,0.5); border-radius:2px; font-size:7.5px; font-family:var(--font-mono); color:#e2e8f0; overflow-x:auto;">${escapeHtml(propJson)}</pre>
              </details>
            </div>
          `;
        }).join('');

        lessonsLearnedContainer.querySelectorAll('.btn-review-rec').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const recId = e.currentTarget.getAttribute('data-rec-id');
            const act = e.currentTarget.getAttribute('data-action');
            if (recId && act && currentCampaignAnalysis) {
              await updateRecommendationStatusAction(currentCampaignAnalysis.analysis_id, recId, act);
            }
          });
        });
      }
    }
  }

  async function updateRecommendationStatusAction(analysisId, recommendationId, status) {
    try {
      const resp = await fetch('/api/campaign/recommendations/review', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          analysis_id: analysisId,
          recommendation_id: recommendationId,
          status: status
        })
      });
      if (resp.ok) {
        const resData = await resp.json();
        currentCampaignAnalysis = resData.analysis;
        renderCampaignAnalyticsView(currentCampaignAnalysis);
        setPlanningStatus(`Recommendation status updated to '${status}'.`, "success");
      }
    } catch (err) {
      console.error('[MarsWalk Atlas] Error updating recommendation status:', err);
    }
  }

  function exportCampaignAnalyticsJson() {
    if (!currentCampaignAnalysis) {
      setPlanningStatus("No active performance analysis to export.", "warning");
      return;
    }
    const blob = new Blob([JSON.stringify(currentCampaignAnalysis, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `campaign_performance_analytics_${currentCampaignAnalysis.analysis_id}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    setPlanningStatus("Exported Campaign Performance Analytics JSON.", "success");
  }

  // Milestone 11H: Campaign Design Space Explorer Implementation
  async function loadAndRenderCampaignDesignSpace(campaignId) {
    if (!campaignId && currentCampaignPlan) campaignId = currentCampaignPlan.campaign_id;
    if (!campaignId) return;

    try {
      const resp = await fetch(`/api/campaign/design-spaces?campaign_id=${encodeURIComponent(campaignId)}`);
      if (resp.ok) {
        const evals = await resp.json();
        if (Array.isArray(evals) && evals.length > 0) {
          currentDesignSpaceEvaluation = evals[0];
          renderCampaignDesignSpaceView(currentDesignSpaceEvaluation);
          return;
        }
      }
      await runCampaignDesignSpaceExploration();
    } catch (err) {
      console.error('[MarsWalk Atlas] Error loading design space:', err);
    }
  }

  async function runCampaignDesignSpaceExploration() {
    if (!currentCampaignPlan) {
      setPlanningStatus("Please plan a campaign before running design space exploration.", "warning");
      return;
    }

    setPlanningStatus("EVALUATING CAMPAIGN DESIGN SPACE & PARETO FRONTIER...", "calculating");

    try {
      const maxCands = dsMaxCandidatesInput ? parseInt(dsMaxCandidatesInput.value, 10) || 10 : 10;
      const profiles = [];
      if (!dsProfileScienceCheck || dsProfileScienceCheck.checked) profiles.push('science_priority');
      if (!dsProfileTimeCheck || dsProfileTimeCheck.checked) profiles.push('time_constrained');
      if (!dsProfileConservativeCheck || dsProfileConservativeCheck.checked) profiles.push('conservative');
      if (profiles.length === 0) profiles.push('science_priority');

      let durLimits = [21600.0, 28800.0, 32400.0];
      if (dsDurationLimitsSelect) {
        const val = dsDurationLimitsSelect.value;
        if (val === 'conservative') durLimits = [21600.0, 28800.0];
        else if (val === 'expanded') durLimits = [28800.0, 36000.0];
      }

      let maxSols = [2, 3, 4];
      if (dsMaxSolsSelect) {
        const val = dsMaxSolsSelect.value;
        if (val === '3_4_5') maxSols = [3, 4, 5];
        else if (val === 'exact') maxSols = [currentCampaignPlan.config ? currentCampaignPlan.config.max_sols || 3 : 3];
      }

      const payload = {
        campaign_id: currentCampaignPlan.campaign_id,
        search_dimensions: {
          profiles: profiles,
          duration_limits_s: durLimits,
          max_sols_options: maxSols
        },
        search_bounds: {
          max_candidates: maxCands,
          max_planner_calls: maxCands + 4
        },
        persist: true
      };

      const resp = await fetch('/api/campaign/design-space/evaluate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.error || `HTTP ${resp.status}`);
      }

      currentDesignSpaceEvaluation = await resp.json();
      renderCampaignDesignSpaceView(currentDesignSpaceEvaluation);
      setPlanningStatus("Design space explored: Pareto frontier identified.", "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Error evaluating design space:', err);
      setPlanningStatus(`EXPLORATION FAILED: ${err.message || err}`, "error");
    }
  }

  function renderCampaignDesignSpaceView(evalData) {
    if (!evalData) return;

    // 1. Completeness & Summary KPIs
    const comp = evalData.search_completeness || {};
    const pareto = evalData.pareto_candidates || [];
    const dominated = evalData.dominated_candidates || [];
    const infeasible = evalData.infeasible_candidates || [];

    if (kpiDsConsidered) kpiDsConsidered.textContent = comp.candidates_considered || 0;
    if (kpiDsDeduplicated) kpiDsDeduplicated.textContent = `${comp.candidates_deduplicated || 0} Deduplicated`;
    if (kpiDsEvaluated) kpiDsEvaluated.textContent = comp.candidates_evaluated || 0;
    if (kpiDsLimitStatus) {
      kpiDsLimitStatus.textContent = comp.limit_reached ? "Limit Reached" : "Budget Preserved";
      kpiDsLimitStatus.style.color = comp.limit_reached ? "#fbbf24" : "var(--text-tertiary)";
    }
    if (kpiDsParetoCount) kpiDsParetoCount.textContent = `${pareto.length} EFFICIENT`;
    if (kpiDsDominatedCount) kpiDsDominatedCount.textContent = `${dominated.length} Dominated`;
    if (kpiDsInfeasibleCount) kpiDsInfeasibleCount.textContent = infeasible.length;
    if (kpiDsCompletenessBadge) {
      kpiDsCompletenessBadge.textContent = comp.is_exhaustive ? "EXHAUSTIVE" : "BOUNDED";
      kpiDsCompletenessBadge.style.color = comp.is_exhaustive ? "#34d399" : "#fbbf24";
    }
    if (dsScopeNotesText) {
      dsScopeNotesText.textContent = comp.unexplored_scope_notes || "All bounded configurations evaluated.";
      dsScopeNotesText.title = comp.unexplored_scope_notes || "";
    }

    // 2. Draw 2D Pareto Scatter Plot
    drawParetoScatterPlot(evalData);

    // 3. Populate Candidate Comparison Table
    if (tblDesignSpaceCandidatesBody) {
      const allCands = [...pareto, ...dominated, ...infeasible];
      if (allCands.length === 0) {
        tblDesignSpaceCandidatesBody.innerHTML = '<tr><td colspan="7" style="padding:8px 6px; color:var(--text-tertiary); text-align:center;">No candidates evaluated.</td></tr>';
      } else {
        tblDesignSpaceCandidatesBody.innerHTML = allCands.map(c => {
          const objs = c.objectives || {};
          const cov = objs.science_coverage_pct !== undefined ? `${objs.science_coverage_pct}%` : '--';
          const durH = objs.total_duration_s ? `${(objs.total_duration_s / 3600).toFixed(1)}h` : '--';
          const distKm = objs.total_distance_m ? `${(objs.total_distance_m / 1000).toFixed(1)}km` : '--';

          let domBadge = '';
          if (c.dominance_status === 'PARETO_EFFICIENT') {
            domBadge = '<span class="badge" style="background:rgba(16,185,129,0.2); color:#34d399; border:1px solid rgba(16,185,129,0.4); font-size:7.5px;">PARETO</span>';
          } else if (c.dominance_status === 'DOMINATED') {
            domBadge = '<span class="badge" style="background:rgba(255,255,255,0.08); color:#9ca3af; font-size:7.5px;">DOMINATED</span>';
          } else {
            domBadge = '<span class="badge" style="background:rgba(239,68,68,0.2); color:#f87171; border:1px solid rgba(239,68,68,0.4); font-size:7.5px;">INFEASIBLE</span>';
          }

          const prof = (c.configuration && c.configuration.planning_profile) ? c.configuration.planning_profile : 'standard';

          return `
            <tr style="border-bottom:1px solid rgba(255,255,255,0.05); cursor:pointer;" class="ds-cand-row" data-cand-id="${escapeHtml(c.candidate_id)}">
              <td style="padding:4px 6px; color:#fff; font-weight:600;">${escapeHtml(c.candidate_id)}</td>
              <td style="padding:4px 6px; color:var(--text-secondary);">${escapeHtml(prof)}</td>
              <td style="padding:4px 6px; color:#34d399; font-weight:600;">${cov}</td>
              <td style="padding:4px 6px; color:#38bdf8;">${durH}</td>
              <td style="padding:4px 6px; color:#e2e8f0;">${distKm}</td>
              <td style="padding:4px 6px;">${domBadge}</td>
              <td style="padding:4px 6px;">
                <button class="btn-picker-secondary btn-inspect-cand" data-cand-id="${escapeHtml(c.candidate_id)}" style="font-size:7px; padding:2px 5px;">Inspect</button>
              </td>
            </tr>
          `;
        }).join('');

        // Wire click handlers on table rows
        tblDesignSpaceCandidatesBody.querySelectorAll('.ds-cand-row').forEach(row => {
          row.addEventListener('click', (e) => {
            const cid = e.currentTarget.getAttribute('data-cand-id');
            if (cid) selectDesignSpaceCandidate(cid);
          });
        });
      }
    }

    // 4. Populate Grounded Recommendations
    if (dsRecommendationsContainer) {
      const recs = evalData.recommendations || [];
      if (recs.length === 0) {
        dsRecommendationsContainer.innerHTML = '<div style="font-size:8.5px; color:var(--text-tertiary); text-align:center; padding:12px 0;">No frontier recommendations generated.</div>';
      } else {
        dsRecommendationsContainer.innerHTML = recs.map(r => {
          return `
            <div style="padding:6px 8px; background:rgba(0,0,0,0.3); border:1px solid rgba(6,182,212,0.25); border-radius:3px;">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <strong style="font-size:8.5px; color:#67e8f9;">${escapeHtml(r.headline)}</strong>
                <button class="btn-picker-secondary btn-inspect-cand" data-cand-id="${escapeHtml(r.candidate_id)}" style="font-size:7px; padding:1px 4px;">Select</button>
              </div>
              <div style="font-size:8px; color:#cbd5e1; margin-top:3px; line-height:1.3;">${escapeHtml(r.tradeoff_summary)}</div>
              <div style="font-size:7.5px; color:#34d399; margin-top:2px;">&bull; ${escapeHtml(r.selection_rationale)}</div>
            </div>
          `;
        }).join('');

        dsRecommendationsContainer.querySelectorAll('.btn-inspect-cand').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const cid = e.currentTarget.getAttribute('data-cand-id');
            if (cid) selectDesignSpaceCandidate(cid);
          });
        });
      }
    }

    // Select first Pareto candidate by default
    if (pareto.length > 0) {
      selectDesignSpaceCandidate(pareto[0].candidate_id);
    } else if (dominated.length > 0) {
      selectDesignSpaceCandidate(dominated[0].candidate_id);
    }
  }

  function drawParetoScatterPlot(evalData) {
    if (!canvasParetoPlot) return;
    const ctx = canvasParetoPlot.getContext('2d');
    const width = canvasParetoPlot.width;
    const height = canvasParetoPlot.height;

    ctx.clearRect(0, 0, width, height);

    const pareto = evalData.pareto_candidates || [];
    const dominated = evalData.dominated_candidates || [];
    const infeasible = evalData.infeasible_candidates || [];
    const allCands = [...pareto, ...dominated, ...infeasible];

    if (allCands.length === 0) {
      ctx.fillStyle = "#9ca3af";
      ctx.font = "10px sans-serif";
      ctx.textAlign = "center";
      ctx.fillText("No candidate data to plot", width / 2, height / 2);
      return;
    }

    // Compute bounding boxes for Duration (X) and Science Coverage (Y)
    let minDurH = Infinity, maxDurH = -Infinity;
    let minCov = 0.0, maxCov = 100.0;

    allCands.forEach(c => {
      const dH = (c.objectives && c.objectives.total_duration_s) ? c.objectives.total_duration_s / 3600.0 : 0;
      if (dH > 0) {
        if (dH < minDurH) minDurH = dH;
        if (dH > maxDurH) maxDurH = dH;
      }
    });

    if (minDurH === Infinity) { minDurH = 4.0; maxDurH = 12.0; }
    minDurH = Math.max(0, minDurH - 1.0);
    maxDurH = maxDurH + 1.0;

    const padLeft = 40, padRight = 20, padTop = 20, padBottom = 25;
    const plotW = width - padLeft - padRight;
    const plotH = height - padTop - padBottom;

    // Helper coordinates mapper
    const toX = (durH) => padLeft + ((durH - minDurH) / Math.max(0.1, maxDurH - minDurH)) * plotW;
    const toY = (cov) => padTop + (1.0 - (cov - minCov) / Math.max(1.0, maxCov - minCov)) * plotH;

    // Draw Grid Lines & Axes
    ctx.strokeStyle = "rgba(255, 255, 255, 0.08)";
    ctx.lineWidth = 1;

    // Horizontal grid lines (0%, 25%, 50%, 75%, 100%)
    [0, 25, 50, 75, 100].forEach(covVal => {
      const y = toY(covVal);
      ctx.beginPath();
      ctx.moveTo(padLeft, y);
      ctx.lineTo(width - padRight, y);
      ctx.stroke();

      ctx.fillStyle = "#9ca3af";
      ctx.font = "7.5px monospace";
      ctx.textAlign = "right";
      ctx.fillText(`${covVal}%`, padLeft - 4, y + 3);
    });

    // Vertical grid lines for duration
    const durStep = Math.max(1, Math.round((maxDurH - minDurH) / 4));
    for (let d = Math.ceil(minDurH); d <= maxDurH; d += durStep) {
      const x = toX(d);
      ctx.beginPath();
      ctx.moveTo(x, padTop);
      ctx.lineTo(x, height - padBottom);
      ctx.stroke();

      ctx.fillStyle = "#9ca3af";
      ctx.font = "7.5px monospace";
      ctx.textAlign = "center";
      ctx.fillText(`${d}h`, x, height - padBottom + 12);
    }

    // Axis Labels
    ctx.fillStyle = "#cbd5e1";
    ctx.font = "8px sans-serif";
    ctx.textAlign = "center";
    ctx.fillText("Duration (hours)", padLeft + plotW / 2, height - 2);

    ctx.save();
    ctx.translate(10, padTop + plotH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText("Science Coverage (%)", 0, 0);
    ctx.restore();

    // Draw Pareto Frontier step curve
    if (pareto.length > 1) {
      const sortedP = [...pareto].sort((a, b) => a.objectives.total_duration_s - b.objectives.total_duration_s);
      ctx.strokeStyle = "rgba(52, 211, 153, 0.7)";
      ctx.lineWidth = 1.5;
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      sortedP.forEach((p, idx) => {
        const px = toX(p.objectives.total_duration_s / 3600.0);
        const py = toY(p.objectives.science_coverage_pct);
        if (idx === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      });
      ctx.stroke();
      ctx.setLineDash([]);
    }

    // 1. Draw Dominated Points (Gray circles)
    dominated.forEach(c => {
      const cx = toX(c.objectives.total_duration_s / 3600.0);
      const cy = toY(c.objectives.science_coverage_pct);
      ctx.fillStyle = "rgba(156, 163, 175, 0.6)";
      ctx.beginPath();
      ctx.arc(cx, cy, 3.5, 0, Math.PI * 2);
      ctx.fill();
    });

    // 2. Draw Infeasible Points (Red cross)
    infeasible.forEach(c => {
      const cx = toX((c.objectives.total_duration_s || 0) / 3600.0);
      const cy = toY(c.objectives.science_coverage_pct || 0);
      ctx.strokeStyle = "rgba(248, 113, 113, 0.8)";
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(cx - 3, cy - 3); ctx.lineTo(cx + 3, cy + 3);
      ctx.moveTo(cx + 3, cy - 3); ctx.lineTo(cx - 3, cy + 3);
      ctx.stroke();
    });

    // 3. Draw Pareto Points (Emerald / Cyan glowing circles)
    pareto.forEach(c => {
      const cx = toX(c.objectives.total_duration_s / 3600.0);
      const cy = toY(c.objectives.science_coverage_pct);

      ctx.fillStyle = "#34d399";
      ctx.beginPath();
      ctx.arc(cx, cy, 5, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = "#fff";
      ctx.lineWidth = 1.5;
      ctx.stroke();
    });
  }

  function selectDesignSpaceCandidate(candidateId) {
    if (!currentDesignSpaceEvaluation) return;
    const allCands = [
      ...(currentDesignSpaceEvaluation.pareto_candidates || []),
      ...(currentDesignSpaceEvaluation.dominated_candidates || []),
      ...(currentDesignSpaceEvaluation.infeasible_candidates || [])
    ];

    const cand = allCands.find(c => c.candidate_id === candidateId);
    if (!cand) return;

    selectedDesignSpaceCandidate = cand;

    if (dsSelectedCandidateTitle) {
      dsSelectedCandidateTitle.textContent = `${cand.candidate_id} (${cand.configuration ? cand.configuration.planning_profile || 'baseline' : 'candidate'})`;
    }

    if (dsSelectedDominanceBadge) {
      if (cand.dominance_status === 'PARETO_EFFICIENT') {
        dsSelectedDominanceBadge.textContent = 'PARETO EFFICIENT';
        dsSelectedDominanceBadge.style.background = 'rgba(16,185,129,0.2)';
        dsSelectedDominanceBadge.style.color = '#34d399';
        dsSelectedDominanceBadge.style.border = '1px solid rgba(16,185,129,0.4)';
      } else if (cand.dominance_status === 'DOMINATED') {
        dsSelectedDominanceBadge.textContent = 'DOMINATED';
        dsSelectedDominanceBadge.style.background = 'rgba(255,255,255,0.08)';
        dsSelectedDominanceBadge.style.color = '#9ca3af';
        dsSelectedDominanceBadge.style.border = '1px solid rgba(255,255,255,0.15)';
      } else {
        dsSelectedDominanceBadge.textContent = 'INFEASIBLE';
        dsSelectedDominanceBadge.style.background = 'rgba(239,68,68,0.2)';
        dsSelectedDominanceBadge.style.color = '#f87171';
        dsSelectedDominanceBadge.style.border = '1px solid rgba(239,68,68,0.4)';
      }
    }

    if (dsSelectedCandidateContent) {
      const objs = cand.objectives || {};
      const cfg = cand.configuration || {};
      const durH = objs.total_duration_s ? (objs.total_duration_s / 3600.0).toFixed(1) : '--';
      const distKm = objs.total_distance_m ? (objs.total_distance_m / 1000.0).toFixed(2) : '--';

      let infHtml = '';
      if (cand.infeasibility_reasons && cand.infeasibility_reasons.length > 0) {
        infHtml = `<div style="margin-top:6px; padding:4px 6px; background:rgba(239,68,68,0.1); border-left:2px solid #ef4444; color:#f87171; font-size:7.5px;"><strong>Infeasibility:</strong> ${cand.infeasibility_reasons.map(r => escapeHtml(r)).join('; ')}</div>`;
      }

      dsSelectedCandidateContent.innerHTML = `
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px; font-family:var(--font-mono); font-size:8px;">
          <div>Coverage: <span style="color:#34d399; font-weight:700;">${objs.science_coverage_pct}%</span></div>
          <div>Duration: <span style="color:#38bdf8; font-weight:700;">${durH}h</span></div>
          <div>Traverse: <span style="color:#e2e8f0;">${distKm}km</span></div>
          <div>Sorties: <span style="color:#e2e8f0;">${objs.sortie_count} Sols</span></div>
        </div>
        <div style="font-size:8px; color:#cbd5e1; margin-top:6px; line-height:1.3;">
          ${escapeHtml(cand.tradeoff_explanation || '')}
        </div>
        ${infHtml}
        <details style="margin-top:6px;">
          <summary style="font-size:7.5px; color:#38bdf8; cursor:pointer; font-family:var(--font-mono);">Configuration Delta</summary>
          <pre style="margin-top:2px; padding:4px 6px; background:rgba(0,0,0,0.5); border-radius:2px; font-size:7.5px; font-family:var(--font-mono); color:#e2e8f0; overflow-x:auto;">${escapeHtml(JSON.stringify(cfg, null, 2))}</pre>
        </details>
      `;
    }

    if (btnPromoteCandidate) {
      if (cand.status === 'FEASIBLE') {
        btnPromoteCandidate.disabled = false;
        btnPromoteCandidate.style.opacity = '1.0';
        btnPromoteCandidate.style.cursor = 'pointer';
      } else {
        btnPromoteCandidate.disabled = true;
        btnPromoteCandidate.style.opacity = '0.4';
        btnPromoteCandidate.style.cursor = 'not-allowed';
      }
    }
  }

  async function promoteSelectedCandidateAction() {
    if (!currentDesignSpaceEvaluation || !selectedDesignSpaceCandidate) return;
    if (selectedDesignSpaceCandidate.status !== 'FEASIBLE') {
      setPlanningStatus("Cannot promote an infeasible candidate.", "error");
      return;
    }

    setPlanningStatus(`PROMOTING CANDIDATE ${selectedDesignSpaceCandidate.candidate_id} TO NEW CAMPAIGN VERSION...`, "calculating");

    try {
      const payload = {
        design_space_id: currentDesignSpaceEvaluation.design_space_id,
        candidate_id: selectedDesignSpaceCandidate.candidate_id,
        new_campaign_name: `${currentCampaignPlan.name} (Pareto Optimized)`
      };

      const resp = await fetch('/api/campaign/design-space/promote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.error || `HTTP ${resp.status}`);
      }

      const resData = await resp.json();
      currentCampaignPlan = resData.campaign;
      renderCampaignPlanningView(currentCampaignPlan);
      setPlanningStatus(`SUCCESS: Promoted to Campaign Version ${resData.new_version} (${resData.new_campaign_id}). Baseline preserved.`, "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Error promoting candidate:', err);
      setPlanningStatus(`PROMOTION FAILED: ${err.message || err}`, "error");
    }
  }

  function exportDesignSpaceJson() {
    if (!currentDesignSpaceEvaluation) {
      setPlanningStatus("No active design space evaluation to export.", "warning");
      return;
    }

    const blob = new Blob([JSON.stringify(currentDesignSpaceEvaluation, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `campaign_design_space_${currentDesignSpaceEvaluation.design_space_id}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    setPlanningStatus("Exported Campaign Design Space JSON.", "success");
  }


  // =========================================================================
  // Milestone 12C: Route Decision Workbench & Interactive Elevation Profile
  // =========================================================================
  let currentTerrainAnalysis = null;
  let currentComparisonData = null;
  let terrainHoverMarkerMesh = null;

  function initTerrainHoverMarker() {
    if (terrainHoverMarkerMesh || !jezeroSurfaceGroup) return;
    const geom = new THREE.SphereGeometry(14, 16, 16);
    const mat = new THREE.MeshBasicMaterial({
      color: 0x00E5FF,
      wireframe: true,
      transparent: true,
      opacity: 0.85
    });
    terrainHoverMarkerMesh = new THREE.Mesh(geom, mat);
    terrainHoverMarkerMesh.visible = false;
    jezeroSurfaceGroup.add(terrainHoverMarkerMesh);
  }

  function clearTerrainProfileWorkbench() {
    currentTerrainAnalysis = null;
    currentComparisonData = null;
    if (elevationEmptyState) elevationEmptyState.classList.remove('hidden');
    if (elevationChartContainer) elevationChartContainer.classList.add('hidden');
    if (elevationMetricsChips) elevationMetricsChips.classList.add('hidden');
    if (terrainCostAccordion) terrainCostAccordion.classList.add('hidden');
    if (terrainExplanationsCard) terrainExplanationsCard.classList.add('hidden');
    if (elevationNoDataBanner) elevationNoDataBanner.classList.add('hidden');
    if (comparisonResultsContainer) comparisonResultsContainer.classList.add('hidden');
    if (comparisonActiveBadge) comparisonActiveBadge.classList.add('hidden');
    if (btnClearComparison) btnClearComparison.classList.add('hidden');
    if (terrainProfileBadge) {
      terrainProfileBadge.textContent = 'NO ROUTE';
      terrainProfileBadge.style.color = 'var(--text-tertiary)';
    }
    if (terrainHoverMarkerMesh) {
      terrainHoverMarkerMesh.visible = false;
    }
  }

  async function refreshTerrainProfileAnalysis(routeData, compareWithProfile = null) {
    const rawPath = (routeData && (routeData.path_rc || routeData.path)) || activeRoutePath;
    if (!rawPath || rawPath.length < 2) {
      clearTerrainProfileWorkbench();
      return;
    }

    if (terrainProfileBadge) {
      terrainProfileBadge.textContent = 'ANALYZING...';
      terrainProfileBadge.style.color = 'var(--data-route-amber)';
    }

    const payload = {
      path: rawPath,
      profile: (routeData && routeData.profile) || currentProfile || 'conservative',
      vehicle_mode: currentVehicleMode || 'crew_eva',
      route_id: (routeData && routeData.route_id) || 'nominal-route'
    };

    if (compareWithProfile) {
      payload.compare_with_profile = compareWithProfile;
    }

    try {
      const resp = await fetch('/api/route/terrain-analysis', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        throw new Error(`Server returned ${resp.status}`);
      }

      const data = await resp.json();
      if (!data || data.status !== 'ok' || !data.analysis) {
        throw new Error('Invalid response structure');
      }

      currentTerrainAnalysis = data.analysis;

      // Update badge
      if (terrainProfileBadge) {
        terrainProfileBadge.textContent = 'PROFILE READY';
        terrainProfileBadge.style.color = 'var(--status-green)';
      }

      // Show container, hide empty state
      if (elevationEmptyState) elevationEmptyState.classList.add('hidden');
      if (elevationChartContainer) elevationChartContainer.classList.remove('hidden');
      if (elevationMetricsChips) elevationMetricsChips.classList.remove('hidden');
      if (terrainCostAccordion) terrainCostAccordion.classList.remove('hidden');
      if (terrainExplanationsCard) terrainExplanationsCard.classList.remove('hidden');

      const prof = data.analysis.terrain_profile;
      const diff = data.analysis.difficulty_summary;
      const cost = data.analysis.cost_decomposition;
      const slopes = data.analysis.slope_distribution;

      // Render interactive SVG
      renderElevationProfileSvg(prof, data.analysis.segments);

      // Render summary chips
      if (chipClimbDescent) {
        const gain = prof.total_elevation_gain_m || 0;
        const loss = prof.total_elevation_loss_m || 0;
        chipClimbDescent.textContent = `+${gain.toFixed(0)}m / -${loss.toFixed(0)}m`;
      }
      if (chipSlopePercentiles) {
        const maxS = diff.max_slope_deg || 0;
        const p50S = slopes.p50_deg || slopes.p50_slope_deg || 0;
        chipSlopePercentiles.textContent = `${maxS.toFixed(1)}° / ${p50S.toFixed(1)}°`;
        chipSlopePercentiles.style.color = maxS >= 15.0 ? 'var(--status-red)' : (maxS >= 10.0 ? 'var(--data-route-amber)' : 'var(--status-green)');
      }
      if (chipCostDensity) {
        const dens = cost.cost_density_ratio || 1.0;
        chipCostDensity.textContent = `${dens.toFixed(2)}x`;
      }

      // Render cost decomposition
      if (costBaseDist) costBaseDist.textContent = `${cost.base_distance_cost_m.toFixed(1)} m`;
      if (costSlopePenalty) costSlopePenalty.textContent = `+${cost.slope_penalty_cost_m.toFixed(1)} m`;
      if (costRoughPenalty) costRoughPenalty.textContent = `+${cost.roughness_penalty_cost_m.toFixed(1)} m`;
      if (costUphillPenalty) costUphillPenalty.textContent = `+${cost.uphill_grade_cost_m.toFixed(1)} m`;
      if (costTotalReconciled) costTotalReconciled.textContent = `${cost.total_cost_m.toFixed(1)} flat-m`;

      // Render Grounded Explanations
      if (terrainExplanationsList) {
        terrainExplanationsList.innerHTML = '';
        const exps = data.analysis.decision_explanations || [];
        exps.forEach(exp => {
          const li = document.createElement('li');
          li.style.marginBottom = '3px';
          li.textContent = exp;
          terrainExplanationsList.appendChild(li);
        });
      }

      // Check missing data
      if (prof.data_completeness_pct < 99.0) {
        if (elevationNoDataBanner) {
          elevationNoDataBanner.classList.remove('hidden');
          if (elevationNoDataText) {
            elevationNoDataText.textContent = `${prof.missing_sample_count} of ${prof.sample_count} samples (${(100 - prof.data_completeness_pct).toFixed(1)}%) cross unmapped or NoData cells.`;
          }
        }
      } else {
        if (elevationNoDataBanner) elevationNoDataBanner.classList.add('hidden');
      }

      // Comparison handling
      if (data.comparison) {
        currentComparisonData = data.comparison;
        renderRouteComparisonResults(data.comparison);
      } else if (!compareWithProfile) {
        if (comparisonResultsContainer) comparisonResultsContainer.classList.add('hidden');
        if (comparisonActiveBadge) comparisonActiveBadge.classList.add('hidden');
        if (btnClearComparison) btnClearComparison.classList.add('hidden');
      }
    } catch (err) {
      console.warn('[MarsWalk 12C] Failed to analyze route terrain:', err);
      if (terrainProfileBadge) {
        terrainProfileBadge.textContent = 'ANALYSIS OFFLINE';
        terrainProfileBadge.style.color = 'var(--status-red)';
      }
    }
  }

  function renderElevationProfileSvg(prof, segments) {
    if (!elevationProfileSvg || !prof || !prof.samples || prof.samples.length < 2) return;
    initTerrainHoverMarker();

    const samples = prof.samples;
    const totalDist = Math.max(1.0, prof.total_distance_m || 1.0);
    const validElevs = samples.filter(s => s.elevation_m !== null).map(s => s.elevation_m);

    let minElev = validElevs.length ? Math.min(...validElevs) : -2500;
    let maxElev = validElevs.length ? Math.max(...validElevs) : -2400;
    if (maxElev - minElev < 8.0) {
      minElev -= 5.0;
      maxElev += 5.0;
    }
    const elevSpan = maxElev - minElev;

    if (elevationChartSpanInfo) {
      elevationChartSpanInfo.textContent = `Span: ${elevSpan.toFixed(0)}m (${minElev.toFixed(0)} to ${maxElev.toFixed(0)}m) | Dist: ${totalDist.toFixed(0)}m`;
    }

    const W = 400;
    const H = 120;
    const padL = 36;
    const padR = 10;
    const padT = 12;
    const padB = 20;
    const plotW = W - padL - padR;
    const plotH = H - padT - padB;

    function getX(dist) {
      return padL + (dist / totalDist) * plotW;
    }
    function getY(elev) {
      if (elev === null || elev === undefined) return padT + plotH;
      const frac = (elev - minElev) / elevSpan;
      return padT + (1.0 - frac) * plotH;
    }

    // Build SVG elements
    let svgHtml = `
      <defs>
        <linearGradient id="elevGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#00e5ff" stop-opacity="0.35"/>
          <stop offset="100%" stop-color="#00e5ff" stop-opacity="0.02"/>
        </linearGradient>
      </defs>
    `;

    // 1. Grid Lines & Axis Labels (3 horizontal levels)
    const yLevels = [
      { val: maxElev, label: `${Math.round(maxElev)}m` },
      { val: (minElev + maxElev) / 2, label: `${Math.round((minElev + maxElev) / 2)}m` },
      { val: minElev, label: `${Math.round(minElev)}m` }
    ];
    yLevels.forEach(lvl => {
      const y = getY(lvl.val);
      svgHtml += `<line x1="${padL}" y1="${y}" x2="${W - padR}" y2="${y}" class="grid-line" />`;
      svgHtml += `<text x="${padL - 4}" y="${y + 2.5}" text-anchor="end">${lvl.label}</text>`;
    });

    // Distance grid lines (Start, Mid, End)
    const distLevels = [
      { d: 0, label: '0m' },
      { d: totalDist / 2, label: `${Math.round(totalDist / 2)}m` },
      { d: totalDist, label: `${Math.round(totalDist)}m` }
    ];
    distLevels.forEach(lvl => {
      const x = getX(lvl.d);
      svgHtml += `<line x1="${x}" y1="${padT}" x2="${x}" y2="${padT + plotH}" class="grid-line" />`;
      svgHtml += `<text x="${x}" y="${H - 5}" text-anchor="middle">${lvl.label}</text>`;
    });

    // 2. Base Fill Polygon
    let fillPoints = `${padL},${padT + plotH} `;
    samples.forEach(s => {
      const x = getX(s.cumulative_distance_m);
      const y = getY(s.elevation_m !== null ? s.elevation_m : minElev);
      fillPoints += `${x.toFixed(1)},${y.toFixed(1)} `;
    });
    fillPoints += `${padL + plotW},${padT + plotH}`;
    svgHtml += `<polygon points="${fillPoints}" fill="url(#elevGrad)" />`;

    // 3. Segment Color Coding (Normal, Moderate, Steep, NoData)
    for (let i = 1; i < samples.length; i++) {
      const s0 = samples[i - 1];
      const s1 = samples[i];
      const x0 = getX(s0.cumulative_distance_m);
      const y0 = getY(s0.elevation_m !== null ? s0.elevation_m : minElev);
      const x1 = getX(s1.cumulative_distance_m);
      const y1 = getY(s1.elevation_m !== null ? s1.elevation_m : minElev);

      let strokeCol = '#00e5ff';
      let strokeWidth = 1.6;
      let strokeDash = '';

      if (s1.is_nodata || s0.is_nodata || s1.elevation_m === null) {
        strokeCol = '#9e9e9e';
        strokeDash = 'stroke-dasharray="3 2"';
      } else if (s1.slope_deg >= 15.0) {
        strokeCol = '#ff1744';
        strokeWidth = 2.4;
      } else if (s1.slope_deg >= 10.0) {
        strokeCol = '#ffa726';
        strokeWidth = 2.0;
      }

      svgHtml += `<line x1="${x0.toFixed(1)}" y1="${y0.toFixed(1)}" x2="${x1.toFixed(1)}" y2="${y1.toFixed(1)}" stroke="${strokeCol}" stroke-width="${strokeWidth}" stroke-linecap="round" ${strokeDash} />`;
    }

    // 4. Interactive Scrubber Elements (Line & Marker Dot)
    svgHtml += `
      <line id="scrubLine" x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT + plotH}" stroke="#ffffff" stroke-width="1.2" stroke-dasharray="2 2" style="display:none;" />
      <circle id="scrubDot" cx="${padL}" cy="${padT + plotH}" r="3.5" fill="#00e5ff" stroke="#ffffff" stroke-width="1.5" style="display:none;" />
    `;

    elevationProfileSvg.innerHTML = svgHtml;

    // Attach scrub events
    const scrubLine = elevationProfileSvg.querySelector('#scrubLine');
    const scrubDot = elevationProfileSvg.querySelector('#scrubDot');

    elevationProfileSvg.onmousemove = (evt) => {
      const rect = elevationProfileSvg.getBoundingClientRect();
      const mouseX = evt.clientX - rect.left;
      const frac = Math.max(0, Math.min(1, (mouseX - (padL / W) * rect.width) / ((plotW / W) * rect.width)));
      const targetDist = frac * totalDist;

      // Find nearest sample
      let bestIdx = 0;
      let minDiff = Infinity;
      for (let i = 0; i < samples.length; i++) {
        const diff = Math.abs(samples[i].cumulative_distance_m - targetDist);
        if (diff < minDiff) {
          minDiff = diff;
          bestIdx = i;
        }
      }

      const s = samples[bestIdx];
      const sx = getX(s.cumulative_distance_m);
      const sy = getY(s.elevation_m !== null ? s.elevation_m : minElev);

      if (scrubLine) {
        scrubLine.setAttribute('x1', sx);
        scrubLine.setAttribute('x2', sx);
        scrubLine.style.display = 'block';
      }
      if (scrubDot) {
        scrubDot.setAttribute('cx', sx);
        scrubDot.setAttribute('cy', sy);
        scrubDot.style.display = 'block';
      }

      if (elevationProfileTooltip) {
        const elevTxt = s.elevation_m !== null ? `${s.elevation_m.toFixed(1)} m` : 'NoData';
        const slopeTxt = s.slope_deg !== null ? `${s.slope_deg.toFixed(1)}°` : 'N/A';
        const coordsTxt = (s.lon_deg !== null && s.lat_deg !== null) ? ` | Lon: ${s.lon_deg.toFixed(3)}°E, Lat: ${s.lat_deg.toFixed(3)}°N` : '';
        elevationProfileTooltip.innerHTML = `
          <strong>${s.cumulative_distance_m.toFixed(0)} m</strong> | Elev: <span style="color:var(--telemetry-cyan); font-weight:600;">${elevTxt}</span> | Slope: <span style="color:${s.slope_deg >= 15 ? '#ff1744' : (s.slope_deg >= 10 ? '#ffa726' : '#00e676')}; font-weight:600;">${slopeTxt}</span>${coordsTxt}
        `;
        elevationProfileTooltip.classList.remove('hidden');

        // Position tooltip inside container
        const ttLeft = Math.max(6, Math.min(rect.width - 180, mouseX - 60));
        elevationProfileTooltip.style.left = `${ttLeft}px`;
        elevationProfileTooltip.style.top = `6px`;
      }

      // Synchronize with 3D map
      if (terrainHoverMarkerMesh && jezeroSurfaceGroup && missionData && missionData.elevation_samples) {
        const r = s.row;
        const c = s.col;
        if (r >= 0 && r < missionData.elevation_samples.length && c >= 0 && c < missionData.elevation_samples[0].length) {
          const elev = missionData.elevation_samples[r][c];
          const pos = rcToLocalPos(r, c, elev, currentExaggeration);
          pos.y += 12.0;
          terrainHoverMarkerMesh.position.copy(pos);
          terrainHoverMarkerMesh.visible = true;
        }
      }
    };

    elevationProfileSvg.onmouseleave = () => {
      if (scrubLine) scrubLine.style.display = 'none';
      if (scrubDot) scrubDot.style.display = 'none';
      if (elevationProfileTooltip) elevationProfileTooltip.classList.add('hidden');
      if (terrainHoverMarkerMesh) terrainHoverMarkerMesh.visible = false;
    };
  }

  function renderRouteComparisonResults(comp) {
    if (!comp || !comparisonResultsContainer) return;

    if (compHeaderA) compHeaderA.textContent = comp.title_a || 'Plan A (Nominal)';
    if (compHeaderB) compHeaderB.textContent = comp.title_b || 'Plan B (Alternative)';

    const tbl = comp.metrics_table || {};
    const deltas = comp.deltas || {};

    if (compDistA && compDistB && compDeltaDist) {
      compDistA.textContent = `${(tbl.distance_m?.a || 0).toFixed(0)} m`;
      compDistB.textContent = `${(tbl.distance_m?.b || 0).toFixed(0)} m`;
      const dD = deltas.distance_delta_m || 0;
      compDeltaDist.textContent = `Δ ${dD > 0 ? '+' : ''}${dD.toFixed(0)} m`;
      compDeltaDist.className = `badge ${dD > 0 ? 'badge-delta-pos' : (dD < 0 ? 'badge-delta-neg' : 'badge-delta-neutral')}`;
    }

    if (compEffortA && compEffortB && compDeltaEffort) {
      compEffortA.textContent = `${(tbl.effort_cost_flat_m?.a || 0).toFixed(0)} flat-m`;
      compEffortB.textContent = `${(tbl.effort_cost_flat_m?.b || 0).toFixed(0)} flat-m`;
      const dE = deltas.cost_delta_m || 0;
      compDeltaEffort.textContent = `Δ ${dE > 0 ? '+' : ''}${dE.toFixed(0)} flat-m`;
      compDeltaEffort.className = `badge ${dE > 0 ? 'badge-delta-pos' : (dE < 0 ? 'badge-delta-neg' : 'badge-delta-neutral')}`;
    }

    if (compGainA && compGainB && compDeltaGain) {
      compGainA.textContent = `+${(tbl.elevation_gain_m?.a || 0).toFixed(0)} m`;
      compGainB.textContent = `+${(tbl.elevation_gain_m?.b || 0).toFixed(0)} m`;
      const dG = deltas.elevation_gain_delta_m || 0;
      compDeltaGain.textContent = `Δ ${dG > 0 ? '+' : ''}${dG.toFixed(0)} m`;
      compDeltaGain.className = `badge ${dG > 0 ? 'badge-delta-pos' : (dG < 0 ? 'badge-delta-neg' : 'badge-delta-neutral')}`;
    }

    if (compSlopeA && compSlopeB && compDeltaSlope) {
      compSlopeA.textContent = `${(tbl.max_slope_deg?.a || 0).toFixed(1)}° max`;
      compSlopeB.textContent = `${(tbl.max_slope_deg?.b || 0).toFixed(1)}° max`;
      const dS = deltas.max_slope_delta_deg || 0;
      compDeltaSlope.textContent = `Δ ${dS > 0 ? '+' : ''}${dS.toFixed(1)}°`;
      compDeltaSlope.className = `badge ${dS > 0 ? 'badge-delta-pos' : (dS < 0 ? 'badge-delta-neg' : 'badge-delta-neutral')}`;
    }

    if (compNarrativeBox) {
      compNarrativeBox.innerHTML = '';
      const narratives = comp.tradeoff_narratives || [];
      narratives.forEach(n => {
        const p = document.createElement('div');
        p.style.marginBottom = '2px';
        p.textContent = `• ${n}`;
        compNarrativeBox.appendChild(p);
      });
    }

    comparisonResultsContainer.classList.remove('hidden');
    if (comparisonActiveBadge) comparisonActiveBadge.classList.remove('hidden');
    if (btnClearComparison) btnClearComparison.classList.remove('hidden');
  }

  function clearTerrainComparison() {
    currentComparisonData = null;
    if (comparisonResultsContainer) comparisonResultsContainer.classList.add('hidden');
    if (comparisonActiveBadge) comparisonActiveBadge.classList.add('hidden');
    if (btnClearComparison) btnClearComparison.classList.add('hidden');
  }

    async function runGauntletStressTest(scenarioIdParam = null) {
    if (currentViewMode !== 'jezero') {
      setPlanningStatus("Terrain stress testing is confined to the surveyed Jezero Crater 20 m DTM. Fly to Jezero Crater to evaluate routes.", "error");
      return;
    }

    if (!customStart || !customGoal) {
      setPlanningStatus("Please calculate a route before running a stress simulation.", "error");
      return;
    }

    const scenarioId = (typeof scenarioIdParam === 'string' && scenarioIdParam)
      ? scenarioIdParam
      : (gauntletScenarioSelect ? gauntletScenarioSelect.value : 'scen_corridor_rockfall');
    if (gauntletScenarioSelect && scenarioId) {
      gauntletScenarioSelect.value = scenarioId;
    }
    if (btnRunGauntlet) {
      btnRunGauntlet.disabled = true;
      btnRunGauntlet.innerHTML = '&#9881; Evaluating Disruption Scenario...';
    }
    setPlanningStatus(`Evaluating stress test scenario: ${scenarioId}...`, "calculating");

    try {
      const payload = {
        start: { row: customStart.row, col: customStart.col },
        goal: { row: customGoal.row, col: customGoal.col },
        profile: currentProfile,
        vehicle_mode: currentVehicleMode,
        scenario_id: scenarioId
      };

      if (inputExpeditionHours && inputExpeditionHours.value !== '') {
        const hVal = parseFloat(inputExpeditionHours.value);
        if (!isNaN(hVal) && hVal > 0) {
          payload.operational_limit_s = hVal * 3600;
        }
      }
      if (inputDwellMins && inputDwellMins.value !== '') {
        const dVal = parseFloat(inputDwellMins.value);
        if (!isNaN(dVal) && dVal >= 0) {
          payload.dwell_time_per_stop_s = dVal * 60;
        }
      }
      if (inputDelayMins && inputDelayMins.value !== '') {
        const delVal = parseFloat(inputDelayMins.value);
        if (!isNaN(delVal) && delVal >= 0) {
          payload.operational_delay_s = delVal * 60;
        }
      }
      if (inputMaxDistanceM && inputMaxDistanceM.value !== '') {
        const mVal = parseFloat(inputMaxDistanceM.value);
        if (!isNaN(mVal) && mVal > 0) {
          payload.max_distance_m = mVal;
        }
      }

      if (activeIntermediateStops && activeIntermediateStops.length > 0) {
        payload.stops = activeIntermediateStops.map(s => ({
          row: s.row,
          col: s.col,
          id: s.id,
          name: s.name,
          priority_score: s.priority_score
        }));
      }

      const resp = await fetch('/api/gauntlet', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const res = await resp.json();

      if (!resp.ok) {
        throw new Error(res.detail || res.message || `HTTP ${resp.status}`);
      }

      lastGauntletResult = res;

      // Display Gauntlet Card
      if (gauntletResultCard) {
        gauntletResultCard.classList.remove('hidden');
        if (gauntletHeadline) gauntletHeadline.textContent = res.headline || "DISRUPTION SCENARIO EVALUATED";
        if (gauntletDetail) gauntletDetail.textContent = res.detail || res.message;
        if (gauntletDeltaDist) {
          const dM = res.delta_distance_m !== null && res.delta_distance_m !== undefined ? res.delta_distance_m : 0;
          gauntletDeltaDist.textContent = `${dM >= 0 ? '+' : ''}${dM.toFixed(1)} m`;
        }
        if (gauntletDeltaCost) {
          const dC = res.delta_cost !== null && res.delta_cost !== undefined ? res.delta_cost : 0;
          gauntletDeltaCost.textContent = `${dC >= 0 ? '+' : ''}${dC.toFixed(1)} effort`;
        }
        if (gauntletDeltaTime) {
          gauntletDeltaTime.textContent = res.formatted_delta_travel_time || '+0 min';
        }
        if (gauntletRetention) {
          const ret = res.regret_ledger ? res.regret_ledger.retention_pct : 100;
          gauntletRetention.textContent = `${ret.toFixed(0)}% science`;
        }

        // Milestone 9H: Recovery Plan Card
        if (res.recovery_plan && res.recovery_plan.recovered_route) {
          lastRecoveryPlan = res.recovery_plan;
          if (recoveryPlanCard) {
            recoveryPlanCard.classList.remove('hidden');
            if (recoveryMarginGain) {
              recoveryMarginGain.textContent = `${res.recovery_plan.formatted_margin_recovered} margin recovered`;
            }
            if (recoveryPlanText) {
              recoveryPlanText.textContent = `${res.recovery_plan.strategy}. Action: ${res.recovery_plan.action_label}.`;
            }
            renderThreeWayRecovery(res.baseline_route, res.scenario_route, res.recovery_plan);
          }
        } else {
          lastRecoveryPlan = null;
          if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
        }

        const inspectorBody = inspectorPanel ? inspectorPanel.querySelector('.hud-inspector-body') : null;
        if (inspectorBody) {
          inspectorBody.scrollTop = inspectorBody.scrollHeight;
        }
      }

      // Draw Detour Polyline
      if (res.scenario_route && res.scenario_route.path_rc && res.scenario_route.path_rc.length > 0) {
        drawDetourRoute(res.scenario_route.path_rc);
      }

      // Draw Hazard Zone if blocked cells or hazard footprints are present
      if (res.scenario && (res.scenario.num_blocked_cells > 0 || (res.scenario.hazard_coordinates_3d && res.scenario.hazard_coordinates_3d.length > 0))) {
        highlightDisruptionZone(res.scenario, scenarioId);
      } else {
        clearDisruptionZone();
      }

      const deltaTxt = res.delta_distance_m !== null ? ` (Detour: ${res.delta_distance_m >= 0 ? '+' : ''}${res.delta_distance_m.toFixed(1)} m)` : '';
      setPlanningStatus(`Stress test applied: ${res.scenario.name}${deltaTxt}`, "calculating");
    } catch (err) {
      console.error('[MarsWalk Atlas] Stress test error:', err);
      setPlanningStatus(`Simulation error: ${err.message}`, "error");
    } finally {
      if (btnRunGauntlet) {
        btnRunGauntlet.disabled = false;
        btnRunGauntlet.innerHTML = '&#9881; Simulate Route Disruption';
      }
    }
  }

  // Milestone 9I: Side-by-Side Multi-Scenario Comparison Lab
  async function runScenarioComparisonLab(customScenarioIds = null) {
    if (currentViewMode !== 'jezero') {
      setPlanningStatus("Scenario Comparison Lab is confined to the surveyed Jezero Crater 20 m DTM.", "error");
      return;
    }
    if (!customStart || !customGoal) {
      setPlanningStatus("Please calculate a route before running comparison lab.", "error");
      return;
    }

    if (btnRunComparison) {
      btnRunComparison.disabled = true;
      btnRunComparison.innerHTML = '&#9881; Evaluating Scenario Comparison Batch...';
    }
    setPlanningStatus("Executing side-by-side scenario comparison batch against baseline mission...", "calculating");

    try {
      const payload = {
        start: { row: customStart.row, col: customStart.col },
        goal: { row: customGoal.row, col: customGoal.col },
        profile: currentProfile,
        vehicle_mode: currentVehicleMode,
      };

      if (inputExpeditionHours && inputExpeditionHours.value !== '') {
        const hVal = parseFloat(inputExpeditionHours.value);
        if (!isNaN(hVal) && hVal > 0) {
          payload.operational_limit_s = hVal * 3600;
        }
      }
      if (inputDwellMins && inputDwellMins.value !== '') {
        const dVal = parseFloat(inputDwellMins.value);
        if (!isNaN(dVal) && dVal >= 0) {
          payload.dwell_time_per_stop_s = dVal * 60;
        }
      }
      if (inputDelayMins && inputDelayMins.value !== '') {
        const delVal = parseFloat(inputDelayMins.value);
        if (!isNaN(delVal) && delVal >= 0) {
          payload.operational_delay_s = delVal * 60;
        }
      }
      if (inputMaxDistanceM && inputMaxDistanceM.value !== '') {
        const mVal = parseFloat(inputMaxDistanceM.value);
        if (!isNaN(mVal) && mVal > 0) {
          payload.max_distance_m = mVal;
        }
      }

      if (activeIntermediateStops && activeIntermediateStops.length > 0) {
        payload.stops = activeIntermediateStops.map(s => ({
          row: s.row,
          col: s.col,
          id: s.id,
          name: s.name,
          priority_score: s.priority_score
        }));
      }

      if (customScenarioIds && Array.isArray(customScenarioIds)) {
        payload.scenario_ids = customScenarioIds;
      }

      const resp = await fetch('/api/scenario_comparison', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const res = await resp.json();
      if (!resp.ok) throw new Error(res.error || res.message || `HTTP ${resp.status}`);

      lastComparisonResult = res;
      setSimulationStale(false);

      if (comparisonLabCard) comparisonLabCard.classList.remove('hidden');
      if (scenarioComparisonTableBody && res.scenarios) {
        scenarioComparisonTableBody.innerHTML = '';

        // Add Baseline row first for reference
        const b = res.baseline_route;
        const bRow = document.createElement('tr');
        bRow.className = 'baseline-row selected';
        bRow.innerHTML = `
          <td><strong>&bull; Baseline Plan</strong></td>
          <td>${b.distance_m.toFixed(0)} m</td>
          <td>—</td>
          <td>${b.timeline ? b.timeline.formatted_mission_time : b.formatted_travel_time}</td>
          <td>—</td>
          <td>100%</td>
          <td><span class="wp-badge" style="background:rgba(0,230,118,0.15); color:var(--status-green);">FEASIBLE</span></td>
        `;
        bRow.addEventListener('click', () => {
          scenarioComparisonTableBody.querySelectorAll('tr').forEach(r => r.classList.remove('selected'));
          bRow.classList.add('selected');
          if (comparisonActiveScenarioLabel) comparisonActiveScenarioLabel.textContent = 'Baseline';
          clearDetour();
          if (b.path_rc) drawLiveRoute(b.path_rc, currentProfile);
          if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
        });
        scenarioComparisonTableBody.appendChild(bRow);

        res.scenarios.forEach(sc => {
          const row = document.createElement('tr');
          const dM = sc.delta_distance_m !== null ? sc.delta_distance_m : 0;
          const detourTxt = `${dM >= 0 ? '+' : ''}${dM.toFixed(0)} m`;
          const sDist = sc.scenario_route ? sc.scenario_route.distance_m.toFixed(0) : '—';
          const totTime = sc.formatted_total_mission_time || '—';
          const dTime = sc.formatted_delta_travel_time || '+0 min';
          const ret = sc.regret_ledger ? `${sc.regret_ledger.retention_pct.toFixed(0)}%` : '100%';
          const isReachable = sc.is_scenario_reachable;
          const statusBadge = isReachable
            ? '<span class="wp-badge" style="background:rgba(0,230,118,0.15); color:var(--status-green);">FEASIBLE</span>'
            : '<span class="wp-badge" style="background:rgba(255,23,68,0.15); color:var(--status-red);">BLOCKED</span>';

          row.innerHTML = `
            <td>${sc.scenario.name}</td>
            <td>${sDist} m</td>
            <td style="color:${dM > 5 ? '#FFA726' : 'inherit'};">${detourTxt}</td>
            <td>${totTime}</td>
            <td style="color:${sc.delta_travel_time_s > 60 ? '#FFA726' : 'inherit'};">${dTime}</td>
            <td>${ret}</td>
            <td>${statusBadge}</td>
          `;

          row.addEventListener('click', () => {
            scenarioComparisonTableBody.querySelectorAll('tr').forEach(r => r.classList.remove('selected'));
            row.classList.add('selected');
            activeScenarioIdInLab = sc.scenario.id;
            if (comparisonActiveScenarioLabel) comparisonActiveScenarioLabel.textContent = sc.scenario.name;

            // Draw detour polyline
            if (sc.scenario_route && sc.scenario_route.path_rc) {
              drawDetourRoute(sc.scenario_route.path_rc);
            }

            // Draw hazard footprint
            highlightDisruptionZone(sc.scenario, sc.scenario.id);

            // Display recovery plan if available
            if (sc.recovery_plan && sc.recovery_plan.recovered_route) {
              lastRecoveryPlan = sc.recovery_plan;
              if (recoveryPlanCard) {
                recoveryPlanCard.classList.remove('hidden');
                if (recoveryMarginGain) recoveryMarginGain.textContent = `${sc.recovery_plan.formatted_margin_recovered} margin recovered`;
                if (recoveryPlanText) recoveryPlanText.textContent = `${sc.recovery_plan.strategy}. Action: ${sc.recovery_plan.action_label}.`;
                renderThreeWayRecovery(res.baseline_route, sc.scenario_route, sc.recovery_plan);
              }
            } else {
              if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
            }
          });

          scenarioComparisonTableBody.appendChild(row);
        });
      }

      setPlanningStatus(`COMPARISON COMPLETE: Evaluated ${res.scenarios.length} disruption scenarios against baseline.`, "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Comparison Lab error:', err);
      setPlanningStatus(`Comparison error: ${err.message}`, "error");
    } finally {
      if (btnRunComparison) {
        btnRunComparison.disabled = false;
        btnRunComparison.innerHTML = '&#9881; Run Multi-Scenario Comparison Lab';
      }
    }
  }

  // Milestone 9I: Scenario Sensitivity Parameter Sweep Analysis
  async function runScenarioSensitivity(scenarioId = null, paramName = null, paramVals = null) {
    if (currentViewMode !== 'jezero') {
      setPlanningStatus("Sensitivity sweep is confined to the surveyed Jezero Crater 20 m DTM.", "error");
      return;
    }
    if (!customStart || !customGoal) {
      setPlanningStatus("Please calculate a route before running sensitivity analysis.", "error");
      return;
    }

    const scenId = scenarioId || (sensitivityScenarioSelect ? sensitivityScenarioSelect.value : 'scen_corridor_rockfall');
    const pName = paramName || (sensitivityParamSelect ? sensitivityParamSelect.value : 'radius_m');

    if (btnRunSensitivity) {
      btnRunSensitivity.disabled = true;
      btnRunSensitivity.innerHTML = '&#9776; Evaluating Parameter Sweep...';
    }
    setPlanningStatus(`Executing sensitivity sweep for ${pName} on ${scenId}...`, "calculating");

    try {
      const payload = {
        start: { row: customStart.row, col: customStart.col },
        goal: { row: customGoal.row, col: customGoal.col },
        profile: currentProfile,
        vehicle_mode: currentVehicleMode,
        scenario_id: scenId,
        parameter_name: pName,
      };

      if (inputExpeditionHours && inputExpeditionHours.value !== '') {
        const hVal = parseFloat(inputExpeditionHours.value);
        if (!isNaN(hVal) && hVal > 0) {
          payload.operational_limit_s = hVal * 3600;
        }
      }
      if (inputDwellMins && inputDwellMins.value !== '') {
        const dVal = parseFloat(inputDwellMins.value);
        if (!isNaN(dVal) && dVal >= 0) {
          payload.dwell_time_per_stop_s = dVal * 60;
        }
      }
      if (inputDelayMins && inputDelayMins.value !== '') {
        const delVal = parseFloat(inputDelayMins.value);
        if (!isNaN(delVal) && delVal >= 0) {
          payload.operational_delay_s = delVal * 60;
        }
      }
      if (inputMaxDistanceM && inputMaxDistanceM.value !== '') {
        const mVal = parseFloat(inputMaxDistanceM.value);
        if (!isNaN(mVal) && mVal > 0) {
          payload.max_distance_m = mVal;
        }
      }

      if (activeIntermediateStops && activeIntermediateStops.length > 0) {
        payload.stops = activeIntermediateStops.map(s => ({
          row: s.row,
          col: s.col,
          id: s.id,
          name: s.name,
          priority_score: s.priority_score
        }));
      }

      if (paramVals && Array.isArray(paramVals)) {
        payload.parameter_values = paramVals;
      }

      const resp = await fetch('/api/scenario_sensitivity', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const res = await resp.json();
      if (!resp.ok) throw new Error(res.error || res.message || `HTTP ${resp.status}`);

      lastSensitivityResult = res;
      setSimulationStale(false);

      if (sensitivityResultCard) sensitivityResultCard.classList.remove('hidden');
      if (thSensitivityParam) {
        const labels = {
          radius_m: 'Radius (m)',
          cost_multiplier: 'Friction (×)',
          speed_multiplier: 'Speed (×)',
          operational_delay_s: 'Hold (s)',
          budget_reduction_pct: 'Budget Cut (%)',
        };
        thSensitivityParam.textContent = labels[pName] || pName;
      }

      if (sensitivityTableBody && res.records) {
        sensitivityTableBody.innerHTML = '';
        res.records.forEach(rec => {
          const row = document.createElement('tr');
          const dM = rec.delta_distance_m !== null ? rec.delta_distance_m : 0;
          const detourTxt = rec.delta_distance_m !== null ? `${dM >= 0 ? '+' : ''}${dM.toFixed(0)} m` : '—';
          const sDist = rec.distance_m !== null ? `${rec.distance_m.toFixed(0)} m` : '—';
          const dTime = rec.formatted_delta_travel_time || '+0 min';
          const totMin = Math.round(rec.total_mission_time_s / 60);
          const totFmt = rec.is_reachable ? (totMin < 60 ? `${totMin} min` : `${Math.floor(totMin / 60)}h ${totMin % 60}m`) : '—';
          const ret = `${rec.retention_pct.toFixed(0)}%`;
          const statusBadge = rec.is_reachable
            ? '<span class="wp-badge" style="background:rgba(0,230,118,0.15); color:var(--status-green);">FEASIBLE</span>'
            : '<span class="wp-badge" style="background:rgba(255,23,68,0.15); color:var(--status-red);">BLOCKED</span>';

          row.innerHTML = `
            <td><strong>${rec.parameter_value}</strong></td>
            <td>${sDist}</td>
            <td style="color:${dM > 5 ? '#FFA726' : 'inherit'};">${detourTxt}</td>
            <td>${totFmt}</td>
            <td>${dTime}</td>
            <td>${ret}</td>
            <td>${statusBadge}</td>
          `;
          sensitivityTableBody.appendChild(row);
        });
      }

      setPlanningStatus(`SENSITIVITY ANALYSIS COMPLETE: Evaluated ${res.num_evaluations} severity steps for ${pName}.`, "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Sensitivity sweep error:', err);
      setPlanningStatus(`Sensitivity error: ${err.message}`, "error");
    } finally {
      if (btnRunSensitivity) {
        btnRunSensitivity.disabled = false;
        btnRunSensitivity.innerHTML = '&#9776; Run Parameter Sensitivity Analysis';
      }
    }
  }

  // Milestone 9I: Reproducible Mission Briefing Export
  async function exportMissionBriefing(format = 'md') {
    setPlanningStatus("Exporting reproducible technical mission briefing...", "calculating");
    try {
      // Use authoritative activeBaselineRouteResult directly (eliminating client DOM text scraping)
      const bRoute = activeBaselineRouteResult || {
        schema_version: '1.0.0',
        input_fingerprint: activeMissionFingerprint || '',
        profile: currentProfile,
        vehicle_mode: currentVehicleMode,
        distance_m: activeRoutePath ? (parseFloat(statDistance ? statDistance.textContent.replace(/,/g, '') : '0') || 0) : 0,
        formatted_travel_time: statTravelTime ? statTravelTime.textContent : '—',
        visited_waypoint_ids: activeIntermediateStops.map(s => s.id),
        is_reachable: statFeasibility ? (statFeasibility.textContent === 'FEASIBLE' || statFeasibility.textContent === 'OVER BUDGET') : true,
        timeline: activeTimeline || {},
      };

      const payload = {
        schema_version: '1.0.0',
        baseline_route: bRoute,
        mission_snapshot: bRoute.mission_snapshot || undefined,
        mission_plan: bRoute,
        comparison_data: lastComparisonResult || {},
        sensitivity_data: lastSensitivityResult || {},
        recovery_data: lastRecoveryPlan || {},
      };

      const resp = await fetch('/api/export_briefing', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const res = await resp.json();
      if (!resp.ok) throw new Error(res.error || res.message || `HTTP ${resp.status}`);

      if (format === 'json') {
        const jsonStr = JSON.stringify(res.json_export, null, 2);
        const blob = new Blob([jsonStr], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `marswalk_mission_briefing_${Date.now()}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        setPlanningStatus("BRIEFING DOWNLOADED: marswalk_mission_briefing.json", "success");
      } else {
        const mdStr = res.markdown_briefing;
        const blob = new Blob([mdStr], { type: 'text/markdown' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `marswalk_mission_briefing_${Date.now()}.md`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        setPlanningStatus("BRIEFING DOWNLOADED: marswalk_mission_briefing.md", "success");
      }
    } catch (err) {
      console.error('[MarsWalk Atlas] Export briefing error:', err);
      setPlanningStatus(`Export error: ${err.message}`, "error");
    }
  }

  // Milestone 9T/9U: Export Auditable Judge-Ready Decision Pack ZIP
  async function exportDecisionPack(options = {}) {
    const exportType = options.exportType || 'auto';

    if (exportType === 'contingency') {
      const hasActiveScenario = Boolean(activeContingencyResult || lastGauntletResult);
      const hasEnabledEvents = stagedContingencyEvents && stagedContingencyEvents.some(e => e.enabled);
      if (!hasActiveScenario && !hasEnabledEvents) {
        setPlanningStatus("Cannot export contingency pack: please stage and simulate a contingency event first.", "warning");
        return;
      }
      if (isContingencyStale) {
        setPlanningStatus("Contingency is stale: please re-simulate contingency before exporting.", "warning");
        return;
      }
    }

    const typeLabel = exportType === 'contingency' ? 'Contingency ' : (exportType === 'baseline' ? 'Baseline ' : '');
    setPlanningStatus(`Assembling judge-ready ${typeLabel}Decision Pack (.zip)...`, "calculating");
    try {
      if (isContingencyStale && exportType !== 'contingency') {
        console.warn('[MarsWalk] Contingency is stale; suppressing stale contingency in baseline pack.');
      }

      const bRoute = activeBaselineRouteResult || {
        schema_version: '1.0.0',
        input_fingerprint: activeMissionFingerprint || '',
        profile: currentProfile,
        vehicle_mode: currentVehicleMode,
        distance_m: activeRoutePath ? (parseFloat(statDistance ? statDistance.textContent.replace(/,/g, '') : '0') || 0) : 0,
        formatted_travel_time: statTravelTime ? statTravelTime.textContent : '-',
        visited_waypoint_ids: activeIntermediateStops.map(s => s.id),
        is_reachable: statFeasibility ? (statFeasibility.textContent === 'FEASIBLE' || statFeasibility.textContent === 'OVER BUDGET') : true,
        timeline: activeTimeline || {},
      };

      const includeContingency = (exportType !== 'baseline') && !isContingencyStale;

      const payload = {
        schema_version: '1.0.0',
        export_type: exportType,
        baseline_route: bRoute,
        mission_input: {
          start: { row: customStart.row, col: customStart.col },
          goal: { row: customGoal.row, col: customGoal.col },
          stops: activeIntermediateStops.map(s => ({
            id: s.id,
            row: s.row,
            col: s.col,
            priority_score: s.priority_score,
            dwell_time_s: s.dwell_time_s || 300
          })),
          profile: currentProfile,
          vehicle_mode: currentVehicleMode,
          speed_multiplier: 1.0,
          max_distance_m: (typeof maxDistanceBudgetM !== 'undefined' ? maxDistanceBudgetM : 15000),
          max_duration_s: (typeof maxDurationBudgetS !== 'undefined' ? maxDurationBudgetS : 28800)
        },
        scenario_result: includeContingency ? (activeContingencyResult || lastGauntletResult || undefined) : undefined,
        custom_events: (includeContingency && stagedContingencyEvents && stagedContingencyEvents.length > 0)
          ? stagedContingencyEvents.filter(e => e.enabled)
          : undefined
      };

      const resp = await fetch('/api/export_decision_pack', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.message || `HTTP ${resp.status}`);
      }

      const blob = await resp.blob();
      const contentDisp = resp.headers.get('Content-Disposition') || '';
      let filename = `marswalk_decision_pack_${Date.now()}.zip`;
      const match = contentDisp.match(/filename="?([^";]+)"?/);
      if (match && match[1]) {
        filename = match[1];
      }

      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      setPlanningStatus(`DECISION PACK DOWNLOADED: ${filename} (Ready for independent audit)`, "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Export decision pack error:', err);
      setPlanningStatus(`Decision pack error: ${err.message}`, "error");
    }
  }

  // ==========================================================================
  // Milestone 9V: Mission Design Lab & Autonomous Tour Optimizer
  // ==========================================================================

  function initMissionDesignLab() {
    if (!missionData || !missionData.waypoints) return;
    mdlSelectedTargetIds.clear();
    // Default to candidate targets excluding departure and destination
    missionData.waypoints.forEach(w => {
      if (w.id !== 'octavia_butler_landing' && w.id !== 'delta_rim_overlook') {
        mdlSelectedTargetIds.add(w.id);
      }
    });
    renderMdlTargetPills();
  }

  function renderMdlTargetPills() {
    if (!mdlTargetPillsContainer || !missionData || !missionData.waypoints) return;
    mdlTargetPillsContainer.innerHTML = '';

    missionData.waypoints.forEach(w => {
      const isSelected = mdlSelectedTargetIds.has(w.id);
      const pill = document.createElement('div');
      pill.className = `mdl-target-pill ${isSelected ? 'selected' : ''}`;
      pill.dataset.targetId = w.id;
      pill.title = `${w.name} (${w.priority_score || 50} pts) - ${w.geological_context || ''}`;
      pill.innerHTML = `
        <span>${w.name}</span>
        <span class="score-badge">${w.priority_score || 50}p</span>
      `;
      pill.addEventListener('click', () => {
        if (mdlSelectedTargetIds.has(w.id)) {
          mdlSelectedTargetIds.delete(w.id);
          pill.classList.remove('selected');
        } else {
          mdlSelectedTargetIds.add(w.id);
          pill.classList.add('selected');
        }
        markMdlStale();
      });
      mdlTargetPillsContainer.appendChild(pill);
    });
  }

  function markMdlStale() {
    isMdlStale = true;
    if (mdlStaleBanner) mdlStaleBanner.classList.remove('hidden');
    markRobustnessStale();
  }

  async function generateMissionAlternatives() {
    if (!customStart || !customGoal) {
      setPlanningStatus("Please specify valid departure and destination endpoints.", "warning");
      return;
    }
    if (mdlSelectedTargetIds.size === 0) {
      setPlanningStatus("Please select at least 1 candidate target for optimization.", "warning");
      return;
    }

    setPlanningStatus("Mission Design Lab: Searching candidate science tours...", "calculating");
    if (btnGenerateSorties) {
      btnGenerateSorties.disabled = true;
      btnGenerateSorties.innerHTML = '&#8987; Optimizing Candidate Sorties...';
    }

    try {
      const opHours = parseFloat(inputExpeditionHours ? inputExpeditionHours.value : 8.0) || 8.0;
      const dwellMins = parseFloat(inputDwellMins ? inputDwellMins.value : 15.0) || 15.0;
      const delayMins = parseFloat(inputDelayMins ? inputDelayMins.value : 0.0) || 0.0;
      const maxDistM = (inputMaxDistanceM && inputMaxDistanceM.value) ? parseFloat(inputMaxDistanceM.value) : undefined;
      const maxStops = parseInt(mdlMaxStops ? mdlMaxStops.value : 3) || 3;
      const objectiveFocus = mdlObjective ? mdlObjective.value : 'balanced';

      const payload = {
        start: { row: customStart.row, col: customStart.col },
        goal: { row: customGoal.row, col: customGoal.col },
        candidate_waypoint_ids: Array.from(mdlSelectedTargetIds),
        max_stops: maxStops,
        profile: currentProfile,
        vehicle_mode: currentVehicleMode,
        operational_limit_s: opHours * 3600.0,
        dwell_time_per_stop_s: dwellMins * 60.0,
        operational_delay_s: delayMins * 60.0,
        max_distance_m: maxDistM,
        beam_width: 14,
      };

      const resp = await fetch('/api/mission/optimize', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!resp.ok) {
        const errJson = await resp.json().catch(() => ({}));
        throw new Error(errJson.detail || errJson.message || `HTTP ${resp.status}`);
      }

      const report = await resp.json();
      mdlActiveReport = report;
      isMdlStale = false;
      if (mdlStaleBanner) mdlStaleBanner.classList.add('hidden');

      renderMdlCandidates(report, objectiveFocus);
      setPlanningStatus(`TOUR OPTIMIZATION COMPLETE: Evaluated ${report.candidates_evaluated} candidates in ${report.execution_time_ms.toFixed(0)} ms.`, "success");
    } catch (err) {
      console.error('[MarsWalk Atlas] Mission optimization error:', err);
      setPlanningStatus(`Optimization error: ${err.message}`, "error");
    } finally {
      if (btnGenerateSorties) {
        btnGenerateSorties.disabled = false;
        btnGenerateSorties.innerHTML = '&#9733; GENERATE MISSION ALTERNATIVES';
      }
    }
  }

  function renderMdlCandidates(report, objectiveFocus = 'balanced') {
    if (!mdlResultsContainer || !mdlCandidateChips) return;
    mdlResultsContainer.classList.remove('hidden');
    mdlCandidateChips.innerHTML = '';

    if (mdlEvaluatedCountBadge) {
      mdlEvaluatedCountBadge.textContent = `${report.candidates_evaluated} EVALUATED (${report.execution_time_ms.toFixed(0)}ms)`;
    }

    let initialChoice = report.recommended_sortie;
    if (objectiveFocus === 'science_priority' && report.science_champion) {
      initialChoice = report.science_champion;
    } else if (objectiveFocus === 'time_efficiency' && report.time_champion) {
      initialChoice = report.time_champion;
    } else if (report.balanced_champion) {
      initialChoice = report.balanced_champion;
    }

    const candidateList = report.all_candidates || [];
    candidateList.forEach(cand => {
      const card = document.createElement('div');
      card.className = `mdl-candidate-card ${cand.id === (initialChoice ? initialChoice.id : '') ? 'active-card' : ''}`;
      card.dataset.candidateId = cand.id;

      let badgeColor = 'var(--telemetry-cyan)';
      let badgeBg = 'rgba(0,229,255,0.15)';
      let badgeText = cand.objective.replace(/_/g, ' ').toUpperCase();

      if (cand.objective === 'science_priority') {
        badgeColor = 'var(--status-green)';
        badgeBg = 'rgba(0,230,118,0.15)';
        badgeText = 'MAX SCIENCE';
      } else if (cand.objective === 'time_efficiency') {
        badgeColor = '#FFD54F';
        badgeBg = 'rgba(255,213,79,0.15)';
        badgeText = 'FASTEST';
      } else if (cand.objective === 'balanced') {
        badgeColor = 'var(--telemetry-cyan)';
        badgeBg = 'rgba(0,229,255,0.15)';
        badgeText = 'BALANCED';
      } else if (cand.objective === 'direct_baseline') {
        badgeColor = 'var(--text-tertiary)';
        badgeBg = 'rgba(255,255,255,0.08)';
        badgeText = 'BASELINE';
      }

      const stopsSummary = cand.stop_names.length > 0 ? cand.stop_names.join(' &rarr; ') : 'Direct (0 stops)';
      card.innerHTML = `
        <div class="mdl-candidate-title-row">
          <span class="mdl-candidate-title">${cand.title}</span>
          <span class="wp-badge" style="background:${badgeBg}; color:${badgeColor}; font-size:7.5px;">${badgeText}</span>
        </div>
        <div style="font-size:8.5px; color:var(--text-secondary); margin:2px 0;">
          ${stopsSummary}
        </div>
        <div class="mdl-candidate-meta">
          <span>&#9733; <strong>${cand.science_score}</strong> pts</span>
          <span>&#8644; <strong>${cand.distance_m.toLocaleString()}</strong> m</span>
          <span>&#128338; <strong>${cand.formatted_mission_time}</strong></span>
          <span style="color:${cand.is_feasible ? 'var(--status-green)' : 'var(--status-red)'}; font-weight:600;">
            ${cand.is_feasible ? 'FEASIBLE' : 'OVER BUDGET'}
          </span>
        </div>
      `;

      card.addEventListener('click', () => {
        document.querySelectorAll('.mdl-candidate-card').forEach(c => c.classList.remove('active-card'));
        card.classList.add('active-card');
        selectMdlCandidate(cand, { drawPreview: true });
      });

      mdlCandidateChips.appendChild(card);
    });

    if (initialChoice) {
      selectMdlCandidate(initialChoice, { drawPreview: true });
    }
  }

  function selectMdlCandidate(sortie, options = { drawPreview: true }) {
    if (!sortie) return;
    mdlSelectedSortie = sortie;

    if (mdlSelectedCandidateCard) {
      mdlSelectedCandidateCard.classList.remove('hidden');
      if (mdlSelectedTitle) mdlSelectedTitle.textContent = sortie.title;
      if (mdlSelectedBadge) {
        mdlSelectedBadge.textContent = sortie.objective.replace(/_/g, ' ').toUpperCase();
        mdlSelectedBadge.style.color = sortie.is_feasible ? 'var(--status-green)' : 'var(--status-red)';
      }
      if (mdlSelectedRationale) mdlSelectedRationale.textContent = sortie.tradeoff_rationale;
      if (mdlStatScience) mdlStatScience.textContent = `${sortie.science_score.toFixed(0)} pts`;
      if (mdlStatDistance) mdlStatDistance.textContent = `${sortie.distance_m.toLocaleString()} m`;
      if (mdlStatTime) mdlStatTime.textContent = sortie.formatted_mission_time;
      if (mdlStatMargin) mdlStatMargin.textContent = sortie.formatted_margin;
    }

    if (options.drawPreview && sortie.path_rc && sortie.path_rc.length >= 2) {
      drawDetourRoute(sortie.path_rc);
    }
  }

  function applyMdlSortieToActiveMission(sortie) {
    if (!sortie || !missionData || !missionData.waypoints) return;

    activeIntermediateStops = [];
    const wpMap = {};
    missionData.waypoints.forEach(w => { wpMap[w.id] = w; });

    sortie.stop_ids.forEach(sid => {
      const w = wpMap[sid];
      if (w) {
        activeIntermediateStops.push({
          id: w.id,
          name: w.name,
          row: (w.rc && w.rc[0] !== undefined) ? w.rc[0] : (w.row !== undefined ? w.row : 100),
          col: (w.rc && w.rc[1] !== undefined) ? w.rc[1] : (w.col !== undefined ? w.col : 100),
          priority_score: w.priority_score,
          dwell_time_s: (sortie.dwell_time_s / Math.max(1, sortie.num_stops)) || 900.0,
        });
      }
    });

    renderActiveStopsList();
    populateAddStopDropdown();
    activeRoutePath = sortie.path_rc;

    activeBaselineRouteResult = {
      schema_version: '1.0.0',
      input_fingerprint: mdlActiveReport ? mdlActiveReport.computation_fingerprint : '',
      profile: sortie.profile,
      vehicle_mode: sortie.vehicle_mode,
      distance_m: sortie.distance_m,
      formatted_travel_time: sortie.formatted_travel_time,
      visited_waypoint_ids: sortie.stop_ids,
      is_reachable: sortie.is_reachable,
      is_budget_feasible: sortie.is_budget_feasible,
      timeline: {
        total_traverse_time_s: sortie.travel_time_s,
        total_dwell_time_s: sortie.dwell_time_s,
        total_mission_time_s: sortie.total_mission_time_s,
        operational_limit_s: sortie.operational_limit_s,
        remaining_margin_s: sortie.time_margin_s,
        is_within_limit: sortie.is_budget_feasible,
        formatted_traverse_time: sortie.formatted_travel_time,
        formatted_dwell_time: sortie.formatted_dwell_time,
        formatted_mission_time: sortie.formatted_mission_time,
        formatted_remaining_margin: sortie.formatted_margin,
      },
    };

    drawLiveRoute(activeRoutePath, currentProfile);
    clearDetour();
    updatePlanningMarkers();

    if (statDistance) statDistance.innerHTML = `${sortie.distance_m.toLocaleString()} <span class="unit">m</span>`;
    if (statEffort) statEffort.innerHTML = `${sortie.terrain_cost.toLocaleString()} <span class="unit">flat-m</span>`;
    if (statClimb) statClimb.innerHTML = `${sortie.cumulative_climb_m.toFixed(1)} <span class="unit">m</span>`;
    if (statSlope) statSlope.innerHTML = `${sortie.max_slope_deg.toFixed(1)} <span class="unit">&deg;</span>`;
    if (statScience) statScience.innerHTML = `${sortie.science_score.toFixed(1)} <span class="unit">pts</span>`;
    if (statTravelTime) statTravelTime.textContent = sortie.formatted_travel_time;

    if (timelineTraverseTime) timelineTraverseTime.textContent = sortie.formatted_travel_time;
    if (timelineDwellTime) timelineDwellTime.textContent = sortie.formatted_dwell_time;
    if (timelineTotalTime) timelineTotalTime.textContent = sortie.formatted_mission_time;
    if (statTimelineMarginBadge) {
      statTimelineMarginBadge.textContent = `MARGIN: ${sortie.formatted_margin}`;
      statTimelineMarginBadge.className = `timeline-margin-badge ${sortie.is_budget_feasible ? 'margin-ok' : 'margin-warning'}`;
    }

    setPlanningStatus(`APPLIED SORTIE: ${sortie.title} (${sortie.stop_ids.length} stops, ${sortie.science_score} pts) active in workspace.`, "success");
    setUnsavedChanges(true);
  }

  // Reset Planning to Default Endpoints
  function resetPlanning() {
    setPlanningMode('none');
    activeIntermediateStops = [];
    renderActiveStopsList();
    populateAddStopDropdown();
    customStart = { row: 117, col: 157, name: 'Octavia Landing (117, 157)' };
    customGoal = { row: 66, col: 128, name: 'Delta Rim Overlook (66, 128)' };
    if (startPointVal) startPointVal.textContent = customStart.name;
    if (goalPointVal) goalPointVal.textContent = customGoal.name;
    updatePlanningMarkers();
    clearDetour();
    if (gauntletResultCard) gauntletResultCard.classList.add('hidden');

    if (missionData && missionData.routes && missionData.routes[currentProfile]) {
      activeRoutePath = missionData.routes[currentProfile].path_rc;
      drawLiveRoute(activeRoutePath, currentProfile);
      updateRouteTelemetry(currentProfile);
      setPlanningStatus("RESET: Restored default landing site and destination landmark.", "ready");
    }
  }

  // Cancel active camera flight tween immediately without ghost callbacks
  function cancelCurrentFlight() {
    flightGeneration++;
    if (flightState) {
      flightState.active = false;
      flightState.onComplete = null;
    }
    if (controls) controls.enabled = true;
  }

  // 4. Spherical Great-Circle SLERP Camera Navigator
  function startSphericalFlight(targetLatDeg, targetLonDeg, targetAltitude = 2200, duration = 2400, onComplete = null) {
    if (!camera || !controls) return;

    const thisFlightGen = ++flightGeneration;

    // Account for current globe rotation so camera flies directly in front of the landmark
    const globeAngle = marsGlobeGroup ? marsGlobeGroup.rotation.y : 0;
    const baseTargetPos = latLonToSpherePos(targetLatDeg, targetLonDeg, 1.0);
    const targetDir = baseTargetPos.clone().applyAxisAngle(new THREE.Vector3(0, 1, 0), globeAngle).normalize();

    const startPos = camera.position.clone();
    const startRadius = startPos.length();
    const targetRadius = GLOBE_RADIUS + targetAltitude;
    const startDir = startPos.clone().normalize();

    // Spherical angular separation
    const dot = Math.max(-1.0, Math.min(1.0, startDir.dot(targetDir)));
    const angularDistance = Math.acos(dot);

    // Apex altitude parabolic arc (elevates camera above chord to prevent clipping)
    const apexAltitude = angularDistance > 0.08 ? Math.min(1300, 480 * angularDistance) : 0;

    flightState = {
      active: true,
      generation: thisFlightGen,
      mode: 'spherical',
      startTime: performance.now(),
      duration: duration,
      startPos: startPos,
      targetPos: targetDir.clone().multiplyScalar(targetRadius),
      startLookAt: controls.target.clone(),
      targetLookAt: new THREE.Vector3(0, 0, 0),
      startDir: startDir,
      targetDir: targetDir,
      startRadius: startRadius,
      targetRadius: targetRadius,
      angularDistance: angularDistance,
      apexAltitude: apexAltitude,
      onComplete: onComplete
    };

    controls.enabled = false;
  }

  // Linear / Surface Camera Flight (for Jezero surface workstation)
  function startSurfaceFlight(targetPos, targetLookAt, duration = 2000, onComplete = null) {
    if (!camera || !controls) return;

    const thisFlightGen = ++flightGeneration;

    flightState = {
      active: true,
      generation: thisFlightGen,
      mode: 'surface',
      startTime: performance.now(),
      duration: duration,
      startPos: camera.position.clone(),
      targetPos: targetPos.clone(),
      startLookAt: controls.target.clone(),
      targetLookAt: targetLookAt.clone(),
      startDir: new THREE.Vector3(),
      targetDir: new THREE.Vector3(),
      startRadius: 0,
      targetRadius: 0,
      angularDistance: 0,
      apexAltitude: 0,
      onComplete: onComplete
    };

    controls.enabled = false;
  }

  // Update Flight Controller on Every Animation Frame
  function updateCameraFlight(now) {
    if (!flightState.active) return;

    const elapsed = now - flightState.startTime;
    const t = Math.min(1.0, elapsed / flightState.duration);
    // Smooth cubic ease-in-out
    const ease = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

    if (flightState.mode === 'spherical') {
      const ang = flightState.angularDistance;
      let curDir;
      if (ang > 0.001) {
        const sinAng = Math.sin(ang);
        const weightA = Math.sin((1 - ease) * ang) / sinAng;
        const weightB = Math.sin(ease * ang) / sinAng;
        curDir = flightState.startDir.clone().multiplyScalar(weightA)
          .add(flightState.targetDir.clone().multiplyScalar(weightB)).normalize();
      } else {
        curDir = flightState.targetDir.clone();
      }

      // Parabolic apex altitude curve
      const arcOffset = 4.0 * ease * (1.0 - ease) * flightState.apexAltitude;
      const curRadius = flightState.startRadius + (flightState.targetRadius - flightState.startRadius) * ease + arcOffset;

      camera.position.copy(curDir.multiplyScalar(curRadius));
      controls.target.lerpVectors(flightState.startLookAt, flightState.targetLookAt, ease);
    } else {
      camera.position.lerpVectors(flightState.startPos, flightState.targetPos, ease);
      controls.target.lerpVectors(flightState.startLookAt, flightState.targetLookAt, ease);
    }

    if (t >= 1.0) {
      const activeGen = flightState.generation;
      const onCompleteCb = flightState.onComplete;
      flightState.active = false;
      flightState.onComplete = null;
      controls.enabled = true;
      camera.position.copy(flightState.targetPos);
      controls.target.copy(flightState.targetLookAt);
      if (onCompleteCb && activeGen === flightGeneration) {
        onCompleteCb();
      }
    }
  }

  // Switch to Orbit (Space) View
  function setOrbitView(animated = true) {
    cancelCurrentFlight();
    currentViewMode = 'orbit';
    selectedPlace = null;
    if (locationCard) locationCard.classList.add('hidden');
    if (viewModeSelect) viewModeSelect.value = 'orbit';

    // Show globe, hide surface mesh workstation
    if (marsGlobeGroup) marsGlobeGroup.visible = true;
    if (jezeroSurfaceGroup) jezeroSurfaceGroup.visible = false;
    if (labelsOverlay) labelsOverlay.style.display = 'block';
    if (jezeroLabelsOverlay) jezeroLabelsOverlay.style.display = 'none';
    if (cockpitHudOverlay) cockpitHudOverlay.classList.add('hidden');

    // In Orbit view, hide the surface planning inspector, terrain legend and waypoint search
    if (inspectorPanel) inspectorPanel.classList.add('hidden');
    if (terrainLegend) terrainLegend.classList.add('hidden');
    if (coverageNotice) coverageNotice.classList.add('hidden');
    if (waypointSelect) waypointSelect.classList.add('hidden');
    if (waypointModal) waypointModal.classList.add('hidden');
    if (btnFlyJezero) btnFlyJezero.classList.remove('hidden');

    clearRegionalOverlay();

    if (animated) {
      setNavigationState('camera-flight', 'transitioning to orbit view');
      startSphericalFlight(0, 0, 2600, 2000, () => {
        controls.target.set(0, 0, 0);
        updateLiveTelemetry(0, 0, '8,450 km', '-20°');
        updateImageryAndElevationTelemetry(0, 0);
        setNavigationState('idle-orbit', 'restored global orbit view');
      });
    } else {
      camera.position.set(0, 900, 2600);
      controls.target.set(0, 0, 0);
      updateLiveTelemetry(0, 0, '8,450 km', '-20°');
      updateImageryAndElevationTelemetry(0, 0);
      setNavigationState('idle-orbit', 'initial orbit view');
    }
  }

  // Set / Fly to Jezero Surface Workstation
  function setJezeroView(animated = true) {
    currentViewMode = 'jezero';
    selectedPlace = null;
    if (viewModeSelect) viewModeSelect.value = 'jezero';
    setNavigationState('jezero-workstation', 'entering 3D surface mesh workstation');

    clearRegionalOverlay();

    if (labelsOverlay) {
      labelsOverlay.style.display = 'none';
      pooledLabelElements.forEach(p => { p.dom.style.display = 'none'; p.active = false; });
    }
    if (coverageNotice) coverageNotice.classList.add('hidden');
    if (locationCard) locationCard.classList.add('hidden');

    // Show surface mesh workstation, hide globe
    if (marsGlobeGroup) marsGlobeGroup.visible = false;
    if (jezeroSurfaceGroup) jezeroSurfaceGroup.visible = true;
    if (jezeroLabelsOverlay) jezeroLabelsOverlay.style.display = 'block';

    // Show surface planning inspector and waypoint select; hide Fly Jezero CTA
    if (inspectorPanel) inspectorPanel.classList.remove('hidden');
    if (waypointSelect) waypointSelect.classList.remove('hidden');
    if (btnFlyJezero) btnFlyJezero.classList.add('hidden');

    // Milestone 9N: Default to all waypoints visible upon entering Jezero exploration
    setWaypointVisibilityMode('all');

    const surfaceEntryPos = new THREE.Vector3(0, 2400, 3200);
    const surfaceTargetLookAt = new THREE.Vector3(0, 0, 0);

    if (animated) {
      startSurfaceFlight(surfaceEntryPos, surfaceTargetLookAt, 1600, () => {
        controls.target.set(0, 0, 0);
        updateLiveTelemetry(JEZERO_LON, JEZERO_LAT, '3.8 km', '-35°');
        updateImageryAndElevationTelemetry(JEZERO_LON, JEZERO_LAT);
        updateTerrainLegend(currentTerrainTexture);
      });
    } else {
      camera.position.copy(surfaceEntryPos);
      controls.target.set(0, 0, 0);
      updateLiveTelemetry(JEZERO_LON, JEZERO_LAT, '3.8 km', '-35°');
      updateImageryAndElevationTelemetry(JEZERO_LON, JEZERO_LAT);
      updateTerrainLegend(currentTerrainTexture);
    }
  }

  function flyToJezeroView() {
    cancelCurrentFlight();
    if (currentViewMode === 'orbit') {
      startSphericalFlight(JEZERO_LAT, JEZERO_LON, 1200, 1600, () => {
        setJezeroView(true);
      });
    } else {
      setJezeroView(true);
    }
  }

  // Fly Camera to Specific Waypoint in Surface Workstation
  function focusOnWaypoint(wp) {
    if (!wp) return;
    if (currentViewMode !== 'jezero') {
      if (marsGlobeGroup) marsGlobeGroup.visible = false;
      if (jezeroSurfaceGroup) jezeroSurfaceGroup.visible = true;
      if (labelsOverlay) labelsOverlay.style.display = 'none';
      if (coverageNotice) coverageNotice.classList.add('hidden');
      currentViewMode = 'jezero';
      if (viewModeSelect) viewModeSelect.value = 'jezero';
    }

    const pos = rcToLocalPos(wp.row, wp.col, wp.elevation_m, currentExaggeration);
    const targetCamPos = new THREE.Vector3(pos.x, pos.y + 700, pos.z + 1000);

    startSurfaceFlight(targetCamPos, pos, 1800, () => {
      controls.target.copy(pos);
    });

    updateLiveTelemetry(wp.lon_deg, wp.lat_deg, '1.2 km', '-45°');
  }

  // Update Live Telemetry Bar
  function updateLiveTelemetry(lon, lat, alt, pitch) {
    if (lon !== null && lon !== undefined && Number.isFinite(lon)) {
      const lonDir = lon >= 0 ? 'E' : 'W';
      if (telemetryLon) telemetryLon.textContent = `${Math.abs(lon).toFixed(3)}° ${lonDir}`;
    } else {
      if (telemetryLon) telemetryLon.textContent = '—';
    }
    if (lat !== null && lat !== undefined && Number.isFinite(lat)) {
      const latDir = lat >= 0 ? 'N' : 'S';
      if (telemetryLat) telemetryLat.textContent = `${Math.abs(lat).toFixed(3)}° ${latDir}`;
    } else {
      if (telemetryLat) telemetryLat.textContent = '—';
    }
    if (telemetryAlt && alt !== undefined) telemetryAlt.textContent = alt;
    if (telemetryPitch && pitch !== undefined) telemetryPitch.textContent = pitch;
    if (telemetryFov && camera) telemetryFov.textContent = `${camera.fov.toFixed(0)}°`;
  }

  // 5. Cartographic Labels Object Pool (Orbit Globe)
  function initLabelsPool() {
    if (!labelsOverlay) return;
    labelsOverlay.innerHTML = '';
    pooledLabelElements.length = 0;

    for (let i = 0; i < LABEL_POOL_SIZE; i++) {
      const el = document.createElement('div');
      el.className = 'planet-label';
      el.style.display = 'none';

      const dot = document.createElement('span');
      dot.className = 'label-pin';

      const nameSpan = document.createElement('span');
      nameSpan.className = 'label-name';

      const subSpan = document.createElement('span');
      subSpan.className = 'label-sub';

      el.appendChild(dot);
      el.appendChild(nameSpan);
      el.appendChild(subSpan);

      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const pid = el.dataset.placeId;
        if (pid) {
          const place = placesById.get(pid);
          if (place) {
            selectAndFocusPlace(place);
          }
        }
      });

      labelsOverlay.appendChild(el);
      pooledLabelElements.push({
        dom: el,
        dot: dot,
        name: nameSpan,
        sub: subSpan,
        placeId: null,
        active: false
      });
    }
  }

  // 5b. Local Jezero Surface Workstation Waypoint Labels
  function initJezeroLabels() {
    if (!jezeroLabelsOverlay || !missionData) return;
    jezeroLabelsOverlay.innerHTML = '';
    jezeroWaypointLabelElements.clear();

    missionData.waypoints.forEach(wp => {
      const el = document.createElement('div');
      const isLanding = wp.type === 'landing_site';
      el.className = `jezero-waypoint-label ${isLanding ? 'landing' : ''}`;
      el.style.display = 'none';

      const pin = document.createElement('span');
      pin.className = 'wp-label-pin';

      const nameSpan = document.createElement('span');
      nameSpan.className = 'wp-label-name';
      nameSpan.textContent = wp.name;

      const subSpan = document.createElement('span');
      subSpan.className = 'wp-label-sub';
      subSpan.textContent = isLanding ? 'LANDING SITE' : `${wp.priority_score} PTS`;

      el.appendChild(pin);
      el.appendChild(nameSpan);
      el.appendChild(subSpan);

      el.addEventListener('click', (e) => {
        e.stopPropagation();
        openWaypointModal(wp);
        focusOnWaypoint(wp);
      });

      jezeroLabelsOverlay.appendChild(el);
      jezeroWaypointLabelElements.set(wp.id, {
        dom: el,
        waypoint: wp
      });
    });
  }

  function updateJezeroLabels() {
    if (currentViewMode !== 'jezero' || !camera || !jezeroLabelsOverlay || !missionData) {
      if (jezeroLabelsOverlay) jezeroLabelsOverlay.style.display = 'none';
      return;
    }

    jezeroLabelsOverlay.style.display = 'block';
    const width = window.innerWidth;
    const height = window.innerHeight;

    const projScreenMatrix = new THREE.Matrix4();
    projScreenMatrix.multiplyMatrices(camera.projectionMatrix, camera.matrixWorldInverse);

    const showAll = (waypointVisibilityMode === 'all');

    missionData.waypoints.forEach(wp => {
      const item = jezeroWaypointLabelElements.get(wp.id);
      if (!item) return;

      const isStart = customStart && (wp.row === customStart.row && wp.col === customStart.col);
      const isGoal = customGoal && (wp.row === customGoal.row && wp.col === customGoal.col);
      const isStop = activeIntermediateStops && activeIntermediateStops.some(s => s.id === wp.id || (s.row === wp.row && s.col === wp.col));
      const isMissionParticipant = Boolean(isStart || isGoal || isStop);

      if (!showAll && !isMissionParticipant) {
        item.dom.style.display = 'none';
        return;
      }

      // Dynamic styling classes for Start (green), Goal (cyan), Stop (amber), or default catalog
      item.dom.classList.toggle('is-start', Boolean(isStart));
      item.dom.classList.toggle('is-goal', Boolean(isGoal));
      item.dom.classList.toggle('is-stop', Boolean(isStop));

      // Dynamic sub-badge label text
      const subSpan = item.dom.querySelector('.wp-label-sub');
      if (subSpan) {
        if (isStart) subSpan.textContent = 'DEPARTURE';
        else if (isGoal) subSpan.textContent = 'DESTINATION';
        else if (isStop) subSpan.textContent = 'RESEARCH STOP';
        else if (wp.type === 'landing_site') subSpan.textContent = 'LANDING SITE';
        else subSpan.textContent = `${wp.priority_score} PTS`;
      }

      const localPos = rcToLocalPos(wp.row, wp.col, wp.elevation_m, currentExaggeration);
      // Anchor label badge above vertical beacon head
      const worldPos = localPos.clone();
      worldPos.y += 85;

      const projected = worldPos.clone().applyMatrix4(projScreenMatrix);

      // Frustum & depth check
      if (projected.z >= 1.0 || projected.z < -1.0 || projected.x < -1.05 || projected.x > 1.05 || projected.y < -1.05 || projected.y > 1.05) {
        item.dom.style.display = 'none';
        return;
      }

      const sx = (projected.x * 0.5 + 0.5) * width;
      const sy = (-(projected.y * 0.5) + 0.5) * height;

      // Avoid top HUD bar
      if (sy < 80) {
        item.dom.style.display = 'none';
        return;
      }

      // Avoid open inspector panel bottom right
      const isInspectorOpen = inspectorPanel && (!inspectorPanel.querySelector('.hud-inspector-body') || inspectorPanel.querySelector('.hud-inspector-body').style.display !== 'none');
      if (isInspectorOpen && sx > width - 390 && sy > height - 560) {
        item.dom.style.display = 'none';
        return;
      }

      item.dom.style.transform = `translate3d(${Math.round(sx)}px, ${Math.round(sy)}px, 0)`;
      item.dom.style.display = 'flex';
    });
  }

  // 6. Progressive Dynamic Map Label Projection & Decluttering
  function updateMapLabels() {
    if (isLandingActive || document.body.classList.contains('landing-active') || !placeCatalog || !camera || currentViewMode !== 'orbit' || !marsGlobeGroup || !marsGlobeGroup.visible) {
      pooledLabelElements.forEach(item => {
        if (item.active) {
          item.dom.style.display = 'none';
          item.active = false;
        }
      });
      if (diagVisibleLabels) diagVisibleLabels.textContent = `0 / ${placeCatalog ? placeCatalog.places.length : 0}`;
      return;
    }

    const globeRotationY = marsGlobeGroup.rotation.y;
    const camPos = camera.position;
    const camDist = camPos.length();
    const altitude = camDist - GLOBE_RADIUS;
    const width = window.innerWidth;
    const height = window.innerHeight;

    // View Frustum Matrix
    const projScreenMatrix = new THREE.Matrix4();
    projScreenMatrix.multiplyMatrices(camera.projectionMatrix, camera.matrixWorldInverse);

    const candidates = [];
    const places = placeCatalog.places;
    const totalCount = places.length;

    // Check if in calm far global space view (altitude > 1500 scene units)
    const isGlobalSpaceView = (altitude > 1500);

    for (let i = 0; i < totalCount; i++) {
      const p = places[i];

      // 1. At global space altitude, strictly filter to curated iconic landmarks (~5-8 major features)
      if (isGlobalSpaceView) {
        if (!IDLE_ICONIC_LANDMARKS.has(p.id) && !(selectedPlace && selectedPlace.id === p.id)) {
          continue;
        }
      } else {
        // 2. Zoomed in regional exploration mode (altitude <= 1500):
        // Category Filter Check
        if (selectedCategory !== 'all' && p.category !== selectedCategory) {
          if (!selectedPlace || selectedPlace.id !== p.id) {
            continue;
          }
        }

        // Distance / scale LOD filter in regional view
        if (selectedCategory === 'all' && (!selectedPlace || selectedPlace.id !== p.id)) {
          if (altitude > 1400) {
            // Mid altitude: Tier 1 + large Tier 2
            if (p.importance_tier === 3) continue;
            if (p.importance_tier === 2 && !p.is_landing_site && (!p.diameter_km || p.diameter_km < 200.0)) continue;
          } else if (altitude > 800) {
            // Close regional: Tier 1 + Tier 2
            if (p.importance_tier === 3) continue;
          }
        }
      }

      // 3. Compute Current World Position (accounting for planetary rotation)
      const worldPos = p.pos3D.clone().applyAxisAngle(new THREE.Vector3(0, 1, 0), globeRotationY);

      // 4. Horizon Limb & Backside Occlusion Culling
      const norm = worldPos.clone().normalize();
      const toCam = camPos.clone().sub(worldPos);
      const distToCam = toCam.length();
      toCam.normalize();

      const cosAngle = norm.dot(toCam);
      // Occluded by the curvature of Mars
      if (cosAngle <= 0.12) {
        continue;
      }

      // 5. Screen Frustum Projection
      const projected = worldPos.clone().applyMatrix4(projScreenMatrix);
      if (projected.z >= 1.0 || projected.x < -1.05 || projected.x > 1.05 || projected.y < -1.05 || projected.y > 1.05) {
        continue;
      }

      // Screen Pixels
      const sx = (projected.x * 0.5 + 0.5) * width;
      const sy = (-(projected.y * 0.5) + 0.5) * height;

      // Avoid rendering over top HUD header bar
      if (sy < 80) continue;

      // Avoid rendering underneath the open Mission Inspector panel (bottom-right)
      const isInspectorOpen = inspectorPanel && (!inspectorPanel.querySelector('.hud-inspector-body') || inspectorPanel.querySelector('.hud-inspector-body').style.display !== 'none');
      if (isInspectorOpen && sx > width - 390 && sy > height - 560) {
        continue;
      }

      // Visual Importance Weighting
      let weight = (4 - p.importance_tier) * 3000;
      if (p.is_landing_site) weight += 8000;
      if (selectedPlace && selectedPlace.id === p.id) weight += 50000; // Always keep selected place on top
      if (p.diameter_km) weight += Math.min(2000, p.diameter_km * 3);

      const dxCenter = sx - width / 2;
      const dyCenter = sy - height / 2;
      const distCenterSq = dxCenter * dxCenter + dyCenter * dyCenter;
      weight -= Math.sqrt(distCenterSq) * 0.5;

      candidates.push({
        place: p,
        sx: sx,
        sy: sy,
        weight: weight
      });
    }

    // Sort candidates by visual priority
    candidates.sort((a, b) => b.weight - a.weight);

    // Limit maximum labels: 8 at global space altitude, 14 in regional view for crisp readability
    const maxAllowedLabels = isGlobalSpaceView ? 8 : 14;

    // 6. 2D Screen-Space Collision Decluttering
    const placedBoxes = [];
    const visibleResults = [];

    for (let i = 0; i < candidates.length; i++) {
      const c = candidates[i];
      const boxW = 120;
      const boxH = 26;
      const bx = c.sx - 8;
      const by = c.sy - 13;

      let collides = false;
      for (let j = 0; j < placedBoxes.length; j++) {
        const pb = placedBoxes[j];
        if (
          bx < pb.x + pb.w &&
          bx + boxW > pb.x &&
          by < pb.y + pb.h &&
          by + boxH > pb.y
        ) {
          collides = true;
          break;
        }
      }

      if (!collides || (selectedPlace && selectedPlace.id === c.place.id)) {
        placedBoxes.push({ x: bx, y: by, w: boxW, h: boxH });
        visibleResults.push(c);
        if (visibleResults.length >= maxAllowedLabels) break;
      }
    }

    // 7. Update DOM Element Pool
    const placedCount = visibleResults.length;
    for (let i = 0; i < LABEL_POOL_SIZE; i++) {
      const poolItem = pooledLabelElements[i];
      if (i < placedCount) {
        const res = visibleResults[i];
        const p = res.place;

        poolItem.dom.style.transform = `translate3d(${Math.round(res.sx)}px, ${Math.round(res.sy)}px, 0)`;
        poolItem.dom.style.display = 'flex';
        poolItem.dom.dataset.placeId = p.id;

        // Apply category classes to parent for pin colors and borders
        const isSelected = selectedPlace && selectedPlace.id === p.id;
        poolItem.dom.className = `planet-label ${p.category} ${p.is_landing_site ? 'mission' : ''} ${p.id === 'iau_14300' ? 'jezero-target' : ''} ${isSelected ? 'selected' : ''}`;

        // Text & Subtext
        poolItem.name.textContent = p.name;
        if (p.is_landing_site) {
          poolItem.sub.textContent = p.landing_date ? p.landing_date.slice(0, 4) : 'MISSION';
        } else if (p.diameter_km) {
          poolItem.sub.textContent = `${p.diameter_km >= 10 ? p.diameter_km.toFixed(0) : p.diameter_km.toFixed(1)} km`;
        } else {
          poolItem.sub.textContent = '';
        }

        // Highlight if currently selected
        if (isSelected) {
          poolItem.dom.classList.add('selected');
        } else {
          poolItem.dom.classList.remove('selected');
        }

        poolItem.active = true;
      } else {
        if (poolItem.active) {
          poolItem.dom.style.display = 'none';
          poolItem.active = false;
        }
      }
    }

    if (diagVisibleLabels) {
      diagVisibleLabels.textContent = `${placedCount} / ${placeCatalog.places.length}`;
    }
  }

  // 7. Place Selection & Location Dossier Card Controller
  function selectAndFocusPlace(place) {
    if (!place) return;
    cancelCurrentFlight();
    selectedPlace = place;

    // Prevent mode trap: if currently in Jezero workstation, cleanly restore orbit view first
    if (currentViewMode === 'jezero') {
      currentViewMode = 'orbit';
      if (viewModeSelect) viewModeSelect.value = 'orbit';
      if (marsGlobeGroup) marsGlobeGroup.visible = true;
      if (jezeroSurfaceGroup) jezeroSurfaceGroup.visible = false;
      if (labelsOverlay) labelsOverlay.style.display = 'block';
      if (jezeroLabelsOverlay) jezeroLabelsOverlay.style.display = 'none';
      if (waypointModal) waypointModal.classList.add('hidden');
      if (waypointSelect) waypointSelect.classList.add('hidden');
      if (btnFlyJezero) btnFlyJezero.classList.remove('hidden');
      controls.target.set(0, 0, 0);
    }

    // Planetary exploration mode: hide surface inspector and regional coverage notice
    if (inspectorPanel) inspectorPanel.classList.add('hidden');
    if (coverageNotice) coverageNotice.classList.add('hidden');

    // Immediately stop auto-rotation and enter camera-flight
    setNavigationState('camera-flight', `flying to ${place.name}`);

    // Display Dossier Card
    if (locationCard) {
      locationCard.classList.remove('hidden');
      if (locCardTitle) locCardTitle.textContent = place.name.toUpperCase();
      if (locCardCategory) locCardCategory.textContent = (place.feature_type || place.category).toUpperCase();
      if (locCardLat) locCardLat.innerHTML = `${Math.abs(place.lat_deg).toFixed(2)}&deg; ${place.lat_deg >= 0 ? 'N' : 'S'}`;
      if (locCardLon) locCardLon.innerHTML = `${Math.abs(place.lon_deg).toFixed(2)}&deg; ${place.lon_deg >= 0 ? 'E' : 'W'}`;

      if (locCardSizeChip && locCardSize) {
        if (place.diameter_km) {
          locCardSizeChip.classList.remove('hidden');
          locCardSize.textContent = `${place.diameter_km.toFixed(1)} km`;
        } else {
          locCardSizeChip.classList.add('hidden');
        }
      }

      if (locCardOrigin) {
        locCardOrigin.textContent = place.description || place.origin || 'Planetary nomenclature landmark surveyed by IAU/USGS.';
      }

      if (locCardAttribution) {
        locCardAttribution.textContent = place.dataset_attribution || place.pds_citation || 'USGS Gazetteer of Planetary Nomenclature / IAU WGPSN';
      }

      // If landmark is Jezero or Perseverance, expose "Open 3D Jezero Workstation" CTA
      if (btnLocJezeroWorkstation) {
        const isJezero = place.id === 'iau_14300' || place.id === 'landing_perseverance' || (place.host_feature && place.host_feature.includes('Jezero'));
        if (isJezero) {
          btnLocJezeroWorkstation.classList.remove('hidden');
        } else {
          btnLocJezeroWorkstation.classList.add('hidden');
        }
      }
    }

    // Update imagery and elevation telemetry for the target place
    updateImageryAndElevationTelemetry(place.lon_deg, place.lat_deg);
    const bestProduct = findBestImageryForLocation(place.lon_deg, place.lat_deg);

    // If regional CTX mosaic available, load and project curved overlay on the globe
    if (bestProduct && bestProduct.layer_type === 'regional_mosaic') {
      loadRegionalImageryOverlay(bestProduct);
    } else {
      clearRegionalOverlay();
    }

    // Determine altitude based on feature scale
    let flyAlt = 2000;
    if (place.diameter_km) {
      flyAlt = Math.max(900, Math.min(3200, place.diameter_km * 2.2));
    } else if (place.is_landing_site) {
      flyAlt = 1100;
    }

    startSphericalFlight(place.lat_deg, place.lon_deg, flyAlt, 2200, () => {
      const altKm = (flyAlt * 3.396).toFixed(0);
      updateLiveTelemetry(place.lon_deg, place.lat_deg, `${altKm} km`, '-25°');
      updateImageryAndElevationTelemetry(place.lon_deg, place.lat_deg);
      // Arrived at destination: enter regional exploration mode, staying still with zero rotation
      setNavigationState('regional-exploration', `arrived at ${place.name}`);
    });
  }

  // 8. Search & Autocomplete Engine
  function performSearch(query) {
    activeSearchQuery = (query || '').trim().toLowerCase();
    if (!activeSearchQuery || !placeCatalog) {
      if (searchResultsDropdown) {
        searchResultsDropdown.classList.add('hidden');
        searchResultsDropdown.innerHTML = '';
      }
      activeSearchMatches = [];
      searchSelectedIndex = -1;
      return;
    }

    const matches = [];
    const places = placeCatalog.places;
    const q = activeSearchQuery;

    for (let i = 0; i < places.length; i++) {
      const p = places[i];

      // Category filter check if active
      if (selectedCategory !== 'all' && p.category !== selectedCategory) {
        continue;
      }

      const nameMatch = p.name.toLowerCase().includes(q);
      const catMatch = p.category.toLowerCase().includes(q);
      const typeMatch = (p.feature_type || '').toLowerCase().includes(q);
      const missionMatch = (p.mission || '').toLowerCase().includes(q);

      if (nameMatch || catMatch || typeMatch || missionMatch) {
        // Score matches (exact prefix bonus)
        let score = 0;
        if (p.name.toLowerCase().startsWith(q)) score += 500;
        if (nameMatch) score += 200;
        if (p.is_landing_site) score += 300;
        score += (4 - p.importance_tier) * 100;

        matches.push({ place: p, score: score });
      }
    }

    matches.sort((a, b) => b.score - a.score);
    activeSearchMatches = matches.slice(0, 8).map(m => m.place);
    searchSelectedIndex = -1;

    renderSearchResults();
  }

  function renderSearchResults() {
    if (!searchResultsDropdown) return;

    if (activeSearchMatches.length === 0) {
      searchResultsDropdown.innerHTML = `
        <div style="padding: 10px 14px; font-size: 11px; color: var(--text-muted); text-align: center;">
          No matching features found in IAU catalog.
        </div>
      `;
      searchResultsDropdown.classList.remove('hidden');
      return;
    }

    searchResultsDropdown.innerHTML = '';
    activeSearchMatches.forEach((p, idx) => {
      const item = document.createElement('div');
      item.className = 'search-result-item' + (idx === searchSelectedIndex ? ' highlighted' : '');
      item.dataset.index = idx;

      const emoji = p.is_landing_site ? '🚀' : (p.category === 'volcano' ? '🌋' : (p.category === 'canyon' ? '🏞️' : '⚪'));
      const subInfo = p.is_landing_site
        ? `${p.agency || 'Mission'} • ${p.landing_date ? p.landing_date.slice(0, 4) : 'Landed'}`
        : `${(p.feature_type || p.category).toUpperCase()}${p.diameter_km ? ` • ${p.diameter_km.toFixed(0)} km` : ''}`;

      item.innerHTML = `
        <div class="search-result-info">
          <div class="search-result-name">${emoji} ${p.name}</div>
          <div class="search-result-coords">${subInfo}</div>
        </div>
        <span class="search-badge ${p.category}">${p.category.toUpperCase()}</span>
      `;

      item.addEventListener('click', () => {
        selectAndFocusPlace(p);
        if (searchPlaceInput) searchPlaceInput.value = p.name;
        if (searchResultsDropdown) searchResultsDropdown.classList.add('hidden');
        if (btnClearSearch) btnClearSearch.classList.remove('hidden');
      });

      searchResultsDropdown.appendChild(item);
    });

    searchResultsDropdown.classList.remove('hidden');
  }

  // Handle Canvas Click (Planning Point Selection or Waypoint Beacon or Landmark)
  function onCanvasClick(event) {
    if (event.target.tagName !== 'CANVAS') return;

    mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
    mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;

    raycaster.setFromCamera(mouse, camera);

    if (currentViewMode === 'jezero') {
      // 1. If currently picking start or destination on 3D terrain
      if (planningMode === 'start' || planningMode === 'goal' || planningMode === 'contingency') {
        if (!terrainMesh) return;
        const terrainIntersects = raycaster.intersectObject(terrainMesh);
        if (terrainIntersects.length > 0) {
          const pt = terrainIntersects[0].point;
          const dx = missionData.grid.ground_dx_m;
          const dy = missionData.grid.ground_dy_m;
          const totalW = (missionData.grid.cols - 1) * dx;
          const totalH = (missionData.grid.rows - 1) * dy;
          const halfW = totalW / 2.0;
          const halfH = totalH / 2.0;

          const col = Math.round((pt.x + halfW) / dx);
          const row = Math.round((pt.z + halfH) / dy);

          // Bounds validation
          if (row < 0 || row >= missionData.grid.rows || col < 0 || col >= missionData.grid.cols) {
            setPlanningStatus("OUT OF BOUNDS: Click within the 5.0 km surveyed Jezero boundary.", "error");
            return;
          }

          // Elevation validation (NoData mask)
          const elev = missionData.elevation_samples[row][col];
          if (elev <= -9000) {
            setPlanningStatus("HAZARD VOID: Selected cell is NoData/masked void. Choose valid terrain.", "error");
            return;
          }

          if (planningMode === 'contingency') {
            setContingencyPickedLocation(row, col);
            setPlanningMode('none');
            return;
          }

          if (planningMode === 'start') {
            customStart = { row, col, name: `Custom Departure (${row}, ${col})` };
            if (startPointVal) startPointVal.textContent = customStart.name;
            updateStartMarker(row, col);
            setPlanningMode('none');
            updateCalculateButtonState();
            buildWaypointBeacons();
            updateJezeroLabels();
            populateAddStopDropdown();
            setSimulationStale(true);
            markContingencyStale();
            markMdlStale();
            setUnsavedChanges(true);
            clearDetour();
            if (gauntletResultCard) gauntletResultCard.classList.add('hidden');
            if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
            if (comparisonLabCard) comparisonLabCard.classList.add('hidden');
            if (sensitivityResultCard) sensitivityResultCard.classList.add('hidden');
            setPlanningStatus(`Departure point set at (${row}, ${col}). Select destination or calculate traverse.`, "success");
          } else if (planningMode === 'goal') {
            customGoal = { row, col, name: `Custom Destination (${row}, ${col})` };
            if (goalPointVal) goalPointVal.textContent = customGoal.name;
            updateGoalMarker(row, col);
            setPlanningMode('none');
            updateCalculateButtonState();
            buildWaypointBeacons();
            updateJezeroLabels();
            populateAddStopDropdown();
            setSimulationStale(true);
            markContingencyStale();
            markMdlStale();
            setUnsavedChanges(true);
            clearDetour();
            if (gauntletResultCard) gauntletResultCard.classList.add('hidden');
            if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
            if (comparisonLabCard) comparisonLabCard.classList.add('hidden');
            if (sensitivityResultCard) sensitivityResultCard.classList.add('hidden');
            setPlanningStatus(`Destination point set at (${row}, ${col}). Ready to calculate traverse.`, "success");
          }
          return;
        }
      }

      // 2. Milestone 13C: 5-Tier Spatial Raycasting Hierarchy
      let hitHandled = false;
      if (playbackVehicleMesh && playbackVehicleMesh.visible) {
        const unitHits = raycaster.intersectObjects(playbackVehicleMesh.children);
        if (unitHits.length > 0) {
          showTheaterSpatialInspector('unit', playbackVehicleMesh, unitHits[0].point);
          hitHandled = true;
        }
      }
      if (!hitHandled && disruptionHazardMesh && disruptionHazardMesh.visible) {
        const hazardHits = raycaster.intersectObjects(disruptionHazardMesh.children);
        if (hazardHits.length > 0) {
          showTheaterSpatialInspector('hazard', disruptionHazardMesh, hazardHits[0].point);
          hitHandled = true;
        }
      }
      if (!hitHandled) {
        const intersects = raycaster.intersectObjects(waypointBeacons);
        if (intersects.length > 0) {
          const wp = intersects[0].object.userData.waypoint;
          if (wp) {
            openWaypointModal(wp);
            showTheaterSpatialInspector('waypoint', wp, intersects[0].point);
            hitHandled = true;
          }
        }
      }
      if (!hitHandled && terrainMesh) {
        const tHits = raycaster.intersectObject(terrainMesh);
        if (tHits.length > 0) {
          const pt = tHits[0].point;
          const dx = missionData.grid.ground_dx_m;
          const dy = missionData.grid.ground_dy_m;
          const totalW = (missionData.grid.cols - 1) * dx;
          const totalH = (missionData.grid.rows - 1) * dy;
          const halfW = totalW / 2.0;
          const halfH = totalH / 2.0;
          const col = Math.max(0, Math.min(missionData.grid.cols - 1, Math.round((pt.x + halfW) / dx)));
          const row = Math.max(0, Math.min(missionData.grid.rows - 1, Math.round((pt.z + halfH) / dy)));
          const boundsGeo = (missionData.bounds && missionData.bounds.geographic) || {};
          const lonMin = boundsGeo.min_lon_deg !== undefined ? boundsGeo.min_lon_deg : 77.397666;
          const lonMax = boundsGeo.max_lon_deg !== undefined ? boundsGeo.max_lon_deg : 77.482019;
          const latMin = boundsGeo.min_lat_deg !== undefined ? boundsGeo.min_lat_deg : 18.399978;
          const latMax = boundsGeo.max_lat_deg !== undefined ? boundsGeo.max_lat_deg : 18.484331;
          const lon = lonMin + (col / (missionData.grid.cols - 1)) * (lonMax - lonMin);
          const lat = latMax - (row / (missionData.grid.rows - 1)) * (latMax - latMin);
          updateLiveTelemetry(lon, lat, `${(camera.position.y * 1.5).toFixed(0)} m`, '-35°');
          showTheaterSpatialInspector('terrain', { row, col, lat, lon }, pt);
        }
      }
    } else {
      // In Orbit view, clicking Jezero target ring initiates flight
      if (jezeroTargetMarker) {
        const intersects = raycaster.intersectObjects(jezeroTargetMarker.children);
        if (intersects.length > 0) {
          flyToJezeroView();
          return;
        }
      }

      // Clicking globe surface updates coordinates in telemetry
      if (marsSphereMesh) {
        const sphereIntersects = raycaster.intersectObject(marsSphereMesh);
        if (sphereIntersects.length > 0) {
          const pt = sphereIntersects[0].point;
          // Apply inverse globe rotation to calculate true IAU surface coordinates
          const rotY = marsGlobeGroup ? marsGlobeGroup.rotation.y : 0;
          const unrotPt = pt.clone().applyAxisAngle(new THREE.Vector3(0, 1, 0), -rotY);
          const coords = spherePosToLatLon(unrotPt);
          const altKm = ((camera.position.length() - GLOBE_RADIUS) * 3.396).toFixed(0);
          updateLiveTelemetry(coords.lon, coords.lat, `${altKm} km`, '-25°');
        }
      }
    }
  }

  // Handle Window Resize
  function onWindowResize() {
    if (!renderer || !camera) return;
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  }

  // Event Listeners Setup
  
  // =========================================================================
  // Format Duration in Seconds to Human-Readable String
  function formatDuration(sec) {
    if (sec === null || sec === undefined || isNaN(sec)) return '—';
    const totalSec = Math.round(Number(sec));
    if (totalSec < 60) return `${totalSec}s`;
    const min = Math.round(totalSec / 60);
    if (min < 60) return `${min} min`;
    const h = Math.floor(min / 60);
    const remMin = min % 60;
    return remMin > 0 ? `${h}h ${remMin}m` : `${h}h`;
  }

  // Save Current Mission to Library
  async function saveCurrentMission(nameOverride) {
    const missionName = nameOverride || (inputMissionName ? inputMissionName.value.trim() : '') || activeSavedMissionName;
    if (!customStart || !customGoal) {
      setPlanningStatus("Please define start and destination before saving mission.", "error");
      return null;
    }

    const payload = {
      schema_version: "1.0.0",
      mission_id: activeSavedMissionId || undefined,
      name: missionName,
      canonical_mission: {
        start: { row: customStart.row, col: customStart.col, name: customStart.name },
        goal: { row: customGoal.row, col: customGoal.col, name: customGoal.name },
        stops: activeIntermediateStops.map(s => ({
          row: s.row,
          col: s.col,
          id: s.id,
          name: s.name,
          priority_score: s.priority_score || 50,
          dwell_time_s: s.dwell_time_s || 900
        })),
        profile: currentProfile,
        vehicle_mode: currentVehicleMode,
        speed_multiplier: 1.0,
        optimize_stops: false,
        mission_constraints: {}
      },
      profile: currentProfile,
      vehicle_mode: currentVehicleMode,
      terrain_dataset_id: "USGS_CTX_DTM_JEZERO_20M",
      model_version: "2.0.0",
      assumptions_version: "1.0.0",
      tags: ["jezero", currentProfile, currentVehicleMode]
    };

    try {
      const resp = await fetch('/api/missions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const res = await resp.json();
      if (!resp.ok) throw new Error(res.message || res.error || `HTTP ${resp.status}`);

      activeSavedMissionId = res.mission_id;
      activeSavedMissionName = res.name;
      if (activeMissionNameDisplay) activeMissionNameDisplay.textContent = res.name;
      if (inputMissionName) inputMissionName.value = res.name;
      setUnsavedChanges(false);
      setPlanningStatus(`MISSION SAVED: ${res.name} (ID: ${res.mission_id})`, "success");
      return res;
    } catch (err) {
      console.error('[MarsWalk Atlas] Save mission error:', err);
      setPlanningStatus(`Failed to save mission: ${err.message}`, "error");
      return null;
    }
  }

  // Load Mission by ID
  async function loadMissionById(missionId) {
    try {
      const resp = await fetch(`/api/missions/${missionId}`);
      const res = await resp.json();
      if (!resp.ok) throw new Error(res.message || res.error || `HTTP ${resp.status}`);

      const canon = res.canonical_mission || {};
      if (canon.start) {
        customStart = { row: canon.start.row, col: canon.start.col, name: canon.start.name || `Departure (${canon.start.row}, ${canon.start.col})` };
        if (startPointVal) startPointVal.textContent = customStart.name;
        updateStartMarker(customStart.row, customStart.col);
      }
      if (canon.goal) {
        customGoal = { row: canon.goal.row, col: canon.goal.col, name: canon.goal.name || `Destination (${canon.goal.row}, ${canon.goal.col})` };
        if (goalPointVal) goalPointVal.textContent = customGoal.name;
        updateGoalMarker(customGoal.row, customGoal.col);
      }

      activeIntermediateStops = (canon.stops || []).map(s => ({
        row: s.row,
        col: s.col,
        id: s.id,
        name: s.name || s.id,
        priority_score: s.priority_score,
        dwell_time_s: s.dwell_time_s
      }));
      renderActiveStopsList();
      populateAddStopDropdown();

      if (canon.profile) {
        currentProfile = canon.profile;
        routeTabs.forEach(tab => {
          if (tab.dataset.route === currentProfile) tab.classList.add('active');
          else tab.classList.remove('active');
        });
      }

      if (canon.vehicle_mode) {
        currentVehicleMode = canon.vehicle_mode;
        vehicleModePills.forEach(p => {
          if (p.dataset.mode === currentVehicleMode) p.classList.add('active');
          else p.classList.remove('active');
        });
        if (statTravelTimeLabel) {
          statTravelTimeLabel.textContent = (currentVehicleMode === 'robotic_rover')
            ? 'Estimated Rover Drive Time (Mars 2020 0.035 m/s Model)'
            : 'Estimated EVA Traverse Time (Apollo Walk Model)';
        }
      }

      activeSavedMissionId = res.mission_id;
      activeSavedMissionName = res.name;
      if (activeMissionNameDisplay) activeMissionNameDisplay.textContent = res.name;
      if (inputMissionName) inputMissionName.value = res.name;
      setUnsavedChanges(false);

      if (missionLibraryModal) missionLibraryModal.classList.add('hidden');
      await calculateTraverse();
      setPlanningStatus(`MISSION RESTORED: ${res.name}`, "success");
      return res;
    } catch (err) {
      console.error('[MarsWalk Atlas] Load mission error:', err);
      setPlanningStatus(`Failed to load mission: ${err.message}`, "error");
      return null;
    }
  }

  // Refresh Mission Library Table
  async function refreshMissionLibraryTable() {
    if (!missionLibraryTableBody) return;
    missionLibraryTableBody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-tertiary);">Loading saved missions...</td></tr>';

    try {
      const resp = await fetch('/api/missions');
      const data = await resp.json();
      const list = data.missions || [];

      if (list.length === 0) {
        missionLibraryTableBody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-tertiary); padding:16px;">No saved missions found. Save your current mission above.</td></tr>';
        return;
      }

      missionLibraryTableBody.innerHTML = '';
      list.forEach(m => {
        const tr = document.createElement('tr');
        const dtStr = m.updated_at ? new Date(m.updated_at).toLocaleString(undefined, { dateStyle: 'short', timeStyle: 'short' }) : '—';
        tr.innerHTML = `
          <td><strong>${m.name}</strong><br><span style="font-size:8.5px; color:var(--text-tertiary);">${m.mission_id}</span></td>
          <td><span class="wp-badge">${m.profile.toUpperCase()}</span></td>
          <td><span class="wp-badge">${m.vehicle_mode.replace('_', ' ').toUpperCase()}</span></td>
          <td>${m.num_stops}</td>
          <td style="font-size:9px;">${dtStr}</td>
          <td>
            <button class="table-action-btn btn-load-m" data-id="${m.mission_id}">Load</button>
            <button class="table-action-btn btn-dup-m" data-id="${m.mission_id}">Duplicate</button>
            <button class="table-action-btn btn-exp-m" data-id="${m.mission_id}">Export</button>
            <button class="table-action-btn danger btn-del-m" data-id="${m.mission_id}">Delete</button>
          </td>
        `;
        missionLibraryTableBody.appendChild(tr);
      });

      // Hook action buttons
      missionLibraryTableBody.querySelectorAll('.btn-load-m').forEach(b => {
        b.addEventListener('click', () => loadMissionById(b.dataset.id));
      });
      missionLibraryTableBody.querySelectorAll('.btn-dup-m').forEach(b => {
        b.addEventListener('click', async () => {
          await duplicateMissionById(b.dataset.id);
        });
      });
      missionLibraryTableBody.querySelectorAll('.btn-exp-m').forEach(b => {
        b.addEventListener('click', async () => {
          const resp = await fetch(`/api/missions/${b.dataset.id}`);
          const mData = await resp.json();
          const blob = new Blob([JSON.stringify(mData, null, 2)], { type: 'application/json' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `marswalk_mission_${b.dataset.id}.json`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        });
      });
      missionLibraryTableBody.querySelectorAll('.btn-del-m').forEach(b => {
        b.addEventListener('click', async () => {
          if (confirm(`Are you sure you want to delete saved mission '${b.dataset.id}'?`)) {
            await deleteMissionById(b.dataset.id);
          }
        });
      });
    } catch (err) {
      missionLibraryTableBody.innerHTML = `<tr><td colspan="6" style="color:#ff5252; padding:12px;">Failed loading missions: ${err.message}</td></tr>`;
    }
  }

  // Duplicate Mission
  async function duplicateMissionById(missionId) {
    try {
      const resp = await fetch(`/api/missions/${missionId}/duplicate`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({})
      });
      const res = await resp.json();
      if (!resp.ok) throw new Error(res.message || res.error || `HTTP ${resp.status}`);
      setPlanningStatus(`MISSION DUPLICATED: ID ${res.mission_id}`, "success");
      await refreshMissionLibraryTable();
      return res;
    } catch (err) {
      setPlanningStatus(`Failed to duplicate mission: ${err.message}`, "error");
      return null;
    }
  }

  // Delete Mission
  async function deleteMissionById(missionId) {
    try {
      const resp = await fetch(`/api/missions/${missionId}`, {
        method: 'DELETE'
      });
      const res = await resp.json();
      if (!resp.ok) throw new Error(res.message || res.error || `HTTP ${resp.status}`);
      if (activeSavedMissionId === missionId) {
        activeSavedMissionId = null;
        activeSavedMissionName = 'Untitled Mission';
        if (activeMissionNameDisplay) activeMissionNameDisplay.textContent = 'Untitled Mission';
      }
      setPlanningStatus(`MISSION DELETED: ${missionId}`, "ready");
      await refreshMissionLibraryTable();
      return res;
    } catch (err) {
      setPlanningStatus(`Failed to delete mission: ${err.message}`, "error");
      return null;
    }
  }

  // Save Current Simulation Run as Experiment
  async function saveCurrentExperiment(nameOverride) {
    if (!activeBaselineRouteResult) {
      await calculateTraverse();
    }
    if (!activeBaselineRouteResult) {
      setPlanningStatus("No active baseline calculation to save.", "error");
      return null;
    }

    const expName = nameOverride || `Study ${activeSavedMissionName} (${new Date().toLocaleTimeString()})`;
    const snapshot = activeBaselineRouteResult.mission_snapshot || {
      schema_version: "1.0.0",
      input_fingerprint: activeMissionFingerprint || "",
      canonical_mission: {
        start: customStart,
        goal: customGoal,
        stops: activeIntermediateStops,
        profile: currentProfile,
        vehicle_mode: currentVehicleMode
      },
      ordered_points: activeBaselineRouteResult.path_rc || [],
      terrain_dataset: {
        dataset_id: "USGS_CTX_DTM_JEZERO_20M",
        grid_cell_size_m: 20.0,
        dimensions: { height: 250, width: 250 }
      }
    };

    const payload = {
      schema_version: "1.0.0",
      name: expName,
      description: `Persistent experiment study for mission ${activeSavedMissionName}.`,
      mission_id: activeSavedMissionId || undefined,
      status: activeBaselineRouteResult.is_reachable ? "success" : "infeasible",
      lifecycle_state: "historical_result",
      baseline_fingerprint: activeBaselineRouteResult.input_fingerprint || activeMissionFingerprint || "",
      mission_snapshot: snapshot,
      baseline_route: activeBaselineRouteResult,
      scenarios_evaluated: lastComparisonResult ? (lastComparisonResult.scenarios || []) : [],
      sensitivity_sweep: lastSensitivityResult || null,
      recovery_plan: lastRecoveryPlan || null,
      reproducibility_notes: `Recorded on ${new Date().toISOString()} under MarsWalk 2.0.`,
      terrain_dataset_id: "USGS_CTX_DTM_JEZERO_20M",
      model_version: "2.0.0",
      assumptions_version: "1.0.0"
    };

    try {
      const resp = await fetch('/api/experiments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const res = await resp.json();
      if (!resp.ok) throw new Error(res.message || res.error || `HTTP ${resp.status}`);

      setPlanningStatus(`EXPERIMENT PERSISTED: ${res.name} (ID: ${res.experiment_id})`, "success");
      return res;
    } catch (err) {
      console.error('[MarsWalk Atlas] Save experiment error:', err);
      setPlanningStatus(`Failed to save experiment: ${err.message}`, "error");
      return null;
    }
  }

  // Refresh Experiment Library Table
  async function refreshExperimentLibraryTable() {
    if (!experimentLibraryTableBody) return;
    experimentLibraryTableBody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--text-tertiary);">Loading saved experiments...</td></tr>';

    try {
      const resp = await fetch('/api/experiments');
      const data = await resp.json();
      const list = data.experiments || [];

      if (list.length === 0) {
        experimentLibraryTableBody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--text-tertiary); padding:16px;">No saved experiments found. Run a simulation and click "Save Run" above.</td></tr>';
        return;
      }

      experimentLibraryTableBody.innerHTML = '';
      list.forEach(exp => {
        const tr = document.createElement('tr');
        const dtStr = exp.created_at ? new Date(exp.created_at).toLocaleString(undefined, { dateStyle: 'short', timeStyle: 'short' }) : '—';
        const distStr = (exp.ground_distance_m !== null && exp.ground_distance_m !== undefined) ? `${exp.ground_distance_m.toFixed(1)} m` : '—';
        const timeStr = exp.active_traverse_time_s ? formatDuration(exp.active_traverse_time_s) : '—';

        let badgeClass = 'lifecycle-historical';
        let badgeLabel = 'HISTORICAL';
        if (exp.lifecycle_state === 'reproducible') {
          badgeClass = 'lifecycle-reproducible';
          badgeLabel = 'REPRODUCIBLE';
        } else if (exp.lifecycle_state === 'recalculation_required') {
          badgeClass = 'lifecycle-recalc';
          badgeLabel = 'RECALC REQUIRED';
        } else if (exp.lifecycle_state === 'stale_incompatible') {
          badgeClass = 'lifecycle-stale';
          badgeLabel = 'INCOMPATIBLE';
        } else if (exp.lifecycle_state === 'failed') {
          badgeClass = 'lifecycle-failed';
          badgeLabel = 'FAILED';
        }

        tr.innerHTML = `
          <td><strong>${exp.name}</strong><br><span style="font-size:8.5px; color:var(--text-tertiary);">${exp.experiment_id}</span></td>
          <td><span class="lifecycle-badge ${badgeClass}">${badgeLabel}</span></td>
          <td>${distStr}</td>
          <td>${timeStr}</td>
          <td>${exp.num_scenarios}</td>
          <td style="font-size:9px;">${dtStr}</td>
          <td>
            <button class="table-action-btn btn-view-e" data-id="${exp.experiment_id}">View</button>
            <button class="table-action-btn btn-replay-e" data-id="${exp.experiment_id}">Replay</button>
            <button class="table-action-btn danger btn-del-e" data-id="${exp.experiment_id}">Delete</button>
          </td>
        `;
        experimentLibraryTableBody.appendChild(tr);
      });

      experimentLibraryTableBody.querySelectorAll('.btn-view-e').forEach(b => {
        b.addEventListener('click', () => viewExperimentById(b.dataset.id));
      });
      experimentLibraryTableBody.querySelectorAll('.btn-replay-e').forEach(b => {
        b.addEventListener('click', () => replayExperimentById(b.dataset.id));
      });
      experimentLibraryTableBody.querySelectorAll('.btn-del-e').forEach(b => {
        b.addEventListener('click', async () => {
          if (confirm(`Are you sure you want to delete experiment '${b.dataset.id}'?`)) {
            await deleteExperimentById(b.dataset.id);
          }
        });
      });
    } catch (err) {
      experimentLibraryTableBody.innerHTML = `<tr><td colspan="7" style="color:#ff5252; padding:12px;">Failed loading experiments: ${err.message}</td></tr>`;
    }
  }

  // View Historical Experiment
  async function viewExperimentById(expId) {
    try {
      const resp = await fetch(`/api/experiments/${expId}`);
      const expData = await resp.json();
      if (!resp.ok) throw new Error(expData.message || expData.error || `HTTP ${resp.status}`);

      activeHistoricalExperiment = expData;
      const bRoute = expData.baseline_route || {};
      if (bRoute.path_rc && bRoute.path_rc.length > 0) {
        drawLiveRoute(bRoute.path_rc, bRoute.profile || currentProfile);
      }
      updateTelemetryFromData(bRoute);

      if (experimentLibraryModal) experimentLibraryModal.classList.add('hidden');
      setPlanningStatus(`VIEWING HISTORICAL EXPERIMENT: ${expData.name} (${expData.lifecycle_state.toUpperCase()})`, "ready");
      return expData;
    } catch (err) {
      setPlanningStatus(`Failed to view experiment: ${err.message}`, "error");
      return null;
    }
  }

  // Replay Saved Experiment
  async function replayExperimentById(expId) {
    setPlanningStatus(`Replaying experiment ${expId} under current simulation engine...`, "calculating");
    try {
      const resp = await fetch(`/api/experiments/${expId}/replay`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({})
      });
      const res = await resp.json();
      if (!resp.ok) throw new Error(res.message || res.error || `HTTP ${resp.status}`);

      const matchMsg = res.is_exact_match
        ? "REPLAY VERIFIED: Exact mathematical match to historical study."
        : "REPLAY COMPLETED: Output differs from historical baseline (see notes).";
      setPlanningStatus(`${matchMsg} Saved as: ${res.experiment_id}`, "success");
      await refreshExperimentLibraryTable();
      return res;
    } catch (err) {
      setPlanningStatus(`Replay failed: ${err.message}`, "error");
      return null;
    }
  }

  // Delete Experiment
  async function deleteExperimentById(expId) {
    try {
      const resp = await fetch(`/api/experiments/${expId}`, {
        method: 'DELETE'
      });
      const res = await resp.json();
      if (!resp.ok) throw new Error(res.message || res.error || `HTTP ${resp.status}`);
      setPlanningStatus(`EXPERIMENT DELETED: ${expId}`, "ready");
      await refreshExperimentLibraryTable();
      return res;
    } catch (err) {
      setPlanningStatus(`Failed to delete experiment: ${err.message}`, "error");
      return null;
    }
  }

  // Open Experiment Comparison Modal
  async function openExperimentComparisonModal() {
    if (!selectCompareExpA || !selectCompareExpB) return;
    try {
      const resp = await fetch('/api/experiments');
      const data = await resp.json();
      const list = data.experiments || [];

      if (list.length < 2) {
        setPlanningStatus("At least 2 saved experiments are required for trade-off comparison.", "error");
        return;
      }

      selectCompareExpA.innerHTML = '';
      selectCompareExpB.innerHTML = '';
      list.forEach((exp, idx) => {
        const optA = document.createElement('option');
        optA.value = exp.experiment_id;
        optA.textContent = `${exp.name} (${exp.experiment_id})`;
        selectCompareExpA.appendChild(optA);

        const optB = document.createElement('option');
        optB.value = exp.experiment_id;
        optB.textContent = `${exp.name} (${exp.experiment_id})`;
        if (idx === 1) optB.selected = true;
        selectCompareExpB.appendChild(optB);
      });

      if (experimentLibraryModal) experimentLibraryModal.classList.add('hidden');
      if (experimentComparisonModal) experimentComparisonModal.classList.remove('hidden');
    } catch (err) {
      setPlanningStatus(`Failed opening comparison modal: ${err.message}`, "error");
    }
  }

  // Execute Side-by-Side Trade-off Comparison
  async function executeExperimentComparison(idAOverride, idBOverride) {
    const idA = idAOverride || (selectCompareExpA ? selectCompareExpA.value : null);
    const idB = idBOverride || (selectCompareExpB ? selectCompareExpB.value : null);

    if (!idA || !idB) {
      setPlanningStatus("Please select two experiments to compare.", "error");
      return null;
    }
    if (idA === idB) {
      setPlanningStatus("Please select two distinct experiments for comparison.", "error");
      return null;
    }

    try {
      const resp = await fetch('/api/experiments/compare', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          schema_version: "1.0.0",
          experiment_id_a: idA,
          experiment_id_b: idB
        })
      });
      const res = await resp.json();
      if (!resp.ok) throw new Error(res.message || res.error || `HTTP ${resp.status}`);

      if (thExpAName) thExpAName.textContent = res.experiment_a.name;
      if (thExpBName) thExpBName.textContent = res.experiment_b.name;

      if (compareTableBody) {
        const d = res.deltas || {};
        const distDeltaStr = (d.distance_delta_m !== null) ? `${(d.distance_delta_m > 0 ? '+' : '')}${d.distance_delta_m.toFixed(1)} m (${d.distance_pct_delta !== null ? (d.distance_pct_delta > 0 ? '+' : '') + d.distance_pct_delta + '%' : '—'})` : '—';
        const timeDeltaStr = (d.active_time_delta_s !== null) ? `${(d.active_time_delta_s > 0 ? '+' : '')}${formatDuration(Math.abs(d.active_time_delta_s))} (${d.active_time_pct_delta !== null ? (d.active_time_pct_delta > 0 ? '+' : '') + d.active_time_pct_delta + '%' : '—'})` : '—';
        const effortDeltaStr = (d.effort_delta_flat_m !== null) ? `${(d.effort_delta_flat_m > 0 ? '+' : '')}${d.effort_delta_flat_m.toFixed(1)} flat-m` : '—';
        const sciDeltaStr = (d.science_score_delta !== null) ? `${(d.science_score_delta > 0 ? '+' : '')}${d.science_score_delta.toFixed(1)} pts` : '—';

        compareTableBody.innerHTML = `
          <tr>
            <td><strong>Ground Distance</strong></td>
            <td>${res.experiment_a.distance_m ? res.experiment_a.distance_m.toFixed(1) + ' m' : '—'}</td>
            <td>${res.experiment_b.distance_m ? res.experiment_b.distance_m.toFixed(1) + ' m' : '—'}</td>
            <td><strong style="color:var(--telemetry-cyan);">${distDeltaStr}</strong></td>
          </tr>
          <tr>
            <td><strong>Active Traverse Time</strong></td>
            <td>${res.experiment_a.active_traverse_time_s ? formatDuration(res.experiment_a.active_traverse_time_s) : '—'}</td>
            <td>${res.experiment_b.active_traverse_time_s ? formatDuration(res.experiment_b.active_traverse_time_s) : '—'}</td>
            <td><strong style="color:var(--telemetry-cyan);">${timeDeltaStr}</strong></td>
          </tr>
          <tr>
            <td><strong>Terrain Effort</strong></td>
            <td>${res.experiment_a.terrain_cost_flat_m ? res.experiment_a.terrain_cost_flat_m.toFixed(1) + ' flat-m' : '—'}</td>
            <td>${res.experiment_b.terrain_cost_flat_m ? res.experiment_b.terrain_cost_flat_m.toFixed(1) + ' flat-m' : '—'}</td>
            <td><strong style="color:var(--telemetry-cyan);">${effortDeltaStr}</strong></td>
          </tr>
          <tr>
            <td><strong>Scientific Harvest</strong></td>
            <td>${res.experiment_a.science_score ? res.experiment_a.science_score.toFixed(1) + ' pts' : '—'}</td>
            <td>${res.experiment_b.science_score ? res.experiment_b.science_score.toFixed(1) + ' pts' : '—'}</td>
            <td><strong style="color:var(--telemetry-cyan);">${sciDeltaStr}</strong></td>
          </tr>
          <tr>
            <td><strong>Evaluated Scenarios</strong></td>
            <td>${res.experiment_a.num_scenarios} scenarios</td>
            <td>${res.experiment_b.num_scenarios} scenarios</td>
            <td>—</td>
          </tr>
        `;
      }

      if (compareTradeOffsList) {
        compareTradeOffsList.innerHTML = '';
        (res.trade_offs_summary || []).forEach(item => {
          const div = document.createElement('div');
          div.innerHTML = `&bull; ${item}`;
          compareTradeOffsList.appendChild(div);
        });
      }

      if (compareResultsContainer) compareResultsContainer.classList.remove('hidden');
      setPlanningStatus(`EXPERIMENT COMPARISON COMPLETE: ${res.experiment_a.name} vs ${res.experiment_b.name}`, "success");
      return res;
    } catch (err) {
      setPlanningStatus(`Comparison calculation failed: ${err.message}`, "error");
      return null;
    }
  }

  // =========================================================================
  // MILESTONE 9Q: DEMO MODE, GUIDED 5-MINUTE SHOWCASE & PREFLIGHT DIAGNOSTICS
  // =========================================================================

  function clearDemoHighlights() {
    document.querySelectorAll('.demo-highlight-pulse').forEach(el => el.classList.remove('demo-highlight-pulse'));
  }

  function applyDemoHighlight(selector) {
    clearDemoHighlights();
    if (!selector) return;
    try {
      const el = document.querySelector(selector);
      if (el) el.classList.add('demo-highlight-pulse');
    } catch (e) {
      // ignore selector errors
    }
  }

  function loadDemoMissionConfig() {
    customStart = { row: 117, col: 157, id: 'octavia_landing', name: 'Octavia E. Butler Landing (117, 157)' };
    customGoal = { row: 66, col: 128, id: 'delta_rim', name: 'Delta Rim Overlook (66, 128)' };

    activeIntermediateStops = [
      { id: 'hawksbill_gap', name: 'Hawksbill Gap', priority_score: 95.0, row: 104, col: 147 },
      { id: 'skinner_ridge', name: 'Skinner Ridge', priority_score: 88.0, row: 95, col: 139 },
      { id: 'enchanted_lake', name: 'Enchanted Lake', priority_score: 80.0, row: 107, col: 136 }
    ];

    currentProfile = 'balanced';
    currentVehicleMode = 'crew_eva';

    if (inputExpeditionHours) inputExpeditionHours.value = '8.0';
    if (inputDwellMins) inputDwellMins.value = '15';
    if (inputDelayMins) inputDelayMins.value = '0';
    if (inputMaxDistanceM) inputMaxDistanceM.value = '';

    if (startPointVal) startPointVal.textContent = customStart.name;
    if (goalPointVal) goalPointVal.textContent = customGoal.name;

    renderActiveStopsList();
    populateAddStopDropdown();
    updateCalculateButtonState();
    buildWaypointBeacons();
    updateJezeroLabels();

    routeTabs.forEach(tab => {
      if (tab.dataset.route === 'balanced') tab.classList.add('active');
      else tab.classList.remove('active');
    });
    vehicleModePills.forEach(p => {
      if (p.dataset.vehicle === 'crew_eva') p.classList.add('active');
      else p.classList.remove('active');
    });
  }

  const DEMO_SHOWCASE_STEPS = [
    {
      step: 1,
      title: "01. Global Cartography & Geodesy",
      desc: "Explore Mars referenced to the IAU 2000 planetocentric datum (R=3,396,190 m) with Viking MDIM 2.1 color mosaics and 2,061 verified IAU landmarks across four featured destinations.",
      truthNote: "High-resolution surface routing is strictly confined to surveyed basins where calibrated elevation models exist.",
      actionText: "Fly to Jezero Crater Workstation →",
      action: () => {
        flyToJezeroView();
        setDemoStep(2);
      },
      highlightSelector: ".landing-hero-sidebar, #featuredSelect"
    },
    {
      step: 2,
      title: "02. Jezero Surface Topography & Slope Hazards",
      desc: "Investigate Jezero Crater Western Delta on the authentic USGS CTX 20m Digital Terrain Model (250x250 cells, 5x5 km, -2624m to -2445m). Slopes are calculated using Horn's 3x3 kernel, with >15° slopes marked as hazardous.",
      truthNote: "USGS CTX 20m DTM (DOI: 10.5066/P906QQT8). 12 candidate science targets are anchored to physical elevation coordinates.",
      actionText: "Load Demo Sortie Configuration →",
      action: () => {
        loadDemoMissionConfig();
        setDemoStep(3);
      },
      highlightSelector: "#terrainTexturePills, #waypointVisibilityPills"
    },
    {
      step: 3,
      title: "03. Multi-Stop Sortie Planning & Least-Cost A*",
      desc: "Planning sortie across candidate targets (Octavia Landing → Hawksbill Gap → Skinner Ridge → Enchanted Lake → Delta Rim Overlook) under Crew EVA (0.85 m/s) with 15 min dwell per stop. Computing live A* least-cost terrain traverse...",
      truthNote: "A* uses an anisotropic octile heuristic provably admissible and Dijkstra-equivalent (0.000 m cost discrepancy).",
      actionText: "Calculate Traverse (Python A*) →",
      action: async () => {
        loadDemoMissionConfig();
        await calculateTraverse();
        setDemoStep(4);
      },
      highlightSelector: "#btnCalculateRoute, #timelineCard"
    },
    {
      step: 4,
      title: "04. Route Decision Workbench & Elevation Profile",
      desc: "Inspect the interactive SVG elevation profile with distance/slope crosshair and 3D terrain locator synchronization. The Locomotion Cost Attribution Ledger reconciles ground distance, slope, roughness, and uphill climb.",
      truthNote: "Effort decomposition reconciles additively to machine epsilon: Total Effort = Distance * (1 + SlopePenalty + Roughness + ClimbGrade).",
      actionText: "Enter Mission Operations Cockpit →",
      action: async () => {
        switchInspectorTab('tabMissionControl');
        if (typeof selectMissionControlCampaign === 'function') {
          await selectMissionControlCampaign('cmp_conference_demo_jezero');
        }
        setDemoStep(5);
      },
      highlightSelector: "#routeDecisionWorkbenchCard, #mcElevationProfileSvg, #tabBtnMissionControl"
    },
    {
      step: 5,
      title: "05. Mission Operations Cockpit & Telemetry",
      desc: "Real-time mission operations cockpit displaying the 3-Sol Jezero campaign (cmp_conference_demo_jezero), 12-checkpoint preflight flight-readiness assessment, and environmental telemetry from PDS4 MEDA archives (Sol 1619, 589.7 Pa).",
      truthNote: "Atmospheric telemetry sourced from Perseverance MEDA PDS4 archives; sensor-damaged channels remain null rather than fabricated.",
      actionText: "Audit Scientific Traceability & Evidence →",
      action: () => {
        if (typeof openEvidenceInspector === 'function') {
          openEvidenceInspector('elevation', '-2542.4 m');
        }
        setDemoStep(6);
      },
      highlightSelector: "#mcTransportCard, #mcMetricDistance, #mcEventStream"
    },
    {
      step: 6,
      title: "06. Scientific Traceability & Evidence Inspector",
      desc: "Every metric displayed on screen is independently auditable. The modal exposes governing equations, primary remote sensing sources (USGS CTX 20m DTM), sensor classifications, and the mandatory aerospace non-certification statement.",
      truthNote: "Modeled routes and triage recommendations are planning heuristics and are NOT certified safe for astronaut operational flight.",
      actionText: "Close Inspector & Enter Robustness Lab →",
      action: () => {
        if (evidenceModal) evidenceModal.classList.add('hidden');
        switchInspectorTab('tabRobustnessLab');
        if (typeof runRobustnessAnalysis === 'function') {
          runRobustnessAnalysis();
        }
        setDemoStep(7);
      },
      highlightSelector: "#evidenceModalContent, #btnCloseEvidenceModal"
    },
    {
      step: 7,
      title: "07. Mission Robustness Lab & Stress Gauntlet",
      desc: "Stress-testing campaign feasibility across a deterministic 10-case gauntlet (traction derating, duration contraction, operational holds, corridor chokepoints). Computes finite-difference sensitivity elasticities and answers core resilience questions.",
      truthNote: "Robustness evaluation is non-probabilistic and deterministic, providing reproducible worst-case failure envelopes.",
      actionText: "Adopt Resilient Strategy & Launch Rehearsal →",
      action: () => {
        switchInspectorTab('tabRehearsalDirector');
        if (typeof initRehearsalDirector === 'function') {
          initRehearsalDirector();
        }
        setDemoStep(8);
      },
      highlightSelector: "#robFeasibilityBar, #robStrategyCards, #tabBtnRehearsalDirector"
    },
    {
      step: 8,
      title: "08. Rehearsal Director & Causal Replay Studio",
      desc: "Closed-loop tri-track simulation comparing Nominal Baseline vs Disturbed Unmitigated (60m rockfall barrier) vs Autonomous Recovered (detour preserving 100% science). Evaluators scrub the 7-step Causal Decision Timeline to inspect traceable causal links.",
      truthNote: "Closed-loop controller follows strict 4-tier triage: In-situ resume -> Local A* detour -> Science pruning -> Direct habitat abort.",
      actionText: "Orchestrate Experiment Battery in Studio →",
      action: () => {
        switchInspectorTab('tabExperimentStudio');
        setDemoStep(9);
      },
      highlightSelector: "#rehProgressCard, #rehCausalReplayCard, #tabBtnExperimentStudio"
    },
    {
      step: 9,
      title: "09. Mission Experiment Studio & Tamper-Evident Dossier",
      desc: "Multi-scenario experiment engine evaluates 10 stress scenarios in batch. Cross-scenario comparative matrix highlights degraded vs recovered sorties. Generates a complete, cryptographically verified Evidence Dossier ZIP containing RFC 8259 JSON and SHA-256 manifests.",
      truthNote: "Exported dossier ZIP contains SHA-256 cryptographic verification for all scenario manifests and comparison tables.",
      actionText: "★ Complete Tour & Explore MarsWalk Freely",
      action: () => {
        exitDemoMode(false);
      },
      highlightSelector: "#expMatrixTable, #btnExportDossierZip"
    }
  ];

  function setDemoStep(stepNumber) {
    if (stepNumber < 1) stepNumber = 1;
    if (stepNumber > DEMO_SHOWCASE_STEPS.length) stepNumber = DEMO_SHOWCASE_STEPS.length;
    currentDemoStep = stepNumber;

    const stepDef = DEMO_SHOWCASE_STEPS[currentDemoStep - 1];
    if (showcaseStepIndicator) showcaseStepIndicator.textContent = `STEP 0${currentDemoStep} / 0${DEMO_SHOWCASE_STEPS.length}`;
    if (showcaseProgressBar) {
      showcaseProgressBar.style.width = `${Math.round((currentDemoStep / DEMO_SHOWCASE_STEPS.length) * 100)}%`;
    }
    if (showcaseStepTitle) showcaseStepTitle.textContent = stepDef.title;
    if (showcaseStepDesc) showcaseStepDesc.textContent = stepDef.desc;
    if (showcaseTruthNote) {
      showcaseTruthNote.textContent = stepDef.truthNote || "USGS CTX 20m DTM (DOI: 10.5066/P906QQT8). Modeled traverses are planning heuristics.";
    }
    if (btnShowcaseAction) {
      btnShowcaseAction.textContent = stepDef.actionText;
      btnShowcaseAction.onclick = stepDef.action;
    }

    if (btnShowcasePrev) btnShowcasePrev.disabled = (currentDemoStep === 1);
    if (btnShowcaseNext) {
      if (currentDemoStep === DEMO_SHOWCASE_STEPS.length) {
        btnShowcaseNext.textContent = "Finish ✓";
        btnShowcaseNext.onclick = () => exitDemoMode(false);
      } else {
        btnShowcaseNext.textContent = "Next →";
        btnShowcaseNext.onclick = () => setDemoStep(currentDemoStep + 1);
      }
    }

    applyDemoHighlight(stepDef.highlightSelector);

    // Context transitions on step entry
    if (currentDemoStep === 1) {
      if (currentViewMode !== 'orbit') setOrbitView(false);
    } else if (currentDemoStep === 2) {
      if (currentViewMode !== 'jezero') flyToJezeroView();
    } else if (currentDemoStep === 3) {
      switchInspectorTab('tabPlan');
      loadDemoMissionConfig();
    } else if (currentDemoStep === 4) {
      switchInspectorTab('tabResults');
    } else if (currentDemoStep === 5) {
      switchInspectorTab('tabMissionControl');
      if (typeof selectMissionControlCampaign === 'function') {
        selectMissionControlCampaign('cmp_conference_demo_jezero');
      }
    } else if (currentDemoStep === 6) {
      if (typeof openEvidenceInspector === 'function') {
        openEvidenceInspector('elevation', '-2542.4 m');
      }
    } else if (currentDemoStep === 7) {
      if (evidenceModal) evidenceModal.classList.add('hidden');
      switchInspectorTab('tabRobustnessLab');
      if (robCampaignSelect) robCampaignSelect.value = 'cmp_conference_demo_jezero';
    } else if (currentDemoStep === 8) {
      switchInspectorTab('tabRehearsalDirector');
      if (rehCampaignSelect) rehCampaignSelect.value = 'cmp_conference_demo_jezero';
    } else if (currentDemoStep === 9) {
      switchInspectorTab('tabExperimentStudio');
      if (expCampaignSelect) expCampaignSelect.value = 'cmp_conference_demo_jezero';
    }
  }

  function enterDemoMode() {
    if (isDemoModeActive) return;

    // Snapshot user session
    demoSessionBackup = {
      customStart: customStart ? { ...customStart } : null,
      customGoal: customGoal ? { ...customGoal } : null,
      activeIntermediateStops: activeIntermediateStops.map(s => ({ ...s })),
      currentProfile,
      currentVehicleMode,
      inputExpeditionHours: inputExpeditionHours ? inputExpeditionHours.value : '8.0',
      inputDwellMins: inputDwellMins ? inputDwellMins.value : '15',
      inputDelayMins: inputDelayMins ? inputDelayMins.value : '0',
      inputMaxDistanceM: inputMaxDistanceM ? inputMaxDistanceM.value : '',
      activeRoutePath: activeRoutePath ? [...activeRoutePath] : null,
      activeBaselineRouteResult: activeBaselineRouteResult ? { ...activeBaselineRouteResult } : null,
      currentViewMode,
      activeSavedMissionId,
      activeSavedMissionName,
      hasUnsavedChanges
    };

    isDemoModeActive = true;

    if (isLandingActive) {
      hideLandingPage(false);
    }

    if (inspectorPanel && inspectorPanel.classList.contains('collapsed')) {
      toggleInspectorPanel();
    }

    if (demoModeBanner) demoModeBanner.classList.remove('hidden');
    if (demoShowcaseHUD) demoShowcaseHUD.classList.remove('hidden');

    setPlanningStatus("CONFERENCE DEMO MODE: 9-step guided mission rehearsal loaded. Authentic USGS CTX 20m DTM.", "ready");
    setDemoStep(1);
  }

  function exitDemoMode(restoreSession = true) {
    if (!isDemoModeActive) return;

    clearDemoHighlights();
    if (evidenceModal) evidenceModal.classList.add('hidden');
    if (demoExplainabilityDrawer) demoExplainabilityDrawer.classList.add('hidden');

    if (restoreSession && demoSessionBackup) {
      customStart = demoSessionBackup.customStart;
      customGoal = demoSessionBackup.customGoal;
      activeIntermediateStops = demoSessionBackup.activeIntermediateStops || [];
      currentProfile = demoSessionBackup.currentProfile;
      currentVehicleMode = demoSessionBackup.currentVehicleMode;

      if (inputExpeditionHours) inputExpeditionHours.value = demoSessionBackup.inputExpeditionHours;
      if (inputDwellMins) inputDwellMins.value = demoSessionBackup.inputDwellMins;
      if (inputDelayMins) inputDelayMins.value = demoSessionBackup.inputDelayMins;
      if (inputMaxDistanceM) inputMaxDistanceM.value = demoSessionBackup.inputMaxDistanceM;

      activeSavedMissionId = demoSessionBackup.activeSavedMissionId;
      activeSavedMissionName = demoSessionBackup.activeSavedMissionName || 'Untitled Mission';
      if (activeMissionNameDisplay) activeMissionNameDisplay.textContent = activeSavedMissionName;
      setUnsavedChanges(demoSessionBackup.hasUnsavedChanges);

      if (startPointVal && customStart) startPointVal.textContent = customStart.name;
      if (goalPointVal && customGoal) goalPointVal.textContent = customGoal.name;
      renderActiveStopsList();
      populateAddStopDropdown();
      updateCalculateButtonState();
      buildWaypointBeacons();
      updateJezeroLabels();

      routeTabs.forEach(tab => {
        if (tab.dataset.route === currentProfile) tab.classList.add('active');
        else tab.classList.remove('active');
      });
      vehicleModePills.forEach(p => {
        if (p.dataset.vehicle === currentVehicleMode) p.classList.add('active');
        else p.classList.remove('active');
      });

      if (demoSessionBackup.activeRoutePath && demoSessionBackup.activeRoutePath.length > 0) {
        activeRoutePath = demoSessionBackup.activeRoutePath;
        drawLiveRoute(activeRoutePath, currentProfile);
        clearDetour();
        if (demoSessionBackup.activeBaselineRouteResult) {
          updateTelemetryFromData(demoSessionBackup.activeBaselineRouteResult);
          if (demoSessionBackup.activeBaselineRouteResult.timeline) {
            renderTimeline(demoSessionBackup.activeBaselineRouteResult.timeline);
          }
        }
      } else {
        clearLiveRoute();
        clearDetour();
      }

      if (demoSessionBackup.currentViewMode === 'orbit' && currentViewMode === 'jezero') {
        setOrbitView(false);
      } else if (demoSessionBackup.currentViewMode === 'jezero' && currentViewMode === 'orbit') {
        flyToJezeroView();
      }
    }

    demoSessionBackup = null;
    isDemoModeActive = false;

    if (demoModeBanner) demoModeBanner.classList.add('hidden');
    if (demoShowcaseHUD) demoShowcaseHUD.classList.add('hidden');

    setPlanningStatus("DEMO MODE EXITED: Full Atlas operational workstation unlocked.", "ready");
  }

  async function openPreflightModal() {
    if (!preflightModal) return;
    preflightModal.classList.remove('hidden');

    if (preflightSummaryTitle) preflightSummaryTitle.textContent = "RUNNING 12-POINT READINESS DIAGNOSTICS...";
    if (preflightTableBody) {
      preflightTableBody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:16px; color:var(--text-secondary);">Querying system components...</td></tr>`;
    }

    try {
      const resp = await fetch('/api/preflight');
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      const data = await resp.json();

      if (preflightSummaryTitle) {
        const statusColor = data.is_ready_for_demo ? 'var(--status-green)' : '#FF5252';
        preflightSummaryTitle.innerHTML = `<span style="color:${statusColor}">● ${data.passed_count}/${data.total_count} CHECKS PASSED &bull; ${data.overall_status.toUpperCase()}</span>`;
      }
      if (preflightTimestamp) {
        preflightTimestamp.textContent = `Completed at ${data.timestamp} in ${data.total_duration_ms}ms`;
      }

      if (preflightTableBody && data.checks) {
        preflightTableBody.innerHTML = '';
        data.checks.forEach((c, idx) => {
          const row = document.createElement('tr');
          let statusBadge = `<span class="lifecycle-badge lifecycle-reproducible">PASS</span>`;
          if (c.status === 'warning') statusBadge = `<span class="lifecycle-badge lifecycle-recalc">WARN</span>`;
          else if (c.status === 'failed') statusBadge = `<span class="lifecycle-badge lifecycle-stale">FAIL</span>`;
          else if (c.status === 'not_applicable') statusBadge = `<span class="lifecycle-badge lifecycle-historical">N/A</span>`;

          const typeBadge = c.category === 'local'
            ? `<span style="color:var(--telemetry-cyan); font-size:9px;">LOCAL</span>`
            : `<span style="color:#FFA726; font-size:9px;">${c.category.toUpperCase()}</span>`;

          row.innerHTML = `
            <td>${idx + 1}</td>
            <td style="font-weight:600;">${c.name}</td>
            <td>${statusBadge}</td>
            <td>${typeBadge}</td>
            <td style="font-size:9.5px; color:var(--text-secondary);">${c.details}</td>
            <td style="font-size:9px; color:var(--text-tertiary);">${c.duration_ms} ms</td>
          `;
          preflightTableBody.appendChild(row);
        });
      }
    } catch (err) {
      if (preflightTableBody) {
        preflightTableBody.innerHTML = `<tr><td colspan="6" style="color:#FF5252; padding:16px;">Failed to fetch /api/preflight: ${err.message}</td></tr>`;
      }
    }
  }

  function closePreflightModal() {
    if (preflightModal) preflightModal.classList.add('hidden');
  }

  function setupEventListeners() {
    // Viewport Mode Dropdown
    if (viewModeSelect) {
      viewModeSelect.addEventListener('change', (e) => {
        if (e.target.value === 'orbit') {
          setOrbitView(true);
        } else {
          flyToJezeroView();
        }
      });
    }

    // Basemap Imagery Selector
    if (layerSelect) {
      layerSelect.addEventListener('change', (e) => {
        const val = e.target.value;
        activeLayer = val;
        console.log(`[MarsWalk Atlas] Switching basemap imagery layer: ${val}`);
        if (!marsSphereMesh) return;

        let texturePath = 'assets/mars_viking_color_fallback.jpg';
        if (val === 'usgs_mola') {
          texturePath = 'https://trek.nasa.gov/tiles/Mars/EQ/Mars_MGS_MOLA_ClrShade_merge_global_463m/1.0.0/default/default028mm/0/0/0.jpg';
        } else if (val === 'trek_wmts') {
          texturePath = 'https://trek.nasa.gov/tiles/Mars/EQ/Mars_Viking_MDIM21_ClrMosaic_global_232m/1.0.0/default/default028mm/0/0/0.jpg';
        }

        const loader = new THREE.TextureLoader();
        loader.load(texturePath, (tex) => {
          marsSphereMesh.material.map = tex;
          marsSphereMesh.material.needsUpdate = true;
          if (diagActiveLayer) diagActiveLayer.textContent = val;
          if (telemetryLayer) telemetryLayer.textContent = val === 'usgs_mola' ? 'MGS MOLA (463 m)' : 'Viking MDIM (232 m)';
        }, undefined, (err) => {
          console.warn('[MarsWalk Atlas] Failed to load remote layer, keeping fallback:', err);
        });
      });
    }

    // Primary Navigation Buttons
    if (btnOrbitView) btnOrbitView.addEventListener('click', () => setOrbitView(true));
    if (btnFlyJezero) btnFlyJezero.addEventListener('click', () => flyToJezeroView());
    if (btnReturnToJezero) btnReturnToJezero.addEventListener('click', () => flyToJezeroView());

    // Waypoint Search Dropdown
    if (waypointSelect) {
      waypointSelect.addEventListener('change', (e) => {
        const wpId = e.target.value;
        if (!wpId || !missionData) return;
        const wp = missionData.waypoints.find(w => w.id === wpId);
        if (wp) {
          openWaypointModal(wp);
          focusOnWaypoint(wp);
        }
      });
    }

    // Featured Destinations Dropdown
    if (featuredSelect) {
      featuredSelect.addEventListener('change', (e) => {
        const fid = e.target.value;
        if (!fid || !placeCatalog) return;
        const p = placesById.get(fid);
        if (p) {
          selectAndFocusPlace(p);
        }
      });
    }

    // Category Filter Pills
    if (categoryFilterBar) {
      const pills = categoryFilterBar.querySelectorAll('.cat-pill');
      pills.forEach(pill => {
        pill.addEventListener('click', () => {
          pills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          selectedCategory = pill.dataset.cat || 'all';

          // Update active search if typing
          if (activeSearchQuery) {
            performSearch(activeSearchQuery);
          }
          // Immediate label refresh
          updateMapLabels();
        });
      });
    }

    // Search Input & Autocomplete
    if (searchPlaceInput) {
      searchPlaceInput.addEventListener('focus', () => {
        if (navigationState !== 'jezero-workstation') {
          setNavigationState('searching', 'search bar focused');
        }
      });

      searchPlaceInput.addEventListener('input', (e) => {
        if (navigationState !== 'jezero-workstation') {
          setNavigationState('searching', 'search query typed');
        }
        const val = e.target.value;
        if (btnClearSearch) {
          if (val.length > 0) {
            btnClearSearch.classList.remove('hidden');
          } else {
            btnClearSearch.classList.add('hidden');
          }
        }
        performSearch(val);
      });

      searchPlaceInput.addEventListener('keydown', (e) => {
        if (!activeSearchMatches.length) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          searchSelectedIndex = (searchSelectedIndex + 1) % activeSearchMatches.length;
          renderSearchResults();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          searchSelectedIndex = (searchSelectedIndex - 1 + activeSearchMatches.length) % activeSearchMatches.length;
          renderSearchResults();
        } else if (e.key === 'Enter') {
          e.preventDefault();
          const target = searchSelectedIndex >= 0 ? activeSearchMatches[searchSelectedIndex] : activeSearchMatches[0];
          if (target) {
            selectAndFocusPlace(target);
            searchPlaceInput.value = target.name;
            if (searchResultsDropdown) searchResultsDropdown.classList.add('hidden');
          }
        } else if (e.key === 'Escape') {
          if (searchResultsDropdown) searchResultsDropdown.classList.add('hidden');
        }
      });

      // Close search dropdown on click outside
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.search-box-container')) {
          if (searchResultsDropdown) searchResultsDropdown.classList.add('hidden');
        }
      });
    }

    // Clear Search Button
    if (btnClearSearch) {
      btnClearSearch.addEventListener('click', () => {
        if (searchPlaceInput) searchPlaceInput.value = '';
        btnClearSearch.classList.add('hidden');
        if (searchResultsDropdown) searchResultsDropdown.classList.add('hidden');
        activeSearchMatches = [];
      });
    }

    // Location Card Actions
    if (btnCloseLocCard) {
      btnCloseLocCard.addEventListener('click', () => {
        if (locationCard) locationCard.classList.add('hidden');
        selectedPlace = null;
      });
    }

    if (btnLocFly) {
      btnLocFly.addEventListener('click', () => {
        if (selectedPlace) {
          selectAndFocusPlace(selectedPlace);
        }
      });
    }

    if (btnLocJezeroWorkstation) {
      btnLocJezeroWorkstation.addEventListener('click', () => {
        flyToJezeroView();
      });
    }

    if (btnLocOrbit) {
      btnLocOrbit.addEventListener('click', () => {
        setOrbitView(true);
      });
    }

    // Developer Diagnostics Panel Toggle
    if (btnToggleDiagnostics) {
      btnToggleDiagnostics.addEventListener('click', () => {
        devDiagnosticsVisible = !devDiagnosticsVisible;
        if (devDiagnosticsPanel) {
          if (devDiagnosticsVisible) {
            devDiagnosticsPanel.classList.remove('hidden');
          } else {
            devDiagnosticsPanel.classList.add('hidden');
          }
        }
      });
    }

    // Keyboard Shortcuts ('D' key toggles diagnostics)
    window.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === 'd' || e.key === 'D') {
        devDiagnosticsVisible = !devDiagnosticsVisible;
        if (devDiagnosticsPanel) {
          if (devDiagnosticsVisible) {
            devDiagnosticsPanel.classList.remove('hidden');
          } else {
            devDiagnosticsPanel.classList.add('hidden');
          }
        }
      }
    });

    // Route Profile Tabs
    routeTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        routeTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentProfile = tab.dataset.route;
        setSimulationStale(true);
        markContingencyStale();
        markMdlStale();

        // If at default endpoints AND no intermediate science stops are added, use precomputed assets
        const isDefaultEndpoints = customStart && customStart.row === 117 && customStart.col === 157 &&
                                  customGoal && customGoal.row === 66 && customGoal.col === 128;
        const hasNoStops = (!activeIntermediateStops || activeIntermediateStops.length === 0);

        if (isDefaultEndpoints && hasNoStops && missionData && missionData.routes && missionData.routes[currentProfile]) {
          activeRoutePath = missionData.routes[currentProfile].path_rc;
          updateRouteTelemetry(currentProfile);
          drawLiveRoute(activeRoutePath, currentProfile);
          clearDetour();
          if (gauntletResultCard) gauntletResultCard.classList.add('hidden');
        } else {
          calculateTraverse();
        }
      });
    });

    // Auto-Rotation HUD Toggle Button
    if (btnToggleRotation) {
      btnToggleRotation.addEventListener('click', () => {
        if (autoRotationEnabled && navigationState === 'idle-orbit') {
          autoRotationEnabled = false;
          setNavigationState('user-interacting', 'auto-rotation manually paused');
        } else {
          autoRotationEnabled = true;
          if (currentViewMode === 'orbit') {
            setNavigationState('idle-orbit', 'auto-rotation manually enabled');
          }
        }
      });
    }

    // Jezero Surface Texture Mode Pills
    terrainTexturePills.forEach(pill => {
      pill.addEventListener('click', () => {
        terrainTexturePills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        setTerrainTexture(pill.dataset.texture || 'ctx');
      });
    });

    // Vertical Exaggeration Pills
    exagPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const val = parseFloat(pill.dataset.exag);
        if (isNaN(val) || val <= 0) return;
        exagPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentExaggeration = val;

        buildTerrainMesh(currentExaggeration, currentTerrainTexture);
        buildWaypointBeacons();
        updatePlanningMarkers();
        if (activeRoutePath) {
          drawLiveRoute(activeRoutePath, currentProfile);
        } else {
          updateRoutePolyline(currentProfile);
        }
        if (activeDetourPath) {
          drawDetourRoute(activeDetourPath);
        }
        if (activeDisruptionHazard) {
          highlightDisruptionZone(activeDisruptionHazard.scenarioData, activeDisruptionHazard.scenarioId);
        }
        if (activeContingencyResult && activeContingencyResult.geographic_overlays) {
          renderContingency3DOverlays(activeContingencyResult.geographic_overlays);
        }
        if (contingencyCenterR && contingencyCenterR.value && contingencyPlacementPreviewMesh) {
          highlightContingencyPlacementPreview(
            parseInt(contingencyCenterR.value),
            parseInt(contingencyCenterC.value),
            parseFloat(contingencyRadiusM ? contingencyRadiusM.value : 60) || 60
          );
        }
      });
    });

    // Live Planning Surface Pickers
    if (btnSetStart) {
      btnSetStart.addEventListener('click', () => {
        if (currentViewMode !== 'jezero') {
          setPlanningStatus("SURFACE PICKING UNAVAILABLE: Surface waypoint selection requires Jezero 3D Workstation. Click 'FLY TO JEZERO' first.", "error");
          return;
        }
        if (planningMode === 'start') {
          setPlanningMode('none');
          setPlanningStatus("Planning mode cancelled. Departure point unchanged.");
        } else {
          setPlanningMode('start');
        }
      });
    }

    if (btnSetGoal) {
      btnSetGoal.addEventListener('click', () => {
        if (currentViewMode !== 'jezero') {
          setPlanningStatus("SURFACE PICKING UNAVAILABLE: Surface waypoint selection requires Jezero 3D Workstation. Click 'FLY TO JEZERO' first.", "error");
          return;
        }
        if (planningMode === 'goal') {
          setPlanningMode('none');
          setPlanningStatus("Planning mode cancelled. Destination point unchanged.");
        } else {
          setPlanningMode('goal');
        }
      });
    }

    if (btnResetPlanning) {
      btnResetPlanning.addEventListener('click', () => {
        resetPlanning();
        setSimulationStale(true);
      });
    }

    // Milestone 9N: Waypoint Visibility Mode Pills
    if (btnVisAll) {
      btnVisAll.addEventListener('click', () => {
        setWaypointVisibilityMode('all');
      });
    }

    if (btnVisMission) {
      btnVisMission.addEventListener('click', () => {
        setWaypointVisibilityMode('mission');
      });
    }

    // Milestone 9N: Clear Start & Goal Endpoint Actions
    if (btnClearStart) {
      btnClearStart.addEventListener('click', () => {
        clearStart();
      });
    }

    if (btnClearGoal) {
      btnClearGoal.addEventListener('click', () => {
        clearGoal();
      });
    }

    // Milestone 9N: Swap Endpoints Action
    if (btnSwapEndpoints) {
      btnSwapEndpoints.addEventListener('click', () => {
        swapEndpoints();
      });
    }

    // Milestone 9N: Reset Mission Action & Confirmation Modal
    if (btnResetMission) {
      btnResetMission.addEventListener('click', () => {
        resetMission(false);
      });
    }

    if (btnCancelResetMission) {
      btnCancelResetMission.addEventListener('click', () => {
        closeResetMissionModal();
      });
    }

    if (btnDismissResetMission) {
      btnDismissResetMission.addEventListener('click', () => {
        closeResetMissionModal();
      });
    }

    if (btnConfirmResetMission) {
      btnConfirmResetMission.addEventListener('click', () => {
        executeResetMission();
      });
    }

    // Milestone 9G: Multi-stop intermediate waypoints
    if (btnAddStop) {
      btnAddStop.addEventListener('click', () => {
        if (!selectAddStop || !selectAddStop.value) return;
        const wpId = selectAddStop.value;
        const wp = missionData && missionData.waypoints ? missionData.waypoints.find(w => w.id === wpId) : null;
        if (wp) {
          activeIntermediateStops.push(wp);
          renderActiveStopsList();
          populateAddStopDropdown();
          setSimulationStale(true);
          setUnsavedChanges(true);
          clearDetour();
          if (gauntletResultCard) gauntletResultCard.classList.add('hidden');
          if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
          if (comparisonLabCard) comparisonLabCard.classList.add('hidden');
          if (sensitivityResultCard) sensitivityResultCard.classList.add('hidden');
        }
      });
    }

    if (btnClearStops) {
      btnClearStops.addEventListener('click', () => {
        activeIntermediateStops = [];
        renderActiveStopsList();
        populateAddStopDropdown();
        setSimulationStale(true);
        setUnsavedChanges(true);
        clearDetour();
        if (gauntletResultCard) gauntletResultCard.classList.add('hidden');
        if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
        if (comparisonLabCard) comparisonLabCard.classList.add('hidden');
        if (sensitivityResultCard) sensitivityResultCard.classList.add('hidden');
      });
    }

    if (btnOptimizeStops) {
      btnOptimizeStops.addEventListener('click', optimizeMissionStops);
    }

    initMissionControl();
    initRobustnessLab();
    initRehearsalDirector();
    initExperimentStudio();

    // Milestone 9M: Inspector 4-Tabs Navigation
    if (inspectorTabs) {
      inspectorTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          switchInspectorTab(tab.dataset.tab);
        });
      });
    }

    // Milestone 9M/9N: Waypoint Catalog Visibility Toggle (Keep synced with pills)
    if (chkShowAllWaypoints) {
      chkShowAllWaypoints.addEventListener('change', () => {
        setWaypointVisibilityMode(chkShowAllWaypoints.checked ? 'all' : 'mission');
      });
    }

    // Milestone 9H: Vehicle Mode Pills
    vehicleModePills.forEach(pill => {
      pill.addEventListener('click', () => {
        vehicleModePills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        setVehicleMode(pill.dataset.vehicle || 'crew_eva');
      });
    });

    // Expedition Budget & Constraint Field Listeners
    [inputExpeditionHours, inputDwellMins, inputDelayMins, inputMaxDistanceM].forEach(inp => {
      if (inp) {
        inp.addEventListener('input', () => {
          setSimulationStale(true);
          setUnsavedChanges(true);
          markMdlStale();
        });
        inp.addEventListener('change', () => {
          setSimulationStale(true);
          setUnsavedChanges(true);
          markMdlStale();
        });
      }
    });

    // Milestone 9H: Timeline Details Toggle
    if (btnToggleTimelineDetails && timelineEventsContainer) {
      btnToggleTimelineDetails.addEventListener('click', () => {
        timelineEventsContainer.classList.toggle('hidden');
        btnToggleTimelineDetails.textContent = timelineEventsContainer.classList.contains('hidden')
          ? '▾ Show Schedule Breakdown'
          : '▴ Hide Schedule Breakdown';
      });
    }

    // Milestone 9H: Apply Recovery Plan
    if (btnApplyRecovery) {
      btnApplyRecovery.addEventListener('click', applyRecoveryPlan);
    }

    if (btnCalculateRoute) {
      btnCalculateRoute.addEventListener('click', calculateTraverse);
    }

    if (btnRunGauntlet) {
      btnRunGauntlet.addEventListener('click', runGauntletStressTest);
    }

    // Milestone 9R: Contingency Designer Listeners
    if (contingencyEventType) {
      contingencyEventType.addEventListener('change', () => {
        updateContingencyFormVisibility();
        markContingencyStale();
      });
    }
    if (contingencyCostMult && contingencyCostMultVal) {
      contingencyCostMult.addEventListener('input', (e) => {
        contingencyCostMultVal.textContent = `${parseFloat(e.target.value).toFixed(1)}x`;
        markContingencyStale();
      });
    }
    if (contingencySpeedMult && contingencySpeedMultVal) {
      contingencySpeedMult.addEventListener('input', (e) => {
        contingencySpeedMultVal.textContent = `${parseFloat(e.target.value).toFixed(2)}x`;
        markContingencyStale();
      });
    }
    if (contingencyBudgetCutPct && contingencyBudgetCutPctVal) {
      contingencyBudgetCutPct.addEventListener('input', (e) => {
        contingencyBudgetCutPctVal.textContent = `${e.target.value}%`;
        markContingencyStale();
      });
    }
    if (contingencyHoldMin) {
      contingencyHoldMin.addEventListener('change', markContingencyStale);
    }
    if (contingencyTargetSelect) {
      contingencyTargetSelect.addEventListener('change', markContingencyStale);
    }
    if (contingencyRadiusM) {
      contingencyRadiusM.addEventListener('input', markContingencyStale);
    }
    if (btnPlaceContingencyOnMap) {
      btnPlaceContingencyOnMap.addEventListener('click', () => {
        setPlanningMode(planningMode === 'contingency' ? 'none' : 'contingency');
      });
    }
    if (btnCancelContingencyPlacement) {
      btnCancelContingencyPlacement.addEventListener('click', () => {
        setPlanningMode('none');
      });
    }
    if (btnAddContingencyEvent) {
      btnAddContingencyEvent.addEventListener('click', addStagedContingencyEvent);
    }
    if (btnSimulateContingency) {
      btnSimulateContingency.addEventListener('click', simulateCustomContingency);
    }
    if (btnClearContingency) {
      btnClearContingency.addEventListener('click', clearContingencyEvents);
    }
    if (btnSaveContingencyExperiment) {
      btnSaveContingencyExperiment.addEventListener('click', saveContingencyAsExperiment);
    }

    // Milestone 9W: Adaptive Mission Replanning Listeners
    if (btnAdaptiveReplan) {
      btnAdaptiveReplan.addEventListener('click', executeAdaptiveReplanning);
    }
    if (btnApplyAdaptivePlan) {
      btnApplyAdaptivePlan.addEventListener('click', applyAdaptivePlanToActiveMission);
    }
    if (btnPreviewAdaptive3D) {
      btnPreviewAdaptive3D.addEventListener('click', previewAdaptive3DRoute);
    }

    // Milestone 9X: Mission Robustness Lab Listeners
    if (btnRunRobustness) {
      btnRunRobustness.addEventListener('click', executeMissionRobustnessAnalysis);
    }
    if (selectRobustnessPreset) {
      selectRobustnessPreset.addEventListener('change', markRobustnessStale);
    }

    // Milestone 9Y: Route Decision Intelligence & Cost Attribution Listeners
    if (btnExplainRoute) {
      btnExplainRoute.addEventListener('click', executeRouteExplanation);
    }
    if (chkExplainCompareDetour) {
      chkExplainCompareDetour.addEventListener('change', () => {
        if (activeRouteExplanationResult) {
          setRouteExplanationStale(true);
        }
      });
    }

    // Milestone 9Z & 10A: Mission Timeline Playback & Camera Director Listeners
    if (btnPlaybackPlayPause) {
      btnPlaybackPlayPause.addEventListener('click', () => {
        if (playbackState.playing) {
          pauseMissionPlayback();
        } else {
          playMissionPlayback();
        }
      });
    }
    if (btnPlaybackReset) {
      btnPlaybackReset.addEventListener('click', resetMissionPlayback);
    }
    if (playbackScrubber) {
      playbackScrubber.addEventListener('mousedown', () => { isUserScrubbing = true; });
      playbackScrubber.addEventListener('touchstart', () => { isUserScrubbing = true; }, { passive: true });
      playbackScrubber.addEventListener('input', (e) => {
        isUserScrubbing = true;
        const model = playbackModels[playbackState.activeVariant];
        if (model && model.total_duration_s > 0) {
          const ratio = parseFloat(e.target.value) / 1000.0;
          seekMissionPlayback(ratio * model.total_duration_s);
        }
      });
      playbackScrubber.addEventListener('change', () => {
        isUserScrubbing = false;
      });
      playbackScrubber.addEventListener('mouseup', () => { isUserScrubbing = false; });
      playbackScrubber.addEventListener('touchend', () => { isUserScrubbing = false; });
    }
    document.querySelectorAll('.speed-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const spd = parseFloat(btn.getAttribute('data-speed'));
        if (!isNaN(spd) && spd > 0) {
          setPlaybackSpeed(spd);
        }
      });
    });
    if (btnVariantNominal) {
      btnVariantNominal.addEventListener('click', () => setPlaybackVariant('nominal'));
    }
    if (btnVariantDisrupted) {
      btnVariantDisrupted.addEventListener('click', () => setPlaybackVariant('disrupted'));
    }
    if (btnVariantAdaptive) {
      btnVariantAdaptive.addEventListener('click', () => setPlaybackVariant('adaptive'));
    }
    if (btnFocusMarker) {
      btnFocusMarker.addEventListener('click', focusPlaybackMarker);
    }

    // Milestone 10A: Camera Director Mode Listeners
    if (cameraDirectorModePills && cameraDirectorModePills.length > 0) {
      cameraDirectorModePills.forEach(pill => {
        pill.addEventListener('click', () => {
          const mode = pill.getAttribute('data-mode');
          if (mode) setCameraDirectorMode(mode);
        });
      });
    }

    // Milestone 10A: Audio Cues Toggle Listener
    if (btnToggleAudioCues) {
      btnToggleAudioCues.addEventListener('click', () => {
        toggleAudioCues();
      });
    }

    if (chkPlaybackFollowCamera) {
      chkPlaybackFollowCamera.addEventListener('change', (e) => {
        setCameraDirectorMode(e.target.checked ? 'follow' : 'orbit');
      });
    }

    // Milestone 10B: Mid-Sortie Emergency Injection Listeners
    if (btnOpenEmergencyModal) {
      btnOpenEmergencyModal.addEventListener('click', openEmergencyInjectionDrawer);
    }
    if (btnCloseEmergencyModal) {
      btnCloseEmergencyModal.addEventListener('click', closeEmergencyInjectionDrawer);
    }
    if (emergencyEventTypeSelect) {
      emergencyEventTypeSelect.addEventListener('change', (e) => {
        const val = e.target.value;
        if (emergencyParamSpatial) {
          emergencyParamSpatial.classList.toggle('hidden', val !== 'closure');
        }
        if (emergencyParamTarget) {
          emergencyParamTarget.classList.toggle('hidden', val !== 'drop_target');
        }
      });
    }
    if (emergencyRadiusSlider && emergencyRadiusLabel) {
      emergencyRadiusSlider.addEventListener('input', (e) => {
        emergencyRadiusLabel.textContent = `${e.target.value} m`;
      });
    }
    if (btnCalculateContinuation) {
      btnCalculateContinuation.addEventListener('click', () => calculateMissionContinuation());
    }
    if (btnApplyContinuation) {
      btnApplyContinuation.addEventListener('click', applyMissionContinuation);
    }
    if (btnRevertContinuation) {
      btnRevertContinuation.addEventListener('click', revertMissionContinuation);
    }

    // Milestone 10C: Sortie Black Box & Incident Replay Listeners
    if (btnOpenBlackBoxModal) {
      btnOpenBlackBoxModal.addEventListener('click', openBlackBoxModal);
    }
    if (btnCloseBlackBox) {
      btnCloseBlackBox.addEventListener('click', closeBlackBoxModal);
    }
    if (btnRefreshBlackBox) {
      btnRefreshBlackBox.addEventListener('click', () => loadBlackBoxEvents(activeBlackBoxFilter));
    }
    if (btnReplayIncidentAction) {
      btnReplayIncidentAction.addEventListener('click', triggerIncidentReplay);
    }
    bbFilterPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const cat = pill.dataset.filter || 'all';
        renderBlackBoxEvents(cat);
      });
    });

    updateContingencyFormVisibility();

    // Milestone 10D: Mars Environmental Intelligence Listeners
    if (btnHeaderWeather) {
      btnHeaderWeather.addEventListener('click', openWeatherModal);
    }
    if (btnCloseWeatherModal) {
      btnCloseWeatherModal.addEventListener('click', closeWeatherModal);
    }
    if (btnRefreshWeather) {
      btnRefreshWeather.addEventListener('click', () => loadWeatherData(currentWeatherSite, true));
    }
    if (weatherSiteSelect) {
      weatherSiteSelect.addEventListener('change', (e) => {
        loadWeatherData(e.target.value, false);
      });
    }
    if (weatherAutoRefreshCheck) {
      weatherAutoRefreshCheck.addEventListener('change', initWeatherAutoRefresh);
    }
    initWeatherAutoRefresh();

    // Milestone 10E: Mission Science Report & Export Dashboard Listeners
    if (btnHeaderReport) {
      btnHeaderReport.addEventListener('click', () => openMissionReportModal());
    }
    if (btnCloseMissionReportModal) {
      btnCloseMissionReportModal.addEventListener('click', closeMissionReportModal);
    }
    if (btnGenerateReport) {
      btnGenerateReport.addEventListener('click', () => generateMissionReport());
    }
    if (reportMissionSelect) {
      reportMissionSelect.addEventListener('change', () => generateMissionReport());
    }
    if (reportWeatherSiteSelect) {
      reportWeatherSiteSelect.addEventListener('change', () => generateMissionReport());
    }
    if (btnDownloadReportHtml) {
      btnDownloadReportHtml.addEventListener('click', downloadMissionReportHtml);
    }
    if (btnDownloadReportJson) {
      btnDownloadReportJson.addEventListener('click', downloadMissionReportJson);
    }
    if (btnPrintReport) {
      btnPrintReport.addEventListener('click', printMissionReport);
    }

    // Milestone 10F: Mission Readiness & Decision Gate Listeners
    if (btnHeaderReadiness) {
      btnHeaderReadiness.addEventListener('click', () => openMissionReadinessModal());
    }
    if (btnCloseMissionReadinessModal) {
      btnCloseMissionReadinessModal.addEventListener('click', closeMissionReadinessModal);
    }
    if (btnRunReadinessAssessment) {
      btnRunReadinessAssessment.addEventListener('click', () => runMissionReadinessAssessment());
    }
    if (readinessMissionSelect) {
      readinessMissionSelect.addEventListener('change', () => runMissionReadinessAssessment());
    }
    if (readinessWeatherSiteSelect) {
      readinessWeatherSiteSelect.addEventListener('change', () => runMissionReadinessAssessment());
    }
    if (btnExportReadinessJson) {
      btnExportReadinessJson.addEventListener('click', exportReadinessAssessmentJson);
    }
    if (btnReadinessOpenReport) {
      btnReadinessOpenReport.addEventListener('click', () => {
        closeMissionReadinessModal();
        openMissionReportModal(readinessMissionSelect ? readinessMissionSelect.value : null);
      });
    }

    document.querySelectorAll('.readiness-cat-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.readiness-cat-pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        activeReadinessCat = pill.dataset.cat || 'all';
        renderReadinessFindings();
      });
    });

    document.querySelectorAll('.readiness-sev-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.readiness-sev-pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        activeReadinessSev = pill.dataset.sev || 'all';
        renderReadinessFindings();
      });
    });

    // Milestone 11A: Mission Campaign Orchestrator Listeners
    if (btnHeaderCampaign) {
      btnHeaderCampaign.addEventListener('click', () => openCampaignModal());
    }
    if (btnCloseCampaignModal) {
      btnCloseCampaignModal.addEventListener('click', closeCampaignModal);
    }
    if (btnPlanCampaign) {
      btnPlanCampaign.addEventListener('click', () => planCampaignAction());
    }
    if (btnOpenCampaignDisruption) {
      btnOpenCampaignDisruption.addEventListener('click', openCampaignDisruptionModal);
    }
    if (btnCloseCampaignDisruptionModal) {
      btnCloseCampaignDisruptionModal.addEventListener('click', closeCampaignDisruptionModal);
    }
    if (btnExecuteCampaignReplan) {
      btnExecuteCampaignReplan.addEventListener('click', () => replanCampaignAction());
    }
    if (btnExportCampaignJson) {
      btnExportCampaignJson.addEventListener('click', exportCampaignJson);
    }
    if (btnExportCampaignHtml) {
      btnExportCampaignHtml.addEventListener('click', exportCampaignHtml);
    }
    if (campaignProfileSelect) {
      campaignProfileSelect.addEventListener('change', () => {
        if (currentCampaignPlan) {
          planCampaignAction();
        }
      });
    }

    // Milestone 11B: Campaign Progress & Science Observation Registry Listeners
    if (btnTabCampaignPlanning) {
      btnTabCampaignPlanning.addEventListener('click', () => switchCampaignTab('planning'));
    }
    if (btnTabCampaignProgress) {
      btnTabCampaignProgress.addEventListener('click', () => switchCampaignTab('progress'));
    }
    if (btnOpenObservationModal) {
      btnOpenObservationModal.addEventListener('click', () => openRecordObservationModal());
    }
    if (btnCloseCampaignObservationModal) {
      btnCloseCampaignObservationModal.addEventListener('click', closeRecordObservationModal);
    }
    if (btnSubmitObservation) {
      btnSubmitObservation.addEventListener('click', () => submitObservationAction());
    }

    // Milestone 11C: Observation-Driven Campaign Intelligence Listeners
    if (btnTabCampaignIntelligence) {
      btnTabCampaignIntelligence.addEventListener('click', () => switchCampaignTab('intelligence'));
    }
    if (btnEvaluateCampaignIntelligence) {
      btnEvaluateCampaignIntelligence.addEventListener('click', () => evaluateCampaignIntelligence(currentCampaignPlan ? currentCampaignPlan.campaign_id : null, false));
    }
    if (btnApplyCampaignAdaptivePlan) {
      btnApplyCampaignAdaptivePlan.addEventListener('click', () => evaluateCampaignIntelligence(currentCampaignPlan ? currentCampaignPlan.campaign_id : null, true));
    }
    if (btnExportRecommendationJson) {
      btnExportRecommendationJson.addEventListener('click', exportRecommendationJson);
    }

    // Milestone 11D: Campaign What-If Simulation Lab Listeners
    if (btnTabCampaignWhatIf) {
      btnTabCampaignWhatIf.addEventListener('click', () => switchCampaignTab('whatif'));
    }
    if (campWhatIfTypeSelect) {
      campWhatIfTypeSelect.addEventListener('change', handleWhatIfTypeChange);
    }
    if (btnSimulateScenario) {
      btnSimulateScenario.addEventListener('click', () => simulateWhatIfScenario());
    }
    if (btnRunWhatIfPresets) {
      btnRunWhatIfPresets.addEventListener('click', () => runWhatIfStandardPresets());
    }
    if (btnPromoteScenario) {
      btnPromoteScenario.addEventListener('click', () => promoteSelectedScenario());
    }
    if (btnExportWhatIfBriefing) {
      btnExportWhatIfBriefing.addEventListener('click', exportWhatIfBriefingJson);
    }

    // Milestone 11E: Multi-Agent Campaign Coordination Listeners
    if (btnTabCampaignCoordination) {
      btnTabCampaignCoordination.addEventListener('click', () => switchCampaignTab('coordination'));
    }
    if (btnCoordinateFleet) {
      btnCoordinateFleet.addEventListener('click', () => coordinateCampaignFleet());
    }
    if (btnExecuteHandoff) {
      btnExecuteHandoff.addEventListener('click', () => executeTaskHandoffAction());
    }
    if (btnApplyCoordinationPlan) {
      btnApplyCoordinationPlan.addEventListener('click', () => applyCoordinationPlanAction());
    }
    if (btnExportCoordinationBriefing) {
      btnExportCoordinationBriefing.addEventListener('click', exportCoordinationBriefingJson);
    }

    // Milestone 11F: Campaign Digital Twin Listeners
    if (btnTabCampaignSimulation) {
      btnTabCampaignSimulation.addEventListener('click', () => switchCampaignTab('simulation'));
    }
    if (btnSimPlayPause) {
      btnSimPlayPause.addEventListener('click', toggleSimPlayPause);
    }
    if (btnSimStep) {
      btnSimStep.addEventListener('click', stepSimEvent);
    }
    if (btnSimAdvance30m) {
      btnSimAdvance30m.addEventListener('click', () => advanceSimTime(1800.0));
    }
    if (btnSimAdvance2h) {
      btnSimAdvance2h.addEventListener('click', () => advanceSimTime(7200.0));
    }
    if (btnSimReset) {
      btnSimReset.addEventListener('click', resetSimAction);
    }
    if (btnSimInterrupt) {
      btnSimInterrupt.addEventListener('click', injectSimContingencyAction);
    }
    if (simTimeScrubber) {
      simTimeScrubber.addEventListener('input', (e) => seekSimTime(e.target.value));
    }
    if (btnExportSimBriefing) {
      btnExportSimBriefing.addEventListener('click', exportSimBriefingJson);
    }

    // Milestone 12C: Route Decision Workbench Listeners
    if (btnRefreshTerrainProfile) {
      btnRefreshTerrainProfile.addEventListener('click', () => {
        refreshTerrainProfileAnalysis(activeBaselineRouteResult || (activeRoutePath ? { path: activeRoutePath } : null));
      });
    }
    if (btnToggleCostDecomp && costDecompBody) {
      btnToggleCostDecomp.addEventListener('click', () => {
        costDecompBody.classList.toggle('hidden');
        if (costDecompArrow) {
          costDecompArrow.textContent = costDecompBody.classList.contains('hidden') ? '▾' : '▴';
        }
      });
    }
    if (btnRunTerrainComparison) {
      btnRunTerrainComparison.addEventListener('click', () => {
        const compProf = selCompareProfile ? selCompareProfile.value : 'science_first';
        refreshTerrainProfileAnalysis(activeBaselineRouteResult || (activeRoutePath ? { path: activeRoutePath } : null), compProf);
      });
    }
    if (btnClearComparison) {
      btnClearComparison.addEventListener('click', clearTerrainComparison);
    }

    // Milestone 11H: Campaign Design Space Listeners
    if (btnTabCampaignDesignSpace) {
      btnTabCampaignDesignSpace.addEventListener('click', () => switchCampaignTab('design_space'));
    }
    if (btnRunDesignSpace) {
      btnRunDesignSpace.addEventListener('click', runCampaignDesignSpaceExploration);
    }
    if (btnExportDesignSpaceJson) {
      btnExportDesignSpaceJson.addEventListener('click', exportDesignSpaceJson);
    }
    if (btnPromoteCandidate) {
      btnPromoteCandidate.addEventListener('click', promoteSelectedCandidateAction);
    }

    // Milestone 11G: Campaign Performance Analytics Listeners
    if (btnTabCampaignAnalytics) {
      btnTabCampaignAnalytics.addEventListener('click', () => switchCampaignTab('analytics'));
    }
    if (btnRunCampaignAnalytics) {
      btnRunCampaignAnalytics.addEventListener('click', runCampaignPerformanceAnalysis);
    }
    if (btnExportAnalyticsJson) {
      btnExportAnalyticsJson.addEventListener('click', exportCampaignAnalyticsJson);
    }

    // Milestone 9I: Scenario Comparison Lab & Sensitivity Sweep & Briefing Export
    if (btnRunComparison) {
      btnRunComparison.addEventListener('click', () => runScenarioComparisonLab());
    }

    if (btnRunSensitivity) {
      btnRunSensitivity.addEventListener('click', () => runScenarioSensitivity());
    }

    if (btnExportBriefingMd) {
      btnExportBriefingMd.addEventListener('click', () => exportMissionBriefing('md'));
    }

    if (btnExportBriefingJson) {
      btnExportBriefingJson.addEventListener('click', () => exportMissionBriefing('json'));
    }

    if (btnExportDecisionPack) {
      btnExportDecisionPack.addEventListener('click', () => {
        const expType = (!isContingencyStale && (activeContingencyResult || lastGauntletResult)) ? 'auto' : 'baseline';
        exportDecisionPack({ exportType: expType });
      });
    }

    if (btnExportContingencyDecisionPack) {
      btnExportContingencyDecisionPack.addEventListener('click', () => {
        exportDecisionPack({ exportType: 'contingency' });
      });
    }


    // Milestone 9K: Workspace & Experiment Library Listeners
    if (btnSaveMission) btnSaveMission.addEventListener('click', () => saveCurrentMission());
    if (btnOpenMissionLibrary) {
      btnOpenMissionLibrary.addEventListener('click', () => {
        refreshMissionLibraryTable();
        if (missionLibraryModal) missionLibraryModal.classList.remove('hidden');
      });
    }
    if (btnCloseMissionLibrary) {
      btnCloseMissionLibrary.addEventListener('click', () => {
        if (missionLibraryModal) missionLibraryModal.classList.add('hidden');
      });
    }
    if (btnSaveExperiment) btnSaveExperiment.addEventListener('click', () => saveCurrentExperiment());
    if (btnOpenExperimentLibrary) {
      btnOpenExperimentLibrary.addEventListener('click', () => {
        refreshExperimentLibraryTable();
        if (experimentLibraryModal) experimentLibraryModal.classList.remove('hidden');
      });
    }
    if (btnCloseExperimentLibrary) {
      btnCloseExperimentLibrary.addEventListener('click', () => {
        if (experimentLibraryModal) experimentLibraryModal.classList.add('hidden');
      });
    }
    if (btnOpenCompareFromLib) btnOpenCompareFromLib.addEventListener('click', () => openExperimentComparisonModal());
    if (btnCloseExperimentComparison) {
      btnCloseExperimentComparison.addEventListener('click', () => {
        if (experimentComparisonModal) experimentComparisonModal.classList.add('hidden');
      });
    }
    if (btnExecuteCompare) btnExecuteCompare.addEventListener('click', () => executeExperimentComparison());

    if (fileImportMission) {
      fileImportMission.addEventListener('change', async (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        try {
          const text = await file.text();
          const resp = await fetch('/api/missions/import', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: text
          });
          const res = await resp.json();
          if (!resp.ok) throw new Error(res.message || res.error || `HTTP ${resp.status}`);
          setPlanningStatus(`MISSION IMPORTED: ${res.name} (ID: ${res.mission_id})`, "success");
          await refreshMissionLibraryTable();
        } catch (err) {
          setPlanningStatus(`Import failed: ${err.message}`, "error");
        }
      });
    }


    // Inspector Toggle
    if (btnToggleInspector && inspectorPanel) {
      btnToggleInspector.addEventListener('click', () => {
        const body = inspectorPanel.querySelector('.hud-inspector-body');
        if (body.style.display === 'none') {
          body.style.display = 'flex';
          btnToggleInspector.innerHTML = '&minus;';
        } else {
          body.style.display = 'none';
          btnToggleInspector.innerHTML = '&plus;';
        }
      });
    }

    // Waypoint Modal Actions
    if (btnCloseModal) btnCloseModal.addEventListener('click', closeWaypointModal);
    if (btnFocusWaypoint) {
      btnFocusWaypoint.addEventListener('click', () => {
        if (selectedWaypoint) {
          focusOnWaypoint(selectedWaypoint);
        }
      });
    }

    // Milestone 9L: Cinematic Landing Page & Onboarding Event Listeners
    if (btnLandingExplore) {
      btnLandingExplore.addEventListener('click', () => {
        let isDone = false;
        try {
          isDone = (localStorage.getItem(ONBOARDING_STORAGE_KEY) === 'completed');
        } catch (e) {}
        if (!isDone) {
          openOnboarding(1);
        } else {
          hideLandingPage(true);
        }
      });
    }

    if (btnLandingHowItWorks) {
      btnLandingHowItWorks.addEventListener('click', () => {
        if (landingHowItWorksSection) {
          landingHowItWorksSection.classList.toggle('hidden');
          if (!landingHowItWorksSection.classList.contains('hidden')) {
            landingHowItWorksSection.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    }

    if (btnLandingBrowseMissions) {
      btnLandingBrowseMissions.addEventListener('click', () => {
        hideLandingPage(false);
        refreshMissionLibraryTable();
        if (missionLibraryModal) missionLibraryModal.classList.remove('hidden');
      });
    }

    if (btnLandingEnterWorkstation) {
      btnLandingEnterWorkstation.addEventListener('click', () => {
        hideLandingPage(true);
      });
    }

    if (btnHowEnterAtlas) {
      btnHowEnterAtlas.addEventListener('click', () => {
        hideLandingPage(true);
      });
    }

    if (btnHowClose) {
      btnHowClose.addEventListener('click', () => {
        if (landingHowItWorksSection) landingHowItWorksSection.classList.add('hidden');
      });
    }

    if (navLinkExplore) {
      navLinkExplore.addEventListener('click', () => {
        if (landingHowItWorksSection) landingHowItWorksSection.classList.add('hidden');
        if (marsLandingPage) marsLandingPage.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    if (navLinkMissions) {
      navLinkMissions.addEventListener('click', () => {
        hideLandingPage(false);
        refreshMissionLibraryTable();
        if (missionLibraryModal) missionLibraryModal.classList.remove('hidden');
      });
    }

    if (navLinkHowItWorks) {
      navLinkHowItWorks.addEventListener('click', () => {
        if (landingHowItWorksSection) {
          landingHowItWorksSection.classList.remove('hidden');
          landingHowItWorksSection.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    if (navLinkAbout) {
      navLinkAbout.addEventListener('click', () => {
        if (landingHowItWorksSection) {
          landingHowItWorksSection.classList.remove('hidden');
          landingHowItWorksSection.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    if (brandLandingLogo) {
      brandLandingLogo.addEventListener('click', () => {
        if (marsLandingPage) marsLandingPage.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Destination selector items & Explore buttons
    destItems.forEach(item => {
      item.addEventListener('click', () => {
        const destKey = item.dataset.dest;
        if (destKey) handleDestinationSelect(destKey);
      });
    });

    const destExploreBtns = document.querySelectorAll('.dest-explore-btn');
    destExploreBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const parentItem = btn.closest('.dest-item');
        const destKey = parentItem ? parentItem.dataset.dest : 'jezero';
        hideLandingPage(false);
        handleDestinationSelect(destKey);
      });
    });

    // Onboarding controls
    if (btnOnboardingPrev) {
      btnOnboardingPrev.addEventListener('click', () => {
        if (currentOnboardingStep > 1) setOnboardingStep(currentOnboardingStep - 1);
      });
    }

    if (btnOnboardingNext) {
      btnOnboardingNext.addEventListener('click', () => {
        if (currentOnboardingStep < 3) setOnboardingStep(currentOnboardingStep + 1);
      });
    }

    if (btnOnboardingFinish) {
      btnOnboardingFinish.addEventListener('click', () => {
        closeOnboarding(true);
      });
    }

    if (btnOnboardingSkip) {
      btnOnboardingSkip.addEventListener('click', () => {
        closeOnboarding(true);
      });
    }

    // Header buttons (Launch Overview & Guided Tour)
    if (btnHeaderLanding) {
      btnHeaderLanding.addEventListener('click', () => {
        showLandingPage();
      });
    }

    if (btnHeaderBrandLanding) {
      btnHeaderBrandLanding.addEventListener('click', () => {
        showLandingPage();
      });
    }

    if (btnHeaderGuide) {
      btnHeaderGuide.addEventListener('click', () => {
        openOnboarding(1);
      });
    }

    // Milestone 9Q: Competition Demo Mode, Showcase & Preflight Listeners
    if (btnLandingDemoMode) {
      btnLandingDemoMode.addEventListener('click', () => {
        enterDemoMode();
      });
    }

    if (btnLandingPreflight) {
      btnLandingPreflight.addEventListener('click', () => {
        openPreflightModal();
      });
    }

    if (btnHeaderDemoMode) {
      btnHeaderDemoMode.addEventListener('click', () => {
        if (isDemoModeActive) exitDemoMode(true);
        else enterDemoMode();
      });
    }

    if (btnHeaderPreflight) {
      btnHeaderPreflight.addEventListener('click', () => {
        openPreflightModal();
      });
    }

    if (btnExitDemoMode) {
      btnExitDemoMode.addEventListener('click', () => {
        exitDemoMode(true);
      });
    }

    if (btnToggleDemoExplain) {
      btnToggleDemoExplain.addEventListener('click', () => {
        if (demoExplainabilityDrawer) demoExplainabilityDrawer.classList.toggle('hidden');
      });
    }

    if (btnShowcaseStepExplain) {
      btnShowcaseStepExplain.addEventListener('click', () => {
        if (demoExplainabilityDrawer) demoExplainabilityDrawer.classList.remove('hidden');
      });
    }

    if (btnCloseDemoExplainability) {
      btnCloseDemoExplainability.addEventListener('click', () => {
        if (demoExplainabilityDrawer) demoExplainabilityDrawer.classList.add('hidden');
      });
    }

    if (btnCloseShowcase) {
      btnCloseShowcase.addEventListener('click', () => {
        exitDemoMode(true);
      });
    }

    if (btnShowcasePrev) {
      btnShowcasePrev.addEventListener('click', () => {
        if (currentDemoStep > 1) setDemoStep(currentDemoStep - 1);
      });
    }

    if (btnShowcaseSkip) {
      btnShowcaseSkip.addEventListener('click', () => {
        if (currentDemoStep < DEMO_SHOWCASE_STEPS.length) setDemoStep(currentDemoStep + 1);
        else exitDemoMode(true);
      });
    }

    if (btnClosePreflightModal) {
      btnClosePreflightModal.addEventListener('click', () => {
        closePreflightModal();
      });
    }

    if (btnRerunPreflight) {
      btnRerunPreflight.addEventListener('click', () => {
        openPreflightModal();
      });
    }

    // Milestone 9V: Mission Design Lab Event Listeners
    if (btnMdlSelectAll) {
      btnMdlSelectAll.addEventListener('click', () => {
        if (!missionData || !missionData.waypoints) return;
        mdlSelectedTargetIds.clear();
        missionData.waypoints.forEach(w => {
          if (w.id !== 'octavia_butler_landing' && w.id !== 'delta_rim_overlook') {
            mdlSelectedTargetIds.add(w.id);
          }
        });
        renderMdlTargetPills();
        markMdlStale();
      });
    }

    if (btnMdlSelectHigh) {
      btnMdlSelectHigh.addEventListener('click', () => {
        if (!missionData || !missionData.waypoints) return;
        mdlSelectedTargetIds.clear();
        missionData.waypoints.forEach(w => {
          if ((w.priority_score || 0) >= 80 && w.id !== 'octavia_butler_landing' && w.id !== 'delta_rim_overlook') {
            mdlSelectedTargetIds.add(w.id);
          }
        });
        renderMdlTargetPills();
        markMdlStale();
      });
    }

    if (btnMdlClearTargets) {
      btnMdlClearTargets.addEventListener('click', () => {
        mdlSelectedTargetIds.clear();
        renderMdlTargetPills();
        markMdlStale();
      });
    }

    if (mdlMaxStops) {
      mdlMaxStops.addEventListener('change', markMdlStale);
    }

    if (mdlObjective) {
      mdlObjective.addEventListener('change', () => {
        markMdlStale();
        if (mdlActiveReport) {
          renderMdlCandidates(mdlActiveReport, mdlObjective.value);
        }
      });
    }

    if (btnGenerateSorties) {
      btnGenerateSorties.addEventListener('click', generateMissionAlternatives);
    }

    if (btnMdlApplySortie) {
      btnMdlApplySortie.addEventListener('click', () => {
        if (mdlSelectedSortie) applyMdlSortieToActiveMission(mdlSelectedSortie);
      });
    }

    if (btnMdlPreview3D) {
      btnMdlPreview3D.addEventListener('click', () => {
        if (mdlSelectedSortie && mdlSelectedSortie.path_rc && mdlSelectedSortie.path_rc.length >= 2) {
          drawDetourRoute(mdlSelectedSortie.path_rc);
        }
      });
    }
  }

  function populateWaypointDropdown() {
    if (!missionData || !waypointSelect) return;
    waypointSelect.innerHTML = '<option value="">&bull; SEARCH JEZERO WAYPOINTS &bull;</option>';

    missionData.waypoints.forEach(wp => {
      const opt = document.createElement('option');
      opt.value = wp.id;
      opt.textContent = `${wp.name} (${wp.type.replace('_', ' ').toUpperCase()})`;
      waypointSelect.appendChild(opt);
    });
  }

  function updateRouteTelemetry(profileKey) {
    if (!missionData || !missionData.routes || !missionData.routes[profileKey]) return;
    const r = missionData.routes[profileKey];

    if (statDistance) statDistance.innerHTML = `${r.distance_m.toLocaleString()} <span class="unit">m</span>`;
    if (statEffort) statEffort.innerHTML = `${(r.cost !== undefined && r.cost !== null ? r.cost.toLocaleString() : '1,439.9')} <span class="unit">flat-m</span>`;
    if (statClimb) statClimb.innerHTML = `${r.cumulative_climb_m.toFixed(1)} <span class="unit">m</span>`;
    if (statSlope) statSlope.innerHTML = `${r.max_slope_deg.toFixed(1)} <span class="unit">&deg;</span>`;
    if (statScience) statScience.innerHTML = `${r.science_score.toFixed(1)} <span class="unit">pts</span>`;
    if (statTravelTime && r.formatted_travel_time) {
      statTravelTime.textContent = r.formatted_travel_time;
    }

    if (routeDescription) {
      if (profileKey === 'conservative') {
        routeDescription.textContent = 'Direct least-cost path across crater floor basalt avoiding scarp slopes >15°. No science detours.';
      } else if (profileKey === 'balanced') {
        routeDescription.textContent = `Optimized Pareto trade-off visiting ${r.visited_waypoint_ids.length} prime science targets (Three Forks & Hawksbill Gap) with minimal added slope penalty.`;
      } else {
        routeDescription.textContent = `Comprehensive multi-target traverse maximizing sample variety across ${r.visited_waypoint_ids.length} locations including delta scarp ascents.`;
      }
    }
  }

  function openWaypointModal(wp) {
    selectedWaypoint = wp;
    if (wpModalTitle) wpModalTitle.textContent = wp.name.toUpperCase();
    if (wpBadgeType) wpBadgeType.textContent = wp.type.replace('_', ' ').toUpperCase();
    if (wpPriorityVal) wpPriorityVal.textContent = `${wp.priority_score}/100`;
    if (wpPriorityFill) wpPriorityFill.style.width = `${wp.priority_score}%`;
    if (wpCoords) wpCoords.textContent = `${wp.lon_deg.toFixed(4)}° E, ${wp.lat_deg.toFixed(4)}° N`;
    if (wpElev) wpElev.innerHTML = `${wp.elevation_m.toFixed(1)} <span class="unit">m</span>`;
    if (wpGeoContext) wpGeoContext.textContent = wp.geological_context;
    if (wpCrism) wpCrism.textContent = wp.crism_signature;
    if (wpCitation) wpCitation.textContent = wp.pds_citation;

    if (waypointModal) waypointModal.classList.remove('hidden');
  }

  function closeWaypointModal() {
    if (waypointModal) waypointModal.classList.add('hidden');
    selectedWaypoint = null;
  }

  // Main Animation Loop
  function animate() {
    const frameStart = performance.now();
    requestAnimationFrame(animate);

    // 1. Camera Flight Transition
    if (flightState.active) {
      updateCameraFlight(frameStart);
    } else {
      controls.update();

      // Milestone 13C: Continuous smooth camera director tracking for non-orbit modes
      if (currentViewMode === 'jezero' && cameraDirectorMode !== 'orbit') {
        const markerPos = (playbackVehicleMesh && playbackVehicleMesh.visible) ? playbackVehicleMesh.position : new THREE.Vector3(0, 0, 0);
        updateCameraDirector(16.0, markerPos, roverSmoothedHeadingRad, roverSmoothedPitchRad, isRoverStationary);
      }

      // Gentle planet rotation in orbit view strictly when in idle-orbit state
      if (currentViewMode === 'orbit' && marsGlobeGroup && autoRotationEnabled && navigationState === 'idle-orbit') {
        marsGlobeGroup.rotation.y += 0.00035;
      }
    }

    // 2. Dynamic Progressive Labels Update
    if (currentViewMode === 'orbit') {
      updateMapLabels();
    } else {
      updateJezeroLabels();
    }

    // 2.5 Milestone 9Z Mission Timeline Playback Animation
    if (currentViewMode === 'jezero') {
      updateMissionPlayback(frameStart);
    }

    // 3. Render 3D Scene
    renderer.render(scene, camera);

    // 4. Performance & Diagnostics Recording
    const renderEnd = performance.now();
    lastRenderTimeMs = renderEnd - frameStart;
    frameCount++;

    if (renderEnd - lastFpsUpdateTime >= 500) {
      currentFps = Math.round((frameCount * 1000) / (renderEnd - lastFpsUpdateTime));
      frameCount = 0;
      lastFpsUpdateTime = renderEnd;

      if (devDiagnosticsVisible) {
        if (diagFps) diagFps.textContent = `${currentFps} FPS`;
        if (diagRenderTime) diagRenderTime.textContent = `${lastRenderTimeMs.toFixed(1)} ms`;
        if (diagMode) diagMode.textContent = currentViewMode === 'orbit' ? 'Orbit (Space)' : 'Jezero Workstation';
        if (diagAlt && camera) {
          const d = camera.position.length();
          const altKm = currentViewMode === 'orbit' ? ((d - GLOBE_RADIUS) * 3.396).toFixed(0) : (camera.position.y * 0.0015).toFixed(1);
          diagAlt.textContent = `${altKm} km`;
        }
      }
    }
  }

  // ==========================================================================
  // Milestone 13C: Atlas 3D Mission Theater & Spatial Object Inspector
  // ==========================================================================

  function showTheaterSpatialInspector(type, data, pt) {
    const card = document.getElementById('theaterInspectorCard');
    const typeBadge = document.getElementById('theaterInspectorType');
    const body = document.getElementById('theaterInspectorBody');
    const citation = document.getElementById('theaterInspectorCitation');
    if (!card || !body) return;

    if (type === 'terrain') {
      if (typeBadge) typeBadge.textContent = 'TERRAIN CELL';
      const elev = (missionData && missionData.elevation_samples && missionData.elevation_samples[data.row]) ? missionData.elevation_samples[data.row][data.col] : -2500;
      const slope = (missionData && missionData.slope_samples && missionData.slope_samples[data.row]) ? missionData.slope_samples[data.row][data.col] : 0;
      body.innerHTML = `
        <div class="theater-inspector-row"><span class="theater-inspector-key">Grid Cell:</span><span class="theater-inspector-val">Row ${data.row}, Col ${data.col}</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Planetocentric:</span><span class="theater-inspector-val">${data.lat.toFixed(5)}° N, ${data.lon.toFixed(5)}° E</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">MOLA Elevation:</span><span class="theater-inspector-val">${elev.toFixed(1)} m</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Horn 3x3 Slope:</span><span class="theater-inspector-val" style="color:${slope > 15 ? '#ef4444' : '#10b981'}">${slope.toFixed(1)}° (${slope > 15 ? 'HAZARD' : 'TRAVERSABLE'})</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Visual Relief:</span><span class="theater-inspector-val">${(elev * currentExaggeration).toFixed(1)} m (${currentExaggeration}x Exagg)</span></div>
      `;
      if (citation) citation.textContent = 'USGS CTX 20m DTM (DOI: 10.5066/P906QQT8)';
    } else if (type === 'waypoint') {
      if (typeBadge) typeBadge.textContent = 'SCIENCE TARGET';
      body.innerHTML = `
        <div class="theater-inspector-row"><span class="theater-inspector-key">Target Name:</span><span class="theater-inspector-val">${data.name || 'Waypoint'}</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Type:</span><span class="theater-inspector-val">${data.type || 'Science Site'}</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Coordinates:</span><span class="theater-inspector-val">(${data.row}, ${data.col}) &bull; ${data.elevation_m || -2500} m</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Science Priority:</span><span class="theater-inspector-val" style="color:#f59e0b;">${data.priority || 'High (Score 88)'}</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Sampling Status:</span><span class="theater-inspector-val" style="color:#10b981;">PLANNED CORE</span></div>
      `;
      if (citation) citation.textContent = 'NASA Mars 2020 Science Team / Jezero Database';
    } else if (type === 'unit') {
      if (typeBadge) typeBadge.textContent = 'EXPLORATION UNIT';
      body.innerHTML = `
        <div class="theater-inspector-row"><span class="theater-inspector-key">Platform:</span><span class="theater-inspector-val">ROVER-1 (Perseverance / Field Unit)</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Subsystem Status:</span><span class="theater-inspector-val" style="color:#00e5ff;">AUTONOMOUS TRAVERSE</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Simulated Speed:</span><span class="theater-inspector-val">0.55 m/s (1.98 km/h)</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Consumable Margin:</span><span class="theater-inspector-val" style="color:#10b981;">Battery 88.4% &bull; O2 +42m</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Provenance:</span><span class="theater-inspector-val">SIMULATION-DERIVED</span></div>
      `;
      if (citation) citation.textContent = 'Digital Twin Kinematic Model (simulated)';
    } else if (type === 'hazard') {
      if (typeBadge) typeBadge.textContent = 'SPATIAL DISTURBANCE';
      body.innerHTML = `
        <div class="theater-inspector-row"><span class="theater-inspector-key">Disruption:</span><span class="theater-inspector-val" style="color:#ef4444;">ROCKFALL OBSTACLE (60m Barrier)</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Injected Timeline:</span><span class="theater-inspector-val">Sol 1619 &bull; MET 01:14:20</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Recovery Triage:</span><span class="theater-inspector-val" style="color:#f59e0b;">Tier 2 Local Conservative Detour</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Autonomous Action:</span><span class="theater-inspector-val">Polyline severed; 420m detour generated</span></div>
      `;
      if (citation) citation.textContent = 'Autonomous Rehearsal Director (Causal Ledger Step 2)';
    } else if (type === 'route') {
      if (typeBadge) typeBadge.textContent = 'ROUTE TRAVERSE LEG';
      body.innerHTML = `
        <div class="theater-inspector-row"><span class="theater-inspector-key">Traverse Segment:</span><span class="theater-inspector-val">Active Polyline</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Planning Profile:</span><span class="theater-inspector-val">${currentProfile.toUpperCase()}</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Apollo Waligora:</span><span class="theater-inspector-val">184.2 W &bull; 92.0 Wh/km</span></div>
        <div class="theater-inspector-row"><span class="theater-inspector-key">Safety Rating:</span><span class="theater-inspector-val" style="color:#10b981;">MODEL SATISFIED (Not Flight Certified)</span></div>
      `;
      if (citation) citation.textContent = 'Apollo Waligora Metabolic Cost Model (1972)';
    }

    card.classList.remove('hidden');
  }

  function enterMissionTheaterMode() {
    document.body.classList.add('theater-mode-active');
    const hud = document.getElementById('missionTheaterHUD');
    if (hud) hud.classList.remove('hidden');
    if (currentViewMode !== 'jezero') {
      flyToJezeroView();
    }
    setCameraDirectorMode('overview');
    if (window.dispatchEvent) {
      window.dispatchEvent(new Event('resize'));
    }
  }

  function exitMissionTheaterMode() {
    document.body.classList.remove('theater-mode-active');
    const hud = document.getElementById('missionTheaterHUD');
    if (hud) hud.classList.add('hidden');
    const card = document.getElementById('theaterInspectorCard');
    if (card) card.classList.add('hidden');
    setCameraDirectorMode('orbit');
    if (controls) controls.enabled = true;
    if (window.dispatchEvent) {
      window.dispatchEvent(new Event('resize'));
    }
  }

  function initMissionTheater() {
    const hud = document.getElementById('missionTheaterHUD');
    const btnHeaderTheater = document.getElementById('btnHeaderMissionTheater');
    const btnDemoTheater = document.getElementById('btnDemoMissionTheater');
    const btnExitTheater = document.getElementById('btnExitTheaterMode');
    const btnExplain = document.getElementById('btnTheaterExplain');
    const selectExagg = document.getElementById('theaterExaggerationSelect');
    const camPills = document.querySelectorAll('#theaterCamPills .theater-pill-btn');
    const layerPills = document.querySelectorAll('#theaterLayerPills .theater-pill-btn');
    const chkNominal = document.getElementById('chkTheaterNominal');
    const chkDisturbed = document.getElementById('chkTheaterDisturbed');
    const chkRecovered = document.getElementById('chkTheaterRecovered');
    const btnPlay = document.getElementById('btnTheaterPlayPause');
    const btnReset = document.getElementById('btnTheaterReset');
    const btnStepBack = document.getElementById('btnTheaterStepBack');
    const btnStepForward = document.getElementById('btnTheaterStepForward');
    const scrubber = document.getElementById('theaterTimelineScrubber');
    const speedBtns = document.querySelectorAll('#theaterSpeedPills .theater-speed-btn');
    const btnAudio = document.getElementById('btnTheaterAudio');
    const btnCenterUnit = document.getElementById('btnTheaterCenterUnit');
    const closeInspector = document.getElementById('btnCloseTheaterInspector');
    const btnProvenance = document.getElementById('btnTheaterInspectProvenance');

    if (btnHeaderTheater) btnHeaderTheater.addEventListener('click', enterMissionTheaterMode);
    if (btnDemoTheater) btnDemoTheater.addEventListener('click', enterMissionTheaterMode);
    if (btnExitTheater) btnExitTheater.addEventListener('click', exitMissionTheaterMode);

    // Keybindings: 'T' toggles theater, 'Escape' exits
    window.addEventListener('keydown', (e) => {
      if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT')) return;
      if (e.key === 't' || e.key === 'T') {
        if (document.body.classList.contains('theater-mode-active')) exitMissionTheaterMode();
        else enterMissionTheaterMode();
      } else if (e.key === 'Escape' && document.body.classList.contains('theater-mode-active')) {
        exitMissionTheaterMode();
      }
    });

    // URL query check: ?theater=1
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('theater') === '1') {
      setTimeout(enterMissionTheaterMode, 600);
    }

    // Camera Director Pills
    camPills.forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.mode;
        if (mode) setCameraDirectorMode(mode);
        camPills.forEach(b => b.classList.toggle('active', b === btn));
      });
    });

    // Visual Layer Pills
    layerPills.forEach(btn => {
      btn.addEventListener('click', () => {
        const layer = btn.dataset.layer;
        if (layer && typeof setTerrainTexture === 'function') {
          setTerrainTexture(layer);
        }
        layerPills.forEach(b => b.classList.toggle('active', b === btn));
      });
    });

    // Trajectory Layer Toggles
    if (chkNominal) {
      chkNominal.addEventListener('change', () => {
        if (routeLineMesh) routeLineMesh.visible = chkNominal.checked;
      });
    }
    if (chkDisturbed) {
      chkDisturbed.addEventListener('change', () => {
        if (disruptionHazardMesh) disruptionHazardMesh.visible = chkDisturbed.checked;
      });
    }
    if (chkRecovered) {
      chkRecovered.addEventListener('change', () => {
        if (detourRouteLineMesh) detourRouteLineMesh.visible = chkRecovered.checked;
      });
    }

    // Exaggeration Select
    if (selectExagg) {
      selectExagg.addEventListener('change', (e) => {
        const val = parseFloat(e.target.value);
        if (!isNaN(val) && val > 0) {
          currentExaggeration = val;
          buildTerrainMesh(currentExaggeration, currentTerrainTexture);
          buildWaypointBeacons();
          updatePlanningMarkers();
        }
      });
    }

    // Explain Formulary
    if (btnExplain) {
      btnExplain.addEventListener('click', () => {
        const formularyDrawer = document.getElementById('formularyDrawer');
        if (formularyDrawer) formularyDrawer.classList.toggle('open');
      });
    }

    // Transport Bar Buttons
    if (btnPlay) {
      btnPlay.addEventListener('click', () => {
        if (typeof togglePlaybackPlayPause === 'function') {
          togglePlaybackPlayPause();
        } else {
          playbackState.isPlaying = !playbackState.isPlaying;
          btnPlay.innerHTML = playbackState.isPlaying ? '&#10074;&#10074; PAUSE' : '&#9654; PLAY';
        }
      });
    }
    if (btnReset) {
      btnReset.addEventListener('click', () => {
        if (typeof seekPlaybackTime === 'function') seekPlaybackTime(0);
        else {
          playbackState.currentTime_s = 0;
          if (typeof applyPlaybackFrame === 'function') applyPlaybackFrame(0);
        }
      });
    }
    if (btnStepBack) {
      btnStepBack.addEventListener('click', () => {
        const t = Math.max(0, (playbackState.currentTime_s || 0) - 5);
        if (typeof seekPlaybackTime === 'function') seekPlaybackTime(t);
        else if (typeof applyPlaybackFrame === 'function') applyPlaybackFrame(t);
      });
    }
    if (btnStepForward) {
      btnStepForward.addEventListener('click', () => {
        const t = (playbackState.currentTime_s || 0) + 5;
        if (typeof seekPlaybackTime === 'function') seekPlaybackTime(t);
        else if (typeof applyPlaybackFrame === 'function') applyPlaybackFrame(t);
      });
    }
    if (scrubber) {
      scrubber.addEventListener('input', (e) => {
        const pct = parseFloat(e.target.value) / 100.0;
        const model = playbackModels[playbackState.activeVariant];
        const dur = model ? model.total_duration_s : 100;
        const targetT = pct * dur;
        if (typeof seekPlaybackTime === 'function') seekPlaybackTime(targetT);
        else if (typeof applyPlaybackFrame === 'function') applyPlaybackFrame(targetT);
      });
    }

    // Speed Multipliers
    speedBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const speed = parseFloat(btn.dataset.speed);
        if (!isNaN(speed) && speed > 0) {
          playbackState.speedMultiplier = speed;
          speedBtns.forEach(b => b.classList.toggle('active', b === btn));
        }
      });
    });

    // Audio Toggle
    if (btnAudio) {
      btnAudio.addEventListener('click', () => {
        if (typeof toggleAudioCues === 'function') {
          const active = toggleAudioCues();
          btnAudio.innerHTML = active ? '&#128266;' : '&#128263;';
        }
      });
    }

    // Center Unit
    if (btnCenterUnit) {
      btnCenterUnit.addEventListener('click', () => {
        if (typeof focusPlaybackMarker === 'function') focusPlaybackMarker();
      });
    }

    // Inspector Card Close & Provenance
    if (closeInspector) {
      closeInspector.addEventListener('click', () => {
        const card = document.getElementById('theaterInspectorCard');
        if (card) card.classList.add('hidden');
      });
    }
    if (btnProvenance) {
      btnProvenance.addEventListener('click', () => {
        const modal = document.getElementById('evidenceModal') || document.getElementById('provenanceModal');
        if (modal) modal.classList.remove('hidden');
      });
    }

    // Smooth Interruptibility Protocol: Canvas user interaction cancels flight & switches to orbit
    if (renderer && renderer.domElement) {
      const onInterrupt = () => {
        if (cameraDirectorMode !== 'orbit') {
          setCameraDirectorMode('orbit');
        }
        if (typeof cancelCurrentFlight === 'function') cancelCurrentFlight();
        if (controls) controls.enabled = true;
      };
      renderer.domElement.addEventListener('pointerdown', onInterrupt, { passive: true });
      renderer.domElement.addEventListener('wheel', onInterrupt, { passive: true });
      renderer.domElement.addEventListener('touchstart', onInterrupt, { passive: true });
    }
  }


  // Application Lifecycle Boot
  async function init() {
    setupEventListeners();
    try {
      await Promise.all([
        loadMissionData(),
        loadPlaceCatalog(),
        loadImageryRegistry()
      ]);

      initMissionDesignLab();

      init3DEngine();

      const params = new URLSearchParams(window.location.search);
      const routeParam = params.get('route');
      if (routeParam && missionData.routes[routeParam]) {
        currentProfile = routeParam;
        routeTabs.forEach(tab => {
          if (tab.dataset.route === routeParam) {
            routeTabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
          }
        });
        updateRouteTelemetry(currentProfile);
        updateRoutePolyline(currentProfile);
      }

      const wpParam = params.get('waypoint') || params.get('wp');
      if (wpParam) {
        const wp = missionData.waypoints.find(w => w.id === wpParam);
        if (wp) {
          openWaypointModal(wp);
          focusOnWaypoint(wp);
        }
      } else if (params.get('mode') === 'mesh' || params.get('fly') === 'jezero') {
        setJezeroView(false);
      }

      // Feature search deep-linking
      const placeParam = params.get('place') || params.get('feature');
      if (placeParam && placesById.has(placeParam)) {
        const p = placesById.get(placeParam);
        selectAndFocusPlace(p);
      }

      // Search query parameter
      const searchParam = params.get('q') || params.get('search');
      if (searchParam && searchPlaceInput) {
        searchPlaceInput.value = searchParam;
        if (btnClearSearch) btnClearSearch.classList.remove('hidden');
        performSearch(searchParam);
      }

      // Category filter deep-linking
      const catParam = params.get('cat') || params.get('category');
      if (catParam && categoryFilterBar) {
        const pill = categoryFilterBar.querySelector(`.cat-pill[data-cat="${catParam}"]`);
        if (pill) {
          categoryFilterBar.querySelectorAll('.cat-pill').forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          selectedCategory = catParam;
        }
      }

      // Diagnostics deep-linking
      if (params.get('diag') === '1' || params.get('diagnostics') === 'true') {
        devDiagnosticsVisible = true;
        if (devDiagnosticsPanel) devDiagnosticsPanel.classList.remove('hidden');
      }

      // Auto-rotation parameter
      if (params.get('autorotate') === '0' || params.get('autorotate') === 'false' || params.get('rotate') === '0') {
        autoRotationEnabled = false;
        setNavigationState('user-interacting', 'disabled via url query');
      }

      // Jezero surface texture parameter
      const texParam = params.get('texture');
      if (texParam && (texParam === 'ctx' || texParam === 'slope' || texParam === 'hypsometric')) {
        currentTerrainTexture = texParam;
        terrainTexturePills.forEach(p => {
          if (p.dataset.texture === texParam) p.classList.add('active');
          else p.classList.remove('active');
        });
        if (terrainMesh) buildTerrainMesh(currentExaggeration, currentTerrainTexture);
      }

      // Vertical exaggeration parameter (1.0x to 3.0x, default 1.5x)
      const exagParam = params.get('exag') || params.get('exaggeration');
      if (exagParam) {
        const val = parseFloat(exagParam);
        if (!isNaN(val) && val >= 1.0 && val <= 5.0) {
          currentExaggeration = val;
          exagPills.forEach(p => {
            if (parseFloat(p.dataset.exag) === val) p.classList.add('active');
            else p.classList.remove('active');
          });
          if (terrainMesh) buildTerrainMesh(currentExaggeration, currentTerrainTexture);
        }
      }

      // Deep-linking support for custom start/destination and actions
      const startR = params.get('start_r');
      const startC = params.get('start_c');
      if (startR !== null && startC !== null) {
        const r = parseInt(startR);
        const c = parseInt(startC);
        customStart = { row: r, col: c, name: `Custom Departure (${r}, ${c})` };
        if (startPointVal) startPointVal.textContent = customStart.name;
        updateStartMarker(r, c);
      }

      const goalR = params.get('goal_r');
      const goalC = params.get('goal_c');
      if (goalR !== null && goalC !== null) {
        const r = parseInt(goalR);
        const c = parseInt(goalC);
        customGoal = { row: r, col: c, name: `Custom Destination (${r}, ${c})` };
        if (goalPointVal) goalPointVal.textContent = customGoal.name;
        updateGoalMarker(r, c);
      }

      const scenarioParam = params.get('scenario');
      if (scenarioParam && gauntletScenarioSelect) {
        gauntletScenarioSelect.value = scenarioParam;
      }

      // Milestone 9L: Check URL query parameters for deep linking vs landing page display
      const isDeepLink = params.has('view') ||
                         params.has('mode') ||
                         params.has('fly') ||
                         params.has('route') ||
                         params.has('wp') ||
                         params.has('waypoint') ||
                         params.has('place') ||
                         params.has('feature') ||
                         params.has('q') ||
                         params.has('search') ||
                         params.has('cat') ||
                         params.has('category') ||
                         params.get('skip_landing') === '1' ||
                         params.get('landing') === '0' ||
                         params.get('landing') === 'false';
      const forceLanding = params.get('landing') === '1' || params.get('landing') === 'true';

      if (forceLanding || !isDeepLink) {
        showLandingPage();
      } else {
        hideLandingPage();
      }

      // Milestone 13B: Auto-launch Conference Demo Mode if ?mode=demo or ?demo=1
      if (params.get('mode') === 'demo' || params.get('demo') === '1' || params.get('demo') === 'true') {
        hideLandingPage();
        setTimeout(() => {
          enterDemoMode();
        }, 300);
      }

      // Milestone 13C: Initialize Atlas 3D Mission Theater
      initMissionTheater();

      // Milestone 9H: Expose Atlas Developer & Automation API
      window.__atlas = {
        isBooted: () => true,
        getPlacesCatalog: () => placeCatalog,
        getPlacesById: () => placesById,
        placesById: placesById,
        getPlaceById: (id) => placesById.get(id),
        getActiveDetourPath: () => activeDetourPath,
        getActiveDisruptionHazard: () => activeDisruptionHazard,
        setJezeroView,
        setOrbitView,
        setTerrainTexture,
        flyToJezeroView,
        calculateTraverse,
        calculateRoute: calculateTraverse,
        enterDemoMode,
        exitDemoMode,
        setDemoStep,
        runGauntletStressTest,
        setVehicleMode,
        getVehicleMode: () => currentVehicleMode,
        optimizeMissionStops,
        applyRecoveryPlan,
        getTimeline: () => activeTimeline,
        getGauntletResult: () => lastGauntletResult,
        getRecoveryPlan: () => lastRecoveryPlan,
        getMissionData: () => missionData,
        getViewMode: () => currentViewMode,
        getTerrainTexture: () => currentTerrainTexture,
        getActiveStops: () => activeIntermediateStops,
        // Milestone 9I: Expose Scenario Comparison Lab & Sensitivity Analysis
        runScenarioComparison: runScenarioComparisonLab,
        runScenarioSensitivity: runScenarioSensitivity,
        exportMissionBriefing: exportMissionBriefing,
        getComparisonState: () => ({
          lastComparisonResult,
          lastSensitivityResult,
          lastRecoveryPlan,
          isSimulationStale
        }),
        getBaselineRouteResult: () => activeBaselineRouteResult,
        getMissionFingerprint: () => activeMissionFingerprint,
        isSimulationStale: () => isSimulationStale,
        setSimulationStale: (stale) => setSimulationStale(stale),
        setVehicleMode: (mode) => setVehicleMode(mode),
        setCustomGoal: (wp) => {
          customGoal = { row: wp.row, col: wp.col, id: wp.id, name: wp.name };
          if (goalPointVal) goalPointVal.textContent = wp.name;
          updateGoalMarker(wp.row, wp.col);
          updateCalculateButtonState();
          buildWaypointBeacons();
          updateJezeroLabels();
          populateAddStopDropdown();
          setSimulationStale(true);
          setUnsavedChanges(true);
          clearDetour();
          if (gauntletResultCard) gauntletResultCard.classList.add('hidden');
          if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
          if (comparisonLabCard) comparisonLabCard.classList.add('hidden');
          if (sensitivityResultCard) sensitivityResultCard.classList.add('hidden');
        },
        setCustomStart: (wp) => {
          customStart = { row: wp.row, col: wp.col, id: wp.id, name: wp.name };
          if (startPointVal) startPointVal.textContent = wp.name;
          updateStartMarker(wp.row, wp.col);
          updateCalculateButtonState();
          buildWaypointBeacons();
          updateJezeroLabels();
          populateAddStopDropdown();
          setSimulationStale(true);
          setUnsavedChanges(true);
          clearDetour();
          if (gauntletResultCard) gauntletResultCard.classList.add('hidden');
          if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
          if (comparisonLabCard) comparisonLabCard.classList.add('hidden');
          if (sensitivityResultCard) sensitivityResultCard.classList.add('hidden');
        },
        addIntermediateStop: (wp) => {
          if (!wp) return;
          activeIntermediateStops.push(wp);
          renderActiveStopsList();
          populateAddStopDropdown();
          setSimulationStale(true);
          setUnsavedChanges(true);
          clearDetour();
          if (gauntletResultCard) gauntletResultCard.classList.add('hidden');
          if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
          if (comparisonLabCard) comparisonLabCard.classList.add('hidden');
          if (sensitivityResultCard) sensitivityResultCard.classList.add('hidden');
        },
        clearIntermediateStops: () => {
          activeIntermediateStops = [];
          renderActiveStopsList();
          populateAddStopDropdown();
          setSimulationStale(true);
          setUnsavedChanges(true);
          clearDetour();
          if (gauntletResultCard) gauntletResultCard.classList.add('hidden');
          if (recoveryPlanCard) recoveryPlanCard.classList.add('hidden');
          if (comparisonLabCard) comparisonLabCard.classList.add('hidden');
          if (sensitivityResultCard) sensitivityResultCard.classList.add('hidden');
        },
        // Milestone 9K: Persistent Mission Workspace & Experiment Library
        saveMission: (name) => saveCurrentMission(name),
        loadMission: (id) => loadMissionById(id),
        listMissions: () => fetch('/api/missions').then(r => r.json()),
        deleteMission: (id) => deleteMissionById(id),
        duplicateMission: (id) => duplicateMissionById(id),
        saveExperiment: (name) => saveCurrentExperiment(name),
        loadExperiment: (id) => viewExperimentById(id),
        listExperiments: () => fetch('/api/experiments').then(r => r.json()),
        replayExperiment: (id) => replayExperimentById(id),
        compareExperiments: (idA, idB) => executeExperimentComparison(idA, idB),
        getActiveMissionId: () => activeSavedMissionId,
        getActiveMissionName: () => activeSavedMissionName,
        hasUnsavedChanges: () => hasUnsavedChanges,
        getActiveHistoricalExperiment: () => activeHistoricalExperiment,
        // Milestone 9L: Cinematic Landing Page & Planetary Onboarding API
        showLandingPage: () => showLandingPage(),
        hideLandingPage: (triggerExploration) => hideLandingPage(triggerExploration),
        isLandingPageActive: () => isLandingActive,
        openOnboarding: (step) => openOnboarding(step),
        closeOnboarding: (markCompleted) => closeOnboarding(markCompleted),
        setOnboardingStep: (step) => setOnboardingStep(step),
        getOnboardingStep: () => currentOnboardingStep,
        resetOnboarding: () => resetOnboarding(),
        selectDestination: (destKey) => handleDestinationSelect(destKey),
        // Milestone 9M: Inspector Tabs & Expedition Budget API
        switchInspectorTab: (tabId) => switchInspectorTab(tabId),
        setShowAllWaypoints: (show) => setWaypointVisibilityMode(show ? 'all' : 'mission'),
        setExpeditionBudget: ({ hours, dwellMins, delayMins, maxDistM }) => {
          if (hours !== undefined && inputExpeditionHours) inputExpeditionHours.value = hours;
          if (dwellMins !== undefined && inputDwellMins) inputDwellMins.value = dwellMins;
          if (delayMins !== undefined && inputDelayMins) inputDelayMins.value = delayMins;
          if (maxDistM !== undefined && inputMaxDistanceM) inputMaxDistanceM.value = maxDistM;
        },
        // Milestone 9N: Waypoint Visibility & Mission Workspace Controls API
        setWaypointVisibilityMode: (mode) => setWaypointVisibilityMode(mode),
        getWaypointVisibilityMode: () => waypointVisibilityMode,
        clearStart: () => clearStart(),
        clearGoal: () => clearGoal(),
        swapEndpoints: () => swapEndpoints(),
        resetMission: (force = true) => resetMission(force),
        executeResetMission: () => executeResetMission(),
        getCustomStart: () => customStart,
        getCustomGoal: () => customGoal,
        getActiveIntermediateStops: () => activeIntermediateStops,
        // Milestone 9O: Multi-Scale Planetary Imagery & Regional Verification API
        getTileCacheStatus: () => fetch('/api/imagery/status').then(r => r.json()),
        getActiveRegionalProduct: () => activeRegionalProduct,
        getActiveRegionalOverlayMesh: () => activeRegionalOverlayMesh,
        cancelCurrentFlight: () => cancelCurrentFlight(),
        getRegionalTextureCacheKeys: () => Array.from(regionalTextureCache.keys()),
        loadRegionalOverlayForProduct: (product, cb) => loadRegionalImageryOverlay(product, cb),
        clearRegionalOverlay: () => clearRegionalOverlay(),
        // Milestone 9Q: Competition Demo Mode, Showcase & Preflight API
        enterDemoMode: () => enterDemoMode(),
        exitDemoMode: (restore = true) => exitDemoMode(restore),
        isDemoModeActive: () => isDemoModeActive,
        setDemoStep: (step) => setDemoStep(step),
        getDemoStep: () => currentDemoStep,
        loadDemoMissionConfig: () => loadDemoMissionConfig(),
        openPreflightModal: () => openPreflightModal(),
        closePreflightModal: () => closePreflightModal(),
        getPreflightStatus: () => fetch('/api/preflight').then(r => r.json()),
        // Milestone 9R: Interactive Contingency Designer & What-If API
        simulateContingency: () => simulateCustomContingency(),
        stageContingencyEvent: (def) => {
          stagedContingencyEvents.push(def);
          renderStagedContingencyList();
          renderContingency3DOverlays();
        },
        clearContingencyEvents: () => clearContingencyEvents(),
        getStagedContingencyEvents: () => stagedContingencyEvents,
        getLastContingencyResult: () => activeContingencyResult,
        saveContingencyAsExperiment: () => saveContingencyAsExperiment(),
        setPlanningMode: (mode) => setPlanningMode(mode),
        setContingencyPickedLocation: (r, c) => setContingencyPickedLocation(r, c),
        // Milestone 9T: Decision Pack & Reproducibility API
        exportDecisionPack: () => exportDecisionPack(),
        // Milestone 9V: Mission Design Lab & Autonomous Tour Optimizer API
        initMissionDesignLab: () => initMissionDesignLab(),
        generateMissionAlternatives: () => generateMissionAlternatives(),
        getMdlReport: () => mdlActiveReport,
        getSelectedSortie: () => mdlSelectedSortie,
        selectMdlCandidate: (c, opts) => selectMdlCandidate(c, opts),
        applyMdlSortie: (s) => applyMdlSortieToActiveMission(s),
        setMdlSelectedTargets: (targetIds) => {
          mdlSelectedTargetIds = new Set(targetIds);
          renderMdlTargetPills();
          markMdlStale();
        },
        getMdlSelectedTargets: () => Array.from(mdlSelectedTargetIds),
        isMdlStale: () => isMdlStale,
        markMdlStale: () => markMdlStale(),
        // Milestone 9W: Adaptive Mission Replanning & Science Recovery API
        replanAdaptiveMission: () => executeAdaptiveReplanning(),
        getActiveAdaptiveResult: () => activeAdaptiveResult,
        applyAdaptivePlan: () => applyAdaptivePlanToActiveMission(),
        previewAdaptiveRoute: () => previewAdaptive3DRoute(),
        isAdaptiveStale: () => isAdaptiveStale,
        // Milestone 9X: Mission Robustness Lab & Decision Stability API
        executeMissionRobustnessAnalysis: () => executeMissionRobustnessAnalysis(),
        getActiveRobustnessResult: () => activeRobustnessResult,
        isRobustnessStale: () => isRobustnessStale,
        markRobustnessStale: () => markRobustnessStale(),
        // Milestone 9Y: Route Decision Intelligence & Cost Attribution API
        executeRouteExplanation: () => executeRouteExplanation(),
        getActiveRouteExplanationResult: () => activeRouteExplanationResult,
        highlightRouteSegment: (subpath) => highlightRouteSegment(subpath),
        clearHighlightedSegment: () => clearHighlightedSegment(),
        isRouteExplanationStale: () => isRouteExplanationStale,
        // Milestone 9Z: Mission Timeline Playback & Synchronized 3D Route Animation API
        playMissionPlayback: () => playMissionPlayback(),
        pauseMissionPlayback: () => pauseMissionPlayback(),
        resetMissionPlayback: () => resetMissionPlayback(),
        seekMissionPlayback: (t) => seekMissionPlayback(t),
        setPlaybackSpeed: (spd) => setPlaybackSpeed(spd),
        setPlaybackVariant: (v) => setPlaybackVariant(v),
        getPlaybackState: () => ({ ...playbackState }),
        getPlaybackModel: (v) => playbackModels[v || playbackState.activeVariant],
        focusPlaybackMarker: () => focusPlaybackMarker(),
        refreshPlaybackData: (v) => refreshPlaybackData(v),
        // Milestone 10A: Mission Camera Director & Synchronized Audio Synthesizer API
        setCameraDirectorMode: (m) => setCameraDirectorMode(m),
        getCameraDirectorMode: () => getCameraDirectorMode(),
        toggleAudioCues: (force) => toggleAudioCues(force),
        isAudioCuesEnabled: () => audioCuesEnabled,
        playMissionEventCue: (type) => playMissionEventCue(type),
        getRoverHeadingRad: () => roverSmoothedHeadingRad,
        getRoverHeadingDeg: () => (Math.round((roverSmoothedHeadingRad * 180.0) / Math.PI) + 360) % 360,
        isRoverStationary: () => isRoverStationary,
        // Milestone 10B: Mid-Sortie Emergency Injection & Live Replanning API
        openEmergencyInjection: () => openEmergencyInjectionDrawer(),
        closeEmergencyInjection: () => closeEmergencyInjectionDrawer(),
        calculateContinuation: (ev) => calculateMissionContinuation(ev),
        applyContinuation: () => applyMissionContinuation(),
        revertContinuation: () => revertMissionContinuation(),
        getActiveContinuationResult: () => activeContinuationResult,
        getCapturedMidSortieState: () => capturedMidSortieState,
        // Milestone 10C: Sortie Black Box & Incident Replay API
        openBlackBox: () => openBlackBoxModal(),
        closeBlackBox: () => closeBlackBoxModal(),
        getBlackBoxEvents: () => blackBoxEvents,
        loadBlackBoxEvents: (f) => loadBlackBoxEvents(f),
        renderBlackBoxEvents: (f) => renderBlackBoxEvents(f),
        selectBlackBoxEvent: (ev) => selectBlackBoxEvent(ev),
        replayIncident: () => triggerIncidentReplay(),
        logMissionEvent: (ev) => logMissionEvent(ev),
        // Milestone 10D: Mars Environmental Intelligence API
        openWeather: () => openWeatherModal(),
        closeWeather: () => closeWeatherModal(),
        getWeatherSnapshot: () => currentWeatherSnapshot,
        loadWeather: (s, f) => loadWeatherData(s, f),
        refreshWeather: (s) => loadWeatherData(s, true),
        // Milestone 10E: Mission Science Report & Export Dashboard API
        openMissionReport: (mid) => openMissionReportModal(mid),
        closeMissionReport: () => closeMissionReportModal(),
        generateReport: (mid, site) => generateMissionReport(mid, site),
        getReportData: () => currentMissionReportData,
        getReportHtml: () => currentMissionReportHtml,
        downloadReportHtml: () => downloadMissionReportHtml(),
        downloadReportJson: () => downloadMissionReportJson(),
        printReport: () => printMissionReport(),
        // Milestone 10F: Mission Readiness & Decision Gate API
        openReadiness: (mid) => openMissionReadinessModal(mid),
        closeReadiness: () => closeMissionReadinessModal(),
        assessReadiness: (mid, site) => runMissionReadinessAssessment(mid, site),
        getReadinessAssessment: () => currentReadinessAssessment,
        exportReadinessJson: () => exportReadinessAssessmentJson(),
        // Milestone 11A: Mission Campaign Orchestrator API
        openCampaign: () => openCampaignModal(),
        closeCampaign: () => closeCampaignModal(),
        planCampaign: (opts) => planCampaignAction(opts),
        replanCampaign: (opts) => replanCampaignAction(opts),
        getCampaignPlan: () => currentCampaignPlan,
        drawCampaignRoutes: (sorties) => drawCampaignSortieRoutes(sorties),
        clearCampaignRoutes: () => clearCampaignRoutes(),
        exportCampaignJson: () => exportCampaignJson(),
        exportCampaignHtml: () => exportCampaignHtml(),
        // Milestone 11B: Campaign Progress & Science Observation Registry API
        switchCampaignTab: (tab) => switchCampaignTab(tab),
        loadCampaignProgress: (cid) => loadAndRenderCampaignProgress(cid),
        openRecordObservationModal: (tid, sol) => openRecordObservationModal(tid, sol),
        closeRecordObservationModal: () => closeRecordObservationModal(),
        submitObservation: () => submitObservationAction(),
        markTargetBlocked: (tid) => markTargetBlockedAction(tid),
        // Milestone 11C: Observation-Driven Campaign Intelligence API
        evaluateCampaignIntelligence: (cid, apply) => evaluateCampaignIntelligence(cid, apply),
        renderRecommendationResults: (rec) => renderRecommendationResults(rec),
        exportRecommendationJson: () => exportRecommendationJson(),
        getLatestRecommendation: () => latestCampaignRecommendation,
        // Milestone 11D: Campaign What-If Simulation Lab & Scenario Comparison API
        simulateWhatIfScenario: (spec) => simulateWhatIfScenario(spec),
        runWhatIfStandardPresets: () => runWhatIfStandardPresets(),
        promoteScenario: (scenId) => promoteSelectedScenario(scenId),
        getCampaignScenarios: () => currentCampaignScenarios,
        exportWhatIfBriefing: () => exportWhatIfBriefingJson(),
        // Milestone 11E: Multi-Agent Campaign Coordination & Resource Handoffs API
        coordinateFleet: (strat) => coordinateCampaignFleet(strat),
        executeHandoff: (params) => executeTaskHandoffDirect(params),
        applyCoordinationPlan: () => applyCoordinationPlanAction(),
        getCoordinationPlan: () => currentCoordinationPlan,
        getCampaignHandoffs: () => currentCampaignHandoffs,
        exportCoordinationBriefing: () => exportCoordinationBriefingJson(),
        // Milestone 11F: Campaign Digital Twin & Execution Simulation API
        startSimulation: (cid) => startCampaignSimulationAction(cid),
        advanceSimulation: (deltaS) => advanceSimTime(deltaS),
        stepSimulation: () => stepSimEvent(),
        seekSimulation: (t) => seekSimTime(t),
        injectSimulationInterruption: () => injectSimContingencyAction(),
        getSimulation: () => currentCampaignSimulation,
        exportSimulationBriefing: () => exportSimBriefingJson(),
        // Milestone 11G: Campaign Performance Analytics API
        runCampaignAnalytics: () => runCampaignPerformanceAnalysis(),
        getCampaignAnalysis: () => currentCampaignAnalysis,
        exportCampaignAnalytics: () => exportCampaignAnalyticsJson(),
        // Milestone 11H: Campaign Design Space API
        exploreDesignSpace: () => runCampaignDesignSpaceExploration(),
        getDesignSpace: () => currentDesignSpaceEvaluation,
        promoteCandidate: () => promoteSelectedCandidateAction(),
        exportDesignSpace: () => exportDesignSpaceJson(),
        // Milestone 12D: Atlas Mission Operations Cockpit & Evidence Inspector API
        initMissionControl: () => initMissionControl(),
        loadMissionControlCampaigns: () => loadMissionControlCampaigns(),
        selectMissionControlCampaign: (cid) => selectMissionControlCampaign(cid),
        getMissionControlState: () => mcState,
        rehearseMissionControl: () => startMissionControlSimulation(),
        pauseMissionControl: () => pauseMissionControlSimulation(),
        inspectEvidence: (k, v) => openEvidenceInspector(k, v),
        exportDecisionPackFromCockpit: () => exportMissionControlDecisionPack(),
        // Milestone 12F & 12G: Mission Rehearsal Director & Causal Replay Studio API
        executeRehearsal: (payload) => executeRehearsalAction(payload),
        getRehearsal: () => currentRehearsalRecord,
        listRehearsals: (cid) => fetch('/api/rehearsal/list' + (cid ? '?campaign_id=' + cid : '')).then(r => r.json()),
        getRehearsalDisturbances: () => fetch('/api/rehearsal/disturbances').then(r => r.json()),
        syncRehearsalCampaigns: () => syncRehearsalCampaigns(),
        loadHistoricalReplay: (id) => loadSelectedHistoricalReplay(id),
        seekRehearsalStep: (s) => seekRehearsalStep(s),
        setRehearsalMetricMode: (m) => setRehearsalMetricMode(m),
        exportEvidenceBundle: (f) => exportEvidenceBundle(f),
        // Milestone 12H: Mission Experiment Studio API
        orchestrateExperiment: () => executeExperimentAction(),
        getExperimentRecord: () => currentExperimentRecord,
        exportExperimentDossier: (f) => exportExperimentDossierAction(f),
        syncExperimentCampaigns: () => syncExperimentCampaigns(),
        // Milestone 12E: Mission Robustness Lab API
        runRobustnessLab: (suite, cid) => runRobustnessLabEvaluation(suite, cid),
        getRobustnessReport: () => currentRobustnessReport,
        promoteResilientStrategy: (stratId) => promoteSelectedResilientStrategyAction(stratId),
        syncRobustnessCampaigns: () => syncRobustnessCampaigns(),
        // Milestone 12C: Route Decision Workbench API
        refreshTerrainProfile: (r, c) => refreshTerrainProfileAnalysis(r, c),
        getTerrainAnalysis: () => currentTerrainAnalysis,
        getRouteComparison: () => currentComparisonData,
        clearTerrainWorkbench: () => clearTerrainProfileWorkbench(),
        // Milestone 13C: Atlas 3D Mission Theater API
        enterTheaterMode: () => enterMissionTheaterMode(),
        exitTheaterMode: () => exitMissionTheaterMode(),
        setTheaterCameraMode: (m) => setCameraDirectorMode(m),
        getTheaterCameraMode: () => getCameraDirectorMode()
      };
      window.MarsWalk = window.__atlas;
    } catch (err) {
      console.error('[MarsWalk Atlas] Boot failure:', err && err.message ? err.message : err, err ? err.stack : '');
    }
  }

  // Start Boot
  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
